#: iraction.cpp:122
msgid "Exit mode"
msgstr "Шыққанда"

#: iraction.cpp:124
#, kde-format
msgid "Switch to %1"
msgstr "%1 дегенге ауысу"

#: iraction.cpp:127
msgid "Just start"
msgstr "Тек бастау"

#: iraction.cpp:141
msgid "Do actions before. "
msgstr "Әрекеттерді алдында жасау. "

#: iraction.cpp:142
msgid "Do actions after. "
msgstr "Әрекеттерді соңында жасау. "

#: iraction.cpp:146
msgid "Auto-start. "
msgstr "Авто бастау. "

#: iraction.cpp:147
msgid "Repeatable. "
msgstr "Қайталанатын. "

#: iraction.cpp:148
msgid "Do nothing if many instances. "
msgstr "Бірнеше данасы болса ештеңе істемеу. "

#: iraction.cpp:149
msgid "Send to top instance. "
msgstr "Жоғарғы данасына жіберу. "

#: iraction.cpp:150
msgid "Send to bottom instance. "
msgstr "Төменгі данасына жіберу. "

#: iraction.cpp:150
msgid "Send to all instances. "
msgstr "Барлық данасына жіберу. "
