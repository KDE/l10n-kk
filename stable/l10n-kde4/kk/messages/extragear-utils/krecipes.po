msgstr "Krecipes \"%1\" деректер қорын аша алмады."

#: backends/qsqlrecipedb.cpp:131 backends/qsqlrecipedb.cpp:146
#, kde-format
msgid ""
"Krecipes could not open the database using the driver '%2' (with username: "
