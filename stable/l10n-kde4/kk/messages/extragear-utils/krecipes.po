msgstr "Деректер қорын ашу жаңылысы. Шығу әрекеті\n"

#: backends/qsqlrecipedb.cpp:155
msgid ""
"This database was created with a newer version of Krecipes and cannot be "
"opened."
msgstr "Деректер қоры жаңа Krecipes нұсқасымен құрылған, сондықтан ашылмайды."

#: backends/qsqlrecipedb.cpp:164
msgid "Failed to fix database structure."
msgstr "Деректер қорын жөндеу жаңылысы."

#: backends/qsqlrecipedb.cpp:1814
#, kde-format
