#: plugins/nowlistening/nowlisteningguiclient.cpp:39
msgid "Send Media Info"
msgstr "Әуен туралы мәліметті жіберу"

#: plugins/nowlistening/nowlisteningguiclient.cpp:64
msgid ""
"None of the supported media players (Amarok, KsCD, JuK, Kaffeine, Quod "
"Libet, or Qmmp) are playing anything."
msgstr ""
"Жүйеңіз танитын медиа ойнатқыштардың (Amarok, KsCD, JuK, Kaffeine, Quod "
"Libet, Qmmp) біреуі де ештеңе орындап жатқан жоқ."

#: plugins/nowlistening/nowlisteningguiclient.cpp:65
msgid "Nothing to Send"
msgstr "Жіберетін ештеңе жоқ"

#: plugins/nowlistening/nowlisteningplugin.cpp:133
msgid "USAGE: /media - Displays information on current song"
msgstr "ҚОЛДАНУЫ: /media - назардағы ән туралы мәліметін көрсету"

#: plugins/nowlistening/nowlisteningplugin.cpp:172
msgctxt ""
"Message from Kopete user to another user; used when sending media "
"information even though there are no songs playing or no media players "
"running"
msgid ""
"Now Listening for Kopete - it would tell you what I am listening to, if I "
"was listening to something on a supported media player."
msgstr ""
"Kopete-тің \"Қазір не тыңдап жатқаны\" - қолдау табатын медиа плейердің "
"біреуінде тыңдап жатқаныңызды басқаға жариялайды."

#: plugins/nowlistening/nowlisteningplugin.cpp:440
