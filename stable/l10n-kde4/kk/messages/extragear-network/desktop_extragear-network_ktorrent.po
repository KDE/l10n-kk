#: ktorrent/ktorrent.desktop:2 plasma/applet/plasma-applet-ktorrent.desktop:3
#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:2
msgctxt "Name"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/ktorrent.desktop:62
msgctxt "GenericName"
msgid "BitTorrent Client"
msgstr "BitTorrent клиенті"

#: ktorrent/ktorrent.desktop:128
msgctxt "Comment"
msgid "A BitTorrent program for KDE"
msgstr "KDE-нің BitTorrent бағдарламасы"

#: ktorrent/ktorrent.notifyrc:3
msgctxt "Comment"
msgid "KTorrent"
msgstr "KTorrent"

#: ktorrent/ktorrent.notifyrc:62
msgctxt "Name"
msgid "Torrent stopped by error"
msgstr "Торрент қатемен тоқталды"

#: ktorrent/ktorrent.notifyrc:115
msgctxt "Name"
msgid "Torrent has finished downloading"
msgstr "Торрент жүктеуі аяқталды"

#: ktorrent/ktorrent.notifyrc:168
msgctxt "Name"
msgid "Maximum share ratio reached"
msgstr "Максимум ортақтасу ара-қатынасына жетті"

#: ktorrent/ktorrent.notifyrc:220
msgctxt "Name"
msgid "Maximum seed time reached"
msgstr "Максимум тарату уақытына жетті"

#: ktorrent/ktorrent.notifyrc:272
msgctxt "Name"
msgid "Disk space is running low"
msgstr "Дискіде орын тапшылығы"

#: ktorrent/ktorrent.notifyrc:325
msgctxt "Name"
msgid "Corrupted data has been found"
msgstr "Бүлінген деректер табылды"

#: ktorrent/ktorrent.notifyrc:378
msgctxt "Name"
msgid "Torrent cannot be enqueued"
msgstr "Торрент кезекке тұрмайды"

#: ktorrent/ktorrent.notifyrc:430
msgctxt "Name"
msgid "Torrent cannot be started"
msgstr "Торрент басталмайды"

#: ktorrent/ktorrent.notifyrc:482
msgctxt "Name"
msgid "Torrent cannot be loaded silently"
msgstr "Торрент үндемей жүктелмейді"

#: ktorrent/ktorrent.notifyrc:534
msgctxt "Name"
msgid "DHT is not enabled"
msgstr "DHT рұқсат етілмеген"

#: ktorrent/ktorrent.notifyrc:581
msgctxt "Name"
msgid "Event generated by plugin"
msgstr "Плагин жасаған оқиға"

#: ktorrent/ktorrent.notifyrc:627
msgctxt "Name"
msgid "Magnet link download started"
msgstr "Магнит-сілтемені жүктеп алу басталды"

#: ktorrent/ktorrentplugin.desktop:4
msgctxt "Name"
msgid "KTorrent Plugin"
msgstr "KTorrent плагині"

#: plasma/applet/plasma-applet-ktorrent.desktop:64
msgctxt "Comment"
msgid "Plasma widget to keep track of a single torrent"
msgstr "Жалғыз торрентті қадағалау  Plasma виджеті"

#: plasma/dataengine/plasma-dataengine-ktorrent.desktop:62
msgctxt "Comment"
msgid "KTorrent data engine, for getting information from KTorrent"
msgstr "KTorrent-тен ақпаратты табатын KTorrent дерек тетігі"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:2
msgctxt "Name"
msgid "Scheduler"
msgstr "Жоспарлағыш"

#: plugins/bwscheduler/ktbwschedulerplugin.desktop:45
msgctxt "Comment"
msgid "Schedule upload and download limits over a period of a week"
msgstr "Бір апта мерзімге жүктеп алу мен беру шектерін жоспарлау"

#: plugins/downloadorder/ktdownloadorderplugin.desktop:2
msgctxt "Name"
msgid "Download Order"
msgstr "Жүктеп алу реті"

#: plugins/downloadorder/ktdownloadorderplugin.desktop:52
msgctxt "Comment"
msgid "Specify the download order of a multi-file torrent"
msgstr "Көп-файлды торрент ретін келтіру"

#: plugins/infowidget/ktinfowidgetplugin.desktop:2
msgctxt "Name"
msgid "Information Widget"
msgstr "Ақпарат виджеті"

#: plugins/infowidget/ktinfowidgetplugin.desktop:50
msgctxt "Comment"
msgid "Displays general information about a torrent in several tabs"
msgstr "Бірнеше қойындыда торрент туралы жалпы ақпарат беру"

#: plugins/ipfilter/ktipfilterplugin.desktop:2
msgctxt "Name"
msgid "IP Filter"
msgstr "IP сүзгісі"

#: plugins/ipfilter/ktipfilterplugin.desktop:53
msgctxt "Comment"
msgid "Filter IP addresses through a blocklist"
msgstr "Бұғаттау тізімі бойынша IP-адрестерді сүзу"

#: plugins/logviewer/ktlogviewerplugin.desktop:2
msgctxt "Name"
msgid "Log Viewer"
msgstr "Журналын қарау"

#: plugins/logviewer/ktlogviewerplugin.desktop:55
msgctxt "Comment"
msgid "Displays the logging output"
msgstr "Журнал жазуын көрсету"

#: plugins/magnetgenerator/ktmagnetgeneratorplugin.desktop:2
msgctxt "Name"
msgid "Magnet Generator"
msgstr "Магнит құрғышы"

#: plugins/magnetgenerator/ktmagnetgeneratorplugin.desktop:46
msgctxt "Comment"
msgid "Generates magnet links"
msgstr "Магнит-сілтемені құру"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:2
msgctxt "Name"
msgid "Media Player"
msgstr "Медиаплейер"

#: plugins/mediaplayer/ktmediaplayerplugin.desktop:55
msgctxt "Comment"
msgid "Phonon-based media player"
msgstr "Phonon-негізіндегі медиаплейер"

#: plugins/scanfolder/ktscanfolderplugin.desktop:2
msgctxt "Name"
msgid "Scan Folder"
msgstr "Қапшықты зерттеу"

#: plugins/scanfolder/ktscanfolderplugin.desktop:54
msgctxt "Comment"
msgid "Scan folders for torrent files and load them"
msgstr "Қапшқтарды торрент файлдар бар ма деп зерттеп оларды жүктеу"

#: plugins/scripting/ktscriptingplugin.desktop:2
msgctxt "Name"
msgid "Scripting"
msgstr "Скриптті жазу"

#: plugins/scripting/ktscriptingplugin.desktop:52
msgctxt "Comment"
msgid "Enables Kross scripting support"
msgstr "Kross скриптін рұқсат ету"

#: plugins/scripting/scripts/auto_remove/auto_remove.desktop:2
msgctxt "Name"
msgid "Automatic Remove"
msgstr "Автоматты түрде өшіру"

#: plugins/scripting/scripts/auto_remove/auto_remove.desktop:52
msgctxt "Comment"
msgid ""
"Script to automatically remove torrents when they finish downloading or "
"seeding"
msgstr ""
"Жүктеп алу не тарату аяқталған соң автоматты түрде торрентті өшіру скрипті"

#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:2
msgctxt "Name"
msgid "Automatic Resume"
msgstr "Автоматты түрде жалғастыру"

#: plugins/scripting/scripts/auto_resume/auto_resume.desktop:53
msgctxt "Comment"
msgid ""
"Script to automatically resume after some time, when the suspended state is "
"enabled"
msgstr ""
"Аялдау күйінде біршама уақыттан кейін автоматты түрде жалғастыру скрипті"

#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:2
msgctxt "Name"
msgid "E-Mail Notifications"
msgstr "Эл.поштамен құлақтандыру"

#: plugins/scripting/scripts/email_notifications/email_notifications.desktop:54
msgctxt "Comment"
msgid "Script to notify you of events via e-mail"
msgstr "Оқиғалар туралы эл.пошта арқылы құлақтандыру скрипті"

#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:2
msgctxt "Name"
msgid "Tracker Grouping"
msgstr "Трекер бойынша топтастыру"

#: plugins/scripting/scripts/tracker_groups/tracker_groups.desktop:51
msgctxt "Comment"
msgid "Script to create automatic groups based upon tracker URLs"
msgstr "Трекер URL бойынша автоматы түрде топтастыру скрипті"

#: plugins/search/ktsearchplugin.desktop:2
msgctxt "Name"
msgid "Search"
msgstr "Іздеу"

#: plugins/search/ktsearchplugin.desktop:55
msgctxt "Comment"
msgid "Search for torrents"
msgstr "Торренттерді іздеу"

#: plugins/shutdown/ktshutdownplugin.desktop:2
msgctxt "Name"
msgid "Shutdown"
msgstr "Сөндіру"

#: plugins/shutdown/ktshutdownplugin.desktop:55
msgctxt "Comment"
msgid "Allows you to shutdown your computer when torrents finish"
msgstr "Торренттер біткенде компьютеріңізді сөндіру"

#: plugins/stats/ktstatsplugin.desktop:3
msgctxt "Name"
msgid "Statistics"
msgstr "Статистика"

#: plugins/stats/ktstatsplugin.desktop:57
msgctxt "Comment"
msgid "Shows statistics about torrents in several graphs"
msgstr "Бірнеше графиктерде торренттер статистиканы көрсету"

#: plugins/syndication/ktsyndicationplugin.desktop:2
msgctxt "Name"
msgid "Syndication"
msgstr "Ақпарларды жариялау"

#: plugins/syndication/ktsyndicationplugin.desktop:51
msgctxt "Comment"
msgid "Syndication plugin for KTorrent, supporting RSS and Atom feeds"
msgstr "KTorrent-тің  RSS және Atom ақпарларын танитын жариялау плагині"

#: plugins/upnp/ktupnpplugin.desktop:2
msgctxt "Name"
msgid "UPnP"
msgstr "UPnP"

#: plugins/upnp/ktupnpplugin.desktop:55
msgctxt "Comment"
msgid "Forward ports using UPnP"
msgstr "UPnP көмегімен порттарды қайта бағыттау"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:2
msgctxt "Name"
msgid "Web Interface"
msgstr "Веб интерфейсі"

#: plugins/webinterface/ktwebinterfaceplugin.desktop:54
msgctxt "Comment"
msgid "Allows control of KTorrent via a web interface"
msgstr "KTorrent-ті Веб интерфейс арқылы басқару"

#: plugins/zeroconf/ktzeroconfplugin.desktop:2
msgctxt "Name"
msgid "Zeroconf"
msgstr "Zeroconf"

#: plugins/zeroconf/ktzeroconfplugin.desktop:53
msgctxt "Comment"
msgid "Discover peers on the local network using the Zeroconf protocol"
msgstr "Zeroconf протоколы бойынша жергілікті желідегі қатарларын табу"
