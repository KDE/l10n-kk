#: data/ktelepathy.notifyrc:3
msgctxt "Name"
msgid "Instant messaging"
msgstr "Лезде хабарласу"

#: data/ktelepathy.notifyrc:39
msgctxt "Comment"
msgid "Instant messaging"
msgstr "Лезде хабарласу"

#: data/ktelepathy.notifyrc:77
msgctxt "Name"
msgid "Group"
msgstr "Тобы"

#: data/ktelepathy.notifyrc:114
msgctxt "Comment"
msgid "The group where the contact resides"
msgstr "Контакт жататын тобы"

#: data/ktelepathy.notifyrc:152
msgctxt "Name"
msgid "Contact"
msgstr "Контакт"

#: data/ktelepathy.notifyrc:189
msgctxt "Comment"
msgid "The specified contact"
msgstr "Келтірілген контакт"

#: data/ktelepathy.notifyrc:227
msgctxt "Name"
msgid "Class"
msgstr "Класс"

#: data/ktelepathy.notifyrc:264
msgctxt "Comment"
msgid "The message class"
msgstr "Хабарлама класы"

#: data/ktelepathy.notifyrc:305
msgctxt "Name"
msgid "Instant messaging error"
msgstr "Лезде хабарласу қатесі"

#: data/ktelepathy.notifyrc:340
msgctxt "Comment"
msgid "An error occurred within instant messaging"
msgstr "Лезде хабарласуда бір қате орын алды"

#: data/ktelepathy.notifyrc:380
msgctxt "Name"
msgid "Instant messaging info message"
msgstr "Лезде хабарласу ақпар мәліметі"

#: data/ktelepathy.notifyrc:415
msgctxt "Comment"
msgid "A general info message from instant messaging"
msgstr "Лезде хабарласу жалпы ақпар мәліметі"

#: data/ktelepathy.notifyrc:457
msgctxt "Name"
msgid "Incoming Message"
msgstr "Хабарлама келді"

#: data/ktelepathy.notifyrc:494
msgctxt "Comment"
msgid "An incoming message has been received"
msgstr "Келген хабарлама қабылданды"

#: data/ktelepathy.notifyrc:537
msgctxt "Name"
msgid "Incoming Message in Active Chat"
msgstr "Белсенді чатқа хабарлама келді"

#: data/ktelepathy.notifyrc:573
msgctxt "Comment"
msgid "An incoming message in the active chat window has been received"
msgstr "Белсенді чат терезесіне хабарлама келіп түсті"

#: data/ktelepathy.notifyrc:615
msgctxt "Name"
msgid "Outgoing Message"
msgstr "Жіберілген хабарлама"

#: data/ktelepathy.notifyrc:651
msgctxt "Comment"
msgid "An outgoing message has been sent"
msgstr "Шығыс хабарлама жіберілді"

#: data/ktelepathy.notifyrc:693
msgctxt "Name"
msgid "Highlight"
msgstr "Бояп белгілеген"

#: data/ktelepathy.notifyrc:731
msgctxt "Comment"
msgid "A highlighted message has been received"
msgstr "Ерекше хабарлама келіп түсті"

#: data/ktelepathy.notifyrc:772
msgctxt "Name"
msgid "Buzz/Nudge"
msgstr "Оян қазақ!"

#: data/ktelepathy.notifyrc:808
msgctxt "Comment"
msgid "A contact has sent you a buzz/nudge"
msgstr "Бір контакт назарыңызды аударып жатыр"

#: data/ktelepathy.notifyrc:849
msgctxt "Name"
msgid "Message Dropped"
msgstr "Хабарлама лақтырып тасталды"

#: data/ktelepathy.notifyrc:885
msgctxt "Comment"
msgid "A message was filtered by the Privacy Plugin"
msgstr "Бір хабарлама Дербестік плагиннің сүзгісінен өтпеді"

#: data/ktelepathy.notifyrc:925
msgctxt "Name"
msgid "Service Message"
msgstr "Қызмет хабарламасы"

#: data/ktelepathy.notifyrc:961
msgctxt "Comment"
msgid "A service message has been received (e.g. authorization request)"
msgstr "Қызмет хабарламасы (мысалы, авторизацияны сұрауы) келіп түсті"

#: data/ktelepathy.notifyrc:1004
msgctxt "Name"
msgid "New incoming chat"
msgstr "Чат хабарламасы келді"

#: data/ktelepathy.notifyrc:1039
msgctxt "Comment"
msgid "A new instant message has been received"
msgstr "Жаңа жедел хабарлама келді"

#: data/ktelepathy.notifyrc:1079
msgctxt "Name"
msgid "Incoming file transfer"
msgstr "Кіріс файл тасымалы"

#: data/ktelepathy.notifyrc:1114
msgctxt "Comment"
msgid "An incoming file transfer request has been received"
msgstr "Кіріс файл тасымалдауын сұрауы келді"

#: data/ktelepathy.notifyrc:1155
msgctxt "Name"
msgid "Incoming call"
msgstr "Шақырыс келді"

#: data/ktelepathy.notifyrc:1190
msgctxt "Comment"
msgid "An incoming audio/video call request has been received"
msgstr "Кіріс аудио/видео әңгіме сұрауы келді"

#: data/ktelepathy.notifyrc:1232
msgctxt "Name"
msgid "Chatstyle Install Request"
msgstr "Чат стилін орнату сұранысы"

#: data/ktelepathy.notifyrc:1271
msgctxt "Name"
msgid "Chatstyle Installed Successfully"
msgstr "Чат стилі сәтті орнатылды"

#: data/ktelepathy.notifyrc:1310
msgctxt "Name"
msgid "Chatstyle Installation Failed"
msgstr "Чат стилін орнату жаңылысы"

#: data/ktelepathy.notifyrc:1349
msgctxt "Name"
msgid "Emoticonset Install Request"
msgstr "Көңіл күй белгілер жинағын орнату сұранысы"

#: data/ktelepathy.notifyrc:1388
msgctxt "Name"
msgid "Emoticonset Installed Successfully"
msgstr "Көңіл күй белгілер жинағы сәтті орнатылды"

#: data/ktelepathy.notifyrc:1428
msgctxt "Name"
msgid "Emoticonset Installation failed"
msgstr "Көңіл күй белгілер жинағын орнату жаңылысы"
