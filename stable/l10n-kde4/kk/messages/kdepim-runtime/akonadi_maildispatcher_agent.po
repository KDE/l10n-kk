#: maildispatcheragent.cpp:146 maildispatcheragent.cpp:318
#, kde-format
msgid "Sending messages (1 item in queue)..."
msgid_plural "Sending messages (%1 items in queue)..."
msgstr[0] "Хаттарды жолдау (кезекте %1 аталым)"

#: maildispatcheragent.cpp:157
msgid "Sending canceled."
msgstr "Жолдау доғарылды."

#: maildispatcheragent.cpp:164
msgid "Finished sending messages."
msgstr "Хатрды жолдау аяқталды."

#: maildispatcheragent.cpp:171
msgctxt "Notification when the email was sent"
msgid "E-mail successfully sent"
msgstr "Эл.пошта сәті жіберілді"

#: maildispatcheragent.cpp:176
msgid "No items in queue."
msgstr "Кезек бос."

#: maildispatcheragent.cpp:245
msgid "Online, sending messages in queue."
msgstr "Желіде, кезектегілер жіберліп жатыр."

#: maildispatcheragent.cpp:249
msgid "Offline, message sending suspended."
msgstr "Желіден тыс, кезек жіберуді күтіп тұр."

#: maildispatcheragent.cpp:273
#, kde-format
msgctxt "Message with given subject is being sent."
msgid "Sending: %1"
msgstr "%1 дегенді жіберу"

#: maildispatcheragent.cpp:345
#, kde-format
msgctxt "Notification when email sending failed"
msgid "E-mail sending failed: %1"
msgstr "Эл.потша жолдау жаңылысы: %1"

#: maildispatcheragent.cpp:369
msgid "Ready to dispatch messages."
msgstr "Хаттарды жіберуге дайын."

#: outboxqueue.cpp:336
#, kde-format
msgid "Could not access the outbox folder (%1)."
msgstr "Шығыс қапшығына (%1).қатынау жоқ."

#. i18n: file: settings.ui:15
#. i18n: ectx: property (windowTitle), widget (QWidget, ConfigDialog)
#: rc.cpp:3
msgid "Mail Dispatcher Agent Settings"
msgstr "Пошта жолдау агентінің баптауы"

#. i18n: file: settings.ui:21
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:6
msgid "Select the collection to be used as outbox:"
msgstr "Шығыс пошта жәшігі деп қолданатын жинақ:"

#. i18n: file: settings.ui:38
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:9
msgid "Select the collection to move sent messages into:"
msgstr "Жіберілген поштаны сақтайтын жинақ:"

#. i18n: file: maildispatcheragent.kcfg:10
#. i18n: ectx: label, entry (Outbox), group (General)
#: rc.cpp:12
msgid "Outbox collection id"
msgstr "Шығыс жинағының ID-і"

#. i18n: file: maildispatcheragent.kcfg:14
#. i18n: ectx: label, entry (SentMail), group (General)
#: rc.cpp:15
msgid "Sent Mail collection id"
msgstr "Жіберілген пошта жинағының ID-і"

#: sendjob.cpp:107 sendjob.cpp:108
msgid "Message sending aborted."
msgstr "Хатты жіберу доғарылды."

#: sendjob.cpp:116
msgid "Could not initiate message transport. Possibly invalid transport."
msgstr "Хатты жіберу процесы басталмады. Тасымалдау мәселесі."

#: sendjob.cpp:122
msgid "Could not send message. Invalid transport."
msgstr "Хат жіберілмеді. Тасымалдау мәселесі."

#: sendjob.cpp:147
#, kde-format
msgid "Failed to get D-Bus interface of resource %1."
msgstr "%1 дерек көзінің D-Bus интерфейсі қол жеткізбеді."

#: sendjob.cpp:162
#, kde-format
msgid "Invalid D-Bus reply from resource %1."
msgstr "%1 дерек көзінің D-Bus интерфейсі дұрыс жауап бермеді."

#: sendjob.cpp:271
msgid "Default sent-mail folder unavailable. Keeping message in outbox."
msgstr ""
"Әдетті жіберілген пошта қапшығы қол жеткізбеді. Хат шығыс жәшігінде қалады."

#: sendjob.cpp:283
msgid "Message transport aborted."
msgstr "Хат тасымалдауы доғарылды"

#: sendjob.cpp:284
msgid "Failed to transport message."
msgstr "Хат тасымалдау жаңылысы."

#: sendjob.cpp:331
msgid "Failed to get D-Bus interface of mailfilteragent."
msgstr ""
"Пошта сүзгілеу агентінің (mailfilteragent) D-Bus интерфейсі қол жеткізбеді."

#: sendjob.cpp:340
msgid "Invalid D-Bus reply from mailfilteragent"
msgstr ""
"Пошта сүзгілеу агентінің (mailfilteragent) D-Bus интерфейсі дұрыс жауап "
"бермеді."

#: sendjob.cpp:387
msgid "Sending succeeded, but failed to remove the message from the outbox."
msgstr "Сәті жіберілді, бірақ шығыс жәшігінен өшіргенде жаңылыс орын алды."

#: sendjob.cpp:391
msgid ""
"Sending succeeded, but failed to move the message to the sent-mail folder."
msgstr ""
"Сәті жіберілді, бірақ жіберілгендер қапшығына жылжытқанда жаңылыс орын алды."

#: sendjob.cpp:420
msgid "Failed to store result in item."
msgstr "Нәтижені жазып алу жаңылысы."

#: storeresultjob.cpp:68
msgid "Failed to fetch item."
msgstr "Керегін алу жаңылысы."

