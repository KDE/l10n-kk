msgid "Mimetype of the output file"
msgstr "Шығыс файлдың MIME түрі"

#: koconverter.cpp:117
#, kde-format
msgid "Mimetype for input file %1 not found!"
msgstr "%1 шығыс файлдың MIME түрі жоқ!"

#: koconverter.cpp:127
#, kde-format
msgid "Mimetype not found %1"
msgstr "%1 MIME түрі табылмады"

#: koconverter.cpp:136
msgid "Mimetype not found, try using the -mimetype option"
msgstr "MIME түрі табылмады,  -mimetype параметрін қолданыңыз"

#: koconverter.cpp:150
msgid "*** The conversion failed! ***"
msgstr "*** Түрлендіру жаңылысы! ***"

#: koconverter.cpp:155
msgid "Two arguments required"
msgstr "Екі аргумент керек"

