#: koconverter.cpp:66
msgid "(c) 2001-2004 KOffice developers"
msgstr "(c) 2001-2004 KOffice жасаушылар"

#: koconverter.cpp:67
msgid "David Faure"
msgstr "David Faure"

#: koconverter.cpp:68
