msgstr "Nicolas Goutte"

#: koconverter.cpp:72
msgid "Input file"
msgstr "Кіріс файлы"

#: koconverter.cpp:73
msgid "Output file"
msgstr "Шығыс файлы"

#: koconverter.cpp:74
msgid "Make a backup of the destination file"
msgstr "Мақсатты файлдың сақтық көшірмесін жасау"

#: koconverter.cpp:75
msgid "Batch mode: do not show dialogs"
msgstr "Десте режімі: диалогтар көрсетілмейді"

#: koconverter.cpp:76
msgid "Interactive mode: show dialogs (default)"
msgstr "Интерактивті режімі: диалогтар көрсетіледі (әдетті)"

