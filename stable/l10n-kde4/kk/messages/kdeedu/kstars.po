#. i18n: file: dialogs/wizlocation.ui:150
#. i18n: ectx: property (toolTip), widget (KLineEdit, ProvinceFilter)
#: rc.cpp:4320
msgid "Filter the list by province name"
msgstr "Өлкенің алғашқы әріптері бойынша тізімді қысқарту"

