#: src/worker/qaptworker.actions:2
msgctxt "Name"
msgid "Kubuntu"
msgstr "Kubuntu"

#: src/worker/qaptworker.actions:44
msgctxt "Name"
msgid "Update package information"
msgstr "Десте мәліметін жаңарту"

#: src/worker/qaptworker.actions:82
msgctxt "Description"
msgid "To update the software catalog you need to authenticate."
msgstr "Бағдарламалар каталогын жаңарту үшін аутентификациядан өту қажет."

#: src/worker/qaptworker.actions:124
msgctxt "Name"
msgid "Install or remove packages"
msgstr "Дестелерді орнату мен өшіру"

#: src/worker/qaptworker.actions:163
msgctxt "Description"
msgid "To install or remove software you need to authenticate."
msgstr "Бағдарламаларды орнату мен өшіру үшін аутентификациядан өту қажет."

#: src/worker/qaptworker.actions:205
msgctxt "Name"
msgid "Change software configuration"
msgstr "Бағдарламаның баптауын өзгерту"

#: src/worker/qaptworker.actions:244
msgctxt "Description"
msgid "To change software settings you need to authenticate."
msgstr "Бағдарламаның баптауын өзгерту үшін аутентификациядан өту қажет."

#: src/worker/qaptworker.actions:286
msgctxt "Name"
msgid "Cancel the task of another user"
msgstr "Басқа пайдаланушының тапсырмасынан қайту"

#: src/worker/qaptworker.actions:324
msgctxt "Description"
msgid "To cancel someone else's software changes you need to authenticate."
msgstr ""
"Басқалардың бағдарламаларға ендірген өзгерістерден қайту үшін "
"аутентификациядан өту қажет."

#: utils/plasma-runner-installer/plasma-runner-installer.desktop:2
msgctxt "Name"
msgid "Installer"
msgstr "Орнатқыш"

#: utils/plasma-runner-installer/plasma-runner-installer.desktop:44
msgctxt "Comment"
msgid "Suggests the installation of not-installed applications"
msgstr "Орнатылмаған қолданбаларды орнатуды ұсынады"

#: utils/qapt-deb-installer/qapt-deb-installer.desktop:2
msgctxt "Name"
msgid "QApt Package Installer"
msgstr "QApt дестесін орнатқышы"

#: utils/qapt-deb-installer/qapt-deb-installer.desktop:43
msgctxt "GenericName"
msgid "Package Installer"
msgstr "Десте орнатқышы"

#: utils/qapt-deb-installer/qapt-deb-installer.desktop:84
msgctxt "Comment"
msgid "Install and view software packages"
msgstr "Бағдарлама дестелерін орнату мен көру"

#: utils/qapt-deb-thumbnailer/debthumbnailer.desktop:3
msgctxt "Name"
msgid "Debian Package Files"
msgstr "Debian десте файлдары"
