#: alarmdialog.cpp:149
msgctxt "@title:window"
msgid "Reminders"
msgstr "Еске салу"

#: alarmdialog.cpp:153
msgctxt "@action:button"
msgid "Dismiss Reminder"
msgstr "Еске салудан айну"

#: alarmdialog.cpp:155
msgctxt "@info:tooltip"
msgid "Dismiss the reminders for the selected incidences"
msgstr "Таңдалған оқиға мен істер туралы еске салудан айну"

#: alarmdialog.cpp:156
msgctxt "@action:button"
msgid "Dismiss All"
msgstr "Барлығынан айну"

#: alarmdialog.cpp:158
msgctxt "@info:tooltip"
msgid "Dismiss the reminders for all listed incidences"
msgstr "Тізімегі барлығы туралы еске салудан айну"

#: alarmdialog.cpp:159
msgctxt "@action:button"
msgid "Edit..."
msgstr "Өзгерту..."

#: alarmdialog.cpp:161
msgctxt "@info:tooltip"
msgid "Edit the selected incidence"
msgstr "Таңдалғанды өзгерту"

#: alarmdialog.cpp:162
msgctxt "@action:button"
msgid "Suspend"
msgstr "Аялдау"

#: alarmdialog.cpp:164
msgctxt "@info:tooltip"
msgid ""
"Suspend the reminders for the selected incidences by the specified interval"
msgstr "Келтірілген аралықта. таңдалғандар туралы еске салуды тоқтату"

#: alarmdialog.cpp:175
msgctxt "@label"
msgid "Reminders: Click on a title to toggle the details viewer for that item"
msgstr "Еске салу: Егжей-тегжейлі көрінісі үшін атауынан түртіңз."

#: alarmdialog.cpp:184
msgctxt "@title:column reminder title"
msgid "Title"
msgstr "Айдары"

#: alarmdialog.cpp:185
msgctxt "@title:column happens at date/time"
msgid "Date Time"
msgstr "Күні Уақыты"

#: alarmdialog.cpp:186
msgctxt "@title:column trigger date/time"
msgid "Trigger Time"
msgstr "Жіберу уақыты"

#: alarmdialog.cpp:190
msgctxt "@info:tooltip"
msgid "The event or to-do title"
msgstr "Оқиғаның не істің атауы"

#: alarmdialog.cpp:193
msgctxt "@info:tooltip"
msgid "The reminder is set for this date/time"
msgstr "Еске салуды осы күн/уақытқа бегіленген"

#: alarmdialog.cpp:196
msgctxt "@info:tooltip"
msgid "The date/time the reminder was triggered"
msgstr "Еске салудың күн/уақытын  есептеуі басталды"

#: alarmdialog.cpp:215
msgctxt "@info default incidence details string"
msgid ""
"<emphasis>Select an event or to-do from the list above to view its details "
"here.</emphasis>"
msgstr ""
"<emphasis>Жоғардағы тізімінен, осында егжей-тегжейін қарайтын оқиға не істі "
"таңдаңыз.</emphasis>"

#: alarmdialog.cpp:226
msgctxt "@label:spinbox"
msgid "Suspend &duration:"
msgstr "Тоқтату &аралығы:"

#: alarmdialog.cpp:233
msgctxt "@info:tooltip"
msgid "Suspend the reminders by this amount of time"
msgstr "Осы кезге еске салуларды тоқтату"

#: alarmdialog.cpp:236
msgctxt "@info:whatsthis"
msgid ""
"Each reminder for the selected incidences will be suspended by this number "
"of time units. You can choose the time units (typically minutes) in the "
"adjacent selector."
msgstr ""
"Таңдалғандар туралы еске салу деген көрсетілген уақыт болмайды. Уақыт өлшем "
"бірлігін де таңдап алыңыз (әдетте, минут)."

#: alarmdialog.cpp:243
msgctxt "@item:inlistbox suspend in terms of minutes"
msgid "minute(s)"
msgstr "минут"

#: alarmdialog.cpp:244
msgctxt "@item:inlistbox suspend in terms of hours"
msgid "hour(s)"
msgstr "сағат"

#: alarmdialog.cpp:245
msgctxt "@item:inlistbox suspend in terms of days"
msgid "day(s)"
msgstr "күн"

#: alarmdialog.cpp:246
msgctxt "@item:inlistbox suspend in terms of weeks"
msgid "week(s)"
msgstr "апта"

#: alarmdialog.cpp:249
msgctxt "@info:tooltip"
msgid "Suspend the reminders using this time unit"
msgstr "Еске салуды тоқтату аралығының өлшем бірілігі"

#: alarmdialog.cpp:252
msgctxt "@info:whatsthis"
msgid ""
"Each reminder for the selected incidences will be suspended using this time "
"unit. You can set the number of time units in the adjacent number entry "
"input."
msgstr ""
"Таңдалғандар туралы еске салу деген болмайтын аралық уақыттың өлшем бірлігі. "
"Уақыт аралығының өзін де таңдап алыңыз."

#: alarmdialog.cpp:291
msgctxt "@label an elipsis"
msgid "..."
msgstr "..."

#: alarmdialog.cpp:438
#, kde-format
msgctxt "@info"
msgid "\"%1\" is a read-only item so modifications are not possible."
msgstr "\"%1\" деген тек оқу үшін, ол өзгертуге келмейді."

#: alarmdialog.cpp:649
msgctxt "@title"
msgid "Reminder"
msgstr "Еске салу"

#: alarmdialog.cpp:651 alarmdialog.cpp:654
#, kde-format
msgctxt "@title"
msgid "Reminder: %1"
msgstr "Еске салу: %1"

#: alarmdialog.cpp:923
msgctxt "@info"
msgid "Could not start KOrganizer so editing is not possible."
msgstr "KOrganizer жегілмеді, сондықтан өңдеу-өзгертуге болмайды."

#: alarmdialog.cpp:935
#, kde-format
msgctxt "@info"
msgid "An internal KOrganizer error occurred attempting to modify \"%1\""
msgstr "\"%1\" дегенді өзгерту кезінде KOrganizer-де бір ішкі қате орын алды."

