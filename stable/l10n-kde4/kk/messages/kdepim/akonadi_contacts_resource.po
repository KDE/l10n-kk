#: contactsresource.cpp:54
msgid "Personal Contacts"
msgstr "Дербес контакттар"

#: contactsresource.cpp:133
#, kde-format
msgid "Directory '%1' does not exists"
msgstr "'%1' деген каталогы жоқ екен"

#: contactsresource.cpp:155 contactsresource.cpp:199
#, kde-format
msgid "Found file of unknown format: '%1'"
msgstr "Беймәлім пішімдегі файл табылды: '%1'"

#: contactsresource.cpp:173
#, kde-format
msgid "Unable to open file '%1'"
msgstr "'%1' файлы ашылмады"

#: contactsresource.cpp:183
#, kde-format
msgid "Found invalid contact in file '%1'"
msgstr "'%1' файлында жарамсыз контакт табылды"

#: contactsresource.cpp:193
#, kde-format
msgid "Found invalid contact group in file '%1': %2"
msgstr "'%1' файлында жарамсыз контакт тобы: %2"

#: contactsresource.cpp:213 contactsresource.cpp:342 contactsresource.cpp:363
#: contactsresource.cpp:417
#, kde-format
msgid "Trying to write to a read-only directory: '%1'"
msgstr "Тек оқу үшін ғана каталогында жазу әрекеті: '%1'"

#: contactsresource.cpp:231 contactsresource.cpp:247 contactsresource.cpp:283
#: contactsresource.cpp:296
#, kde-format
msgid "Unable to write to file '%1': %2"
msgstr "'%1' файлы жазуға келмейді: %2"

#: contactsresource.cpp:267 contactsresource.cpp:317
#, kde-format
msgid "Trying to write to a read-only file: '%1'"
msgstr "Тек оқу үшін ғана файлға жазу әрекеті: '%1'"

#: contactsresource.cpp:307
#, kde-format
msgid "Received item with unknown payload %1"
msgstr "%1 - беймәлім деректі бірдеме келді"

#: contactsresource.cpp:332
#, kde-format
msgid "Unable to remove file '%1'"
msgstr "'%1' файлы өшірілмеді"

#: contactsresource.cpp:349
#, kde-format
msgid "Unable to create folder '%1'."
msgstr "'%1' қапшығы кұрылмады."

#: contactsresource.cpp:383
#, kde-format
msgid "Unable to rename folder '%1'."
msgstr "'%1' қапшығының атауы өзгертілмеді."

#: contactsresource.cpp:422
#, kde-format
msgid "Unable to delete folder '%1'."
msgstr "'%1' қапшығы өшірілмеді."

#: contactsresource.cpp:438
#, kde-format
msgid "Unable to move file '%1' to '%2', '%2' already exists."
msgstr "'%1' файл '%2' дегенге ауыспады, '%2' деген бар екен."

#: contactsresource.cpp:450
#, kde-format
msgid "Unable to move directory '%1' to '%2', '%2' already exists."
msgstr "'%1' каталогы '%2' дегенге ауыспады, '%2' деген бар екен."

#. i18n: file: contactsresource.kcfg:10
#. i18n: ectx: label, entry (Path), group (General)
#: rc.cpp:3
msgid "Path to contacts directory"
msgstr "Контакттар каталогының жолы"

#. i18n: file: contactsresource.kcfg:14
#. i18n: ectx: label, entry (ReadOnly), group (General)
#: rc.cpp:6
msgid "Do not change the actual backend data."
msgstr "Бар деректі өзгертпеу"

#. i18n: file: settingsdialog.ui:17
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:9 rc.cpp:27
msgid "Directory Name"
msgstr "Каталогтың атауы"

#. i18n: file: settingsdialog.ui:25
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:12 rc.cpp:30
msgid "&Directory:"
msgstr "&Каталог"

#. i18n: file: settingsdialog.ui:40
#. i18n: ectx: property (text), widget (QLabel, label_3)
#: rc.cpp:15 rc.cpp:33
msgid ""
"Select the directory whose contents should be represented by this resource. "
"If the directory does not exist, it will be created."
msgstr ""
"Осындай ресурсқа арнаған каталогын таңдаңыз. Каталог болмаса - "
"құрылады."

#. i18n: file: settingsdialog.ui:53
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:18 rc.cpp:36
msgid "Access Rights"
msgstr "Қатынау құқықтары"

#. i18n: file: settingsdialog.ui:59
#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: rc.cpp:21 rc.cpp:39
msgid "Read only"
msgstr "Тек оқу"

#. i18n: file: settingsdialog.ui:66
#. i18n: ectx: property (text), widget (QLabel, label_2)
#: rc.cpp:24 rc.cpp:42
msgid ""
"If read-only mode is enabled, no changes will be written to the directory "
"selected above. Read-only mode will be automatically enabled if you do not "
"have write access to the directory."
msgstr ""
"Тек оқу режімі орнатылса, жоғарда таңдалған каталогқа өзгеріс "
"еңгізуге болмайды. Ол каталогқа жазу құқығыңыз болмаса, онда "
"тек оқу ғана режімі автоматты түрде қосылады."


