msgctxt "@label:spinbox"
msgid "KOrganizer event duration:"
msgstr "KOrganizer оқиғасының ұзақтығы:"

#: prefdlg.cpp:744
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"<para>Enter the event duration in hours and minutes, for alarms which are "
