msgctxt "@title:window"
msgid "Alarm Type"
msgstr "Ескерту түрі"

#: mainwindow.cpp:1365
msgctxt "@info"
msgid "Choose alarm type to create:"
msgstr "Ескерту түрін таңдау:"

#: mainwindow.cpp:1494
msgctxt "@action"
msgid "Ena&ble"
msgstr "Рұқсат &ету"

#: mainwindow.cpp:1494
