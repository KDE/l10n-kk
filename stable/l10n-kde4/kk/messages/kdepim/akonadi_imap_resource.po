#: imapresource.cpp:188 imapresource.cpp:665 imapresource.cpp:885
msgid "There is currently no connection to the IMAP server."
msgstr "IMAP серверімен байланыс жоқ."

#: imapresource.cpp:248
msgid "No message retrieved, server reply was empty."
msgstr "Серверден хабар жоқ, ол бос жауап қайтарды."

#: imapresource.cpp:286
msgid "No server configured yet."
msgstr "Сервер әлі көрсетілмеген."

#: imapresource.cpp:347
msgid "Connection established."
msgstr "Байланыс орнатылды."

#: imapresource.cpp:545
msgid "Cannot move message, it does not exist on the server."
msgstr "Хабарлама орынан ауыспады, себебі - ол серверде жоқ."

#: imapresource.cpp:551
#, kde-format
msgid "Cannot move message out of '%1', '%1' does not exist on the server."
msgstr "Хабарлама '%1' деген орынан ауыспады, себебі - '%1' деген серверде жоқ."

#: imapresource.cpp:558
#, kde-format
msgid "Cannot move message to '%1', '%1' does not exist on the server."
msgstr "Хабарлама '%1' деген орынға ауыспады, себебі - '%1' деген серверде жоқ."

#: imapresource.cpp:602
#, kde-format
msgid ""
"Failed to move message out of '%1' on the IMAP server. Could not select '%1'."
msgstr "Хабарлама IMAP серверіндегі '%1' деген орынан ауыспады. '%1' таңдалмады."

#: imapresource.cpp:637
#, kde-format
msgid "Failed to move message to '%1' on the IMAP server. Could not copy into '%1'."
msgstr ""
"Хабарлама IMAP серверіндегі '%1' деген орынға ауыспады. '%1' дегенге "
"көшіруге болмайды."

#: imapresource.cpp:650
#, kde-format
msgid ""
"Failed to mark the message from '%1' for deletion on the IMAP server. It "
"will reappear on next sync."
msgstr ""
"IMAP серверіндегі '%1' дегендегі хабарламаны өшірілетін деп белгіленбеді. "
"Ол келесі қадамдаструда қайта пайда болады."

#: imapresource.cpp:763
msgid "Inbox"
msgstr "Кіріс"

#: imapresource.cpp:780
msgid "Shared Folders"
msgstr "Ортақ қапшықтар"

#: imapresource.cpp:1035
#, kde-format
msgid "Cannot add IMAP folder '%1' for a non-existing parent folder '%2'."
msgstr "'%1' IMAP қапшығы қосылмады, себебі, '%2'  деген аталық қапшығы жоқ."

#: imapresource.cpp:1070
#, kde-format
msgid "Failed to create folder '%1' on the IMAP server."
msgstr "'%1' қапшығы IMAP серверінде құрылмады."

#: imapresource.cpp:1081
#, kde-format
msgid "Cannot modify IMAP folder '%1', it does not exist on the server."
msgstr "'%1' IMAP қапшығына өзгеріс енгізуге болмайды, ондай қапшық жоқ."

#: imapresource.cpp:1132
#, kde-format
msgid ""
"ACLs for '%1' need to be retrieved from the IMAP server first. Skipping ACL "
"change"
msgstr ""
"Алдымен. '%%1' үшін IMAP серверінен қатынауды басқару тізімдерін (ACL) алу керек. "
"ACL-ды өзгертуі болмады."

#: imapresource.cpp:1309
msgid "Failed to rename the folder, restoring folder list."
msgstr "Қапшықтың атауын өзгерту жаңылысы. Қапшық тізімі қалпына келтірілмек."

#: imapresource.cpp:1332
#, kde-format
msgid "Failed to write the new ACLs for '%1' on the IMAP server. %2"
msgstr ""
"IMAP серверіне '%1' үшін жаңа қатынауды басқару тізімді "
"(ACL) жазу жаңылысы. %2"

#: imapresource.cpp:1347
#, kde-format
msgid "Failed to write the new annotations for '%1' on the IMAP server. %2"
msgstr "IMAP серверіне '%1' үшін жаңа аңдатпаларды жазу жаңылысы. %2"

#: imapresource.cpp:1375
msgid "Failed to delete the folder, restoring folder list."
msgstr "Қапшықты өшіру жаңылысы. Қапшық тізімі қалпына келтірілмек."

#: imapresource.cpp:1388
#, kde-format
msgid "Cannot move IMAP folder '%1', it does not exist on the server."
msgstr "'%1' IMAP қапшығы орынынан жылжымады, ондай қапшық жоқ."

#: imapresource.cpp:1395
#, kde-format
msgid "Cannot move IMAP folder '%1' out of '%2', '%2' does not exist on the server."
msgstr "'%1' IMAP қапшығы '%2' деген орнынан ауыспады, '%2' деген жоқ."

#: imapresource.cpp:1403
#, kde-format
msgid "Cannot move IMAP folder '%1' to '%2', '%2' does not exist on the server."
msgstr "'%1' IMAP қапшығы '%2' деген орнынға ауыспады, '%2' деген жоқ."

#: imapresource.cpp:1440
#, kde-format
msgid "Failed to move folder '%1' out of '%2' on the IMAP server."
msgstr "'%1' қапшығы IMAP серверінде '%2' деген орнынан ауыспады."

#: imapresource.cpp:1450
#, kde-format
msgid "Failed to subscribe to the newly moved folder '%1' on the IMAP server."
msgstr ""
"IMAP серверіндегі жаңа ауысқан '%1' қапшығына жазылу талпынысының  "
"жаңылысы."

