msgid "Please Configure"
msgstr "Баптау керек-ау"

#: weatherapplet.cpp:206
#, kde-format
msgctxt ""
"%1 is the weather condition, %2 is the temperature, both come from the "
"weather provider"
msgid "%1 %2"
msgstr "%1 %2"

