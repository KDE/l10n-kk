#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"X11R6 жүйесінің стандартты сеанс басқару протоколын (XSMP)\n"
"қолданатын сенімді KDE сеанс менеджері."

#: main.cpp:244
msgid "The KDE Session Manager"
msgstr "KDE сеанс менеджері"

#: main.cpp:246
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, KDE жасаушылар"

#: main.cpp:247
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:248
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:248
msgid "Maintainer"
msgstr "Жетелдірушісі"

#: main.cpp:256
msgid "Restores the saved user session if available"
msgstr "Мүмкіндік болса, пайдаланушының сақталған сеансын қалпына келтіру"

#: main.cpp:258
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Басқа терезе менеджері қолдануда болмаса, 'wm' менеджерін\n"
"іске қосу. Әдетте 'kwin' қолданылады"

#: main.cpp:259
msgid "Also allow remote connections"
msgstr "Қашық қосылымдарды да рұқсат етілсін"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Сайран Киккарин"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "sairan@computer.org"

#: shutdown.cpp:365
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "'%1' шыгуды доғарды"

#: shutdowndlg.cpp:386
msgid "&Logout"
msgstr "Жүйден &шығу"

#: shutdowndlg.cpp:395
msgid "&Turn Off Computer"
msgstr "Компьютерді &сөндіру"

#: shutdowndlg.cpp:408
msgid "&Standby"
msgstr "&Күту режімі"

#: shutdowndlg.cpp:412
msgid "Suspend to &RAM"
msgstr "Ж&адына сақтап қалғу"

#: shutdowndlg.cpp:416
msgid "Suspend to &Disk"
msgstr "&Дискіне сақтап қалғу"

#: shutdowndlg.cpp:422
msgid "&Restart Computer"
msgstr "Компьютерді қайта жегу"

#: shutdowndlg.cpp:446
msgctxt "current option in boot loader"
msgid " (current)"
msgstr " (қолданудағы)"

#: shutdowndlg.cpp:466
msgid "&Cancel"
msgstr "Қа&йту"

#: shutdowndlg.cpp:524
#, kde-format
