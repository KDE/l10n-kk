#: kio_nepomuk.cpp:299
#, kde-format
msgctxt "@info"
msgid ""
"Please insert the removable medium <resource>%1</resource> to access this "
"file."
msgstr ""
"Бұл файлға қатынау үшін <resource>%1</resource> ауыстырмалы тасушысын "
"салыңыз."

#: kio_nepomuk.cpp:321
msgid ""
"Do you really want to delete the resource and all relations to and from it?"
msgstr ""
"Бұл ресурсты, оған және оның бүкіл қатынастарын жоюды қалағаныңыз рас па?"

#: kio_nepomuk.cpp:324
msgid "Delete Resource"
msgstr "Ресурсты жою"

#: kio_nepomuk.cpp:614
msgid ""
"The Nepomuk system is not activated. Unable to answer queries without it."
msgstr ""
"Nepomuk жүйесі белсендірілмеген. Оны істемей сұраныстарға жауап болмайды."

#: resourcepagegenerator.cpp:182
msgid "Resource does not exist"
msgstr "Ресурс жоқ"

#: resourcepagegenerator.cpp:184
msgid "Relations:"
msgstr "Қатынастары:"

#: resourcepagegenerator.cpp:212
msgid "Backlinks:"
msgstr "Қайтар сілтемелері:"

#: resourcepagegenerator.cpp:232
msgid "Actions:"
msgstr "Әрекеттері:"

