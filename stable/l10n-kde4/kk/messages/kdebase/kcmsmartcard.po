#: rc.cpp:54 rc.cpp:110
msgid ""
"To add new readers you have to modify /etc/readers.conf file and re-start "
"pcscd"
msgstr ""
"Жаңа оқу құралын қосу үшін /etc/readers.conf файлды өзгертіп, pcscd жұмысын "
"қайта бастаңыз"

