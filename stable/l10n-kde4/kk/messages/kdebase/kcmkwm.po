msgid "None"
msgstr "Жоқ"

#: windows.cpp:126
msgctxt "Focus Stealing Prevention Level"
msgid "Low"
msgstr "Төмен"

#: windows.cpp:127
msgctxt "Focus Stealing Prevention Level"
