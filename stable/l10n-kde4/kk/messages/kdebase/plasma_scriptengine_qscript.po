#: javascriptdataengine.cpp:95
msgid "setData() takes at least two arguments"
msgstr "setData() дегеннің кемінде екі аргументі болуы тиіс"

#: javascriptdataengine.cpp:126
msgid "Could not extract the DataEngineObject"
msgstr "DataEngineObject тарқатып алынбады"

#: javascriptdataengine.cpp:130
msgid "Could not extract the DataEngine"
msgstr "DataEngine тарқатып алынбады"

#: javascriptdataengine.cpp:140
msgid "removeAllData() takes at least one argument (the source name)"
msgstr ""
"removeAllData() дегеннің кемінде бір аргументі болуы тиіс (көзінің атауы)"

#: javascriptdataengine.cpp:158
msgid "removeData() takes at least two arguments (the source and key names)"
msgstr ""
"removeData() дегеннің кемінде екі аргументі болуы тиіс (көзінің және "
"кілтінің атаулары)"

#: simplejavascriptapplet.cpp:132
#, kde-format
msgid ""
"Script failure on line %1:\n"
"%2"
msgstr ""
"Скрипттің %1-жолында қате:\n"
"%2"

#: simplejavascriptapplet.cpp:282
#, kde-format
msgid "Unable to load script file: %1"
msgstr "%1 скрипт файлы жүктелмеді"

#: simplejavascriptapplet.cpp:487
#, kde-format
msgid "Authorization for required extension '%1' was denied."
msgstr "'%1' кеңейту үшін рұқсат берілмеді."

#: simplejavascriptapplet.cpp:623
msgid "dataEngine() takes one argument"
msgstr "dataEngine() дегеннің кемінде бір аргументі болуы тиіс"

#: simplejavascriptapplet.cpp:628 simplejavascriptapplet.cpp:646
msgid "Could not extract the Applet"
msgstr "Апплеті тарқатып алынбады"

#: simplejavascriptapplet.cpp:639
msgid "service() takes two arguments"
msgstr "service() екі аргументті қабылдайды"

#: simplejavascriptapplet.cpp:659
msgid "animation() takes one argument"
msgstr "animation() бір аргументті қабылдайды"

#: simplejavascriptapplet.cpp:667 simplejavascriptapplet.cpp:691
#, kde-format
msgid "%1 is not a known animation type"
msgstr "%1 деген беймәлім анимацияның түрі"

#: simplejavascriptapplet.cpp:711
msgid "loadui() takes one argument"
msgstr "loadui() екі аргументті қабылдайды"

#: simplejavascriptapplet.cpp:717
#, kde-format
msgid "Unable to open '%1'"
msgstr "'%1' деген ашылмады"

#: simplejavascriptapplet.cpp:759 simplejavascriptapplet.cpp:775
msgid "Constructor takes at least 1 argument"
msgstr "Конструктор кемінде бір аргументі болуы тиіс"

#: simplejavascriptapplet.cpp:895
#, kde-format
msgid "This operation was not supported, %1"
msgstr "Бұл операцияның қолдауы жоқ, %1"

#: simplejavascriptapplet.cpp:902
msgid "print() takes one argument"
msgstr "print() бір аргументті қабылдайды"

#: simplebindings/anchorlayout.cpp:53 simplebindings/gridlayout.cpp:82
#: simplebindings/linearlayout.cpp:98
msgid "The parent must be a QGraphicsLayoutItem"
msgstr "Аталығы QGraphicsLayoutItem болуы тиіс"
