msgstr "Орынды &бетбегілеу"

#: konq_popupmenu.cpp:368
msgid "&Bookmark This Folder"
msgstr "Қапшықты &бетбегілеу"

#: konq_popupmenu.cpp:370
msgid "&Bookmark This Link"
msgstr "Сілтемені &бетбегілеу"

#: konq_popupmenu.cpp:372
