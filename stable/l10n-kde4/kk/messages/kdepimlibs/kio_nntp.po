#: nntp.cpp:126 nntp.cpp:492
#, kde-format
msgid "Selecting group %1..."
msgstr "%1 тобын таңдау..."

#: nntp.cpp:141
msgid "Downloading article..."
msgstr "Мақаланы жүктеу..."

#: nntp.cpp:199
#, kde-format
msgid "Invalid special command %1"
msgstr "Жарамсыз %1 арнаулы командасы"

#: nntp.cpp:207
msgid "Sending article..."
msgstr "Мақаланы жолдау..."

#: nntp.cpp:357
msgid "Downloading group list..."
msgstr "Топтар тізімін жүктеп алу..."

#: nntp.cpp:362
msgid "Looking for new groups..."
msgstr "Жаңа топтарды қарастыру... "

#: nntp.cpp:428
msgid "Downloading group descriptions..."
msgstr "Топтардың сипаттамаларын жүктеп алу..."

#: nntp.cpp:514
#, kde-format
msgid ""
"Could not extract message serial numbers from server response:\n"
"%1"
msgstr ""
"Сервердің жауабынан хабарламаның нөмірі табылмады:\n"
"%1"

#: nntp.cpp:534
msgid "Downloading new headers..."
msgstr "Жаңа айдарларды жүктеп алу..."

#: nntp.cpp:565
#, kde-format
msgid ""
"Could not extract first message id from server response:\n"
"%1"
msgstr ""
"Сервердің жауабынан хабарламаның индентификаторы табылмады:\n"
"%1"

#: nntp.cpp:591
#, kde-format
msgid ""
"Could not extract message id from server response:\n"
"%1"
msgstr ""
"Сервердің жауабынан хабарламаның индентификаторы табылмады:\n"
"%1"

#: nntp.cpp:742
msgid "Connecting to server..."
msgstr "Серверімен байланысу..."

#: nntp.cpp:776
msgid "This server does not support TLS"
msgstr "Бұл сервер TLS протоколды қолдамайды"

#: nntp.cpp:780
msgid "TLS negotiation failed"
msgstr "TLS келісу қатесі"

#: nntp.cpp:895
#, kde-format
msgid ""
"The server %1 could not handle your request.\n"
"Please try again now, or later if the problem persists."
msgstr ""
"%1 сервері тапсырмаңызды орындай алмады.\n"
"Қайталап көріңіз, мәселе қалса - кейінрек қайталаңыз."

#: nntp.cpp:900
msgid "You need to authenticate to access the requested resource."
msgstr "Керек дерек көзіне қатынау үшін аутентификациядан өту қажет."

#: nntp.cpp:903
msgid "The supplied login and/or password are incorrect."
msgstr "Келтірілген пайдаланушы/паролі дұрыс емес."

#: nntp.cpp:909
#, kde-format
msgid ""
"Unexpected server response to %1 command:\n"
"%2"
msgstr ""
"%1 командаға сервер күтпеген жауап берді:\n"
"%2"
