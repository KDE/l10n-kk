#: sieve.cpp:1108
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"Аутентификациясынан өтпедіңіз.\n"
"Бәлкім пароліңіз дұрыс емес.\n"
"Сервердің жауабы:\n"
"%1"

