msgid "Draw bac&kground color"
msgstr "&Аясы боялсын"

#: part/kateprinter.cpp:922
msgid "Draw &boxes"
msgstr "Қор&шаулар сызылсын"

#: part/kateprinter.cpp:925
msgid "Box Properties"
msgstr "Қоршаудың қасиеттері"

#: part/kateprinter.cpp:928
