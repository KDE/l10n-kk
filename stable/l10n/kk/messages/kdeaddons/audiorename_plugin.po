#: audio_plugin.cpp:80
msgid "A newer file named '%1' already exists.\n"
msgstr "'%1' деген файлдың жаңасы бар ғой.\n"

#: audio_plugin.cpp:78
msgid "A similar file named '%1' already exists.\n"
msgstr "'%1' деп аталған ұқсас файл бар ғой.\n"

#: audio_plugin.cpp:76
msgid "An older file named '%1' already exists.\n"
msgstr "'%1' деген файлдың ескісі бар ғой.\n"

#: audiopreview.cpp:89
msgid "Artist: %1\n"
msgstr "Орындаушы: %1\n"

#: audiopreview.cpp:91
msgid "Comment: %1\n"
msgstr "Түсініктеме: %1\n"

#: audio_plugin.cpp:83
msgid "Existing File"
msgstr "Бар файл"

#: audiopreview.cpp:95
msgid "Length: "
msgstr "Ұзындығы: "

#: audiopreview.cpp:94
msgid "Sample rate: %1 %2\n"
msgstr "Дискретизация жиілігі: %1 %2\n"

#: audio_plugin.cpp:82
msgid "Source File"
msgstr "Бастапқы файл"

#: audiopreview.cpp:54
msgid ""
"This audio file isn't stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Бұл аудио файл жергілікті\n"
"хостта сақталмаған.\n"
"Оны жүктеп алу үшін осы жарлықты түртіңіз.\n"

#: audiopreview.cpp:90
msgid "Title: %1\n"
msgstr "Атауы: %1\n"

#: audiopreview.cpp:62
msgid "Unable to load audio file"
msgstr "Аудио файл жүктелмеді"

#: audio_plugin.cpp:84
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "Бар файлды оң жақтағымен алмастырғыңыз келеді ме?"

#: audiopreview.cpp:92
msgid ""
"_: Biterate: 160 kbits/s\n"
"Bitrate: %1 %2\n"
msgstr "Бит легі: %1 %2\n"
