#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Сайран Киккарин"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "sairan@computer.org"

#: knewthemedlg.cpp:28
msgid "New Theme"
msgstr "Жаңа тақырып"

#: kthememanager.cpp:49
msgid "KDE Theme Manager"
msgstr "KDE тақырып менеджері"

#: kthememanager.cpp:50 kthememanager.cpp:56
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr ""
"Бұл басқару модулі KDE-нің көрнекті тақрыптарды орнату, өшіру және құрастырумен "
"айналысады."

#: kthememanager.cpp:215
msgid "Theme Files"
msgstr "Тақырып файлдары"

#: kthememanager.cpp:216
msgid "Select Theme File"
msgstr "Тақырып файлын таңдаңыз"

#: kthememanager.cpp:250
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "<b>%1</b> деген тақырыбын өшіргіңіз келгені рас па?"

#: kthememanager.cpp:251
msgid "Remove Theme"
msgstr "Тақырыпты өшіру"

#: kthememanager.cpp:273
msgid "My Theme"
msgstr "Менің тақырыбым"

#: kthememanager.cpp:284
msgid "Theme %1 already exists."
msgstr "%1 деген тақырып бар ғой."

#: kthememanager.cpp:304
#, c-format
msgid "Your theme has been successfully created in %1."
msgstr "Тақырыбыңыз %1 деген орында сәтті түрде құрылды."

#: kthememanager.cpp:305
msgid "Theme Created"
msgstr "Тақырып құрылды"

#: kthememanager.cpp:307
msgid "An error occurred while creating your theme."
msgstr "Тақырыбыңызды құру кезде қате пайда болды."

#: kthememanager.cpp:308
msgid "Theme Not Created"
msgstr "Тақырып құрылған жоқ"

#: kthememanager.cpp:335
msgid "This theme does not contain a preview."
msgstr "Бұл тақырыптың алдын-ала қарауы жоқ."

#: kthememanager.cpp:340
msgid "Author: %1<br>Email: %2<br>Version: %3<br>Homepage: %4"
msgstr "Авторы: %1<br>Эл.пошта: %2<br>Нұсқасы: %3<br>Мекен парағы: %4"

