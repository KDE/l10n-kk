#: config/appearance/kcm_ktp_chat_appearance.desktop:14
msgctxt "Name"
msgid "Chat Window Appearance"
msgstr "Әңгіме терезесінің көрінісі"

#: config/appearance/kcm_ktp_chat_appearance.desktop:59
msgctxt "Comment"
msgid "Choose a Style for your Chat Window and customize it"
msgstr "Чат-әңгіме терезесін бір нақышқа келтіріп ыңғайлаңыз"

#: config/behavior/kcm_ktp_chat_behavior.desktop:14
msgctxt "Name"
msgid "Chat Tab Behavior"
msgstr "Чат қойындының тәртібі"

#: config/messages/kcm_ktp_chat_messages.desktop:2
msgctxt "Name"
msgid "Plugins"
msgstr "Плагиндер"

#: config/messages/kcm_ktp_chat_messages.desktop:52
msgctxt "Comment"
msgid "How to deal with extra information obtained from messages"
msgstr "Хабарламадан қосымша мәліметімен не істеу керек"

#: config/otr/kcm_ktp_chat_otr.desktop:13
msgctxt "Comment"
msgid "Encrypt chat sessions with Off-The-Record encryption"
msgstr ""

#: config/otr/kcm_ktp_chat_otr.desktop:47
#: filters/otr/ktptextui_message_filter_otr.desktop.cmake:2
msgctxt "Name"
msgid "OTR"
msgstr ""

#: filters/bugzilla/ktptextui_message_filter_bugzilla.desktop.cmake:3
msgctxt "Name"
msgid "Bugzilla Information"
msgstr "Bugzilla мәліметі"

#: filters/bugzilla/ktptextui_message_filter_bugzilla.desktop.cmake:46
msgctxt "Comment"
msgid ""
"When receiving a link to a bug on bugzilla show additional information such "
"as the title and status"
msgstr ""
"Қаттеге сілтемені қабылдағанда bugzilla атауы мен күй-жайы секілді қосымша "
"мәліметті көрсетеді"

#: filters/emoticons/ktptextui_message_filter_emoticons.desktop.cmake:2
msgctxt "Name"
msgid "Emoticons"
msgstr "Көңіл күйі белгілері"

#: filters/emoticons/ktptextui_message_filter_emoticons.desktop.cmake:51
msgctxt "Comment"
msgid "Show emoticons (smiley faces) inside the chat"
msgstr "Көңіл күйі белгілерді чатта көрсету"

#: filters/formatting/ktptextui_message_filter_formatting.desktop.cmake:3
msgctxt "Name"
msgid "Text Formatting"
msgstr "Пішімделген мәтін"

#: filters/formatting/ktptextui_message_filter_formatting.desktop.cmake:47
msgctxt "Comment"
msgid ""
"Use /, _, * and - to make text italic, underlined, bold or strikeout "
"respectively"
msgstr ""
"Мәтінді көлбеу, асты сызық, қалың, сызып тастаған қылу үшін  /, _, * және - "
"пайдалану"

#: filters/highlight/ktptextui_message_filter_highlight.desktop.cmake:17
msgctxt "Name"
msgid "Highlight"
msgstr "Бояп белгілеген"

#: filters/highlight/ktptextui_message_filter_highlight.desktop.cmake:63
msgctxt "Comment"
msgid ""
"If any incoming messages contain your nickname, it will highlight them in red"
msgstr ""
"Егер кіріс хабарларында бүркеншік атыңыз пайда болғанда оны бояп белгілейді"

#: filters/images/ktptextui_message_filter_images.desktop.cmake:2
msgctxt "Name"
msgid "Image Preview"
msgstr "Кескінді қарау"

#: filters/images/ktptextui_message_filter_images.desktop.cmake:48
msgctxt "Comment"
msgid "Embed a thumbnail of any image URL sent in a chat"
msgstr "Чаттағы жіберілген кескін URL-інде нобайы болсын"

#: filters/latex/kcm_ktptextui_message_filter_latex.desktop:9
msgctxt "Name"
msgid "LaTeX"
msgstr "LaTeX"

#: filters/latex/ktptextui_message_filter_latex.desktop.cmake:17
msgctxt "Name"
msgid "LaTeX Renderer"
msgstr "LaTeX кескіндегіші"

#: filters/latex/ktptextui_message_filter_latex.desktop.cmake:58
msgctxt "Comment"
msgid ""
"If incoming messages contain LaTeX between $$, it will render it directly "
"into the chat."
msgstr ""
"Егер кіріс хабарламада $$ де қоршалған LaTex болса, ол чатта тікелей "
"кескінделеді."

#: filters/otr/ktptextui_message_filter_otr.desktop.cmake:36
msgctxt "Comment"
msgid "If a message is an OTR message, it will not be shown"
msgstr ""

#: filters/searchexpansion/ktptextui_message_filter_searchexpansion.desktop.cmake:2
msgctxt "Name"
msgid "Web Shortcuts"
msgstr "Веб қысқартулары"

#: filters/searchexpansion/ktptextui_message_filter_searchexpansion.desktop.cmake:52
msgctxt "Comment"
msgid ""
"Expand a KDE-shortened URI into a URL (i.e. typing wp:KDE will translate to "
"http://en.wikipedia.org/wiki/KDE)"
msgstr ""
"KDE-қыөсқарма URI-ды толық URL-ге аудару (мысалы, wp:KDE дегені http://en."
"wikipedia.org/wiki/KDE болады)"

#: filters/texttospeech/ktptextui_message_filter_tts.desktop.cmake:2
msgctxt "Name"
msgid "Text To Speech"
msgstr "Мәтінді дауыстап оқу"

#: filters/texttospeech/ktptextui_message_filter_tts.desktop.cmake:47
msgctxt "Comment"
msgid "Read out incoming messages using text-to-speech service"
msgstr "Келген хабарламаларды мәтінді дауыстап оқу қызметі көмегімен оқу"

#: filters/urlexpansion/ktptextui_message_filter_urlexpansion.desktop.cmake:3
msgctxt "Name"
msgid "Short URLs"
msgstr "Қысқа URL-дер"

#: filters/urlexpansion/ktptextui_message_filter_urlexpansion.desktop.cmake:44
msgctxt "Comment"
msgid "Shows the actual URL to which a shortened URL is redirecting to"
msgstr "Қысқа URL бағыттайтын шын URL-адресін көрсету"

#: filters/youtube/ktptextui_message_filter_youtube.desktop.cmake:2
msgctxt "Name"
msgid "YouTube Preview"
msgstr "YouTube алдың-аласы"

#: filters/youtube/ktptextui_message_filter_youtube.desktop.cmake:45
msgctxt "Comment"
msgid ""
"If any messages contains a link to a YouTube video, it will embed a preview "
"in the chat"
msgstr ""
"Егер хабарламада YouTube видеосына сілтеме болса, оның қарап-шығу мүмкіндігі "
"чатта болады"

#: lib/ktptxtui_message_filter.desktop:4
msgctxt "Comment"
msgid "Telepathy Text-Ui Message Filter"
msgstr "Telepathy мәтін-интерфейсінің хабарлама сүзгісі"

#: logviewer/config/kcm_ktp_logviewer_behavior.desktop:14
msgctxt "Name"
msgid "LogViewer Behavior"
msgstr "Журналды қарау құрал тәртібі"

#: logviewer/ktp-log-viewer.desktop:2
msgctxt "Name"
msgid "KDE IM Log Viewer"
msgstr "KDE хабарласу журналын қарау"

#: logviewer/ktp-log-viewer.desktop:48
msgctxt "GenericName"
msgid "KDE Instant Messenger Log Viewer"
msgstr "KDE лезде хабарласу бағдарламасының журналын қарау"

#: logviewer/ktp-log-viewer.desktop:93
msgctxt "Comment"
msgid "Displays your KDE Instant Messenger logs"
msgstr "KDE лезде хабарласу журналдарын көрсету"

