#: blogger1.cpp:243
#, kde-format
msgid ""
"Could not fetch user's info out of the result from the server, not a map."
msgstr ""
"Серверінен алынған деректерінен пайдаланушы туралы мәлімет табылмады, карта "
"жоқ."

#: blogger1.cpp:270
#, kde-format
msgid "Could not fetch blogs out of the result from the server, not a list."
msgstr "Серверінен алынған деректерінен блогтар табылмады, тізім жоқ."

#: blogger1.cpp:307
#, kde-format
msgid ""
"Could not fetch list of posts out of the result from the server, not a list."
msgstr "Серверінен алынған деректерінен жазбалар тізімі табылмады, тізім жоқ."

#: blogger1.cpp:326
#, kde-format
msgid "Could not read post."
msgstr "Жазба оқылмады."

#: blogger1.cpp:355 blogger1.cpp:358 movabletype.cpp:280 movabletype.cpp:283
#, kde-format
msgid "Could not fetch post out of the result from the server."
msgstr "Серверінен алынған деректерінен жазба табылмады."

#: blogger1.cpp:377 movabletype.cpp:241
#, kde-format
msgid "Could not read the postId, not a string or an integer."
msgstr ""
"Жазбаның идентификаторы дұрыс емес, оқылғаны, не мәтін жолы емес, не бүтін "
"сан емес."

#: blogger1.cpp:410 blogger1.cpp:435 movabletype.cpp:316
#, kde-format
msgid "Could not read the result, not a boolean."
msgstr "Нәтижесі оқылмады, ол логикалық мән емес."

#: gdata.cpp:215 gdata.cpp:279 gdata.cpp:339 gdata.cpp:384 gdata.cpp:440
#, kde-format
msgid "Authentication failed."
msgstr "Аутентификациясынан өтпедіңіз."

#: gdata.cpp:531
#, kde-format
msgid "Could not regexp the Profile ID."
msgstr "Профилінің ID-і үлгі өрнегіне ілекпеді.."

#: gdata.cpp:552
#, kde-format
msgid "Could not get blogs."
msgstr "Блогтар алынбады."

#: gdata.cpp:574 gdata.cpp:780
#, kde-format
msgid "Could not regexp the blog id path."
msgstr "Блог ID-інің жолы үлгі өрнегіне ілекпеді.."

#: gdata.cpp:595 gdata.cpp:637
#, kde-format
msgid "Could not get comments."
