#: configdialog.cpp:40
msgid "Select a MailDir folder"
msgstr "MailDir қапшығын таңдау"

#: configdialog.cpp:48
msgid "Folder Archive"
msgstr ""

#: configdialog.cpp:94
msgid "The selected path is empty."
msgstr "Таңдалған жолы бос."

#: configdialog.cpp:107
msgid "The selected path contains valid Maildir folders."
msgstr "Таңдалған жолында жарамды MailDir қапшықтар бар."

#: configdialog.cpp:114
msgid "The selected path is a valid Maildir."
msgstr "Таңдалған жолы жарамды MailDir қапшығының өзі."

#: configdialog.cpp:120
msgid "The selected path does not exist yet, a new Maildir will be created."
msgstr "Таңдалған MailDir қапшығы әлі жоқ, бірақ құрылмақ."

#: configdialog.cpp:124
msgid "The selected path does not exist."
msgstr "Тандалған жол табылған жоқ."

#: libmaildir/maildir.cpp:251 libmaildir/maildir.cpp:256
#, kde-format
msgid "Error opening %1; this folder is missing."
msgstr "%1 ашу қатесі; бұндай қапшық жоқ."

#: libmaildir/maildir.cpp:261
#, kde-format
msgid ""
"Error opening %1; either this is not a valid maildir folder, or you do not "
"have sufficient access permissions."
msgstr ""
"%1 ашу қатесі; немесе жарамсыз maildir қапшығы, немесе керек құқығыңыз жоқ."

#: libmaildir/maildir.cpp:486 libmaildir/maildir.cpp:507
#: libmaildir/maildir.cpp:525 libmaildir/maildir.cpp:545
#: libmaildir/maildir.cpp:565 libmaildir/maildir.cpp:589
#: libmaildir/maildir.cpp:664 libmaildir/maildir.cpp:816
#, kde-format
msgid "Cannot locate mail file %1."
msgstr "%1 пошта файлы табылмады."

#: libmaildir/maildir.cpp:492 libmaildir/maildir.cpp:513
#, kde-format
msgid "Cannot open mail file %1."
msgstr "%1 пошта файлы ашылмады."

#: libmaildir/maildir.cpp:597 libmaildir/maildir.cpp:624
#, kde-format
msgid "Cannot write to mail file %1."
msgstr "%1 пошта файлына жазылмады."

#: libmaildir/maildir.cpp:638
#, kde-format
msgid "Failed to create mail file %1. The error was: %2"
msgstr "%1 пошта файлды құру жаңылысы. Қатесі: %2"

#: libmaildir/maildir.cpp:735
#, kde-format
msgid "Failed to update the file name %1 to %2 on the disk. The error was: %3."
msgstr "Дискіде %1 деген файл атауын %2 деп өзгерту жаңылысы. Қатесі: %3."

#: maildirresource.cpp:142 maildirresource.cpp:281 maildirresource.cpp:319
#: maildirresource.cpp:413 maildirresource.cpp:453 maildirresource.cpp:570
#: maildirresource.cpp:601 maildirresource.cpp:644 maildirresource.cpp:677
msgid "Unusable configuration."
msgstr "Баптауы жарамсыз."

#: maildirresource.cpp:209
#, kde-format
msgid "Unable to fetch item: The maildir folder \"%1\" is not valid."
msgstr "Керегі алынбады: \"%1\" MaiDir қапшығы жарамсыз."

#: maildirresource.cpp:292
msgid "Error: Unsupported type."
msgstr "Қате: Танымайтын түрі."

#: maildirresource.cpp:357
#, kde-format
msgid "Failed to change the flags for the mail. %1"
msgstr "Поштаның жалаушаларын өзгерту жаңылысы. %1"

#: maildirresource.cpp:392
msgid "Maildir resource got a non-mail content."
msgstr ""

#: maildirresource.cpp:419
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "'%1' көз қапшығы жарамсыз."

#: maildirresource.cpp:425
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "Жарамсыз мақсатты қапшық: '%1'"

#: maildirresource.cpp:441
#, kde-format
msgid "Could not move message '%1' from '%2' to '%3'. The error was %4."
msgstr "'%1' деген хат '%2' дегеннен '%3' дегенге жылжытылмады. Қатесі: %4"

#: maildirresource.cpp:463
#, kde-format
msgid "Failed to delete message: %1"
msgstr "'%1' деген хат өшірілмеді."

#: maildirresource.cpp:549
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "'%1' MailDir қапшығы '%2' жинағы үшін жарамайды.."

#: maildirresource.cpp:629
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "'%1' MailDir қапшығының атауы өзгертілмеді."

#: maildirresource.cpp:650
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "'%1' MailDir түбір қапшығы жылжытылмады."

#: maildirresource.cpp:665
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr "'%1' MailDir қапшығы '%2' дегенен '%3' дегенге жылжытылмады."

#: maildirresource.cpp:683
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "Жоғары деңгейлі '%1' MailDir қапшығы өшірілмеді."

#: maildirresource.cpp:692
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "'%1' ішкі қапшықты өшіру жаңылысы."

#: maildirresource.cpp:706
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "'%1' MailDir қапшығы құрылмады."

#: maildirresource.cpp:716
msgid "No usable storage location configured."
msgstr "Баптауында жарамсыз сақтағышы көрсетілген."

#. i18n: ectx: label, entry (Path), group (General)
#: maildirresource.kcfg:10
msgid "Path to maildir"
msgstr "MailDir пошта қаталогының жолы"

#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: maildirresource.kcfg:14
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr ""
"MailDir қапшығының орнына, MailDir қапшықтары орналасқан қапшықтың жолы."

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: maildirresource.kcfg:18
msgid "Do not change the actual backend data."
msgstr "Тетіктің деректері өзгертілмейді."

