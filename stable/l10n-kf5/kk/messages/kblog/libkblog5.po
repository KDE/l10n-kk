#: blogger1.cpp:230
#, kde-format
msgid ""
"Could not fetch user's info out of the result from the server, not a map."
msgstr ""
"Серверінен алынған деректерінен пайдаланушы туралы мәлімет табылмады, карта "
"жоқ."

#: blogger1.cpp:257
#, kde-format
msgid "Could not fetch blogs out of the result from the server, not a list."
msgstr "Серверінен алынған деректерінен блогтар табылмады, тізім жоқ."

#: blogger1.cpp:294
#, kde-format
msgid ""
"Could not fetch list of posts out of the result from the server, not a list."
msgstr "Серверінен алынған деректерінен жазбалар тізімі табылмады, тізім жоқ."

#: blogger1.cpp:313
#, kde-format
msgid "Could not read post."
msgstr "Жазба оқылмады."

#: blogger1.cpp:342 blogger1.cpp:345 movabletype.cpp:267 movabletype.cpp:270
#, kde-format
msgid "Could not fetch post out of the result from the server."
msgstr "Серверінен алынған деректерінен жазба табылмады."

#: blogger1.cpp:364 movabletype.cpp:228
#, kde-format
msgid "Could not read the postId, not a string or an integer."
msgstr ""
"Жазбаның идентификаторы дұрыс емес, оқылғаны, не мәтін жолы емес, не бүтін "
"сан емес."

#: blogger1.cpp:397 blogger1.cpp:422 movabletype.cpp:303
#, kde-format
msgid "Could not read the result, not a boolean."
msgstr "Нәтижесі оқылмады, ол логикалық мән емес."

#: gdata.cpp:202 gdata.cpp:266 gdata.cpp:326 gdata.cpp:371 gdata.cpp:427
#, kde-format
msgid "Authentication failed."
msgstr "Аутентификациясынан өтпедіңіз."

#: gdata.cpp:518
#, kde-format
msgid "Could not regexp the Profile ID."
msgstr "Профилінің ID-і үлгі өрнегіне ілекпеді.."

#: gdata.cpp:539
#, kde-format
msgid "Could not get blogs."
msgstr "Блогтар алынбады."

#: gdata.cpp:561 gdata.cpp:767
#, kde-format
msgid "Could not regexp the blog id path."
msgstr "Блог ID-інің жолы үлгі өрнегіне ілекпеді.."

#: gdata.cpp:582 gdata.cpp:624
#, kde-format
msgid "Could not get comments."
msgstr "Түсініктемелері алынбады."

#: gdata.cpp:596 gdata.cpp:638
#, kde-format
msgid "Could not regexp the comment id path."
msgstr "Түсінітеме ID-інің жолы үлгі өрнегіне ілекпеді.."

#: gdata.cpp:667 gdata.cpp:738
#, kde-format
msgid "Could not get posts."
msgstr "Жазбалар алынбады."

#: gdata.cpp:687
#, kde-format
msgid "Could not regexp the post id path."
msgstr "Жазба ID-інің жолы үлгі өрнегіне ілекпеді.."

#: gdata.cpp:796 gdata.cpp:850 gdata.cpp:931 wordpressbuggy.cpp:317
#: wordpressbuggy.cpp:365
#, kde-format
msgid "Could not regexp the id out of the result."
msgstr "Индентификаторы нәтижелердін арасында  үлгі өрнегіне ілекпеді.."

#: gdata.cpp:805 gdata.cpp:859 gdata.cpp:940
#, kde-format
msgid "Could not regexp the published time out of the result."
msgstr "Жариялау уақыты нәтижелердін арасында  үлгі өрнегіне ілекпеді.."

#: gdata.cpp:814 gdata.cpp:868 gdata.cpp:949
#, kde-format
msgid "Could not regexp the update time out of the result."
msgstr "Жаңарту уақыты нәтижелердін арасында  үлгі өрнегіне ілекпеді.."

#: livejournal.cpp:330 livejournal.cpp:439 livejournal.cpp:464
#, kde-format
msgid "Could not read the post ID, result not a map."
msgstr "Жазбаның ID-і оқылмады, нәтижесі карта емес."

#: livejournal.cpp:477
#, kde-format
msgid "The returned post ID did not match the sent one: "
msgstr "Қайтарылған жазбаның ID-і жібергеніне сәйкес келмейді."

#: metaweblog.cpp:66
#, kde-format
msgid "Media is a null pointer."
msgstr "Мултимедиаға нөл-көрсеткіш меңзейді."

#: metaweblog.cpp:174
#, kde-format
msgid "Could not list categories out of the result from the server."
msgstr "Серверінен алынған деректерінен санаттар тізімі табылмады."

#: metaweblog.cpp:233
#, kde-format
msgid "Could not read the result, not a map."
msgstr "Нәтижесі оқылмады, ол карта емес."

#: movabletype.cpp:368
#, kde-format
msgid "Could not read the result - is not a list. Category fetching failed."
msgstr "Нәтижесі оқылмады, ол тізім емес. Санатын білу жаңылысы."

#: movabletype.cpp:402
#, kde-format
msgid ""
"Could not read the result - is not a boolean value. Category setting "
"failed.  Will still publish now if necessary."
msgstr ""
"Нәтижесі оқылмады, ол логикалық мән емес. Санатын орнату жаңылысы. Қажет "
"болса, жариялай беруге болады."

#: movabletype.cpp:535
#, kde-format
msgid ""
"Could not fetch list of trackback pings out of the result from the server."
msgstr ""
"Серверінен алынған деректер арасында жіберілген ping-тер тізімі табылмады."

#: wordpressbuggy.cpp:61 wordpressbuggy.cpp:173
#, kde-format
msgid "Post is a null pointer."
msgstr "Жазбаға нөл-көрсеткіш меңзейді."
