#: shellEdit.cpp:24
msgid "Custom desktop shell"
msgstr "Өзгеше үстел командалық ортасы"

#: shellEdit.cpp:24
msgid ""
"This shell is reserved for user's custom shell. Press \"Setup\" button to "
"setup your favourite shell."
msgstr ""
"Пайдаланушының өзінің өзгеше командалық ортасын орнатуға арналған. \"Орнату"
"\" батырмасын басып керегін орнатыңыз."

#~ msgid "Platform Specific Configuration Module"
#~ msgstr "Платфоманың ерекше параметрлерін баптау модулі"

#~ msgctxt "'Windows' means the OS"
#~ msgid "Windows Desktop Shell"
#~ msgstr "Windows үстелінің командалық ортасы"

#~ msgid "Native Windows Explorer shell"
#~ msgstr "Windows-тың өзінің Explorer командалық-ортасы"

#~ msgid ""
#~ "This is the standard Windows Desktop shell. Choose this if you want to "
#~ "return your system to the default desktop."
#~ msgstr ""
#~ "Бұл стандартты Windows үстелінің командалық ортасы. Жүйеңізді әдетті "
#~ "үстеліне қайтарыңыз келсе - осыны таңдаңыз."

#~ msgid "Native desktop shell"
#~ msgstr "Тұған үстел командалық ортасы"

#~ msgid "System's default desktop shell"
#~ msgstr "Жүйенің әдетті үстел командалық ортасы"

#~ msgid "Use the KDE desktop shell, as it is seen on Linux."
#~ msgstr "Linux.-ке тән KDE үстел командалық ортасын таңдаңыз."

#~ msgid ""
#~ "Choose this option if you would like to use the Plasma desktop shell for "
#~ "your Windows system."
#~ msgstr ""
#~ "Windows жүйеңізде Plasma үстел командалық ортасын пайдаланыңыз келсе - "
#~ "осыны таңдаңыз."

#~ msgid "Plasma desktop shell"
#~ msgstr "Plasma үстел командалық ортасы"

#~ msgid "KDE4 Plasma desktop shell"
#~ msgstr "KDE4 Plasma үстел командалық ортасы"

#~ msgid "Your custom desktop shell"
#~ msgstr "Өзіңіздің өзгеше үстел командалық ортасы"

#~ msgid ""
#~ "Choose this and press the <i>\"Setup...\"</i> button to configure you "
#~ "custom desktop shell. Not recommended for the average user."
#~ msgstr ""
#~ "Өзіңіздің өзгеше үстел командалық ортасын орнату үшін <i>\"Орнату...\"</"
#~ "i> батырмасын басыңыз. Қарапайым пайдаланушыларға арналмаған."

#~ msgid ""
#~ "This shell is reserved for the user's custom shell. Press the \"Setup\" "
#~ "button to setup your favorite shell."
#~ msgstr ""
#~ "Пайдаланушының өзінің өзгеше үстел командалық ортасын орнатуға арналған. "
#~ "\"Орнату\" батырмасын басып керегін орнатыңыз."

#~ msgid "Press to setup your custom desktop shell"
#~ msgstr "Өзінің өзгеше үстел командалық ортаңызды орнату үшін басыңыз"

#~ msgid ""
#~ "Press this and a configuration dialog will appear to allow you to "
#~ "configure your custom desktop shell."
#~ msgstr ""
#~ "Осыны басқанда өзінің өзгеше үстел командалық ортасын орнатуға мүмкіндік "
#~ "беретін диалогы шығарылады."

#~ msgid "Setup..."
#~ msgstr "Орнату..."

#~ msgid "System Integration"
#~ msgstr "Жүйені түгелдеу"

#~ msgid ""
#~ "This will enable automatic regeneration of Windows' Start menu entries "
#~ "for KDE applications"
#~ msgstr ""
#~ "Бұл, Windows Бастау мәзіріне KDE қолданбаларын енгізіп, автоматты тұрде "
#~ "оны қайта құруды рұқсат етуі"

#~ msgid ""
#~ "This option defines if Windows' Start menu entries should be regenerated "
#~ "or not. By default start menu entries are regenerated automatically, but "
#~ "you may wish to disable it if you have issues with that."
#~ msgstr ""
#~ "Бұл параметр Windows Бастау мәзірі қайта құрылып берілетінін- "
#~ "берілмейтінін басқарады. Әдетте мәзір автоматты түрде қайта құрылады, "
#~ "бірақ, керек болса, бұны өзгерте аласыз."

#~ msgid "Enable automatic regeneration of start menu entries"
#~ msgstr "Бастау мәзірі автоматты түрде қайта құрылсын"

#~ msgid "Use native Windows file dialogs instead of KDE ones"
#~ msgstr ""
#~ "KDE-нің диалогтарының орнына Windows-тың өзіндікілерін пайдалану үшін"

#~ msgid ""
#~ "Choose this option to make KDE applications use the standard Windows Open/"
#~ "Save file dialogs, instead of those normally used in KDE."
#~ msgstr ""
#~ "KDE қолданбаларында әдетте пайдаланатын Ашу/Сақтау диалогттарының орнына "
#~ "Windows-тың стандартты диалогтары болсын десеңіз - осыны таңдаңыз."

#~ msgid "Use native system file dialogs"
#~ msgstr "Өзінің жүйелік файл диалогтары болсын"

#~ msgid "Install System Settings into the Windows Control Panel."
#~ msgstr "Windows Басқару панелінде Жүйе параметрлерін орнату"

#~ msgid ""
#~ "This will install the KDE 'System Settings' as an element in the Windows "
#~ "Control Panel.<br><b>Caution: This option tweaks your Windows registry.</"
#~ "b>"
#~ msgstr ""
#~ "Бұл KDE 'Жүйе параметрлері' деген Windows Басқару панеліне орнатады.<br> "
#~ "<b>Ескерту: Бұл Windows реестрін өзгертетін амал.</b>"

#~ msgid "Install as control panel element"
#~ msgstr "Басқару  панеліне енсін"

#~ msgid "Install Oxygen cursors as Windows cursor schemes"
#~ msgstr "Oxygen меңзерлерін Windows меңзер сұлбалары ретінде орнату"

#~ msgid ""
#~ "This will install the Oxygen cursors into your system and combine them as "
#~ "a cursor theme.<br><b>Caution: This option tweaks your Windows registry.</"
#~ "b>"
#~ msgstr ""
#~ "Бұл Oxygen меңзерлерін жүйеңізге меңзер нақышы қылып орналастырады. "
#~ "<b>Ескерту: Бұл Windows реестрін өзгертетін амал.</b>"

#~ msgid "Install Oxygen cursor schemes"
#~ msgstr "Oxygen меңзер сұлбалары орнатылсын"

#~ msgid ""
#~ "This option installs KDE wallpapers into your \"My Pictures\" directory"
#~ msgstr ""
#~ "Бұл параметр KDE түсқағаздарын 'Менің суреттерім' қапшығыңызға орнатып "
#~ "береді"

#~ msgid ""
#~ "This will install KDE wallpapers into the <i>\"My Pictures\"</i> "
#~ "directory so they can be used as your Windows wallpaper. If the checkbox "
#~ "is set to half-checked then it means that there are new wallpapers "
#~ "available to update.<br> The wallpaper aspect ratio will be selected "
#~ "according to your current screen resolution."
#~ msgstr ""
#~ "Бұл KDE түсқағаздарын <i>\"Менің суреттерім\"</i> қапшығына, оларды "
#~ "Windows түсқағазы ретінде қолдана алатындай, орнатып беруі. Белгінің көзі "
#~ "жартылай белгіленіп тұрса, ол жаңартып алуға дайын жаңа түсқағаздар бар "
#~ "дегені.<br>Түсқағаздың жақтарының ара қатынасын қазір қолданыстағы "
#~ "экраныңызға лайық қылып таңдап береді."

#~ msgid "Install Oxygen wallpapers"
#~ msgstr "Oxygen түсқағаздары орнатылсын"

#~ msgid "This will make essential KDE processes run at user login"
#~ msgstr ""
#~ "Бұл параметр, маңызды KDE процестерін пайдаланушы кірер кезде басталатын "
#~ "қылады"

#~ msgid ""
#~ "Enabling this option will start essential KDE processes at user login. "
#~ "Normally these processes are started when you first start a KDE "
#~ "application, thereby delaying the actual application launch.<br>It is "
#~ "recommended to enable this option to make your applications launch faster "
#~ "for the first time.<br><b>Caution: This option tweaks your Windows "
#~ "registry.</b>"
#~ msgstr ""
#~ "Бұл параметр пайдаланушы кірер кезде маңызды KDE процестерін бастауды "
#~ "рұқсат етеді. Әдетте, бұлар бірінші KDE қолданбасын бастағанда, оның "
#~ "жегуін кідіртіп, жіберіледі.<br>Бұны, қолданбаңыз тез жегілу үшін, рұқсат "
#~ "еткен жөн.<br><b>Ескерту: Бұл Windows реестрін өзгертетін амал.</b>"

#~ msgid "Load KDE at user login"
#~ msgstr "Пайдаланушы кіргенде KDE жүктелсін"

#~ msgid "Setup Custom Shell"
#~ msgstr "Өзгеше командалық ортасын орнату"

#~ msgid "Name:"
#~ msgstr "Атауы"

#~ msgid "Command:"
#~ msgstr "Командасы"

#~ msgid "Description:"
#~ msgstr "Сипаттамасы"

#~ msgctxt "radio button to chose Windows Desktop shell"
#~ msgid "Custom desktop shell"
#~ msgstr "Өзгеше үстелі"
