#: src/email.cpp:539
msgid ""
"The email address you entered is not valid because it contains more than one "
"@. You will not create valid messages if you do not change your address."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені онда бірнеше @ деген бар. Адресін "
"жөндемей, хат дұрыс болмайды."

#: src/email.cpp:544
msgid ""
"The email address you entered is not valid because it does not contain a @. "
"You will not create valid messages if you do not change your address."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені онда @ деген жоқ Адресін жөндемей, "
"хат дұрыс болмайды."

#: src/email.cpp:549
msgid "You have to enter something in the email address field."
msgstr "Адрес өрісіне бірдеме деп жазу керек."

#: src/email.cpp:551
msgid ""
"The email address you entered is not valid because it does not contain a "
"local part."
msgstr "Келтірілген адресіңіз жарамсыз, өйткені онда @ дейінгісі жоқ "

#: src/email.cpp:554
msgid ""
"The email address you entered is not valid because it does not contain a "
"domain part."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені онда @ кейінгісі (домендік жағы) жоқ "

#: src/email.cpp:557
msgid ""
"The email address you entered is not valid because it contains unclosed "
"comments/brackets."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені оның жабылмаған түсініктеме/"
"жақшалары бар."

#: src/email.cpp:560
msgid "The email address you entered is valid."
msgstr "Келтірілген адрес жарайды."

#: src/email.cpp:562
msgid ""
"The email address you entered is not valid because it contains an unclosed "
"angle bracket."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені оның жабылмаған бұрыштық жақшасы бар."

#: src/email.cpp:565
msgid ""
"The email address you entered is not valid because it contains too many "
"closing angle brackets."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені оның тым көп жабубұрыштық жақшалары "
"бар."

#: src/email.cpp:568
msgid ""
"The email address you have entered is not valid because it contains an "
"unexpected comma."
msgstr "Келтірілген адресіңіз жарамсыз, өйткені оның артық үтірі бар."

#: src/email.cpp:571
msgid ""
"The email address you entered is not valid because it ended unexpectedly. "
"This probably means you have used an escaping type character like a '\\' as "
"the last character in your email address."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені ол күтпеген жерде біткен. Оның "
"мүмкін себебі: адрестін соңында '\\' секілді басқару белгіні қолданғаныңыз."

#: src/email.cpp:576
msgid ""
"The email address you entered is not valid because it contains quoted text "
"which does not end."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені оның жабылмаған тырнақшасы бар."

#: src/email.cpp:579 src/email.cpp:658
msgid ""
"The email address you entered is not valid because it does not seem to "
"contain an actual email address, i.e. something of the form joe@example.org."
msgstr ""
"Келтірілген адресіңіз жарамсыз. Ол мынандай түрдегі жазудан құрылуға тиіс: "
"joe@example.org. Келтіргеніңіз бұған ұқсамайды."

#: src/email.cpp:583
msgid ""
"The email address you entered is not valid because it contains an illegal "
"character."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені оның болуға тиіс емес таңбасы бар."

#: src/email.cpp:586
msgid ""
"The email address you have entered is not valid because it contains an "
"invalid display name."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені оның көрсетілетін аты дұрыс емес."

#: src/email.cpp:589
msgid ""
"The email address you entered is not valid because it does not contain a "
"'.'. You will not create valid messages if you do not change your address."
msgstr ""
"Келтірілген адресіңіз жарамсыз, өйткені онда '.' деген жоқ. Адресін "
"жөндемей, хат дұрыс болмайды."

#: src/email.cpp:595
msgid "Unknown problem with email address"
msgstr "Хат адресінің беймәлім мәселесі"

#: src/kfileio.cpp:46
msgid "File I/O Error"
msgstr "Файлдың Е/Ш қатесі"

#: src/kfileio.cpp:66
#, kde-format
msgid ""
"The specified file does not exist:\n"
"%1"
msgstr ""
"Келтірілген файл жоқ:\n"
"%1"

#: src/kfileio.cpp:72
#, kde-format
msgid ""
"This is a folder and not a file:\n"
"%1"
msgstr ""
"Бұл фай емес, қапшық екен:\n"
"%1"

#: src/kfileio.cpp:78
#, kde-format
msgid ""
"You do not have read permissions to the file:\n"
"%1"
msgstr ""
"Бұл файлды оқуға рұқсатыңыз жоқ:\n"
"%1"

#: src/kfileio.cpp:90
#, kde-format
msgid ""
"Could not read file:\n"
"%1"
msgstr ""
"Файл оқылмады:\n"
"%1"

#: src/kfileio.cpp:93
#, kde-format
msgid ""
"Could not open file:\n"
"%1"
msgstr ""
"Файл ашылмады:\n"
"%1"

#: src/kfileio.cpp:96
#, kde-format
msgid ""
"Error while reading file:\n"
"%1"
msgstr ""
"%1\n"
"файлын оқығанда қате орын алды"

#: src/kfileio.cpp:114
#, kde-format
msgid "Could only read 1 byte of %2."
msgid_plural "Could only read %1 bytes of %2."
msgstr[0] "%2 байттан %1 байт қана оқылды."

#: src/kfileio.cpp:139
#, kde-format
msgid ""
"File %1 exists.\n"
"Do you want to replace it?"
msgstr ""
"%1 деген файл бар екен.\n"
"Оны ауыстырмақсыз ба?"

#: src/kfileio.cpp:141 src/kfileio.cpp:162
msgid "Save to File"
msgstr "Файлға сақтау"

#: src/kfileio.cpp:142
msgid "&Replace"
msgstr "&Ауыстыру"

#: src/kfileio.cpp:161
#, kde-format
msgid ""
"Failed to make a backup copy of %1.\n"
"Continue anyway?"
msgstr ""
"%1 сақтық көшірмесін құру жаңылысы.\n"
"Сонда да жағастырмақсыз ба?"

#: src/kfileio.cpp:175 src/kfileio.cpp:191
#, kde-format
msgid ""
"Could not write to file:\n"
"%1"
msgstr ""
"%1\n"
"файлына жазуы болмады"

#: src/kfileio.cpp:178
#, kde-format
msgid ""
"Could not open file for writing:\n"
"%1"
msgstr ""
"%1\n"
"файлы жазуға ашылмады"

#: src/kfileio.cpp:181
#, kde-format
msgid ""
"Error while writing file:\n"
"%1"
msgstr ""
"%1\n"
"файлына жазу қатесі"

#: src/kfileio.cpp:195
#, kde-format
msgid "Could only write 1 byte of %2."
msgid_plural "Could only write %1 bytes of %2."
msgstr[0] "%2 байттан %1 байт қана жазылды."

#: src/kfileio.cpp:222
#, kde-format
msgid "%1 does not exist"
msgstr "%1 деген жоқ"

#: src/kfileio.cpp:233
#, kde-format
msgid "%1 is not accessible and that is unchangeable."
msgstr "%1 деген қол жеткізбеуде"

#: src/kfileio.cpp:254
#, kde-format
msgid "%1 is not readable and that is unchangeable."
msgstr "%1 деген оқылмады"

#: src/kfileio.cpp:270
#, kde-format
msgid "%1 is not writable and that is unchangeable."
msgstr "%1 деген жазуға келмеді."

#: src/kfileio.cpp:284
#, kde-format
msgid "Folder %1 is inaccessible."
msgstr "%1 қапшығы қатынауға келмеді."

#~ msgid ""
#~ "Some files or folders do not have the necessary permissions, please "
#~ "correct them manually."
#~ msgstr ""
#~ "Кейбір файлдаыныңр не қапшықтарының қажетті рұқсаттары жоқ, оны қолмен "
#~ "түзеңіз."

#~ msgid "Permissions Check"
#~ msgstr "Рұқсаттарын тексеру"
