#: options/opsguides.ui:270
msgid "Hori&zon (line)"
msgstr "Көк&жиек (сызығы)"

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_ShowGround)
#: options/opsguides.ui:277
msgid "Draw opaque ground?"
msgstr "Жердің тасалағаны көрсетілсін бе?"

