#: ArtisticTextShapeFactory.cpp:30
#, kde-format
msgid "ArtisticTextShape"
msgstr "КөркемЖазуҚалыпы"

#: ArtisticTextShapeFactory.cpp:32
#, kde-format
msgid "A shape which shows a single text line"
msgstr "Бір жол жазуын көрсететін қалып"

#: ArtisticTextShapeFactory.cpp:42
#, kde-format
msgid "Artistic Text"
msgstr "Көркем жазу"

#: ArtisticTextTool.cpp:78
#, kde-format
msgid "Detach Path"
msgstr "Сүрлеу бойынан босату"

#: ArtisticTextTool.cpp:83
#, kde-format
msgid "Convert to Path"
msgstr "Сүрлеуге аудару"

#: ArtisticTextTool.cpp:88
#, kde-format
msgid "Bold text"
msgstr "Қалың жазу"

#: ArtisticTextTool.cpp:93
#, kde-format
msgid "Italic text"
msgstr "Көлбеу жазу"

#: ArtisticTextTool.cpp:98
#, kde-format
msgid "Superscript"
msgstr "Жол үстілік"

#: ArtisticTextTool.cpp:103
#, kde-format
msgid "Subscript"
msgstr "Жол астылық"

#: ArtisticTextTool.cpp:108
#, kde-format
msgid "Anchor at Start"
msgstr "Басын бекіту"

#: ArtisticTextTool.cpp:113
#, kde-format
msgid "Anchor at Middle"
msgstr "Ортасын бекіту"

#: ArtisticTextTool.cpp:118
#, kde-format
msgid "Anchor at End"
msgstr "Соңын бекіту"

#: ArtisticTextTool.cpp:310
#, kde-format
msgid "Click to change cursor position."
msgstr "Меңзердің орнын өзгерту үшін түртіңіз."

#: ArtisticTextTool.cpp:312
#, kde-format
msgid "Click to select text shape."
msgstr "Мәтіннің қалыпын таңдау үшін түртіңіз."

#: ArtisticTextTool.cpp:315
#, kde-format
msgid "Double click to put text on path."
msgstr "Мәтінді сүрлеу бойына салу үшін қос түртім жасаңыз."

#: ArtisticTextTool.cpp:318
#, kde-format
msgid "Drag handle to change start offset."
msgstr "Бастапқы шегінісін өзгерту үшін тізгінін тартыңыз."

#: ArtisticTextTool.cpp:322
#, kde-format
msgid "Press escape to finish editing."
msgstr "Өңдеуді аяқтау үшін Esc-ті басыныз."

#: ArtisticTextTool.cpp:500
#, kde-format
msgid "Press return to finish editing."
msgstr "Өңдеуді аяқтау үшін Enter пернесін басыныз."

