#: calligraconverter.cpp:148
msgid "CalligraConverter"
msgstr "Calligra түрлендіргіші"

#: calligraconverter.cpp:149
msgid "Calligra Document Converter"
msgstr "Calligra құжат түрлендіргіші"

#: calligraconverter.cpp:151
msgid "(c) 2001-2011 Calligra developers"
msgstr "(c) 2001-2011 Calligra құрастырғыштары"

#: calligraconverter.cpp:152
msgid "David Faure"
msgstr "David Faure"

#: calligraconverter.cpp:153
msgid "Nicolas Goutte"
msgstr "Nicolas Goutte"

#: calligraconverter.cpp:154
msgid "Dan Leinir Turthra Jensen"
msgstr "Dan Leinir Turthra Jensen"

#: calligraconverter.cpp:158
msgid "Input file"
msgstr "Кіріс файлы"

#: calligraconverter.cpp:159
msgid "Output file"
msgstr "Шығыс файлы"

#: calligraconverter.cpp:160
msgid "Make a backup of the destination file"
msgstr "Мақсатты файлдың сақтық көшірмесін жасау"

#: calligraconverter.cpp:161
msgid "Batch mode: do not show dialogs"
msgstr "Десте режімі: диалогтар көрсетілмейді"

#: calligraconverter.cpp:162
msgid "Interactive mode: show dialogs (default)"
msgstr "Интерактивті режімі: диалогтар көрсетіледі (әдетті)"

#: calligraconverter.cpp:163
msgid "Mimetype of the output file"
msgstr "Шығыс файлдың MIME түрі"

#: calligraconverter.cpp:166
msgid "The print orientation. This could be either Portrait or Landscape."
msgstr "Басу бағыты. Тік немесе Көлденең болады."

#: calligraconverter.cpp:167
msgid "The paper size. A4, Legal, Letter, ..."
msgstr "Қағаз өлшемі. A4, Legal, Letter, ..."

#: calligraconverter.cpp:168
msgid "The size of the paper margin. By default this is 0.2."
msgstr "Қағаз жиегінің өлшемі. Әдетте 0,2 болады."

#: calligraconverter.cpp:177
msgid "Two arguments required"
msgstr "Екі аргумент керек"

#: calligraconverter.cpp:205
#, kde-format
msgid "Mimetype for input file %1 not found!"
msgstr "%1 кіріс файлдың MIME түрі жоқ!"

#: calligraconverter.cpp:214
#, kde-format
msgid "Mimetype not found %1"
msgstr "%1 MIME түрі табылмады"

#: calligraconverter.cpp:220
msgid "Mimetype not found, try using the -mimetype option"
msgstr "MIME түрі табылмады,  -mimetype параметрін қолданыңыз"

#: calligraconverter.cpp:244
msgid "*** The conversion failed! ***"
msgstr "*** Түрлендіру жаңылысы! ***"

