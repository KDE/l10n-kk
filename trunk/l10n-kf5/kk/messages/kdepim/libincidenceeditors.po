msgid "Request No Response"
msgstr "Жауабын сұрамау"

#: attendeeline.cpp:188
msgctxt "@info:tooltip"
msgid "Enter the name or email address of the attendee."
msgstr "Қатысушының эл.пошта адресін келтіріңіз."

#: attendeeline.cpp:192
msgctxt "@info:whatsthis"
msgid "Edits the current attendance status of the attendee."
msgstr "Қатысушысының күй-жайын өзгерту."

#: attendeeline.cpp:195 schedulingdialog.cpp:136
msgctxt "@info:whatsthis"
msgid "Edits the role of the attendee."
msgstr "Қатысушы атқаратын қызметін өзгерту."

#: attendeeline.cpp:198
msgctxt "@info:whatsthis"
msgid ""
"The email address or name of the attendee. An invitation can be sent to the "
"user if an email address is provided."
msgstr ""
"Қатысушының эл.пошта адресі не аты. Шақыру, эл.поштасы келтірілсе ғана  "
"жіберіледі."

#: attendeeline.cpp:203
msgctxt "@info:tooltip"
msgid "Request a response from the attendee"
msgstr "Қатысушының жауабын сұрау"

#: attendeeline.cpp:205
msgctxt "@info:whatsthis"
msgid ""
"Edits whether to send an email to the attendee to request a response "
