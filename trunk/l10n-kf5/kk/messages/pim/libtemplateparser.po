msgid "Insert Command"
msgstr "Команданы енгізу"

#: templatesinsertcommandpushbutton.cpp:430
#, kde-format
msgctxt "@info:tooltip"
msgid "Select a command to insert into the template"
msgstr "Үлгіге ендіретін команданы таңдау"

#: templatesinsertcommandpushbutton.cpp:433
#, kde-format
msgctxt "@info:whatsthis"
msgid ""
"Traverse this menu to find a command to insert into the current template "
"being edited.  The command will be inserted at the cursor location, so you "
"want to move your cursor to the desired insertion point first."
msgstr ""
"Өзгертілетін үлгісіне енгізетін команданы осы мәзірден таңдап алыңыз. "
"Команда меңзер тұрған орынға енгізіледі, сондықтан алдымен оны керек жерге "
"орналастыру абзал."

#: templatesinsertcommandpushbutton.cpp:438
#, kde-format
msgid "Original Message"
msgstr "Бастапқы хат"

#: templatesinsertcommandpushbutton.cpp:450
#, kde-format
msgid "Current Message"
msgstr "Назардағы хат"

#: templatesinsertcommandpushbutton.cpp:461
#, kde-format
msgid "Process with External Programs"
msgstr "Сыртқы бағдарламалармен өңдеу"

