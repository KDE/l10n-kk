#: krdb.cpp:340
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# KDE жүйесі құрған, %1\n"
"#\n"
"# GTK баптауларын KDE жүйесі құрғанын қаламасаңыз\n"
"# Басқару орталығында \"Көрініс пен тақырыптар -> Түстер\" модулін ашып\n"
"# \"KDE-ге кірмейтін қолданбаларда осы түстер қолданылсын\"\n"
"# деген құсбелгісін алып тастаңыз.\n"
"#\n"
