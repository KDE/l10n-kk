msgstr "\"Қара тізімді\" тетік қолдануда: '%1'."

#: nepomukfeederagentbase.cpp:371
#, kde-format
msgid "Calling the Nepomuk storage service failed: '%1'."
msgstr "Nepomuk қоймасының қызметін шақыру жаңылысы: '%1'."

#: nepomukfeederagentbase.cpp:379
msgid "Nepomuk is not running."
msgstr "Nepomuk жегілмеген."

#: nepomukfeederagentbase.cpp:386
msgid "Nepomuk backend for Strigi is not available."
msgstr "Nepomuk тетігі Strigi-ге қол жеткізбейді."

#: nepomukfeederagentbase.cpp:401
msgid "Ready to index data."
msgstr "Деректі индекстеуге дайын."

#: nepomukfeederagentbase.cpp:408
#, kde-format
msgid ""
"<b>Nepomuk Indexing Agents Have Been Disabled</b><br/>The Nepomuk service is "
"not available or fully operational and attempts to rectify this have failed. "
"Therefore indexing of all data stored in the Akonadi PIM service has been "
"disabled, which will severely limit the capabilities of any application "
"using this data.<br/><br/>The following problems were detected:<ul><li>%1</"
"li></ul>Additional help can be found here: <a href=\"http://userbase.kde.org/"
"Akonadi\">userbase.kde.org/Akonadi</a>"
msgstr ""
"<b>Nepomuk индекстеу агенті бұғатталған</b><br/>Nepomuk қызметі қол "
"жеткізбеді және бұны түзеу амалы сәтсіздікке ұшрады. Сондықтан, Akonadi PIM "
"қызметі сақтаған барлық деректерінің индекстеуі істемейді, бұл, сол "
"деректерді пайдаланатын бүкіл бағдарламалардың мүмкіндіктерін едәуір шеқтеп "
"тастайды.<br/><br/>Байқалған мәселесі мынадай:<ul> <li>%1</li></ul>Қосымша "
"көмекті мына жерден таба аласыз: <a href=\"http://userbase.kde.org/Akonadi"
"\">userbase.kde.org/Akonadi</a>"

#: nepomukfeederagentbase.cpp:417
msgid "Nepomuk not operational"
msgstr "Nepomuk іске келмейді"

#: nepomukfeederagentbase.cpp:420
msgid "Nepomuk Indexing Disabled"
msgstr "Nepomuk индекстеуі істемейді"

#: nepomukfeederagentbase.cpp:480
msgid "Strigi is not available for indexing."
msgstr "Strigi индекстеуді істей алмайды."

#: nepomukfeederagentbase.cpp:539
msgid "Indexing recent changes..."
msgstr "Жуырдағы өзгерістерін индекстеу..."

#: nepomukfeederagentbase.cpp:549
msgid "System idle, ready to index data."
msgstr "Жүйе бос, индекстеуге дайын."

#: nepomukfeederagentbase.cpp:560
msgid "System busy, indexing suspended."
msgstr "Жүйе бос емес, индекстеу аялдап тұр."
