#: kabcresource.cpp:123
msgctxt "@info:status"
msgid "Changing address book plugin configuration"
msgstr "Адрестік кітапша плагиннің баптауын өзгерту"

#: kabcresource.cpp:148
msgctxt "@info:status"
msgid "Acquiring address book plugin configuration"
msgstr "Адрестік кітапша плагиннің баптауын қабылдау"

#: kabcresource.cpp:157 kabcresource.cpp:201 kabcresource.cpp:378
#: kabcresource.cpp:434 kabcresource.cpp:489 kabcresource.cpp:527
#: kabcresource.cpp:764 kabcresource.cpp:777 kabcresource.cpp:784
msgctxt "@info:status"
msgid "No KDE address book plugin configured yet"
msgstr "KDE адрестік кітапша плагині әлі бапталмаған"

#: kabcresource.cpp:179
msgctxt "@info:status"
msgid "Initialization based on newly created configuration failed."
msgstr "Жаңа баптау негіздегі иніциализация жаңылсы."

#: kabcresource.cpp:186 kabcresource.cpp:803
msgctxt "@info:status"
msgid "Loading of address book failed."
msgstr "Адрестік кітапшаны жүктеп алу жаңылысы."

#: kabcresource.cpp:192 kabcresource.cpp:809
msgctxt "@info:status"
msgid "Loading address book"
msgstr "Адрестік кітапшаны жүктеу"

#: kabcresource.cpp:325
msgctxt "@info:status"
msgid ""
"Request for data of a specific distribution list failed because there is no "
"such list"
msgstr ""
"Нақты бір тарату тізімінің деректерін сұрау жаңылды, себебі ондай тізім жоқ"

#: kabcresource.cpp:338
msgctxt "@info:status"
msgid ""
"Request for data of a specific address book entry failed because there is no "
"such entry"
msgstr ""
"Нақты бір адрестік кітапша жазуының деректерін сұрау жаңылды, себебі ондай "
"жазуы жоқ"

#: kabcresource.cpp:640
msgctxt "@info:status"
msgid ""
"Request for saving the address book failed. Probably locked by another "
"application"
msgstr ""
"Адрестік кітапшаны сақтау талпыныс жаңылды. Мүмкін себебі - оны басқа "
"қолданба бұғаттап тұр."

#: kabcresource.cpp:794
msgctxt "@info:status"
msgid "Initialization based on stored configuration failed."
msgstr "Сақталған баптау негіздегі иніциализация жаңылсы."
