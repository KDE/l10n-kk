#: kilestdactions.cpp:31
#, kde-format
msgid ""
"\\documentclass[options]{class}\n"
"class : article,report,book,letter\n"
"size options : 10pt, 11pt, 12pt\n"
"paper size options: a4paper, a5paper, b5paper, letterpaper, legalpaper, "
"executivepaper\n"
"other options: \n"
"landscape -- selects landscape format; default is portrait. \n"
"titlepage, notitlepage -- selects if there should be a separate title page.\n"
"leqno -- display equation number on left side of equations; default is right "
"side.\n"
"fleqn -- display formulae flush left; default is centered.\n"
"onecolumn, twocolumn -- one or two columns; defaults to one column\n"
"oneside, twoside -- selects one- or two-sided layout.\n"
msgstr ""
"\\documentclass[options]{class}\n"
"класы : article,report,book,letter\n"
"өлшемі : 10pt, 11pt, 12pt\n"
"қағаз өлшемі: a4paper, a5paper, b5paper, letterpaper, legalpaper, "
"executivepaper\n"
"басқа параметрлер: \n"
"landscape -- көлденең пішімін таңдау; әдетте ол тік. \n"
"titlepage, notitlepage -- бөлек титулды бет керек пе, жоқ па.\n"
"leqno -- теңдіктің нөмірін сол жағынан келтіру; әдетте ол оң жағында.\n"
"fleqn -- формулаларды сол жағына туралау; әдетте ол ортаға.\n"
"onecolumn, twocolumn -- бір немесе екі бағанада жазу; әдетте бір\n"
"oneside, twoside -- бір жақты не екі жақты ма.\n"

#: kilestdactions.cpp:35
#, kde-format
msgid "Package Import - \\usepackage{}"
msgstr "Дестені импорттау - \\usepackage{}"

#: kilestdactions.cpp:35
#, kde-format
msgid "Package Import"
msgstr "Дестені импорттау"

#: kilestdactions.cpp:36
#, kde-format
msgid ""
"Any options given in the \\documentclass command that are unknown by the "
"selected document class\n"
"are passed on to the packages loaded with \\usepackage."
msgstr ""
"Таңдалған құжат класына беймәлім \\documentclass командасымен берілген "
"параметрлер\n"
"\\usepackage командасымен жүктелген дестелерге тапсырылады."

#: kilestdactions.cpp:39
#, kde-format
msgid "AMS Packages"
msgstr "AMS дестелері"

#: kilestdactions.cpp:39
#, kde-format
msgid "The principal American Mathematical Society packages"
msgstr "Америка математикалық қоғамының негізгі дестелері"

#: kilestdactions.cpp:40
#, kde-format
msgid "Start Document Body - \\begin{document}"
msgstr "Құжаттың денесін бастау - \\begin{document}"

#: kilestdactions.cpp:40
#, kde-format
msgid "Start Document Body"
msgstr "Құжаттың денесін бастау"

#: kilestdactions.cpp:40
#, kde-format
msgid ""
"Text is allowed only between \\begin{document} and \\end{document}.\n"
"The 'preamble' (before \\begin{document} ) may contain declarations only."
msgstr ""
"Мәтін тек қана \\begin{document} пен \\end{document} дегеннің арасында.\n"
"ғана келтіріледі. 'Преамбулада' (\\begin{document} ) дегеннің алдында "
"мәлімдемелер ғана болады."

#: kilestdactions.cpp:41
#, kde-format
msgid "Generate Title - \\maketitle"
msgstr "Титулды жазуын құру - \\maketitle"

#: kilestdactions.cpp:41
#, kde-format
msgid "Generate Title"
msgstr "Титулды жазуын құру"

#: kilestdactions.cpp:41
#, kde-format
msgid ""
"This command generates a title on a separate title page\n"
"- except in the article class, where the title normally goes at the top of "
"the first page."
msgstr ""
"Бөлек титулды бетті құру командасы\n"
"- тек article класында ғана титулды жазуы алғашқы беттің жоғарында "
"келтіріледі."

#: kilestdactions.cpp:42
#, kde-format
msgid "Table of Contents - \\tableofcontents"
msgstr "Мазмұнының кестесі - \\tableofcontents"

#: kilestdactions.cpp:42
#, kde-format
msgid "Put this command where you want the table of contents to go"
msgstr "Бұл команданы мазмұнының кестесін қалаған жерінде қойыңыз"

#: kilestdactions.cpp:43
#, kde-format
msgid "Title Definition - \\title{}"
msgstr "Титул мәтіні - \\title{}"

#: kilestdactions.cpp:43
#, kde-format
msgid "Title Definition"
msgstr "Титул мәтіні"

#: kilestdactions.cpp:43
#, kde-format
msgid ""
"\\title{text}\n"
"The \\title command declares text to be the title.\n"
"Use \\\\ to tell LaTeX where to start a new line in a long title."
msgstr ""
"\\title{text}\n"
"\\title командасы титул жазуы болатын мәтінді келтіреді.\n"
"Жазуы ұзын болса \\\\ деп жаңа жолды бастауға болады."

#: kilestdactions.cpp:44
#, kde-format
msgid "Author Definition - \\author{}"
msgstr "Авторды келтіру - \\author{}"

#: kilestdactions.cpp:44
#, kde-format
msgid "Author Definition"
msgstr "Авторды келтіру"

#: kilestdactions.cpp:44
#, kde-format
msgid ""
"\\author{names}\n"
"The \\author command declares the author(s), where names is a list of "
"authors separated by \\and commands."
msgstr ""
"\\author{аттары}\n"
"\\author командасы автордың атын (не авторлардын аттарын \\and деп бөліктеп) "
"келтіреді."

#: kilestdactions.cpp:46
#, kde-format
msgid "Center - \\begin{center}"
msgstr "Ортаға келтіру - \\begin{center}"

#: kilestdactions.cpp:46 kilestdactions.cpp:47 kilestdactions.cpp:48
#, kde-format
msgid "Each line must be terminated with the string \\\\."
msgstr "Әр жолы \\\\ деп аяқталу керек."

#: kilestdactions.cpp:47
#, kde-format
msgid "Align Left - \\begin{flushleft}"
msgstr "Солға туралау - \\begin{flushleft}"

#: kilestdactions.cpp:48
#, kde-format
msgid "Align Right - \\begin{flushright}"
msgstr "Оңға туралау - \\begin{flushright}"

#: kilestdactions.cpp:49
#, kde-format
msgid "Quote - \\begin{quote}"
msgstr "Дәйекше - \\begin{quote}"

#: kilestdactions.cpp:49
#, kde-format
msgid "Quote"
msgstr "Дәйекше"

#: kilestdactions.cpp:49
#, kde-format
msgid ""
"The text is justified at both margins.\n"
"Leaving a blank line between text produces a new paragraph."
msgstr ""
"Мәтінді екі жиегіне де туралау.\n"
"Бос жолды қалдыру - жаңа абзацты бастайды."

#: kilestdactions.cpp:50
#, kde-format
msgid "Quotation - \\begin{quotation}"
msgstr "Дәйексөз - \\begin{quotation}"

#: kilestdactions.cpp:50
#, kde-format
msgid "Quotation"
msgstr "Дәйексөз"

#: kilestdactions.cpp:50
#, kde-format
msgid ""
"The text is justified at both margins and there is paragraph indentation.\n"
"Leaving a blank line between text produces a new paragraph."
msgstr ""
"Абзацты шегініспен бастап, мәтінді екі жиегіне де туралау.\n"
"Бос жолды қалдыру - жаңа абзацты бастайды."

#: kilestdactions.cpp:51
#, kde-format
msgid "Verse - \\begin{verse}"
msgstr "Тақпақ - \\begin{verse}"

#: kilestdactions.cpp:51
#, kde-format
msgid "Verse"
msgstr "Тақпақ"

#: kilestdactions.cpp:51
#, kde-format
msgid ""
"The verse environment is designed for poetry.\n"
"Separate the lines of each stanza with \\\\, and use one or more blank lines "
"to separate the stanzas."
msgstr ""
"Тақпақ жазуға арналған айналасы.\n"
"Шумақтағы жолдары \\\\ деп бөлініп, шумақтар бір не бірнеше бос жолмен "
"бөлінеді."

#: kilestdactions.cpp:53
#, kde-format
msgid "Verbatim - \\begin{verbatim}"
msgstr "Сөзбе-сөз - \\begin{verbatim}"

#: kilestdactions.cpp:53
#, kde-format
msgid "Environment that gets LaTeX to print exactly what you type in."
msgstr "Теріп бергенін сөзбе-сөз келтіретін LaTeX айналасы."

#: kilestdactions.cpp:54
#, kde-format
msgid "Bulleted List - \\begin{itemize}"
msgstr "Таңбаланған тізім - \\begin{itemize}"

#: kilestdactions.cpp:54
#, kde-format
msgid "Bulleted List"
msgstr "Таңбаланған тізім"

#: kilestdactions.cpp:54
#, kde-format
msgid ""
"The itemize environment produces a 'bulleted' list.\n"
"Each item of an itemized list begins with an \\item command."
msgstr ""
"Таңбаланған тізімді жасайтын тізбелеу айналасы.\n"
"Әрбір тізбелегені \\item командасынан басталады."

#: kilestdactions.cpp:55
#, kde-format
msgid "Enumeration - \\begin{enumerate}"
msgstr "Тізбелеу - \\begin{enumerate}"

#: kilestdactions.cpp:55
#, kde-format
msgid "Enumeration"
msgstr "Тізбелеу"

#: kilestdactions.cpp:55
#, kde-format
msgid ""
"The enumerate environment produces a numbered list.\n"
"Each item of an enumerated list begins with an \\item command."
msgstr ""
"Тізбелеу айналасы нөмрленген тізімді жасайды.\n"
"Әрбір тізбелегені \\item командасынан басталады."

#: kilestdactions.cpp:56
#, kde-format
msgid "Description - \\begin{description}"
msgstr "Сипатама - \\begin{description}"

#: kilestdactions.cpp:56
#, kde-format
msgid ""
"The description environment is used to make labeled lists.\n"
"Each item of the list begins with an \\item[label] command.\n"
"The 'label' is bold face and flushed right."
msgstr ""
"Жарлықпен белгіленген тізімді жасайтын сипатау айналасы.\n"
"Әрбір тізбелегені \\item[label] командасынан басталады.\n"
"'Жарлық' оң жаққа тураланған қалың қаріппен келтіріледі."

#: kilestdactions.cpp:58
#, kde-format
msgid "Table - \\begin{table}"
msgstr "Кесте - \\begin{table}"

#: kilestdactions.cpp:58
#, kde-format
msgid "Table"
msgstr "Кесте"

#: kilestdactions.cpp:59
#, kde-format
msgid ""
"\\begin{table}[placement]\n"
"body of the table\n"
"\\caption{table title}\n"
"\\end{table}\n"
"Tables are objects that are not part of the normal text, and are usually "
"floated to a convenient place.\n"
"The optional argument [placement] determines where LaTeX will try to place "
"your table\n"
"h : Here - at the position in the text where the table environment appears\n"
"t : Top - at the top of a text page\n"
"b : Bottom - at the bottom of a text page\n"
"p : Page of floats - on a separate float page, which is a page containing no "
"text, only floats.\n"
"The body of the table is made up of whatever text or LaTeX commands, etc., "
"you wish.\n"
"The \\caption command allows you to title your table."
msgstr ""
"\\begin{table}[орны]\n"
"кестенің денесі\n"
"\\caption{кестенің атауы}\n"
"\\end{table}\n"
"Кестелер кәдімгі мәтінге жатпайтын нысандар, оларды тұтас керек орынға "
"жылжытуға болады.\n"
"[орны] деген болуы міндетті емес аргументі LaTeX оны қай жерге орналастыруға "
"тырысатынын көрсетеді.\n"
"h : Осында - кестені айналасы келтірілген орында көрсету\n"
"t : Жоғарыда - мәтін беттің жоғарында\n"
"b : Төменінде - мәтін беттің төменінде\n"
"p : Қалқымалы бетінде - мәтіні жоқ, бөлек, тек қалқымалы нысандарға арналған "
"бетте.\n"
"Кестенің денесі кез-келген мәтін не LaTeX командалардан, т.б. қалаған "
"нәрселерден тұрады.\n"
"\\caption командасы кестенің атауын келтіруге арналған. "

#: kilestdactions.cpp:63
#, kde-format
msgid "Figure - \\begin{figure}"
msgstr "Сурет - \\begin{figure}"

#: kilestdactions.cpp:63
#, kde-format
msgid "Figure"
msgstr "Сурет"

#: kilestdactions.cpp:64
#, kde-format
msgid ""
"\\begin{figure}[placement]\n"
"body of the figure\n"
"\\caption{figure title}\n"
"\\end{figure}\n"
"Figures are objects that are not part of the normal text, and are usually "
"floated to a convenient place.\n"
"The optional argument [placement] determines where LaTeX will try to place "
"your figure\n"
"h : Here - at the position in the text where the figure environment appears\n"
"t : Top - at the top of a text page\n"
"b : Bottom - at the bottom of a text page\n"
"p : Page of floats - on a separate float page, which is a page containing no "
"text, only floats.\n"
"The body of the figure is made up of whatever text or LaTeX commands, etc., "
"you wish.\n"
"The \\caption command allows you to title your figure."
msgstr ""
"\\begin{figure}[орны]\n"
"суреттің денесі\n"
"\\caption{суреттің атауы}\n"
"\\end{table}\n"
"Суретер кәдімгі мәтінге жатпайтын нысандар, оларды тұтас керек орынға "
"жылжытуға болады.\n"
"[орны] деген болуы міндетті емес аргументі LaTeX оны қай жерге орналастыруға "
"тырысатынын көрсетеді.\n"
"h : Осында - суретті айналасы келтірілген орында көрсету\n"
"t : Жоғарыда - мәтін беттің жоғарында\n"
"b : Төменінде - мәтін беттің төменінде\n"
"p : Қалқымалы бетінде - мәтіні жоқ, бөлек, тек қалқымалы нысандарға арналған "
"бетте.\n"
"Суреттің денесі кез-келген мәтін не LaTeX командалардан, т.б. қалаған "
"нәрселерден тұрады.\n"
"\\caption командасы суреттің атауын келтіруге арналған. "

#: kilestdactions.cpp:68
#, kde-format
msgid "Title Page - \\begin{titlepage}"
msgstr "Титулды бет - \\begin{titlepage}"

#: kilestdactions.cpp:68
#, kde-format
msgid "Title Page"
msgstr "Титулды бет"

#: kilestdactions.cpp:69
#, kde-format
msgid ""
"\\begin{titlepage}\n"
"text\n"
"\\end{titlepage}\n"
"The titlepage environment creates a title page, i.e. a page with no printed "
"page number or heading."
msgstr ""
"\\begin{titlepage}\n"
"мәтін\n"
"\\end{titlepage}\n"
"Бұл titlepage айналасы титулды бетті, яғни бетің нөмірі не колонтитулдары "
"жоқ бетін құрып береді."

#: kilestdactions.cpp:71
#, kde-format
msgid "Italics - \\textit{}"
msgstr "Көлбеу - \\textit{}"

#: kilestdactions.cpp:71
#, kde-format
msgid "Italics"
msgstr "Көлбеу мәтін"

#: kilestdactions.cpp:71
#, kde-format
msgid "\\textit{italic text}"
msgstr "\\textit{көлбеу мәтіні}"

#: kilestdactions.cpp:72
#, kde-format
msgid "Slanted - \\textsl{}"
msgstr "Қисайған - \\textsl{}"

#: kilestdactions.cpp:72 kilestdactions.cpp:213
#, kde-format
msgid "Slanted"
msgstr "Қисайған мәтін"

#: kilestdactions.cpp:72
#, kde-format
msgid "\\textsl{slanted text}"
msgstr "\\textsl{қисайған мәтін}"

#: kilestdactions.cpp:73
#, kde-format
msgid "Boldface - \\textbf{}"
msgstr "Қалың - \\textbf{}"

#: kilestdactions.cpp:73
#, kde-format
msgid "Boldface"
msgstr "Қалың әріпті мәтін"

#: kilestdactions.cpp:73
#, kde-format
msgid "\\textbf{boldface text}"
msgstr "\\textbf{қалың әріпті мәтін}"

#: kilestdactions.cpp:74
#, kde-format
msgid "Typewriter - \\texttt{}"
msgstr "Жазу машинка - \\texttt{}"

#: kilestdactions.cpp:74
#, kde-format
msgid "Typewriter"
msgstr "Жазу машинкасы"

#: kilestdactions.cpp:74
#, kde-format
msgid "\\texttt{typewriter text}"
msgstr "\\texttt{жазу машинка мәтіні}"

#: kilestdactions.cpp:75
#, kde-format
msgid "Small Caps - \\textsc{}"
msgstr "Шағын үлкен әріп - \\textsc{}"

#: kilestdactions.cpp:75
#, kde-format
msgid "Small Caps"
msgstr "Шағын үлкен әріп"

#: kilestdactions.cpp:75
#, kde-format
msgid "\\textsc{small caps text}"
msgstr "\\textsc{шағын үлкен әріпті мәтін}"

#: kilestdactions.cpp:76
#, kde-format
msgid "\\item[label] Hello!"
msgstr "\\item[label] Сәлем!"

#: kilestdactions.cpp:78
#, kde-format
msgid "Tabbing - \\begin{tabbing}"
msgstr "Кестелеу - \\begin{tabbing}"

#: kilestdactions.cpp:78
#, kde-format
msgid ""
"The tabbing environment provides a way to align text in columns.\n"
"\\begin{tabbing}\n"
"text \\= more text \\= still more text \\= last text \\\\\n"
"second row \\&gt;  \\&gt; more \\\\\n"
"\\end{tabbing}\n"
"Commands :\n"
"\\=  Sets a tab stop at the current position.\n"
"\\>  Advances to the next tab stop.\n"
"\\&lt;  Allows you to put something to the left of the local margin without "
"changing the margin. Can only be used at the start of the line.\n"
"\\+  Moves the left margin of the next and all the following commands one "
"tab stop to the right\n"
"\\-  Moves the left margin of the next and all the following commands one "
"tab stop to the left\n"
"\\' Moves everything that you have typed so far in the current column to the "
"right of the previous column, flush against the current column's tab stop. \n"
"\\`  Allows you to put text flush right against any tab stop, including tab "
"stop 0\n"
"\\kill  Sets tab stops without producing text.\n"
"\\a  In a tabbing environment, the commands \\=, \\' and \\` do not produce "
"accents as normal. Instead, the commands \\a=, \\a' and \\a` are used."
msgstr ""
"Кестелеу айналасы мәтінді бағандарға туралап береді.\n"
"\\begin{tabbing}\n"
"мәтін \\= әрі мәтін \\= әрі қалған мәтін \\= мәтін соңы \\\\\n"
"екінші жол \\&gt;  \\&gt; көбірек \\\\\n"
"\\end{tabbing}\n"
"Командалар :\n"
"\\=  Кестелеу аттау орнын осы орынға кою.\n"
"\\>  Келесі кестелеу орнына өту.\n"
"\\&lt;  Жиегін өзгертпей сол жақ жиегінде бідеме орналастыруды мүмкін "
"қылады. Тек қана жол басында ғана қолданылады.\n"
"\\+  Келесі командалардың сол жақ жиегін бір аттам оңға жылжыту.\n"
"\\-   Келесі командалардың сол жақ жиегін бір аттам солға жылжыту.\n"
"\\' Бүкіл бұдан бұрын назардағы бағанда терген мәтінді алдыңғы бағанның оң "
"жағына жылжып, назардағы кестелеу орнына туралау. \n"
"\\`  Кез келген кестелеу аттамында (0-аттамын қоса) мәтінді оң жағына "
"туралау\n"
"\\kill  Кестелеу аттамдарын мәтінсіз орнату.\n"
"\\a  Кестелеу айналада \\=, \\' және \\` командалары кәдімгідей істемейді. "
"Олардың орнына \\a=, \\a' және \\a` дегендерді қолдану керек."

#: kilestdactions.cpp:79
#, kde-format
msgid "Tabular - \\begin{tabular}"
msgstr "Tabular - \\begin{tabular}"

#: kilestdactions.cpp:79
#, kde-format
msgid ""
"\\begin{tabular}[pos]{cols}\n"
"column 1 entry & column 2 entry ... & column n entry \\\\\n"
"...\n"
"\\end{tabular}\n"
"pos : Specifies the vertical position; default is alignment on the center of "
"the environment.\n"
"     t - align on top row\n"
"     b - align on bottom row\n"
"cols : Specifies the column formatting.\n"
"     l - A column of left-aligned items.\n"
"     r - A column of right-aligned items.\n"
"     c - A column of centered items.\n"
"     | - A vertical line the full height and depth of the environment.\n"
"     @{text} - this inserts text in every row.\n"
"The \\hline command draws a horizontal line the width of the table.\n"
"The \\cline{i-j} command draws horizontal lines across the columns "
"specified, beginning in column i and ending in column j.\n"
"The \\vline command draws a vertical line extending the full height and "
"depth of its row."
msgstr ""
"\\begin{tabular}[тікорны]{бағандар}\n"
"1-баған мазмұны & 2-баған мазмұны ... & n-баған мазмұны \\\\ \n"
"...\n"
"\\end{tabular}\n"
"тікорны : Тігінен туралауы; әдеттегісі айналаның ортасына.\n"
"     t - жолдың жоғарына туралау\n"
"     b - жолдың төменіне туралау\n"
"бағандар : Бағанның пішімдеуі.\n"
"     l - Бағандағысын солға туралау.\n"
"     r - Бағандағысын оңға туралау.\n"
"     c - Бағандағысын ортаға туралау.\n"
"     | - ұзындығы айналасының биіктігі мен жол тереңдігіне тең тік сызық.\n"
