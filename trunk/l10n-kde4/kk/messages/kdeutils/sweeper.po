msgstr "Төмен"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 62
#: rc.cpp:16
#, no-c-format
msgid "Medium"
msgstr "Орташа"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 67
#: rc.cpp:20
#, no-c-format
msgid "High"
msgstr "Жоғары"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 72
#: rc.cpp:24
#, no-c-format
msgid "Custom"
msgstr "Қалауы бойынша"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 80
#: rc.cpp:28
#, no-c-format
msgid "Financial Information"
msgstr "Қаржылық мәлімет"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 89
#: rc.cpp:32
#, no-c-format
msgid ""
"Warn me when I visit a site that uses my financial or purchase information:"
msgstr ""
"Қаржылық не сатып алу туралы мәліметтерімді келесі мақсаттарға қолданатын "
"сайттарға кіріп-шығудың алдында ескертілсін:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 99
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 135
#: rc.cpp:36 rc.cpp:52
#, no-c-format
msgid "For marketing or advertising purposes"
msgstr "Жарнамалық және маркетингтік мақсаттар үшін"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 106
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 142
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 178
#: rc.cpp:40 rc.cpp:56 rc.cpp:72
#, no-c-format
msgid "To share with other companies"
msgstr "Мәліметтерді басқа компаниялармен ортақтастыру үшін"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 116
#: rc.cpp:44
#, no-c-format
msgid "Health Information"
msgstr "Денсаулық туралы мәлімет"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 125
#: rc.cpp:48
#, no-c-format
msgid ""
"Warn me when I visit a site that uses my health or medical information: "
msgstr ""
"Медициналық мәліметтерімді келесі мақсаттарға қолданатын сайттарға кіріп-"
"шығудың алдында ескертілсін: "

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:60
#, no-c-format
msgid "Demographics"
msgstr "Демография"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:64
#, no-c-format
msgid ""
"Warn me when I visit a site that uses my non-personally identifiable "
"information:"
msgstr ""
"Жеке мені сипаттайтын мәліметтерімді келесі мақсаттарға қолданатын сайттарға "
"кіріп-шығудың алдында ескертілсін: "

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:68
#, no-c-format
msgid "To determine my interests, habits or general behavior"
msgstr ""
"Менің мүдделерімді, әдеттерімді, не басқа жалпы қасиетерімді анықтау үшін"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:76
#, no-c-format
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr ""
"Жеке мәліметтерімен үшінші жақтарымен бөлісетін сайтқа кіріп- шығудың "
"алдында ескертілсін"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:80
#, no-c-format
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr ""
"Мен туралы оларда қандай мәлімет бар екенін анықтауға рұқсат бермейтін "
"сайттарға кіріп шығудың алдында ескертілсін"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:84
#, no-c-format
msgid "Personal Information"
msgstr "Жеке мәліметтер"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:88
#, no-c-format
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"Өнімдері мен қызметтері туралы жарнамасын жіберетін сайттарға кіріп-шығудың "
"алдында ескерілсін"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:92
#, no-c-format
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr ""
"Жеке мәліметтерімді қолданатын сайттарға кіріп-шығудың алдында ескертілсін:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:96
#, no-c-format
msgid "Determine my habits, interests or general behavior"
msgstr "Менің мүдделерімді, әдеттерімді, не басқа жалпы қасиеттерімді анықтау"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:100
#, no-c-format
msgid "Via telephone"
msgstr "Телефон арқылы"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:104
#, no-c-format
msgid "Via mail"
msgstr "Пошта арқылы"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:108
#, no-c-format
msgid "Via email"
msgstr "Эл.пошта арқылы"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:112
#, no-c-format
msgid "And do not allow me to remove my contact information"
msgstr "Және мен туралы мәліметтерді өшіруге рұқсат етпейтін"

