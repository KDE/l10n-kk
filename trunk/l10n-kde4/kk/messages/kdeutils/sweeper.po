#: rc.cpp:8
#, no-c-format
msgid "Network privacy level:"
msgstr "Желінің дербестік деңгейі:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 57
#: rc.cpp:12
#, no-c-format
