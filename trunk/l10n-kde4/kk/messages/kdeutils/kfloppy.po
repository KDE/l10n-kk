#: floppy.cpp:84
msgid "Floppy &drive:"
msgstr "&Дискжетегі:"

#: floppy.cpp:92 floppy.cpp:384 floppy.cpp:730
msgid "Primary"
msgstr "Негізгі"

#: floppy.cpp:93 floppy.cpp:388
msgid "Secondary"
msgstr "Қосалқы"

#: floppy.cpp:95
msgid "<qt>Select the floppy drive.</qt>"
msgstr "<qt>Дискжетекті таңдаңыз.</qt>"

#: floppy.cpp:102
msgid "&Size:"
msgstr "&Көлемі:"

#: floppy.cpp:108 floppy.cpp:732
msgid "Auto-Detect"
msgstr "Авто-анықтау"

#: floppy.cpp:110 floppy.cpp:395 floppy.cpp:734
msgid "3.5\" 1.44MB"
msgstr "3.5\" 1.44 Mб"

