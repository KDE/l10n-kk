#, kde-format
msgid ""
"Create new folder in:\n"
"%1"
msgstr ""
"Жаңа қапшықтын орны:\n"
"%1"

#: ../kfile/knewfilemenu.cpp:606
#, kde-format
msgid "<qt>The template file <b>%1</b> does not exist.</qt>"
