#: volumeslider.cpp:176
#, kde-format
msgid "Volume: %1%"
msgstr "Үнділігі: %1%"

#: volumeslider.cpp:37 volumeslider.cpp:49 volumeslider.cpp:99
#, kde-format
msgid ""
"Use this slider to adjust the volume. The leftmost position is 0%, the "
"rightmost is %1%"
msgstr ""
"Дыбыстын қаттылығын басқаратын жүгірткі. Сол жақ шеті 0%, оң жақ шеті %1%"

#: volumeslider.cpp:162
msgid "Muted"
msgstr "Үні өшірілген"

#: audiooutput.cpp:304
#, kde-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>Дыбысты орындау <b>%1</b> құрылғысы істемейді.<br/><b>%2</b> дегенге "
"ауысты.</html>"

#: audiooutput.cpp:309
#, kde-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>Қол жеткізер болған және артықшылығы жоғарырақ <b>%1</b><br/>дыбысты "
"орындау құрылғысына ауысу.</html>"

#: audiooutput.cpp:312
#, kde-format
msgid "Revert back to device '%1'"
msgstr "'%1' құрылғысына қайту"

