"жоғалады."

#. i18n: file: dialogs/cursorconfigwidget.ui:125
#. i18n: ectx: property (text), widget (QRadioButton, rbNormal)
#: rc.cpp:368
msgid "&Normal"
msgstr "Қ&алыпты"

#. i18n: file: dialogs/cursorconfigwidget.ui:132
#. i18n: ectx: property (whatsThis), widget (QRadioButton, rbPersistent)
#: rc.cpp:371
