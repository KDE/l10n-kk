#: dict.cpp:1477
msgid "The server is temporarily unavailable."
msgstr "Сервер уақытша қол жеткізбеуде."

#: dict.cpp:1480
#, fuzzy
msgid ""
"The server reported a syntax error.\n"
"This should not happen -- please consider\n"
"writing a bug report."
msgstr ""
"Сервер синтаксис қате туралы хабарлады.\n"
"Бұндай болуға тиіс емес -- қате туралы\n"
"хабарлағаныңыз жөн."

#: dict.cpp:1483
#, fuzzy
msgid ""
"A command that Kdict needs is not\n"
"implemented on the server."
msgstr ""
"Kdict керек қылған команда\n"
