msgid "contain"
msgstr "келесі кездесетіні:"

#: rc.cpp:215 common/configaccess.cpp:383
msgid "do not contain"
msgstr "келесі кездеспейтіні:"

#: rc.cpp:218 common/configaccess.cpp:385
msgid "equal"
msgstr "келесіге тең:"

