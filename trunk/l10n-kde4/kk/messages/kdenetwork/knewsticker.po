msgstr "Өрнегі"

#: rc.cpp:144
msgid "Remove selected filter"
msgstr "Таңдалған сүзгіні өшіру"

#: rc.cpp:147
msgid "Press this button to remove the selected filter from the list."
msgstr "Тізімінен таңдалған сүзгіні өшіру үшін осы батырманы басыңыз."

#: rc.cpp:150
