#: src/main.cpp:43
msgid "Thanks also to everyone who should be listed here but is not!"
msgstr "Бүкіл тізімғе кірмеген брақ кіруге  тиістерге алғысымызды айтамыз!"

#~ msgid "The tile set to use."
#~ msgstr "Қолданатын тастар жиыны."

#~ msgid "The background to use."
#~ msgstr "Қолданатын аясы."

#~ msgid "Main Toolbar"
#~ msgstr "Негізгі құралдар"

#~ msgid ""
#~ "<b>Gravity</b><p>Checking this makes the game even harder: If a tile is "
#~ "removed, all tiles lying above it will fall down one step.</p>"
#~ msgstr ""
#~ "<b>Гравитация</b><p>Бұны таңдасаңыз - ойын ауырлайды. Алынып тасталған "
#~ "тас жоғардағылары бір қадам төменге түседі.</p>"

#~ msgid ""
#~ "<b>Create solvable games only</b><p>If checked, you will only be "
#~ "presented with games that are possible to solve.</p><p>Note: Even in "
#~ "solvable games you can fail to complete if you remove the tiles in the "
#~ "wrong order.</p>"
#~ msgstr ""
#~ "<b>Шешімі бар ойындар ғана құрылсын</b><p>Көзі белгіленсе, тек шешімі бар "
#~ "ойындар ғана ұсынылады.</p><p>Ескерту: Шешімі бар ойында да, тастарды "
#~ "дұрыс ретімен алмай тығырыққа тірелуге болады.</p>"

#~ msgid "Create solvable games only"
#~ msgstr "Шешімі бар ойындар ғана құрылсын"

#~ msgid ""
#~ "<b>Use Chinese style: any flower match any flower, any season match any "
#~ "season</b><p>Use the traditional rules for matching the tiles. Previous "
#~ "version of the game used to allow only exact tiles matches, which is "
#~ "inconsistent with Mah-jongg rules. It is recommended to keep this option "
#~ "checked.</p>"
#~ msgstr ""
#~ "<b>Қытай стилі қолданылсын: гүл бүкіл гүлдерге, маусым бүкіл маусымдарға "
#~ "сәйкесті</b><p>Дәстүрлі тас сәйкестік ережелері. Бұрынғы нұсқасында тек "
#~ "нақты сәйкестік рұқсат етілетін, ол Маджонг ережелеріне қайшы келетін. "
#~ "Белгілеп қойғаны жөн.</p>"

#~ msgid ""
#~ "Use Chinese style: any flower match any flower, any season match any "
#~ "season"
#~ msgstr ""
#~ "Қытай стилі қолданылсын: гүл бүкіл гүлдерге, маусым бүкіл маусымдарға "
#~ "сәйкесті"

#~ msgid ""
#~ "<b>Tiles can slide, but you can connect only in 2 lines instead of 3</"
#~ "b><p>This option changes the rules to the point where it almost becomes a "
#~ "completely different game. When it is active, you can only remove the "
#~ "tiles if they can be connected by a line consisting of only two segments "
#~ "instead of the customary three. However, you are allowed to slide the "
#~ "tiles on the board, if the row or column where they are placed has some "
#~ "empty space. To make a sliding move, you have to click on the tile "
#~ "containing the column or row that can slide, and then on the matching "
#~ "tile. If there are two possible sliding moves, you will have to click on "
#~ "one of the two connecting lines to choose your preferred move.</p>"
#~ msgstr ""
#~ "<b>Тастар жылжмалы, бірақ 3 қатардың орына 2-ін ғана қосуға болады</"
#~ "b><p>Бұл ойынды мүлдем өзгертетін параметр. Бұл қосылып тұрса, </p>"

#~ msgid "Tiles can slide, but you can connect only in 2 lines instead of 3"
#~ msgstr "Тастар жылжмалы, бірақ 3 қатардың орына 2-ін ғана қосуға болады"

#~ msgid ""
#~ "<b>Board Difficulty</b><p>The slider controls the difficulty of the board "
#~ "from Easy to Hard.</p>"
#~ msgstr ""
#~ "<b>Тақта күрделігі</b><p>Бұл тақтаны оңай-қиындығын басқаратын жүгірткі.</"
#~ "p>"

#~ msgid "Board Difficulty"
#~ msgstr "Тақта күрделігі"

#~ msgid "Easy"
#~ msgstr "Оңай"

#~ msgid "Hard"
#~ msgstr "Қиын"

#~ msgid ""
#~ "<b>Piece Removal Speed</b><p>Adjusting this slider alters the speed at "
#~ "which the pieces are removed from the screen after a match has been made."
#~ "</p>"
#~ msgstr ""
#~ "<b>Тастарды кетіру жылдамдығы</b><p>Бұл жүгірткі сәйкестігі табылған "
#~ "тастар қандай жылдамдығымен алынып тастайтының басқарады.</p>"

#~ msgid "Piece Removal Speed"
#~ msgstr "Тастарды кетіру жылдамдығы"

#~ msgid "Slow"
#~ msgstr "Баяу"

#~ msgid "Fast"
#~ msgstr "Жылдам"

#~ msgid ""
#~ "<b>Board Size</b><p>This slider allows you to change the number of tiles "
#~ "on the board. The more tiles you have, the harder (and longer) the game "
#~ "will be.</p>"
#~ msgstr ""
#~ "<b>Тақта өлшемі</b><p>Бұл жүгірткімен тақтадағы тастар санын өзгертуге "
#~ "болады. Бұл неғұрлым көп, соғұрлым ойын қиын (және ұзақ) болады.</p>"

#~ msgid "Board Size"
#~ msgstr "Тақта өлшемі"

