msgstr "CARY(12;0) қайтаратыны 0"

#: functions/conversion.xml:251
msgid "KCFormat"
msgstr "Пішін"

#: functions/conversion.xml:255
msgid ""
"The ROMAN() function returns the number in Roman format. Only positive whole "
"numbers can be converted. The optional KCFormat argument specifies the level "
"of conciseness, and defaults to 0."
msgstr ""
"ROMAN() функциясы санды римдік түрдегі санға аударады. Сан теріс емес және "
"бүтін болу керек. Қосымша Пішім аргументі қысқалық деңгейін анықтайды, ал ол "
"келтірілмесе әдетті деңгейі - 0."

#: functions/conversion.xml:256
msgid "ROMAN(Number)"
msgstr "ROMAN(сан)"

#: functions/conversion.xml:257
msgid "ROMAN(99) returns \"XCIX\""
msgstr "ROMAN(99) қайтаратыны \"XCIX\""

#: functions/conversion.xml:258
msgid "ROMAN(-55) returns \"Err\""
msgstr "ROMAN(-55) қайтаратыны \"Err\""

#: functions/conversion.xml:267
msgid "Numeral"
msgstr "Рим_саны"

#: functions/conversion.xml:271
msgid "The ARABIC() function converts a roman numeral into a number."
msgstr "ARABIC() функциясы Римдік санды кәдімгі (араб) пішіміне аударады."

#: functions/conversion.xml:272
msgid "ARABIC(Numeral)"
msgstr "ARABIC(Рим_саны)"

#: functions/conversion.xml:273
msgid "ARABIC(\"IV\") returns 4"
msgstr "ARABIC(\"IV\") қайтаратыны 4"

#: functions/conversion.xml:274
msgid "ARABIC(\"XCIX\") returns 99"
msgstr "ARABIC(\"XCIX\") қайтаратыны 99"

