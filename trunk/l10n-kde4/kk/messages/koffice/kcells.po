"AMORLINC( Cost; purchaseDate; firstPeriodEndDate; salvage; period; rate; "
"basis)"
msgstr ""
"AMORLINC( Бағасы; сатыпАлуКүні; біріншіКезеңАяқтауы; қалдықҚұны; кезеңі; "
"пайызМөлшер; күнСанауТәсілі)"

#: functions/financial.xml:121
