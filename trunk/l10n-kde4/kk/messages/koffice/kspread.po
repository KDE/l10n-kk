#. i18n: tag Text
#. i18n: file functions/financial.xml line 468
#: xml_doc.cpp:2357
msgid "Returns the Macauley duration of a fixed interest security in years."
msgstr ""
"Өсім мөлшерлемесі өзгертілмейтін құнды қағаздың өтеу мерзімінің зілдеме орта "
"жылдар санын есептеп береді."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 469
#: xml_doc.cpp:2360
msgid "DURATION_ADD(Settlement; Maturity; Coupon; Yield; Frequency; Basis)"
msgstr ""
"DURATION_ADD(есеп_айырсу_кезі; өтеу_күні; купон; табысы; жиілігі; "
"күн_санау_тәсілі)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 470
#: xml_doc.cpp:2363
msgid ""
"DURATION_ADD( \"1998-01-01\"; \"2006-01-01\"; 0.08; 0.09; 2; 1 ) returns "
"5.9937749555"
msgstr ""
"DURATION_ADD( \"01.01.1998\"; \"01.01.2006\"; 0,08; 0,09; 2; 1 ) қайтаратыны "
"5,9937749555"

