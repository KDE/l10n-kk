#. i18n: tag Comment
#. i18n: file functions/financial.xml line 499
#: xml_doc.cpp:2366 xml_doc.cpp:2382
msgid "Nominal interest rate"
msgstr "Номиналды өсім мөлшерлемесі"

#. i18n: tag Comment
#. i18n: file functions/financial.xml line 483
#. i18n: tag Comment
#. i18n: file functions/financial.xml line 503
#. i18n: tag Comment
#. i18n: file functions/financial.xml line 563
