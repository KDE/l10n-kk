#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 574
#: xml_doc.cpp:825 xml_doc.cpp:846 xml_doc.cpp:900 xml_doc.cpp:912
#: xml_doc.cpp:927 xml_doc.cpp:939 xml_doc.cpp:1044
msgid "Year"
msgstr "Жыл"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 322
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 345
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 419
#. i18n: tag Comment
#. i18n: file functions/financial.xml line 301
#: xml_doc.cpp:828 xml_doc.cpp:849 xml_doc.cpp:915 xml_doc.cpp:2228
msgid "Month"
msgstr "Ай"

#. i18n: tag Comment
