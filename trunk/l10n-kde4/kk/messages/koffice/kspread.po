#. i18n: file functions/financial.xml line 428
#: xml_doc.cpp:2327
msgid "Future value (FV)"
msgstr "Келешек сомасы (КС)"

#. i18n: tag Text
#. i18n: file functions/financial.xml line 432
#: xml_doc.cpp:2330
msgid ""
"Returns the number of periods needed for an investment to retain a desired "
"value."
msgstr "Салым неше кезеңнен кейін керек сомаға жететінін есептеп береді."

#. i18n: tag Syntax
#. i18n: file functions/financial.xml line 433
#: xml_doc.cpp:2333
msgid "DURATION(rate; pv; fv)"
msgstr "DURATION(өм; бс; кс)"

#. i18n: tag Example
#. i18n: file functions/financial.xml line 434
#: xml_doc.cpp:2336
msgid "DURATION(0.1; 1000; 2000) returns 7.27"
msgstr "DURATION(0,1; 1000; 2000) қайтаратыны 7,27"

