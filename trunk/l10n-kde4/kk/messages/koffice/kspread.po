msgid "Day"
msgstr "Күн"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 330
#: xml_doc.cpp:834
msgid ""
"The DAYOFYEAR() function returns the number of the day in the year (1...365)."
msgstr ""
"DAYOFYEAR() функциясы күннің жылдын басынан есептеген нөмірін қайтарады "
"(1...365)."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 331
#: xml_doc.cpp:837
msgid "DAYOFYEAR(year;month;date)"
msgstr "DAYOFYEAR(жыл;ай;күн)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 332
#: xml_doc.cpp:840
msgid "DAYOFYEAR(2000;12;1) returns 336"
msgstr "DAYOFYEAR(2000;12;1) қайтаратыны 336"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 333
#: xml_doc.cpp:843
msgid "DAYOFYEAR(2000;2;29) returns 60"
msgstr "DAYOFYEAR(2000;2;29) қайтаратыны 60"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 353
#: xml_doc.cpp:855
msgid "The DATE() function returns the date formatted with local parameters."
msgstr "DATE() функциясы жергілікті пішіміндегі күнді қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 354
#: xml_doc.cpp:858
msgid "DATE(year;month;date)"
msgstr "DATE(жыл;ай;күн)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 355
#: xml_doc.cpp:861
msgid "DATE(2000;5;5) returns Friday 05 May 2000"
msgstr "DATE(2000;5;25) қайтаратыны 25.05.2000"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 375
#: xml_doc.cpp:873
msgid "The TIME() function returns the time formatted with local parameters."
msgstr "TIME() функциясы жергілікті пішіміндегі уақытты қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 376
#: xml_doc.cpp:876
msgid "TIME(hours;minutes;seconds)"
msgstr "TIME(сағат;минут;секунд)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 377
#: xml_doc.cpp:879
msgid "TIME(10;2;2) returns 10:02:02"
msgstr "TIME(10;2;2) қайтаратыны 10:02:02"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 378
#: xml_doc.cpp:882
msgid "TIME(10;70;0) returns 11:10:0"
msgstr "TIME(10;70;0) қайтаратыны 11:10:0"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 379
#: xml_doc.cpp:885
msgid "TIME(10;-40;0) returns 9:20:0"
msgstr "TIME(10;-40;0) қайтаратыны 9:20:0"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 391
#: xml_doc.cpp:891
msgid ""
"The HOURS() function returns the value of the hours in a time expression."
msgstr "HOURS() функциясы уақыт өрнегіндегі сағат санын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 392
#: xml_doc.cpp:894
msgid "HOURS(time)"
msgstr "HOURS(уақыт)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 393
#: xml_doc.cpp:897
msgid "HOURS(\"10:5:2\") returns 10"
msgstr "HOURS(\"10:5:2\") қайтаратыны 10"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 405
#: xml_doc.cpp:903
msgid "The function ISLEAPYEAR() returns True if the given year is leap."
msgstr "Келтірілген жыл кібісе болса ISLEAPYEAR() қайтаратыны True."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 406
#: xml_doc.cpp:906
msgid "ISLEAPYEAR(year)"
msgstr "ISLEAPYEAR(жыл)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 407
#: xml_doc.cpp:909
msgid "ISLEAPYEAR(2000) returns True"
msgstr "ISLEAPYEAR(2000) қайтаратыны True"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 423
#: xml_doc.cpp:918
msgid ""
"The function DAYSINMONTH() returns number of days in the given year and "
"month."
msgstr ""
"DAYSINMONTH() функциясы келтірілген жылдағы айының күндер санын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 424
#: xml_doc.cpp:921
msgid "DAYSINMONTH(year;month)"
msgstr "DAYSINMONTH(жыл;ай)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 425
#: xml_doc.cpp:924
msgid "DAYSINMONTH(2000;2) returns 29"
msgstr "DAYSINMONTH(2000;2) қайтаратыны 29"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 437
#: xml_doc.cpp:930
msgid "The function DAYSINYEAR() returns the number of days in the given year."
msgstr "DAYSINYEAR() функциясы келтірілген жылдағы күндер санын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 438
#: xml_doc.cpp:933
msgid "DAYSINYEAR(year)"
msgstr "DAYSINYEAR(жыл)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 439
#: xml_doc.cpp:936
msgid "DAYSINYEAR(2000) returns 366"
msgstr "DAYSINYEAR(2000) қайтаратыны 366"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 451
#: xml_doc.cpp:942
msgid ""
"The function WEEKSINYEAR() returns the number of weeks in the given year."
msgstr "WEEKSINYEAR() функциясы келтірілген жылдағы апталар санын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 452
#: xml_doc.cpp:945
msgid "WEEKSINYEAR(year)"
msgstr "WEEKSINYEAR(жыл)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 453
#: xml_doc.cpp:948
msgid "WEEKSINYEAR(2000) returns 52"
msgstr "WEEKSINYEAR(2000) қайтаратыны 52"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 465
#: xml_doc.cpp:954
msgid ""
"The MINUTES() function returns the value of the minutes in a time expression."
msgstr "MINUTES() функциясы уақыт өрнегіндегі минут санын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 466
#: xml_doc.cpp:957
msgid "MINUTES(time)"
msgstr "MINUTES(уақыт)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 467
#: xml_doc.cpp:960
msgid "MINUTES(\"10:5:2\") returns 5"
msgstr "MINUTES(\"10:5:2\") қайтаратыны 5"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 479
#: xml_doc.cpp:966
msgid ""
"The SECONDS() function returns the value of the seconds in a time expression."
msgstr "SECONDS() функциясы уақыт өрнегіндегі секунд санын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 480
#: xml_doc.cpp:969
msgid "SECONDS(time)"
msgstr "SECONDS(уақыт)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 481
#: xml_doc.cpp:972
msgid "SECONDS(\"10:5:2\") returns 2"
msgstr "SECONDS(\"10:5:2\") қайтаратыны 2"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 489
#: xml_doc.cpp:975
msgid "Number of day in week (1..7)"
msgstr "Күннің аптадағы нөмірі (1..7)"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 493
#: xml_doc.cpp:978
msgid ""
"The DAYNAME() function returns the name of the day of the week (1..7). In "
"some countries the first day of the week is Monday, while in others the "
"first day of the week is Sunday."
msgstr ""
"DAYNAME() функциясы келтірілген күннің аптадағы нөміріне (1..7) сәйкесті "
"күннің атауын қайтарады. Кейбір елдерде аптаның бірінші күні Дүйсенбі, "
"кейбірлерде - Жексенбі."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 494
#: xml_doc.cpp:981
msgid "DAYNAME(weekday)"
msgstr "DAYNAME(апта_күні)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 495
#: xml_doc.cpp:984
msgid "DAYNAME(1) returns Monday (if the week starts on Monday)"
msgstr "DAYNAME(1) қайтаратыны Дүйсенбі (апта Дүйенбіден басталатын болса)"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 504
#: xml_doc.cpp:987
msgid "Number of month (1..12)"
msgstr "Айдың нөмірі (1..12)"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 508
#: xml_doc.cpp:990
msgid "The MONTHNAME() function returns the name of the month (1...12)."
msgstr ""
"MONTHNAME() функциясы келтірілген айдың нөміріне (1...12) сәйкесті ай атауын "
"қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 509
#: xml_doc.cpp:993
msgid "MONTHNAME(number)"
msgstr "MONTHNAME(нөмір)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 510
#: xml_doc.cpp:996
msgid "MONTHNAME(5) returns May"
msgstr "MONTHNAME(5) қайтаратыны Мамыр"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 518
#: xml_doc.cpp:999
msgid ""
"The CURRENTDATE() function returns the current date. It is equivalent to the "
"TODAY function."
msgstr ""
"CURRENTDATE() функциясы бүгінгі күнді қайтарады. Бұл TODAY функциясының "
"баламасы."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 519
#: xml_doc.cpp:1002
msgid "CURRENTDATE()"
msgstr "CURRENTDATE()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 520
#: xml_doc.cpp:1005
msgid "CURRENTDATE() returns \"Saturday 13 April 2002\""
msgstr "CURRENTDATE() қайтаратыны \"24.11.2007\""

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 530
#: xml_doc.cpp:1008
msgid "The TODAY() function returns the current date."
msgstr "TODAY() функциясы бүгінгі күнді қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 531
#: xml_doc.cpp:1011
msgid "TODAY()"
msgstr "TODAY()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 532
#: xml_doc.cpp:1014
msgid "TODAY() returns \"Saturday 13 April 2002\""
msgstr "TODAY() қайтаратыны \"24.11.2007\""

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 542
#: xml_doc.cpp:1017
msgid ""
"The NOW() function returns the current date and time. It is identical with "
"CURRENTDATETIME and provided for compatibility with other applications."
msgstr ""
"NOW() функциясы қазіргі күнді мен уақытты қайтарады. Бұл CURRENTDATETIME "
"функциясымен бірдей, басқа қолданбалармен үйлесімділік болсын деп енгізілген."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 543
#: xml_doc.cpp:1020
msgid "NOW()"
msgstr "NOW()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 544
#: xml_doc.cpp:1023
msgid "NOW() returns \"Saturday 13 April 2002 19:12:01\""
msgstr "NOW() қайтаратыны \"Сенбі 24 Қараша 2007 19:12:01\""

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 554
#: xml_doc.cpp:1026
msgid "The CURRENTDATETIME() function returns the current date and time."
msgstr "CURRENTDATETIME() функциясы қазіргі күн мен уақытты қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 555
#: xml_doc.cpp:1029
msgid "CURRENTDATETIME()"
msgstr "CURRENTDATETIME()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 556
#: xml_doc.cpp:1032
msgid "CURRENTDATETIME() returns \"Saturday 13 April 2002 19:12:01\""
msgstr "CURRENTDATETIME() қайтаратыны \"Сенбі 24 Қараша 2007 19:12:01\""

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 564
#: xml_doc.cpp:1035
msgid ""
"The CURRENTTIME() function returns the current time formatted with local "
"parameters."
msgstr ""
"CURRENTTIME() функциясы жергілікті пішіміндегі қазіргі уақытты қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 565
#: xml_doc.cpp:1038
msgid "CURRENTTIME()"
msgstr "CURRENTTIME()"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 566
#: xml_doc.cpp:1041
msgid "CURRENTTIME() returns \"19:12:01\""
msgstr "CURRENTTIME() қайтаратыны \"19:12:01\""

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 578
#: xml_doc.cpp:1047
msgid ""
"The EASTERSUNDAY() function returns the date which corresponds to Easter "
"Sunday in the year given as the parameter."
msgstr ""
"EASTERSUNDAY() функциясы көрсетілген жылдағы (католик) Пасха мейрамы келетін "
"күнін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 579
#: xml_doc.cpp:1050
msgid "EASTERSUNDAY(year)"
msgstr "EASTERSUNDAY(жыл)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 580
#: xml_doc.cpp:1053
msgid "EASTERSUNDAY(2003) returns \"20th April 2003\""
msgstr "EASTERSUNDAY(2007) қайтаратыны \"07.04.2007\""

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 592
#: xml_doc.cpp:1059
msgid ""
"The ISOWEEKNUM() function returns number of the week which the date falls "
"into. Note that this function is compliant with the ISO8601 standard: a week "
"always begins on a Monday, and ends on a Sunday. The first week of a year is "
"that week which contains the first Thursday of the year."
msgstr ""
"ISOWEEKNUM() функциясы келтірілген күннің аптасының нөмірін қайтарады. Бұл "
"функция ISO8601 стандартына бағынады: апта Дүйсенбіден басталып Жексенбімен "
"аяқталады. Жылдың бірінші аптасы деп бірінші Бейсенбісі бар аптасы "
"есептеледі."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 593
#: xml_doc.cpp:1062
msgid "ISOWEEKNUM(date)"
msgstr "ISOWEEKNUM(күн)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 594
#: xml_doc.cpp:1065
msgid "ISOWEEKNUM(A1) returns 51 when A1 is \"21st of Dec\"."
msgstr "ISOWEEKNUM(A1) қайтаратыны 47 егер A1 ұяшығында \"24.11.2007\" болса."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 611
#: xml_doc.cpp:1074
msgid ""
"The WEEKNUM() function returns the non-ISO week number in which the date "
"falls into."
msgstr ""
"WEEKNUM() функциясы келтірілген күннің аптасының (ISO-стандартты емес) "
"нөмірін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 612
#: xml_doc.cpp:1077
msgid "WEEKNUM(date; method)"
msgstr "WEEKNUM(күн; тәсіл)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 613
#: xml_doc.cpp:1080
msgid ""
"WEEKNUM(A1; 1) returns 11 when A1 is \"9th of March 2008\". Number of the "
"week in the year, with a week beginning on Sunday (11)"
msgstr ""
"WEEKNUM(A1; 1) қайтаратыны 11, егер A1 ұяшығында \"09.03.2008\" деп тұрса. "
"11 - жексенбіден басталатын жылдың апта нөмірі"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 614
#: xml_doc.cpp:1083
msgid ""
"WEEKNUM(A1; 2) returns 10 when A1 is \"9th of March 2008\". Number of the "
"week in the year, with a week beginning on Monday (10)"
msgstr ""
"WEEKNUM(A1; 2) қайтаратыны 10, егер A1 ұяшығында \"09.03.2008\" деп тұрса. "
"10 - дүйсенбіден басталатын жылдың апта нөмірі"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 623
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 647
#: xml_doc.cpp:1086 xml_doc.cpp:1110
msgid "First date"
msgstr "Бірінші күн"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 627
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 651
#: xml_doc.cpp:1089 xml_doc.cpp:1113
msgid "Second date"
msgstr "Екінші күн"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 631
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 655
#: xml_doc.cpp:1092 xml_doc.cpp:1116
msgid "interval"
msgstr "аралық"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 635
#: xml_doc.cpp:1095
msgid "The DATEDIF() function returns the difference between two dates."
msgstr "DATEDIF() функциясы екі күн аралығын қайтарады."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 636
#: xml_doc.cpp:1098
msgid ""
"Interval must be one of the following: \"m\": month; \"d\": days; \"y\": "
"complete years; \"ym\": month excluding years; \"yd\": days excluding years; "
"\"md\": days excluding months and years"
msgstr ""
"Аралық дегені келесінің бірі болу керек: \"m\": айлар; \"d\": күндер; \"y\": "
"толық жылдар; \"ym\": айларсыз жылдар; \"yd\": күндерсіз жылдар; \"md\": "
"күндерсіз айлар мен жылдар"

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 637
#: xml_doc.cpp:1101
msgid "DATEDIF(first date; second date; interval)"
msgstr "DATEDIF(күн1; күн2; аралық)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 638
#: xml_doc.cpp:1104
msgid ""
"DATEDIF(A1;A2;\"d\") A1 is \"1st of January 1995\" and A2 is \"15th of June "
"1999\" returns number of days 1626"
msgstr ""
"DATEDIF(A1;A2;\"d\"), A1 ұяшығында \"1 қантар 1995\" және A2 ұяшығында \"15 "
"маусым 1999\" болса, қайтаратыны күндер саны 1626"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 639
#: xml_doc.cpp:1107
msgid ""
"DATEDIF(A1;A2;\"m\") A1 is \"1st of January 1995\" and A2 is \"15th of June "
"1999\" returns number of weeks 53"
msgstr ""
"DATEDIF(A1;A2;\"m\"), A1 ұяшығында \"1 қантар 1995\" және A2 ұяшығында \"15 "
"маусым 1999\" болса, қайтаратыны апталар саны 53"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 659
#: xml_doc.cpp:1119
msgid ""
"The YEARFRAC() function returns the number of full days between start date "
"and end date according to the basis."
msgstr ""
"YEARFRAC() функциясы негіз параметріне жүгініп екі күннің арасындағы толық "
"күндер санын есептейді."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 660
#: xml_doc.cpp:1122
msgid ""
"Basis must be one of the following: 0 = 30/360 US, 1 = Actual/actual, 2 = "
"Actual/360, 3 = Actual/365, 4 = European 30/360"
msgstr ""
"Негіз дегені келесінің бірі болу керек: 0 = 30/360 АҚШ, 1 = Шындықтағы/"
"шындықтағы, 2 = Шындықтағы/360, 3 = Шындықтағы/365, 4 = 30/360 Еуропа"

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 661
#: xml_doc.cpp:1125
msgid "YEARFRAC(start date; endd date; basis)"
msgstr "YEARFRAC(бастапқы_күн; соңғы_күн; негіз)"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 669
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 692
#: xml_doc.cpp:1128 xml_doc.cpp:1149
msgid "Start date"
msgstr "Бастапқы күн"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 673
#: xml_doc.cpp:1131
msgid "Working days"
msgstr "Жұмыс күндері"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 677
#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 700
#: xml_doc.cpp:1134 xml_doc.cpp:1155
msgid "Holidays"
msgstr "Демалыстар"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 681
#: xml_doc.cpp:1137
msgid ""
"The WORKDAY() function returns the date which is working days from the start "
"date."
msgstr ""
"WORKDAY() функциясы келтірілген күннен бастап көрсетілген күндер "
"аралығындағы жұмыс күндерін қайтарады."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 682
#. i18n: tag Text
#. i18n: file functions/datetime.xml line 705
#: xml_doc.cpp:1140 xml_doc.cpp:1161
msgid ""
"Holidays must be one of the following: number = days to add, a single date "
"or an array of dates."
msgstr ""
"Демалыстар деген параметрі келесінің бірі: сан = қосылатын күндер, нақты бір "
"күн, күндер жиымы."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 683
#: xml_doc.cpp:1143
msgid "WORKDAY(start date; days; holidays)"
msgstr "WORKDAY(бастапқы_күн; күндер; демалыстар)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 684
#: xml_doc.cpp:1146
msgid ""
"WORKDAY(B9;2;D3:E4) B9 is \"01/01/2001\", D3 is \"01/03/2001\", D4 is "
"\"01/04/2003\" workday returns \"Fri Jan 5 2001\""
msgstr ""
"WORKDAY(B9;2;D3:E4) B9 ұяшығында \"01.01.2001\", D3 ұяшығында \"03.01.2001"
"\", D4 ұяшығында \"04.01.2003\" болса қайтаратын жұмыс күні \"05.01.2001\""

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 696
#: xml_doc.cpp:1152
msgid "End date"
msgstr "Соңғы күн"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 704
#: xml_doc.cpp:1158
msgid ""
"The NETWORKDAY() function returns the number of working days between "
"startdate and enddate."
msgstr ""
"NETWORKDAY() функциясы екі күннің арасындағы жұмыс күндер санын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 706
#: xml_doc.cpp:1164
msgid "NETWORKDAY(start date; end date; holidays)"
msgstr "NETWORKDAY(күн1; күн2; демалыстар)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 707
#: xml_doc.cpp:1167
msgid "NETWORKDAY(\"01/01/2001\";\"01/08/2001\") returns 5 workdays"
msgstr "NETWORKDAY(\"01.01.2001\";\"08.01.2001\") кайтаратыны 5 жұмыс күн"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 708
#: xml_doc.cpp:1170
msgid "NETWORKDAY(\"01/01/2001\";\"01/08/2001\";2) returns 3 workdays"
msgstr "NETWORKDAY(\"01.01.2001\";\"08.01.2001\";2) кайтаратыны 3 жұмыс күн"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 720
#: xml_doc.cpp:1176
msgid "DATE2UNIX() function converts a date and time value to unix time."
msgstr "DATE2UNIX() функциясы күн мен уақытын UNIX уақытына аударады."

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 721
#. i18n: tag Text
#. i18n: file functions/datetime.xml line 736
#: xml_doc.cpp:1179 xml_doc.cpp:1194
msgid "A unix time is the number of seconds after midnight January 1st, 1970."
msgstr "UNIX уақыты деген 1970 жылғы 1 қантар басынан өткен секундтар саны."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 722
#: xml_doc.cpp:1182
msgid "DATE2UNIX(date)"
msgstr "DATE2UNIX(күн)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 723
#: xml_doc.cpp:1185
msgid "DATE2UNIX(\"01/01/2000\") returns 946,681,200"
msgstr "DATE2UNIX(\"01.01.2001\") қайтаратыны 946 681 200"

#. i18n: tag Comment
#. i18n: file functions/datetime.xml line 731
#: xml_doc.cpp:1188
msgid "Unixtime"
msgstr "Unix_уақыты"

#. i18n: tag Text
#. i18n: file functions/datetime.xml line 735
#: xml_doc.cpp:1191
msgid "UNIX2DATE() function converts unix time to a date and time value."
msgstr "UNIX2DATE() функциясы unix уақытын кәдімгі күн мен уақытына аударады."

#. i18n: tag Syntax
#. i18n: file functions/datetime.xml line 737
#: xml_doc.cpp:1197
msgid "UNIX2DATE(unixtime)"
msgstr "UNIX2DATE(unix_уақыты)"

#. i18n: tag Example
#. i18n: file functions/datetime.xml line 738
#: xml_doc.cpp:1200
msgid "UNIX2DATE(0) returns 1970-01-01"
msgstr "UNIX2DATE(0) қайтаратыны 01.01.1970"

#. i18n: tag GroupName
#. i18n: file functions/engineering.xml line 5
#: xml_doc.cpp:1203
msgid "Engineering"
msgstr "Инженерлік"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 15
#. i18n: tag Comment
#. i18n: file functions/math.xml line 706
#: xml_doc.cpp:1209 xml_doc.cpp:4279
msgid "Base"
msgstr "Негізі"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 19
#: xml_doc.cpp:1212
msgid "MinLength"
msgstr "МинҰзындығы"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 23
#: xml_doc.cpp:1215
msgid ""
"The BASE() function converts a number from base-10 to a string value in a "
"target base from 2 to 36."
msgstr ""
"BASE() функциясы 10-негізді санды негізі 2-ден 36-ға дейінгі санның таңбалар "
"жолына аударады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 24
#: xml_doc.cpp:1218
msgid "BASE(number;base;prec)"
msgstr "BASE(сан;негізі;дәлділігі)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 25
#: xml_doc.cpp:1221
msgid "BASE(128;8) returns \"200\""
msgstr "BASE(128;8) қайтаратыны \"200\""

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 33
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 54
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 75
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 96
#: xml_doc.cpp:1224 xml_doc.cpp:1239 xml_doc.cpp:1254 xml_doc.cpp:1269
msgid "Where the function is evaluated"
msgstr "Функцияның аргументі"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 37
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 58
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 79
