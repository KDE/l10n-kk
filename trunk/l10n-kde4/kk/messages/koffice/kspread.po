msgstr "POISSON(сан;лямбда;жинақтау)"

#. i18n: file: functions/statistical.xml:980
#: xml_doc.cpp:3948
msgid "POISSON(60;50;0) equals 0.020105"
msgstr "POISSON(60;50;0) нәтижесі 0,020105"

#. i18n: file: functions/statistical.xml:981
#: xml_doc.cpp:3950
msgid "POISSON(60;50;1) equals 0.927840"
msgstr "POISSON(60;50;1) нәтижесі 0,927840"

#. i18n: file: functions/statistical.xml:993
#: xml_doc.cpp:3954
msgid "Data (array)"
msgstr "Деректер (жиым)"

#. i18n: file: functions/statistical.xml:997
#: xml_doc.cpp:3956
msgid "Order"
msgstr "Алатын орны"

#. i18n: file: functions/statistical.xml:1001
#: xml_doc.cpp:3958
msgid "The RANK() function returns the rank of a number in a list of numbers."
msgstr ""
"RANK() функциясы көрсетілген санның тізімінде үлкен-кішілігін салыстырғанда "
"алатын орнын қайтарады."

#. i18n: file: functions/statistical.xml:1002
#: xml_doc.cpp:3960
msgid "Order specifies how to rank the numbers:"
msgstr "Орның табу тәртібі:"

#. i18n: file: functions/statistical.xml:1003
#: xml_doc.cpp:3962
msgid "If 0 or omitted, Data is ranked in descending order."
msgstr "Егер 0 немесе келтірілмегенде, кему ретіндегі орны табылады."

#. i18n: file: functions/statistical.xml:1004
#: xml_doc.cpp:3964
msgid "If not 0, Data is ranked in descending order."
msgstr "Егер 0 емес болса, өсу ретіндегі орны табылады."

#. i18n: file: functions/statistical.xml:1005
#: xml_doc.cpp:3966
msgid "RSQ(Value; Data; Order)"
msgstr "RANK(сан; Деректер; Тәртібі)"

#. i18n: file: functions/statistical.xml:1006
#: xml_doc.cpp:3968
msgid "RANK (2;{1;2;3}) equals 2"
msgstr "RANK (2;{1;2;3}) нәтижесі 2"

#. i18n: file: functions/statistical.xml:1014
#: xml_doc.cpp:3970
msgid "known Y (array)"
msgstr "Мәлім Y (жиымы)"

#. i18n: file: functions/statistical.xml:1018
#: xml_doc.cpp:3972
msgid "known X (array)"
msgstr "Мәлім X (жиымы)"

#. i18n: file: functions/statistical.xml:1022
#: xml_doc.cpp:3974
msgid ""
"The RSQ() function returns the square of the Pearson product moment "
"correlation coefficient through data points in known_y's and known_x's."
msgstr ""
"RSQ() функциясы белгілі y пен x-тер негзінде Пирсон көбейтіндісі моментінің "
"корреляция коэфициентінің квадратын қайтарады."

#. i18n: file: functions/statistical.xml:1023
#: xml_doc.cpp:3976
msgid ""
"If \"arrayY\" and \"arrayX\" are empty or have a different number of data "
"points, then #N/A is returned."
msgstr ""
"Егер Y және X жиымдары бос не олардың ұзындығы келіспейтін болса - "
"қайтарылатыны #А/Ж белгісі."

#. i18n: file: functions/statistical.xml:1024
#: xml_doc.cpp:3978
msgid "RSQ(known Y; known X)"
msgstr "RSQ(Y; X)"

#. i18n: file: functions/statistical.xml:1048
#: xml_doc.cpp:3988
msgid "The SKEW() function returns an estimate for skewness of a distribution"
msgstr "SKEW() функциясы үлестірімнің ассиметриясын бағалап береді"

#. i18n: file: functions/statistical.xml:1049
#: xml_doc.cpp:3990
msgid "SKEW(number; number2; ...)"
msgstr "SKEW(сан; сан2; ...)"

#. i18n: file: functions/statistical.xml:1050
#: xml_doc.cpp:3992
msgid "SKEW(range)"
msgstr "SKEW(ауқым)"

#. i18n: file: functions/statistical.xml:1051
#: xml_doc.cpp:3994
msgid "SKEW(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.9768"
msgstr "SKEW(11,4; 17,3; 21,3; 25,9; 40,1) қайтаратыны 0,9768"

#. i18n: file: functions/statistical.xml:1076
#: xml_doc.cpp:4004
msgid "The SKEWP() function returns the population skewness of a distribution"
msgstr ""
"SKEWP() функциясы жиынтығы бойынша үлестірімінің ассиметриясын есептеп береді"

#. i18n: file: functions/statistical.xml:1077
#: xml_doc.cpp:4006
msgid "SKEWP(number; number2; ...)"
msgstr "SKEWP(сан; сан2; ...)"

#. i18n: file: functions/statistical.xml:1078
#: xml_doc.cpp:4008
msgid "SKEWP(range)"
msgstr "SKEWP(ауқым)"

#. i18n: file: functions/statistical.xml:1079
#: xml_doc.cpp:4010
msgid "SKEWP(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.6552"
msgstr "SKEWP(11,4; 17,3; 21,3; 25,9; 40,1) қайтаратыны 0,6552"

#. i18n: file: functions/statistical.xml:1096
#: xml_doc.cpp:4016
msgid ""
"The SLOPE() function calculates the slope of the linear regression line."
msgstr ""
"SLOPE() функциясы сызықты регрессия түзуінің көлбеулігін есептеп береді."

#. i18n: file: functions/statistical.xml:1097
#. i18n: file: functions/statistical.xml:1283
#: xml_doc.cpp:4018 xml_doc.cpp:4118
msgid "SLOPE(y;x)"
msgstr "SLOPE(y;x)"

#. i18n: file: functions/statistical.xml:1109
#: xml_doc.cpp:4022
msgid "Position (from the smallest)"
msgstr "Орны (кішісінен бастап)"

#. i18n: file: functions/statistical.xml:1113
#: xml_doc.cpp:4024
msgid "The SMALL() function returns the k-th smallest value from the data set."
msgstr "SMALL() функциясы ауқымынан k-ші ең кіші мәнін тауып береді."

#. i18n: file: functions/statistical.xml:1114
#: xml_doc.cpp:4026
msgid "SMALL(range; k)"
msgstr "SMALL(ауқым; k)"

#. i18n: file: functions/statistical.xml:1115
#: xml_doc.cpp:4028
msgid "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) returns 1"
msgstr "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) қайтаратыны 1"

#. i18n: file: functions/statistical.xml:1123
#: xml_doc.cpp:4030
msgid "Number to be normalized"
msgstr "Нормалайтын сан"

#. i18n: file: functions/statistical.xml:1127
#: xml_doc.cpp:4032
msgid "Mean of the distribution"
msgstr "Үлестірімінің орташасы"

#. i18n: file: functions/statistical.xml:1131
#: xml_doc.cpp:4034
msgid "Standard deviation"
msgstr "Стандартты ауытқу"

#. i18n: file: functions/statistical.xml:1135
#: xml_doc.cpp:4036
msgid "The STANDARDIZE() function calculates a normalized value."
msgstr "STANDARDIZE() функциясы нормаланған мәнін есептеп береді."

#. i18n: file: functions/statistical.xml:1136
#: xml_doc.cpp:4038
msgid "STANDARDIZE(x; mean, stdev)"
msgstr "STANDARDIZE(x; орта, ст_ауыт)"

#. i18n: file: functions/statistical.xml:1137
#: xml_doc.cpp:4040
msgid "STANDARDIZE(4; 3; 7) returns 0.1429"
msgstr "STANDARDIZE(4; 3; 7) қайтаратыны 0,1429"

#. i18n: file: functions/statistical.xml:1165
#: xml_doc.cpp:4052
msgid ""
"The STDEV() function returns the estimate standard deviation based on a "
"sample. The standard deviation is a measure of how widely values are "
"dispersed from the average value."
msgstr ""
"STDEV() функциясы таңдаманың стандартты ауытқуын бағалап береді. Стандартты "
"ауытқу деген мәндер орташасынан қай шамада шашылғанының өлшемі."

#. i18n: file: functions/statistical.xml:1166
#: xml_doc.cpp:4054
msgid "STDEV(value;value;...)"
msgstr "STDEV(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1167
#: xml_doc.cpp:4056
msgid "STDEV(6;7;8) equals 1"
msgstr "STDEV(6;7;8) нәтижесі 1"

#. i18n: file: functions/statistical.xml:1196
#: xml_doc.cpp:4068
msgid ""
"The STDEVA() function returns the estimate standard deviation based on a "
"sample. The standard deviation is a measure of how widely values are "
"dispersed from the average value. If a referenced cell contains text or "
"contains the boolean value FALSE, it is counted as 0. If the boolean value "
"is TRUE it is counted as 1."
msgstr ""
"STDEVA() функциясы таңдаманың стандартты ауытқуын бағалап береді. Стандартты "
"ауытқу деген мәндер орташасынан қай шамада шашылғанын өлшемі. Таңдаманың "
"арасында мәтін не логикалық FALSE мәні кезессе, ол 0 деп есептеледі, "
"логикалық TRUE кезессе, 1 деп есептеледі."

#. i18n: file: functions/statistical.xml:1197
#: xml_doc.cpp:4070
msgid "STDEVA(value;value;...)"
msgstr "STDEVA(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1198
#: xml_doc.cpp:4072
msgid "STDEVA(6; 7; A1; 8) equals 1, if A1 is empty"
msgstr "STDEVA(6; 7; A1; 8), егер A1 бос болса, нәтижесі 1, "

#. i18n: file: functions/statistical.xml:1199
#: xml_doc.cpp:4074
msgid "STDEVA(6; 7; A1; 8) equals 3.109, if A1 is TRUE"
msgstr "STDEVA(6; 7; A1; 8), егер A1 ұяшығында TRUE болса, нәтижесі 3,109"

#. i18n: file: functions/statistical.xml:1229
#: xml_doc.cpp:4086
msgid ""
"The STDEVP() function returns the standard deviation based on an entire "
"population"
msgstr ""
"STDEVP() функциясы толық жиынтығының стандартты ауытқуын бағалап береді"

#. i18n: file: functions/statistical.xml:1230
#: xml_doc.cpp:4088
msgid "STDEVP(value;value;...)"
msgstr "STDEVP(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1231
#: xml_doc.cpp:4090
msgid "STDEVP(6;7;8) equals 0.816497..."
msgstr "STDEVP(6;7;8) нәтижесі 0,816497..."

#. i18n: file: functions/statistical.xml:1260
#: xml_doc.cpp:4102
msgid ""
"The STDEVPA() function returns standard deviation based on an entire "
"population. If a referenced cell contains text or contains the boolean value "
"FALSE, it is counted as 0. If the boolean value is TRUE it is counted as 1."
msgstr ""
"STDEVPA() функциясы толық жиынтығының стандартты ауытқуын бағалап береді. "
"Стандартты ауытқу деген мәндер орташасынан қай шамада шашылғанының өлшемі. "
"Жиынтығының арасында мәтін не логикалық FALSE мәні кезессе, ол 0 деп "
"есептеледі, логикалық TRUE кезессе, 1 деп есептеледі."

#. i18n: file: functions/statistical.xml:1261
#: xml_doc.cpp:4104
msgid "STDEVPA(value;value;...)"
msgstr "STDEVPA(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1262
#: xml_doc.cpp:4106
msgid "STDEVPA(6; 7; A1; 8) equals 0.816497..., if A1 is empty"
msgstr "STDEVPA(6; 7; A1; 8), егер A1 бос болса, нәтижесі 0,816497"

#. i18n: file: functions/statistical.xml:1263
#: xml_doc.cpp:4108
msgid "STDEVPA(6; 7; A1; 8) equals 2.69..., if A1 is TRUE"
msgstr "STDEVPA(6; 7; A1; 8), егер A1 ұяшығында TRUE болса, нәтижесі 2,69"

#. i18n: file: functions/statistical.xml:1264
#: xml_doc.cpp:4110
msgid "STDEVPA(6; 7; A1; 8) equals 3.11..., if A1 is FALSE"
msgstr "STDEVPA(6; 7; A1; 8), егер A1 ұяшығында FALSE болса, нәтижесі 3,11"

#. i18n: file: functions/statistical.xml:1282
#: xml_doc.cpp:4116
msgid ""
"The STEYX() function calculates the standard error of the predicted y value "
"for each x in the regression."
msgstr ""
"STEYX() функциясы әрбір x-ке сәйкесті y- регрессиясы бойынша болжаған мәннің "
"стандартты қатесін есептеп береді."

#. i18n: file: functions/statistical.xml:1296
#. i18n: file: functions/statistical.xml:1300
#. i18n: file: functions/statistical.xml:1314
#. i18n: file: functions/statistical.xml:1318
#. i18n: file: functions/statistical.xml:1332
#. i18n: file: functions/statistical.xml:1336
#. i18n: file: functions/statistical.xml:1737
#. i18n: file: functions/statistical.xml:1741
#: xml_doc.cpp:4120 xml_doc.cpp:4122 xml_doc.cpp:4130 xml_doc.cpp:4132
#: xml_doc.cpp:4140 xml_doc.cpp:4142 xml_doc.cpp:4350 xml_doc.cpp:4352
msgid "Value (array)"
msgstr "Жиым"

#. i18n: file: functions/statistical.xml:1304
#: xml_doc.cpp:4124
msgid ""
"The SUMPRODUCT() function (SUM(X*Y)) returns the sum of the product of these "
"values. The number of values in the two arrays should be equal. Otherwise "
"this function returns Err."
msgstr ""
"SUMPRODUCT() функциясы (SUM(X*Y)) тапсырылған мәндерінің бір-біріне көбейту "
"нәтижелерінің қосындысын есептеп береді. Екі жиымының ұзындықтары бірдей "
"болуға тиіс. Әйтпесе, қате белгісі қайтарылады."

#. i18n: file: functions/statistical.xml:1305
#: xml_doc.cpp:4126
msgid "SUMPRODUCT(array1;array2)"
msgstr "SUMPRODUCT(жиым1;жиым2)"

#. i18n: file: functions/statistical.xml:1306
#: xml_doc.cpp:4128
msgid "SUMPRODUCT(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 31"
msgstr ""
"SUMPRODUCT(A1:A2;B1:B2), егерде A1=2, A2=5, B1=3, B2=5 болса, қайтаратыны 31"

#. i18n: file: functions/statistical.xml:1322
#: xml_doc.cpp:4134
msgid ""
"The SUMX2PY2() function (SUM(X^2+Y^2)) returns the sum of the squares of "
"these values. The number of values in the two arrays should be equal. "
"Otherwise this function returns Err."
msgstr ""
"SUMX2PY2() функциясы (SUM(X^2+Y^2)) тапсырылған мәндерінің квадраттарының "
"қосындысын есептеп береді. Екі жиымының ұзындықтары бірдей болуға тиіс. "
"Әйтпесе, қате белгісі қайтарылады."

#. i18n: file: functions/statistical.xml:1323
#: xml_doc.cpp:4136
msgid "SUMX2PY2(array1;array2)"
msgstr "SUMX2PY2(жиым1;жиым2)"

#. i18n: file: functions/statistical.xml:1324
#: xml_doc.cpp:4138
msgid "SUMX2PY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 63"
msgstr ""
"SUMX2PY2(A1:A2;B1:B2), егерде A1=2, A2=5, B1=3, B2=5 болса, қайтаратыны 63"

#. i18n: file: functions/statistical.xml:1340
#: xml_doc.cpp:4144
msgid ""
"The SUMX2MY2() function (SUM(X^2-Y^2)) returns the difference of the squares "
"of these values. The number of values in the two arrays should be equal. "
"Otherwise this function returns Err."
msgstr ""
"SUMX2MY2() функциясы (SUM(X^2-Y^2)) тапсырылған мәндерінің квадраттарының "
"айырымын есептеп береді. Екі жиымының ұзындықтары бірдей болуға тиіс. "
"Әйтпесе, қате белгісі қайтарылады."

#. i18n: file: functions/statistical.xml:1341
#: xml_doc.cpp:4146
msgid "SUMX2MY2(array1;array2)"
msgstr "SUMX2MY2(жиым1;жиым2)"

#. i18n: file: functions/statistical.xml:1342
#: xml_doc.cpp:4148
msgid "SUMX2MY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns -5"
msgstr ""
"SUMX2MY2(A1:A2;B1:B2), егерде A1=2, A2=5, B1=3, B2=5 болса, қайтаратыны -5"

#. i18n: file: functions/statistical.xml:1354
#: xml_doc.cpp:4152
msgid "Degrees of freedom for the t-distribution"
msgstr "t-үлестірімінің еркіндік дәрежесі"

#. i18n: file: functions/statistical.xml:1358
#: xml_doc.cpp:4154
msgid "Mode (1 or 2)"
msgstr "Режімі (1 не 2)"

#. i18n: file: functions/statistical.xml:1362
#: xml_doc.cpp:4156
msgid "The TDIST() function returns the t-distribution."
msgstr "TDIST() функциясы t-үлестірімін қайтарады."

#. i18n: file: functions/statistical.xml:1363
#: xml_doc.cpp:4158
msgid ""
"Mode = 1 returns the one-tailed test, Mode = 2 returns the two-tailed test."
msgstr ""
"Режімі = 1 болса, біржақты үлестірім, Режімі = 2 болса, екіжақты үлестірім "
"шығады."

#. i18n: file: functions/statistical.xml:1364
#: xml_doc.cpp:4160
msgid "TDIST(number;degrees_freedom;mode)"
msgstr "TDIST(саны;еркін_дәреж;режімі)"

#. i18n: file: functions/statistical.xml:1365
#: xml_doc.cpp:4162
msgid "TDIST(12;5;1) returns 0.000035"
msgstr "TDIST(12;5;1) қайтаратыны 0,000035"

#. i18n: file: functions/statistical.xml:1373
#: xml_doc.cpp:4164
msgid "KnownY"
msgstr "МәлімY"

#. i18n: file: functions/statistical.xml:1377
#: xml_doc.cpp:4166
msgid "KnownX"
msgstr "МәлімX"

#. i18n: file: functions/statistical.xml:1381
#: xml_doc.cpp:4168
msgid "NumberSequence newX"
msgstr "ЖаңаX тізбегі"

#. i18n: file: functions/statistical.xml:1385
#: xml_doc.cpp:4170
msgid "allowOffset"
msgstr "ШегінісРұқсатты"

#. i18n: file: functions/statistical.xml:1389
#: xml_doc.cpp:4172
msgid ""
"The TREND() function calculates a sequence of values based on a linear "
"regression of known value pairs."
msgstr ""
"TREND() функциясы мәлім x пен y-тердің сызықты регрессиясының негізінде бір "
"қатар нүктелерді есептеп береді."

#. i18n: file: functions/statistical.xml:1390
#: xml_doc.cpp:4174
msgid "Constraints: COUNT(knownY) = COUNT(knownX)."
msgstr "Шарт: COUNT(мәлімY) = COUNT(мәлімX)."

#. i18n: file: functions/statistical.xml:1391
#: xml_doc.cpp:4176
msgid "TREND(knownY[;knownX[;newX[;allowOffset = TRUE]]])"
msgstr "TREND(мәлімY[;мәлімX[;жаңаX[;ШегінісРұқсатты = TRUE]]])"

#. i18n: file: functions/statistical.xml:1402
#: xml_doc.cpp:4178
msgid "dataSet"
msgstr "деректерЖиыны"

#. i18n: file: functions/statistical.xml:1406
#: xml_doc.cpp:4180
msgid "cutOffFraction"
msgstr "алатынБөлігі"

#. i18n: file: functions/statistical.xml:1410
#: xml_doc.cpp:4182
msgid "The TRIMMEAN() function calculates the mean of a data set's fraction."
msgstr ""
"TRIMMEAN() функциясы деректердің бір бөлігінің орташасын есептеп береді."

#. i18n: file: functions/statistical.xml:1411
#: xml_doc.cpp:4184
msgid "TRIMMEAN(dataSet; cutOffFraction)"
msgstr "TRIMMEAN(деректерЖиыны; алатынБөлігі)"

#. i18n: file: functions/statistical.xml:1422
#. i18n: file: functions/statistical.xml:1653
#: xml_doc.cpp:4186 xml_doc.cpp:4318
msgid "x (array)"
msgstr "x (жиым)"

#. i18n: file: functions/statistical.xml:1426
#: xml_doc.cpp:4188
msgid "y (array)"
msgstr "y (жиым)"

#. i18n: file: functions/statistical.xml:1434
#: xml_doc.cpp:4192
msgid "mode"
msgstr "режімі"

#. i18n: file: functions/statistical.xml:1438
#: xml_doc.cpp:4194
msgid "The TTEST() function calculates the probability of a t-test."
msgstr "TTEST() функциясы t-сынағының ықтималдығын есептеп береді."

#. i18n: file: functions/statistical.xml:1439
#: xml_doc.cpp:4196
msgid "TTEST(x; y; type; mode)"
msgstr "TTEST(x; y; түрі; режімі)"

#. i18n: file: functions/statistical.xml:1467
#: xml_doc.cpp:4208
msgid "The VAR() function calculates the estimates variance based on a sample."
msgstr ""
"VAR() функциясы таңдама бойынша бағаланған дисперсиясын есептеп береді."

#. i18n: file: functions/statistical.xml:1468
#: xml_doc.cpp:4210
msgid "VAR(value;value;...)"
msgstr "VAR(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1469
#: xml_doc.cpp:4212
msgid "VAR(12;5;7) equals 13"
msgstr "VAR(12;5;7) нәтижесі 13"

#. i18n: file: functions/statistical.xml:1470
#: xml_doc.cpp:4214
msgid "VAR(15;80;3) equals 1716.333..."
msgstr "VAR(15;80;3) нәтижесі 1716,333..."

#. i18n: file: functions/statistical.xml:1471
#: xml_doc.cpp:4216
msgid "VAR(6;7;8) equals 1"
msgstr "VAR(6;7;8) нәтижесі 1"

#. i18n: file: functions/statistical.xml:1503
#: xml_doc.cpp:4228
msgid "The VARA() function calculates the variance based on a sample."
msgstr "VARA() функциясы таңдама бойынша дисперсиясын есептеп береді."

#. i18n: file: functions/statistical.xml:1504
#: xml_doc.cpp:4230
msgid "VARA(value;value;...)"
msgstr "VARA(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1505
#: xml_doc.cpp:4232
msgid "VARA(12;5;7) equals 13"
msgstr "VARA(12;5;7) нәтижесі 13"

#. i18n: file: functions/statistical.xml:1506
#: xml_doc.cpp:4234
msgid "VARA(15;80;3) equals 1716.333..."
msgstr "VARA(15;80;3) нәтижесі 1716,333..."

#. i18n: file: functions/statistical.xml:1507
#: xml_doc.cpp:4236
msgid "VARA(6;7;8) equals 1"
msgstr "VARA(6;7;8) нәтижесі 1"

#. i18n: file: functions/statistical.xml:1538
#: xml_doc.cpp:4248
msgid ""
"The VARIANCE() function calculates the estimates variance based on a sample. "
"It's the same as the VAR function."
msgstr ""
"VARIANCE() функциясы таңдама бойынша бағаланған дисперсиясын есептеп береді. "
"Бұл VAR функциясымен бірдей."

#. i18n: file: functions/statistical.xml:1539
#: xml_doc.cpp:4250
msgid "VARIANCE(value;value;...)"
msgstr "VARIANCE(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1540
#: xml_doc.cpp:4252
msgid "VARIANCE(12;5;7) equals 13"
msgstr "VARIANCE(12;5;7) нәтижесі 13"

#. i18n: file: functions/statistical.xml:1541
#: xml_doc.cpp:4254
msgid "VARIANCE(15;80;3) equals 1716.333..."
msgstr "VARIANCE(15;80;3) нәтижесі 1716,333..."

#. i18n: file: functions/statistical.xml:1542
#: xml_doc.cpp:4256
msgid "VARIANCE(6;7;8) equals 1"
msgstr "VARIANCE(6;7;8) нәтижесі 1"

#. i18n: file: functions/statistical.xml:1574
#: xml_doc.cpp:4268
msgid ""
"The VARP() function calculates the variance based on an entire population."
msgstr ""
"The VARP() функциясы толық жиынтығы бойынша дисперсиясын есептеп береді."

#. i18n: file: functions/statistical.xml:1575
#: xml_doc.cpp:4270
msgid "VARP(value;value;...)"
msgstr "VARP(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1576
#: xml_doc.cpp:4272
msgid "VARP(12;5;7) equals 8.666..."
msgstr "VARP(12;5;7) нәтижесі 8,666..."

#. i18n: file: functions/statistical.xml:1577
#: xml_doc.cpp:4274
msgid "VARP(15;80;3) equals 1144.22..."
msgstr "VARP(15;80;3) нәтижесі 1144,22..."

#. i18n: file: functions/statistical.xml:1578
#: xml_doc.cpp:4276
msgid "VARP(6;7;8) equals 0.6666667..."
msgstr "VARP(6;7;8) нәтижесі 0,6666667..."

#. i18n: file: functions/statistical.xml:1609
#: xml_doc.cpp:4288
msgid ""
"The VARPA() function calculates the variance based on an entire population. "
"Text and boolean values that evaluate to FALSE are counted as 0, boolean "
"value that evaluate to TRUE are counted as 1."
msgstr ""
"VARPA() функциясы толық жиынтығы бойынша дисперсиясын есептеп береді.Мәтін "
"мен FALSE дегенге келетін логикалық мәндер 0 деп есептеледі, TRUE дегенге "
"келетін логикалық мәндер 1 деп есептеледі."

#. i18n: file: functions/statistical.xml:1610
#: xml_doc.cpp:4290
msgid "VARPA(value;value;...)"
msgstr "VARPA(мән;мән;...)"

#. i18n: file: functions/statistical.xml:1611
#: xml_doc.cpp:4292
msgid "VARPA(12;5;7) equals 8.666..."
msgstr "VARPA(12;5;7) нәтижесі 8,666..."

#. i18n: file: functions/statistical.xml:1612
#: xml_doc.cpp:4294
msgid "VARPA(15;80;3) equals 1144.22..."
msgstr "VARPA(15;80;3) нәтижесі 1144,22..."

#. i18n: file: functions/statistical.xml:1613
#: xml_doc.cpp:4296
msgid "VARPA(6;7;8) equals 0.6666667..."
msgstr "VARPA(6;7;8) нәтижесі 0,6666667..."

#. i18n: file: functions/statistical.xml:1640
#: xml_doc.cpp:4306
msgid "The WEIBULL() function returns the Weibull distribution."
msgstr "WEIBULL() функциясы Вейбулл үлестірімін қайтарады."

#. i18n: file: functions/statistical.xml:1641
#: xml_doc.cpp:4308
msgid ""
"The alpha and beta parameters must be positive, the number (first parameter) "
"must be non-negative."
msgstr ""
"Альфа мен бета параметрлері оң саң болуға тиіс, сан (бірінші параметрі) "
"теріс сан болмауға тиіс."

#. i18n: file: functions/statistical.xml:1643
#: xml_doc.cpp:4312
msgid "WEIBULL(number;alpha;beta;cumulative)"
msgstr "WEIBULL(сан;альфа;бета;жинақтау)"

#. i18n: file: functions/statistical.xml:1644
#: xml_doc.cpp:4314
msgid "WEIBULL(2;1;1;0) equals 0.135335"
msgstr "WEIBULL(2;1;1;0) нәтижесі 0,135335"

#. i18n: file: functions/statistical.xml:1645
#: xml_doc.cpp:4316
msgid "WEIBULL(2;1;1;1) equals 0.864665"
msgstr "WEIBULL(2;1;1;1) нәтижесі 0,864665"

#. i18n: file: functions/statistical.xml:1657
#: xml_doc.cpp:4320
msgid "mean"
msgstr "орташасы"

#. i18n: file: functions/statistical.xml:1661
#: xml_doc.cpp:4322
msgid "standardDeviation"
msgstr "стандартАуытқу"

#. i18n: file: functions/statistical.xml:1665
#: xml_doc.cpp:4324
msgid ""
"The ZTEST() function calculates the two tailed probability of a z-test with "
"normal distribution."
msgstr ""
"ZTEST() функциясы қалыпты үлестірімді z-сынақтың екі жақты ықтималдығын "
"есептеп береді."

#. i18n: file: functions/statistical.xml:1666
#: xml_doc.cpp:4326
msgid "ZTEST(x; mean; standardDeviation)"
msgstr "ZTEST(x; орташасы; стандартАуытқу)"

#. i18n: file: functions/statistical.xml:1673
#: xml_doc.cpp:4328
msgid ""
"Performs a test of the null hypothesis, that sample is a sample\n"
"            of a normal distributed random variable with mean mean and "
"standard\n"
"            deviation sigma. A return value of 1 indicates, that the null\n"
"            hypothesis is rejected, i.e. the sample is not a random sample "
"of\n"
"            the normal distribution.\n"
"            If sigma is omitted, it is estimated from sample, using STDEV.\n"
"        "
msgstr ""
"Таңдамасы қалыпты үлестірімінің кездейсоқ айнымалы екенін,\n"
"            орташасы дегені оның орташа мәні және сигма дегені - стандартты\n"
"            ауытқуы екені туралы нөл-гипотезасы сынаққа салынады.\n"
"            Қайтарғаны 1 болғаны, нөл-гипотеза өтпегенін көрсетеді, яғни\n"
"            қарастырылған таңдамасы кездейсоқ қалыпты үлестірімі емес\n"
"            дегені. Егер сигма келтірілмесе, ол STDEV көмегімен\n"
"            таңдамасынан бағаланады.\n"
"        "

#. i18n: file: functions/statistical.xml:1726
#: xml_doc.cpp:4342
msgid "The BINO() function returns the binomial distribution."
msgstr "BINO() функциясы биномдық үлестірімін қайтарады."

#. i18n: file: functions/statistical.xml:1727
#: xml_doc.cpp:4344
msgid ""
"The first parameter is the number of trials, the second parameter is the "
"number of successes, and the third is the probability of success. The number "
"of trials should be greater than the number of successes and the probability "
"should be smaller or equal to 1."
msgstr ""
"Бірінші параметрі - сынақтар саны, екінші параметрі - сынақтан өткендер "
"саны, үшіншісі - сынақтан өту ықтималдығы. Сынақтар саны сынақтан "
"өткендерден кем болмауы тиіс, ықтималдығы бірден кем не оған тең болуы тиіс."

#. i18n: file: functions/statistical.xml:1728
#: xml_doc.cpp:4346
msgid "BINO(trials;success;prob_of_success)"
msgstr "BINO(сынақтар;өткендер;өту_ықтимал)"

#. i18n: file: functions/statistical.xml:1729
#: xml_doc.cpp:4348
msgid "BINO(12;9;0.8) returns 0.236223201"
msgstr "BINO(12;9;0,8) қайтаратыны 0,236223201"

#. i18n: file: functions/statistical.xml:1745
#: xml_doc.cpp:4354
msgid ""
"The SUMXMY2() function (SUM((X-Y)^2)) returns the square of the differences "
"of these values. The number of values in the two arrays should be equal. "
"Otherwise this function returns Err."
msgstr ""
"SUMXMY2() функциясы (SUM((X-Y)^2)) тапсырылған мәндерінің айырымының "
"квадратын есептеп береді. Екі жиымының ұзындықтары бірдей болуға тиіс. "
"Әйтпесе, қате белгісі қайтарылады."

#. i18n: file: functions/statistical.xml:1746
#: xml_doc.cpp:4356
msgid "SUMXMY2(array1;array2)"
msgstr "SUMXMY2(жиым1;жиым2)"

#. i18n: file: functions/statistical.xml:1747
#: xml_doc.cpp:4358
msgid "SUMXMY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 1"
msgstr ""
"SUMXMY2(A1:A2;B1:B2), егерде  A1=2, A2=5, B1=3; B2=5 болса, қайтаратыны 1"

#. i18n: file: functions/statistical.xml:1763
#: xml_doc.cpp:4364
msgid "Probability of failure"
msgstr "Сынақтан өтпеу ықтималдығы"

#. i18n: file: functions/statistical.xml:1767
#: xml_doc.cpp:4366
msgid ""
"The INVBINO() function returns the negative binomial distribution. The first "
"parameter is the number of trials, the second parameter is the number of "
"failures, and the third is the probability of failure. The number of trials "
"should be larger than the number of failures and the probability should be "
"smaller or equal to 1."
msgstr ""
"INVBINO() функциясы кері биномдық үлестірімін қайтарады. Бірінші параметрі - "
"сынақтар саны, екінші параметрі - сынақтан өтпегендер саны, үшіншісі - "
"сынақтан өтпеу ықтималдығы. Сынақтар саны сынақтан өтпегендерден кем болмауы "
"тиіс, ықтималдығы бірден кем не оған тең болуы тиіс."

#. i18n: file: functions/statistical.xml:1768
#: xml_doc.cpp:4368
msgid "INVBINO(trials;failure;prob_of_failure)"
msgstr "INVBINOBINO(сынақтар;өтпегендер;өпеу_ықтимал)"

#. i18n: file: functions/statistical.xml:1769
#: xml_doc.cpp:4370
msgid "INVBINO(12;3;0.2) returns 0.236223201"
msgstr "INVBINO(12;3;0,2) қайтаратыны 0,236223201"

#. i18n: file: functions/statistical.xml:1781
#: xml_doc.cpp:4374
msgid ""
"The GAMMALN() function returns the natural logarithm of the gamma function: G"
"(x). The number parameter must be positive."
msgstr ""
"GAMMALN() функциясы қайтаратыны G(x) гамма функцияның натурал логарифмі. "
"Параметрі оң сан болуы тиіс."

#. i18n: file: functions/statistical.xml:1782
#: xml_doc.cpp:4376
msgid "GAMMALN(Number)"
msgstr "GAMMALN(сан)"

#. i18n: file: functions/statistical.xml:1783
#: xml_doc.cpp:4378
msgid "GAMMALN(2) returns 0"
msgstr "GAMMALN(2) қайтаратыны 0"

#. i18n: file: functions/text.xml:15
#. i18n: file: functions/text.xml:34
#: xml_doc.cpp:4384 xml_doc.cpp:4396
msgid "Decimals"
msgstr "Ондық бөлшек таңбалар саны"

#. i18n: file: functions/text.xml:19
#: xml_doc.cpp:4386
msgid ""
"The DOLLAR() function converts a number to text using currency format, with "
"the decimals rounded to the specified place. Although the name is DOLLAR, "
"this function will do the conversion according to the current locale."
msgstr ""
"DOLLAR() функциясы тапсырылған санды, келтірілген шамаға дөңгелектеп, ақша "
"пішімді мәтін жолына аударады. DOLLAR деп аталғанына қарамастан, функция "
"жергілікті ақша пішіміне аударады."

#. i18n: file: functions/text.xml:20
#: xml_doc.cpp:4388
msgid "DOLLAR(number;decimals)"
msgstr "DOLLAR(сан;бөлшек_таңбалары)"

#. i18n: file: functions/text.xml:21
#: xml_doc.cpp:4390
msgid "DOLLAR(1403.77) returns \"$ 1,403.77\""
msgstr "DOLLAR(1403,77) қайтаратыны \"T1 403,77\""

#. i18n: file: functions/text.xml:22
#: xml_doc.cpp:4392
msgid "DOLLAR(-0.123;4) returns \"$-0.1230\""
msgstr "DOLLAR(-0,123;4) қайтаратыны \"T-0,1230\""

#. i18n: file: functions/text.xml:38
#: xml_doc.cpp:4398
msgid "No_commas"
msgstr "Мыңдық_бөлгішсіз"

#. i18n: file: functions/text.xml:42
#: xml_doc.cpp:4400
msgid ""
"The FIXED() function rounds a number to the specified number of decimals, "
"formats the number in decimal format string, and returns the result as text. "
"If decimals is negative, number is rounded to the left of the decimal point. "
"If you omit decimals, it is assumed to be 2. If optional parameter no_commas "
"is True, thousand separators will not show up."
msgstr ""
"FIXED() функциясы тапсырылған санды, келтірілген шамаға дөңгелектеп, ондық "
"санды пішімдеп мәтін жолы ретінде қайтарады. 'Бөлшек_таңбалары' дегені теріс "
"болса, сан бүтін ондықтары дөңгелектеледі. 'Бөлшек_таңбалары' дегені "
"келтірілмесе, ол 2 деп саналады. Міндетті емес 'Мыңдық_бөлгішсіз' деген "
"параметрі True болса, мыңдық топтары бір-бірінен бөлінбей көрсетіледі."

#. i18n: file: functions/text.xml:43
#: xml_doc.cpp:4402
msgid "FIXED(number;decimals;no_commas)"
msgstr "FIXED((сан;бөлшек_таңбалары;мыңдық_бөлгішсіз)"

#. i18n: file: functions/text.xml:44
#: xml_doc.cpp:4404
msgid "FIXED(1234.567;1) returns \"1,234.6\""
msgstr "FIXED(1234,567;1) қайтаратыны \"1 234,6\""

#. i18n: file: functions/text.xml:45
#: xml_doc.cpp:4406
msgid "FIXED(1234.567;1;FALSE) returns \"1234.6\""
msgstr "FIXED(1234,567;1;FALSE) қайтаратыны \"1234,6\""

#. i18n: file: functions/text.xml:46
#: xml_doc.cpp:4408
msgid "FIXED(44.332) returns \"44.33\""
msgstr "FIXED(44,332) қайтаратыны \"44,33\""

#. i18n: file: functions/text.xml:54
#: xml_doc.cpp:4410
msgid "Text for which you want to substitute"
msgstr "Қай мәтінде алмастыру жасайтыны"

#. i18n: file: functions/text.xml:58
#: xml_doc.cpp:4412
msgid "Part of text you want to replace"
msgstr "Алмастыратын мәтін"

#. i18n: file: functions/text.xml:62
#: xml_doc.cpp:4414
msgid "New text which will be replacement"
msgstr "Алмастырмақ жаңа мәтін"

#. i18n: file: functions/text.xml:66
#: xml_doc.cpp:4416
msgid "Which occurrence to replace"
msgstr "Қайталануын қайсысын алмастыру"

#. i18n: file: functions/text.xml:70
#: xml_doc.cpp:4418
msgid ""
"The SUBSTITUTE() substitutes new_text for old_text in a text string. If "
"instance_num is specified, only that instance of old_text is replaced. "
"Otherwise, every occurrence of old_text is changed to new_text. Use "
"SUBSTITUTE when you want to replace specific text, use REPLACE when you want "
"to replace any text that occurs in a specific location."
msgstr ""
"SUBSTITUTE() функциясы 'жаңа_мәтін' дегенді 'бұрынғы_мәтін' дегенге "
"алмастырады. Егер 'қайталануы' деген параметрі келтірілсе тек "
"'бұрынғы_мәтін' дегеннің соншалықты қайталанғаны алмастырылады.Әйтпесе, "
"бұрынғы мәтіннің' барлық кездескені алмастырады.SUBSTITUTE функциясын нақты "
"бір қайталануын алмастыру үшін қолданыңыз, ал барлығын алмастыру үшін "
"REPLACE деген функцияны қолданған жөн."

#. i18n: file: functions/text.xml:71
#: xml_doc.cpp:4420
msgid "SUBSTITUTE(text; old_text; new_text; instance_num)"
msgstr "SUBSTITUTE(мәтін; бұрынғы_мәтін; жаңа_мәтін; қайталануы)"

#. i18n: file: functions/text.xml:72
#: xml_doc.cpp:4422
msgid "SUBSTITUTE(\"Cost Data\";\"Cost\";\"Sales\") returns \"Sales Data\""
msgstr ""
"SUBSTITUTE(\"Cost Data\";\"Cost\";\"Sales\") қайтаратыны \"Sales Data\""

#. i18n: file: functions/text.xml:73
#: xml_doc.cpp:4424
msgid "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";1) returns \"Qtr 3, 2001\""
msgstr "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";1) қайтаратыны \"Qtr 3, 2001\""

#. i18n: file: functions/text.xml:74
#: xml_doc.cpp:4426
msgid "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";4) returns \"Qtr 3, 2003\""
msgstr "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";4) қайтаратыны \"Qtr 3, 2003\""

#. i18n: file: functions/text.xml:84
#. i18n: file: functions/text.xml:228
#: xml_doc.cpp:4428 xml_doc.cpp:4518
msgid "The text you want to find"
msgstr "Қарастырылатын мәтін"

#. i18n: file: functions/text.xml:88
#. i18n: file: functions/text.xml:232
#: xml_doc.cpp:4430 xml_doc.cpp:4520
msgid "The text which may contain find_text"
msgstr "Іздейтін мәтін"

#. i18n: file: functions/text.xml:92
#: xml_doc.cpp:4432
msgid "Specified index to start the search"
msgstr "Қай орнынан іздеуді бастау керек"

#. i18n: file: functions/text.xml:96
#: xml_doc.cpp:4434
msgid ""
"The SEARCH() function finds one text string (find_text) within another text "
"string (within_text) and returns the number of the starting point of "
"find_text, from the leftmost character of within_text."
msgstr ""
"SEARCH() функциясы 'іздейтін_мәтін' деген жолына 'кіретін_мәтін' деген жолды "
"іздеп, оның басталу орнының санын қайтарады."

#. i18n: file: functions/text.xml:97
#: xml_doc.cpp:4436
msgid ""
"You can use wildcard characters, question mark (?) and asterisk (*). A "
"question mark matches any single character, an asterisk matches any "
"sequences of characters."
msgstr ""
"Бұнда сұрақ белгі (?) және жұлдызша белгі (*) үлгі қалқаларын қолдануға "
"болады. Сұрақ белгісі бір кез келген таңбаны белгілейді, жұлдызша бір қатар "
"кез келген таңбаларды белгілейді."

#. i18n: file: functions/text.xml:98
#: xml_doc.cpp:4438
msgid ""
"Parameter start_num specifies the character at which to start the search. "
"The first character is character number 1. If start_num is omitted, it is "
"assumed to be 1. SEARCH does not distinguish between uppercase and lowercase "
"letters."
msgstr ""
"'Іздеу_басы' параметрі қай жерден бастап іздеуді атқару керегін көрсетеді. "
"'Іздеу_басы' параметрі келтірілмесе, ол 1 деп саналады. SEARCH үлкен-кіші "
"әріптерді айырмайды."

#. i18n: file: functions/text.xml:99
#: xml_doc.cpp:4440
msgid "SEARCH(find_text;within_text;start_num)"
msgstr "SEARCH(мәтін; кіретін_мәтін; іздеу_басы)"

#. i18n: file: functions/text.xml:100
#: xml_doc.cpp:4442
msgid "SEARCH(\"e\";\"Statements\";6) returns 7"
msgstr "SEARCH(\"e\";\"Statements\";6) қайтаратыны 7"

#. i18n: file: functions/text.xml:101
#: xml_doc.cpp:4444
msgid "SEARCH(\"margin\";\"Profit Margin\") returns 8"
msgstr "SEARCH(\"margin\";\"Profit Margin\") қайтаратыны 8"

#. i18n: file: functions/text.xml:114
#: xml_doc.cpp:4448
msgid ""
"The T() function returns the text referred to by value. If value is, or "
"refers to, text then T returns value. If value does not refer to text then T "
"returns empty text."
msgstr ""
"T() функциясы тапсырылған не сілтегені мәтін жолы болса, сол мәтінді "
"қайтарады. Егер тапсырылғаны мәтін емес болса бос жол қайтарылады."

#. i18n: file: functions/text.xml:115
#: xml_doc.cpp:4450
msgid "T(value)"
msgstr "T(мән)"

#. i18n: file: functions/text.xml:116
#: xml_doc.cpp:4452
msgid "T(\"KOffice\") returns \"KOffice\""
msgstr "T(\"KOffice\") қайтаратыны \"KOffice\""

#. i18n: file: functions/text.xml:117
#: xml_doc.cpp:4454
msgid "T(1.2) returns \"\" (empty text)"
msgstr "T(1,2) қайтаратыны \"\" (бос мәтін)"

#. i18n: file: functions/text.xml:129
#: xml_doc.cpp:4458
msgid "The TEXT() function converts a value to text."
msgstr "TEXT() функциясы тапсырылғанды мәтін жолға аударып береді."

#. i18n: file: functions/text.xml:130
#: xml_doc.cpp:4460
msgid "TEXT(value)"
msgstr "TEXT(мән)"

#. i18n: file: functions/text.xml:131
#: xml_doc.cpp:4462
msgid "TEXT(1234.56) returns \"1234.56\""
msgstr "TEXT(1234,56) қайтаратыны \"1234,56\""

#. i18n: file: functions/text.xml:132
#: xml_doc.cpp:4464
msgid "TEXT(\"KSpread\") returns \"KSpread\""
msgstr "TEXT(\"KSpread\") қайтаратыны \"KSpread\""

#. i18n: file: functions/text.xml:140
#. i18n: file: functions/text.xml:179
#. i18n: file: functions/text.xml:183
#. i18n: file: functions/text.xml:282
#. i18n: file: functions/text.xml:297
#: xml_doc.cpp:4466 xml_doc.cpp:4490 xml_doc.cpp:4492 xml_doc.cpp:4554
#: xml_doc.cpp:4564
msgid "String"
msgstr "Мәтін жолы"

#. i18n: file: functions/text.xml:144
#: xml_doc.cpp:4468
msgid ""
"The PROPER() function converts the first letter of each word to uppercase "
"and the rest of the letters to lowercase."
msgstr ""
"PROPER() функциясы әрбір сөздің алғашқы әріпін үлкен қылып қалған әріптерің "
"кіші қылады."

#. i18n: file: functions/text.xml:145
#: xml_doc.cpp:4470
msgid "PROPER(string)"
msgstr "PROPER(мәтін_жолы)"

#. i18n: file: functions/text.xml:146
#: xml_doc.cpp:4472
msgid "PROPER(\"this is a title\") returns \"This Is A Title\""
msgstr "PROPER(\"this is a title\") қайтаратыны \"This Is A Title\""

#. i18n: file: functions/text.xml:154
#: xml_doc.cpp:4474
msgid "First string"
msgstr "Бірінші жол"

#. i18n: file: functions/text.xml:158
#: xml_doc.cpp:4476
msgid "String to compare with"
msgstr "Салыстыратын жол"

#. i18n: file: functions/text.xml:162
#: xml_doc.cpp:4478
msgid "Compare case-sensitive (true/false)"
msgstr "Әріптерінің үлкен-кішісін ескеріп/ескермей (true/false) салыстыру"

#. i18n: file: functions/text.xml:166
#: xml_doc.cpp:4480
msgid ""
"The COMPARE() function returns 0 if the two strings are equal; -1 if the "
"first one is lower in value than the second one; otherwise it returns 1."
msgstr ""
"COMPARE() функциясы салыстырған жолдар тең болса қайтаратыны 0, бірінші "
"жолдың реттік орны алда болса қайтаратыны 1, әйтпесе қайтаратыны -1."

#. i18n: file: functions/text.xml:167
#: xml_doc.cpp:4482
msgid "COMPARE(string1; string2; true|false)"
msgstr "COMPARE(жол1; жол2; true|false)"

#. i18n: file: functions/text.xml:168
#: xml_doc.cpp:4484
msgid "COMPARE(\"KOffice\"; \"KOffice\"; true) returns 0"
msgstr "COMPARE(\"KOffice\"; \"KOffice\"; true) қайтаратыны 0"

#. i18n: file: functions/text.xml:169
#: xml_doc.cpp:4486
msgid "COMPARE(\"koffice\"; \"KOffice\"; true) returns 1"
msgstr "COMPARE(\"koffice\"; \"KOffice\"; true) қайтаратыны 1"

#. i18n: file: functions/text.xml:170
#: xml_doc.cpp:4488
msgid "COMPARE(\"kspread\"; \"KOffice\"; false) returns 1"
msgstr "COMPARE(\"kspread\"; \"KOffice\"; false) қайтаратыны 1"

#. i18n: file: functions/text.xml:187
#: xml_doc.cpp:4494
msgid ""
"The EXACT() function returns True if these two strings are equal. Otherwise, "
"it returns False."
msgstr ""
"EXACT() функциясы екі жол тең болса қайтаратыны True. Әйтпесе, қайтаратыны "
"False."

#. i18n: file: functions/text.xml:188
#: xml_doc.cpp:4496
msgid "EXACT(string1;string2)"
msgstr "EXACT(жол1;жол2)"

#. i18n: file: functions/text.xml:189
#: xml_doc.cpp:4498
msgid "EXACT(\"KOffice\";\"KOffice\") returns True"
msgstr "EXACT(\"KOffice\";\"KOffice\") қайтаратыны True"

#. i18n: file: functions/text.xml:190
#: xml_doc.cpp:4500
msgid "EXACT(\"KSpread\";\"KOffice\") returns False"
msgstr "EXACT(\"KSpread\";\"KOffice\") қайтаратыны False"

#. i18n: file: functions/text.xml:199
#: xml_doc.cpp:4502
msgid "Text which you want to replace some characters"
msgstr "Бірнеше таңбасын алмастыратын мәтін"

#. i18n: file: functions/text.xml:203
#: xml_doc.cpp:4504
msgid "Position of the characters to replace"
msgstr "Қай орыннан бастап алмастыру"

#. i18n: file: functions/text.xml:207
#: xml_doc.cpp:4506
msgid "Number of characters to replace"
msgstr "Қанша таңбаларын алмастыру"

#. i18n: file: functions/text.xml:211
#: xml_doc.cpp:4508
msgid "The text that will replace characters in old text"
msgstr "Көрсетілген мәтінді алмастыратын жаңа мәтін"

#. i18n: file: functions/text.xml:215
#: xml_doc.cpp:4510
msgid ""
"The REPLACE() function replaces part of a text string with a different text "
"string."
msgstr ""
"REPLACE() функциясы мәтін жолының бір бөлігін басқа бір жолмен алмастырады."

#. i18n: file: functions/text.xml:216
#: xml_doc.cpp:4512
msgid "REPLACE(text;position;length;new_text)"
msgstr "REPLACE(мәтін;орны;ұзындығы;жаңа_мәтін)"

#. i18n: file: functions/text.xml:217
#: xml_doc.cpp:4514
msgid "REPLACE(\"abcdefghijk\";6;5;\"-\") returns \"abcde-k\""
msgstr "REPLACE(\"abcdefghijk\";6;5;\"-\") қайтаратыны \"abcde-k\""

#. i18n: file: functions/text.xml:218
#: xml_doc.cpp:4516
msgid "REPLACE(\"2002\";3;2;\"03\") returns \"2003\""
msgstr "REPLACE(\"2002\";3;2;\"03\") қайтаратыны \"2003\""

#. i18n: file: functions/text.xml:236
#: xml_doc.cpp:4522
msgid "Specifies index to start the search"
msgstr "Іздеуді бастайтын орны"

#. i18n: file: functions/text.xml:240
#: xml_doc.cpp:4524
msgid ""
"The FIND() function finds one text string (find_text) within another text "
"string (within_text) and returns the number of the starting point of "
"find_text, from the leftmost character of within_text."
msgstr ""
"FIND() функциясы 'іздейтін_мәтін' деген жолына 'кіретін_мәтін' деген жолды "
"іздеп, оның басталу орнының санын қайтарады."

#. i18n: file: functions/text.xml:241
#: xml_doc.cpp:4526
msgid ""
"Parameter start_num specifies the character at which to start the search. "
"The first character is character number 1. If start_num is omitted, it is "
"assumed to be 1."
msgstr ""
"'Іздеу_басы' параметрі қай жерден бастап іздеуді атқару керегін көрсетеді. "
"'Іздеу_басы' параметрі келтірілмесе, ол 1 деп саналады."

#. i18n: file: functions/text.xml:242
#: xml_doc.cpp:4528
msgid ""
"You can also use function SEARCH, but unlike SEARCH, FIND is case-sensitive "
"and does not allow wildcard characters."
msgstr ""
"Бұның орнына SEARCH функциясын қолдануға болады, FIND-тың SEARCH-тен "
"айырмашылығы - FIND әріптің үлкен-кішілігін айырады және үлгі қалқаларды "
"түсінбейді."

#. i18n: file: functions/text.xml:243
#: xml_doc.cpp:4530
msgid "FIND(find_text;within_text;start_num)"
msgstr "FIND(мәтін; кіретін_мәтін; іздеу_басы)"

#. i18n: file: functions/text.xml:244
#: xml_doc.cpp:4532
msgid "FIND(\"KOf\";\"KOffice\") returns 1"
msgstr "FIND(\"KOf\";\"KOffice\") қайтаратыны 1"

#. i18n: file: functions/text.xml:245
#: xml_doc.cpp:4534
msgid "FIND(\"i\";\"KOffice\") returns 5"
msgstr "FIND(\"i\";\"KOffice\") қайтаратыны 5"

#. i18n: file: functions/text.xml:246
#: xml_doc.cpp:4536
msgid "FIND(\"K\";\"KSpread in KOffice\";4) returns 12"
msgstr "FIND(\"K\";\"KSpread in KOffice\";4) қайтаратыны 12"

#. i18n: file: functions/text.xml:256
#. i18n: file: functions/text.xml:341
#. i18n: file: functions/text.xml:363
#. i18n: file: functions/text.xml:385
#. i18n: file: functions/text.xml:420
#. i18n: file: functions/text.xml:438
#. i18n: file: functions/text.xml:452
#. i18n: file: functions/text.xml:467
#. i18n: file: functions/text.xml:484
#: xml_doc.cpp:4538 xml_doc.cpp:4588 xml_doc.cpp:4602 xml_doc.cpp:4616
#: xml_doc.cpp:4640 xml_doc.cpp:4652 xml_doc.cpp:4660 xml_doc.cpp:4668
#: xml_doc.cpp:4678
msgid "Source string"
msgstr "Бастапқы мәтін"

#. i18n: file: functions/text.xml:260
#: xml_doc.cpp:4540
msgid "Position"
msgstr "Орны"

#. i18n: file: functions/text.xml:264
#: xml_doc.cpp:4542
msgid "Length"
msgstr "Ұзындығы"

#. i18n: file: functions/text.xml:268
#: xml_doc.cpp:4544
msgid ""
"The MID() function returns a substring that contains 'length' characters of "
"the string, starting at 'position' index."
msgstr ""
"MID() функциясы 'орны' деген орыннан басталатын ұзындығы' әріпті 'мәтін' деп "
"көрсетілген жолдың үзіндісін қайтарады."

#. i18n: file: functions/text.xml:269
#: xml_doc.cpp:4546
msgid "MID(text;position;length)"
msgstr "MID(мәтін;орны;ұзындығы)"

#. i18n: file: functions/text.xml:270
#: xml_doc.cpp:4548
msgid "MID(text;position)"
msgstr "MID(мәтін;орны)"

#. i18n: file: functions/text.xml:271
#: xml_doc.cpp:4550
msgid "MID(\"KOffice\";2;3) returns \"Off\""
msgstr "MID(\"KOffice\";2;3) қайтаратыны \"Off\""

#. i18n: file: functions/text.xml:272
#: xml_doc.cpp:4552
msgid "MID(\"KOffice\";2) returns \"Office\""
msgstr "MID(\"KOffice\";2) қайтаратыны \"Office\""

#. i18n: file: functions/text.xml:286
#: xml_doc.cpp:4556
msgid "The LEN() function returns the length of the string."
msgstr "LEN() функциясы мәтін жолының ұзындығын санап береді."

#. i18n: file: functions/text.xml:287
#: xml_doc.cpp:4558
msgid "LEN(text)"
msgstr "LEN(мәтін)"

#. i18n: file: functions/text.xml:288
#: xml_doc.cpp:4560
msgid "LEN(\"hello\") returns 5"
msgstr "LEN(\"hello\") қайтаратыны 5"

#. i18n: file: functions/text.xml:289
#: xml_doc.cpp:4562
msgid "LEN(\"KSpread\") returns 7"
msgstr "LEN(\"KSpread\") қайтаратыны 7"

#. i18n: file: functions/text.xml:301
#: xml_doc.cpp:4566
msgid "The TRIM() function returns text with only single spaces between words."
msgstr ""
"TRIM() функциясы мәтіннің сөздер арасында бір ғана бос орын қалдырып береді."

#. i18n: file: functions/text.xml:302
#: xml_doc.cpp:4568
msgid "TRIM(text)"
msgstr "TRIM(мәтін)"

#. i18n: file: functions/text.xml:303
#: xml_doc.cpp:4570
msgid "TRIM(\" hello    KSpread   \") returns \"hello KSpread\""
msgstr "TRIM(\" hello    KSpread   \") қайтаратыны \"hello KSpread\""

#. i18n: file: functions/text.xml:331
#: xml_doc.cpp:4582
msgid ""
"The CONCATENATE() function returns a string which is the concatenation of "
"the strings passed as parameters."
msgstr "CONCATENATE() функциясы тапсырылған мәтін жолдарын біріктіріп береді."

#. i18n: file: functions/text.xml:332
#: xml_doc.cpp:4584
msgid "CONCATENATE(value;value;...)"
msgstr "CONCATENATE(мән;мән;...)"

#. i18n: file: functions/text.xml:333
#: xml_doc.cpp:4586
msgid ""
"CONCATENATE(\"KSpread\";\"KOffice\";\"KDE\") returns \"KSpreadKOfficeKDE\""
msgstr ""
"CONCATENATE(\"KSpread\";\"KOffice\";\"KDE\") қайтаратыны \"KSpreadKOfficeKDE"
"\""

#. i18n: file: functions/text.xml:345
#. i18n: file: functions/text.xml:367
#: xml_doc.cpp:4590 xml_doc.cpp:4604
msgid "Number of characters"
msgstr "Таңбалар саны"

#. i18n: file: functions/text.xml:349
#: xml_doc.cpp:4592
msgid ""
"The RIGHT() function returns a substring that contains the 'length' "
"rightmost characters of the string. The whole string is returned if 'length' "
"exceeds the length of the string."
msgstr ""
"RIGHT() функциясы тапсырылған мәтін жолдың соңғы 'ұзындығы' әріпті үзіндісін "
"бөліп береді. 'Ұзындығы' деген жолдың ұзындығынан артық болса, жолды "
"толығымен қайтарады."

#. i18n: file: functions/text.xml:350
#: xml_doc.cpp:4594
msgid "RIGHT(text;length)"
msgstr "RIGHT(мәтін;ұзындығы)"

#. i18n: file: functions/text.xml:351
#: xml_doc.cpp:4596
msgid "RIGHT(\"hello\";2) returns \"lo\""
msgstr "RIGHT(\"hello\";2) қайтаратыны \"lo\""

#. i18n: file: functions/text.xml:352
#: xml_doc.cpp:4598
msgid "RIGHT(\"KSpread\";10) returns \"KSpread\""
msgstr "RIGHT(\"KSpread\";10) қайтаратыны \"KSpread\""

#. i18n: file: functions/text.xml:353
#: xml_doc.cpp:4600
msgid "RIGHT(\"KSpread\") returns \"d\""
msgstr "RIGHT(\"KSpread\") қайтаратыны \"d\""

#. i18n: file: functions/text.xml:371
#: xml_doc.cpp:4606
msgid ""
"The LEFT() function returns a substring that contains the 'length' leftmost "
"characters of the string. The whole string is returned if 'length' exceeds "
"the length of the string. It is an error for the number of characters to be "
"less than 0."
msgstr ""
"LEFT() функциясы тапсырылған мәтін жолдың алғашқы 'ұзындығы' әріпті "
"үзіндісін бөліп береді. 'Ұзындығы' деген жолдың ұзындығынан артық болса, "
"жолды толығымен қайтарады. 'Ұзындығы' деген сан теріс болса қате белгісі "
"қайтарылады."

#. i18n: file: functions/text.xml:372
#: xml_doc.cpp:4608
msgid "LEFT(text;length)"
msgstr "LEFT(мәтін;ұзындығы)"

#. i18n: file: functions/text.xml:373
#: xml_doc.cpp:4610
msgid "LEFT(\"hello\";2) returns \"he\""
msgstr "LEFT(\"hello\";2) қайтаратыны \"he\""

#. i18n: file: functions/text.xml:374
#: xml_doc.cpp:4612
msgid "LEFT(\"KSpread\";10) returns \"KSpread\""
msgstr "LEFT(\"KSpread\";10) қайтаратыны \"KSpread\""

#. i18n: file: functions/text.xml:375
#: xml_doc.cpp:4614
msgid "LEFT(\"KSpread\") returns \"K\""
msgstr "LEFT(\"KSpread\") қайтаратыны \"K\""

#. i18n: file: functions/text.xml:389
#: xml_doc.cpp:4618
msgid "Count of repetitions"
msgstr "Қайталау саны"

#. i18n: file: functions/text.xml:393
#: xml_doc.cpp:4620
msgid ""
"The REPT() function repeats the first parameter as many times as by the "
"second parameter. The second parameter must not be negative, and this "
"function will return an empty string if the second parameter is zero (or "
"rounds down to zero)."
msgstr ""
"REPT() функциясы бірінші параметрімен берілген мәтінді екінші параметрімен "
"берілген рет қайталап береді. Екінші параметрі теріс сан болмауы тиіс, ол "
"нөл (немесе нөлге дөңгелектенетін) болса функция бос жолды қайтарады."

#. i18n: file: functions/text.xml:394
#: xml_doc.cpp:4622
msgid "REPT(text;count)"
msgstr "REPT(мәтін;қайталау)"

#. i18n: file: functions/text.xml:395
#: xml_doc.cpp:4624
msgid "REPT(\"KSpread\";3) returns \"KSpreadKSpreadKSpread\""
msgstr "REPT(\"KSpread\";3) қайтаратыны \"KSpreadKSpreadKSpread\""

#. i18n: file: functions/text.xml:396
#: xml_doc.cpp:4626
msgid "REPT(\"KSpread\";0) returns \"\""
msgstr "REPT(\"KSpread\";0) қайтаратыны \"\""

#. i18n: file: functions/text.xml:408
#: xml_doc.cpp:4630
msgid ""
"The ROT() function encrypts text by replacing each letter with the one 13 "
"places along in the alphabet. If the 13th position is beyond the letter Z, "
"it begins again at A (rotation)."
msgstr ""
"ROT() функциясы мәтіндегі әрбір әріпті әліппе бойынша келесі 13-ші әріппен "
"ауыстырып шифрлайды. Келесі 13-шісі Z-тен асып кетсе, ол A-ға оралып "
"жалғастырады. Функция тек латын әліппемен істейді."

#. i18n: file: functions/text.xml:409
#: xml_doc.cpp:4632
msgid ""
"By applying the encryption function again to the resulting text, you can "
"decrypt the text."
msgstr "Шифрланған мәтінді қайта шифрласа - шифр шешіледі."

#. i18n: file: functions/text.xml:410
#: xml_doc.cpp:4634
msgid "ROT(Text)"
msgstr "ROT(Мәтін)"

#. i18n: file: functions/text.xml:411
#: xml_doc.cpp:4636
msgid "ROT(\"KSpread\") returns \"XFcernq\""
msgstr "ROT(\"KSpread\") қайтаратыны \"XFcernq\""

#. i18n: file: functions/text.xml:412
#: xml_doc.cpp:4638
msgid "ROT(\"XFcernq\") returns \"KSpread\""
msgstr "ROT(\"XFcernq\") қайтаратыны \"KSpread\""

#. i18n: file: functions/text.xml:424
#: xml_doc.cpp:4642
msgid ""
"The TOGGLE() function changes lowercase characters to uppercase and "
"uppercase characters to lowercase."
msgstr "TOGGLE() функциясы кіші әріптерді үлкен және үлкендерді кіші қылады."

#. i18n: file: functions/text.xml:425
#: xml_doc.cpp:4644
msgid "TOGGLE(text)"
msgstr "TOGGLE(мәтін)"

#. i18n: file: functions/text.xml:426
#: xml_doc.cpp:4646
msgid "TOGGLE(\"hello\") returns \"HELLO\""
msgstr "TOGGLE(\"hello\") қайтаратыны \"HELLO\""

#. i18n: file: functions/text.xml:427
#: xml_doc.cpp:4648
msgid "TOGGLE(\"HELLO\") returns \"hello\""
msgstr "TOGGLE(\"HELLO\") қайтаратыны \"hello\""

#. i18n: file: functions/text.xml:428
#: xml_doc.cpp:4650
msgid "TOGGLE(\"HeLlO\") returns \"hElLo\""
msgstr "TOGGLE(\"HeLlO\") қайтаратыны \"hElLo\""

#. i18n: file: functions/text.xml:442
#: xml_doc.cpp:4654
msgid ""
"The CLEAN() function removes every non-printable character from the string"
msgstr ""
"CLEAN() функциясы тапсырылған мәтінінен барлық басып шығаруға келмейтін "
"таңбаларды алып тастайды"

#. i18n: file: functions/text.xml:443
#: xml_doc.cpp:4656
msgid "CLEAN(text)"
msgstr "CLEAN(мәтін)"

#. i18n: file: functions/text.xml:444
#: xml_doc.cpp:4658
msgid "CLEAN(AsciiToChar(7) + \"HELLO\") returns \"HELLO\""
msgstr "CLEAN(AsciiToChar(7) + \"HELLO\") қайтаратыны \"HELLO\""

#. i18n: file: functions/text.xml:456
#: xml_doc.cpp:4662
msgid "The SLEEK() function removes all spaces from the string."
msgstr ""
"SLEEK() функциясы тапсырылған мәтінінен барлық бос орындарды алып тастайды."

#. i18n: file: functions/text.xml:457
#: xml_doc.cpp:4664
msgid "SLEEK(text)"
msgstr "SLEEK(мәтін)"

#. i18n: file: functions/text.xml:458
#: xml_doc.cpp:4666
msgid "SLEEK(\"This is   some  text \") returns \"Thisissometext\""
msgstr "SLEEK(\"This is   some  text \") қайтаратыны \"Thisissometext\""

#. i18n: file: functions/text.xml:471
#: xml_doc.cpp:4670
msgid "The UPPER() function converts a string to upper case."
msgstr "UPPER() функциясы барлық кіші әріптерді үлкен қылады."

#. i18n: file: functions/text.xml:472
#: xml_doc.cpp:4672
msgid "UPPER(text)"
msgstr "UPPER(мәтін)"

#. i18n: file: functions/text.xml:473
#: xml_doc.cpp:4674
msgid "UPPER(\"hello\") returns \"HELLO\""
msgstr "UPPER(\"hello\") қайтаратыны \"HELLO\""

#. i18n: file: functions/text.xml:474
#: xml_doc.cpp:4676
msgid "UPPER(\"HELLO\") returns \"HELLO\""
msgstr "UPPER(\"HELLO\") қайтаратыны \"HELLO\""

#. i18n: file: functions/text.xml:488
#: xml_doc.cpp:4680
msgid "The LOWER() function converts a string to lower case."
msgstr "LOWER() функциясы барлық үлкен әріптерді кіші қылады."

#. i18n: file: functions/text.xml:489
#: xml_doc.cpp:4682
msgid "LOWER(text)"
msgstr "LOWER(мәтін)"

#. i18n: file: functions/text.xml:490
#: xml_doc.cpp:4684
msgid "LOWER(\"hello\") returns \"hello\""
msgstr "LOWER(\"hello\") қайтаратыны \"hello\""

#. i18n: file: functions/text.xml:491
#: xml_doc.cpp:4686
msgid "LOWER(\"HELLO\") returns \"hello\""
msgstr "LOWER(\"HELLO\") қайтаратыны \"hello\""

#. i18n: file: functions/text.xml:501
#. i18n: file: functions/text.xml:612
#: xml_doc.cpp:4688 xml_doc.cpp:4752
msgid "Character code"
msgstr "Таңбаның коды"

#. i18n: file: functions/text.xml:505
#: xml_doc.cpp:4690
msgid "The CHAR() function returns the character specified by a number."
msgstr "CHAR() функциясы келтірілген кодтың таңбасын қайтарады."

#. i18n: file: functions/text.xml:506
#: xml_doc.cpp:4692
msgid "CHAR(code)"
msgstr "CHAR(код)"

#. i18n: file: functions/text.xml:507
#: xml_doc.cpp:4694
msgid "CHAR(65) returns \"A\""
msgstr "CHAR(65) қайтаратыны \"A\""

#. i18n: file: functions/text.xml:520
#: xml_doc.cpp:4698
msgid ""
"The CODE() function returns a numeric code for the first character in a text "
"string."
msgstr ""
"CODE() функциясы келтірілген мәтіннің бірінші әрібінің кодын қайтарады."
"string."

#. i18n: file: functions/text.xml:521
#: xml_doc.cpp:4700
msgid "CODE(text)"
msgstr "CODE(мәтін)"

#. i18n: file: functions/text.xml:522
#: xml_doc.cpp:4702
msgid "CODE(\"KDE\") returns 75"
msgstr "CODE(\"KDE\") қайтаратыны 75"

#. i18n: file: functions/text.xml:535
#: xml_doc.cpp:4706
msgid "Converts text string that represents a value to the real value.  "
msgstr "Санды таңбалайтын мәтін жолын нақты санға айналдырады.  "

#. i18n: file: functions/text.xml:536
#: xml_doc.cpp:4708
msgid "VALUE(text)"
msgstr "VALUE(мәтін)"

#. i18n: file: functions/text.xml:537
#: xml_doc.cpp:4710
msgid "VALUE(\"14.03\") returns 14.03"
msgstr "VALUE(\"14,03\") қайтаратыны 14,03"

#. i18n: file: functions/text.xml:545
#. i18n: file: functions/text.xml:574
#: xml_doc.cpp:4712 xml_doc.cpp:4732
msgid "Searched text"
msgstr "Іздейтін мәтін"

#. i18n: file: functions/text.xml:549
#. i18n: file: functions/text.xml:578
#: xml_doc.cpp:4714 xml_doc.cpp:4734
msgid "Regular expression"
msgstr "Үлгі өрнегі"

#. i18n: file: functions/text.xml:553
#: xml_doc.cpp:4716
msgid "Default value (optional)"
msgstr "Әдетті мән (келтірмеуге болады)"

#. i18n: file: functions/text.xml:557
#: xml_doc.cpp:4718
msgid "Back-reference (optional)"
msgstr "Сілтемелі (келтірмеуге болады)"

#. i18n: file: functions/text.xml:561
#: xml_doc.cpp:4720
msgid ""
"Returns a part of the string that matches a regular expression. If the "
"string does not match the given regular expression, value specified as "
"default is returned."
msgstr ""
"Мәтіннің үлгі өрнегіне сәйкес келетін бір бөлігін тауып береді. Сәйкес "
"келетіні табылмаса, әдетті деп белгіленген мәнін қайтарады."

#. i18n: file: functions/text.xml:562
#: xml_doc.cpp:4722
msgid ""
"If a back-reference is provided, then the value of that back-reference is "
"returned."
msgstr "Сілтемелі деп келтірілсе, сілтелген мәні қайтарылады."

#. i18n: file: functions/text.xml:563
#: xml_doc.cpp:4724
msgid ""
"If no default value is given, an empty string is assumed. If no back-"
"reference is given, 0 is assumed (so that entire matching part is returned)."
msgstr ""
"Әдетті мәні келтірілмесе, ол бос жол деп саналады. Сілтемелі дегені "
"келтірілмесе, ол 0 деп саналады (сонымен сәйкес келетін бүкілі қайтарылады)."

#. i18n: file: functions/text.xml:564
#: xml_doc.cpp:4726
msgid "REGEXP(text; regexp; default; backref)"
msgstr "REGEXP(мәтін; үлгі_өрнек; әдетті; сілтеме)"

#. i18n: file: functions/text.xml:565
#: xml_doc.cpp:4728
msgid "REGEXP(\"Number is   15.\";\"[0-9]+\") = \"15\" "
msgstr "REGEXP(\"Number is   15.\";\"[0-9]+\") = \"15\" "

#. i18n: file: functions/text.xml:566
#: xml_doc.cpp:4730
msgid "REGEXP(\"15, 20, 26, 41\";\"([0-9]+), *[0-9]+$\";\"\";1) = \"26\" "
msgstr "REGEXP(\"15, 20, 26, 41\";\"([0-9]+), *[0-9]+$\";\"\";1) = \"26\" "

#. i18n: file: functions/text.xml:582
#: xml_doc.cpp:4736
msgid "Replacement"
msgstr "Алмастыратын жаңа мәтін"

#. i18n: file: functions/text.xml:586
#: xml_doc.cpp:4738
msgid "Replaces all matches of a regular expression with the replacement text"
msgstr "Барлық үлгі өрнегіне сәйкес келетін жаңа мәтінімен алмастыру"

#. i18n: file: functions/text.xml:587
#: xml_doc.cpp:4740
msgid "REGEXPRE(text; regexp; replacement)"
msgstr "REGEXPRE(мәтін; үлгі_өрнек; алмастыру)"

#. i18n: file: functions/text.xml:588
#: xml_doc.cpp:4742
msgid ""
"REGEXPRE(\"14 and 15 and 16\";\"[0-9]+\";\"num\") returns \"num and num and "
"num\""
msgstr ""
"REGEXPRE(\"14 and 15 and 16\";\"[0-9]+\";\"num\") қайтаратыны \"num and num "
"and num\""

#. i18n: file: functions/text.xml:600
#: xml_doc.cpp:4746
msgid ""
"The UNICODE() function returns a unicode code point for the first character "
"in a text string."
msgstr ""
"UNICODE() функциясы келтірілген мәтіннің бірінші әрібінің юникодын қайтарады."

#. i18n: file: functions/text.xml:601
#: xml_doc.cpp:4748
msgid "UNICODE(text)"
msgstr "UNICODE(мәтін)"

#. i18n: file: functions/text.xml:602
#: xml_doc.cpp:4750
msgid "UNICODE(\"KDE\") returns 75"
msgstr "UNICODE(\"KDE\") қайтаратыны 75"

#. i18n: file: functions/text.xml:616
#: xml_doc.cpp:4754
msgid ""
"The UNICHAR() function returns the character specified by a unicode code "
"point."
msgstr "UNICHAR() функциясы келтірілген юникодтың таңбасын қайтарады."

#. i18n: file: functions/text.xml:617
#: xml_doc.cpp:4756
msgid "UNICHAR(code)"
msgstr "UNICHAR(код)"

#. i18n: file: functions/text.xml:618
#: xml_doc.cpp:4758
msgid "UNICHAR(65) returns \"A\""
msgstr "UNICHAR(65) қайтаратыны \"A\""

#. i18n: file: functions/text.xml:628
#: xml_doc.cpp:4760
msgid "Full width characters"
msgstr "Екі-байттық кодтамадағы таңбалар"

#. i18n: file: functions/text.xml:632
#: xml_doc.cpp:4762
msgid ""
"The ASC() function returns the half-width characters corresponding to the "
"full-width argument."
msgstr ""
"ASC() функциясы келтірілген екі-байттық (full-width) кодтамадағы мәтіннің "
"сәйкесті бір-байттық (half-width) кодтамасына көшіріп береді."

#. i18n: file: functions/text.xml:633
#: xml_doc.cpp:4764
msgid "ASC(text)"
msgstr "ASC(мәтін)"

#. i18n: file: functions/text.xml:642
#: xml_doc.cpp:4766
msgid "Half-width characters"
msgstr "Бір-байттық кодтамадағы таңбалар"

#. i18n: file: functions/text.xml:646
#: xml_doc.cpp:4768
msgid ""
"The JIS() function returns the full-width characters corresponding to the "
"half-width argument."
msgstr ""
"JIS() функциясы келтірілген бір-байттық (half-width) кодтамадағы мәтіннің "
"сәйкесті екі-байттық (full-width) кодтамасына көшіріп береді."

#. i18n: file: functions/text.xml:647
#: xml_doc.cpp:4770
msgid "JIS(text)"
msgstr "JIS(мәтін)"

#. i18n: file: functions/trig.xml:4
#: xml_doc.cpp:4772
msgid "Trigonometric"
msgstr "Тригонометриялық"

#. i18n: file: functions/trig.xml:14
#: xml_doc.cpp:4776
msgid ""
"The COS() function returns the cosine of x, where x is given in radians."
msgstr "COS() функциясы x радианның косинусын қайтарады."

#. i18n: file: functions/trig.xml:15
#: xml_doc.cpp:4778
msgid "COS(Float)"
msgstr "COS(x)"

#. i18n: file: functions/trig.xml:16
#: xml_doc.cpp:4780
msgid "COS(0) equals 1.0"
msgstr "COS(0) нәтижесі 1,0"

#. i18n: file: functions/trig.xml:17
#: xml_doc.cpp:4782
msgid "COS(PI()/2) equals 0"
msgstr "COS(PI()/2) нәтижесі 0"

#. i18n: file: functions/trig.xml:31
#: xml_doc.cpp:4786
msgid "The ACOT() function returns the inverse cotangent of a number."
msgstr "ACOT() функциясы тапсырылған санның кері котангенсін қайтарады."

#. i18n: file: functions/trig.xml:32
#: xml_doc.cpp:4788
msgid "ACOT(Float)"
msgstr "ACOT(сан)"

#. i18n: file: functions/trig.xml:33
#: xml_doc.cpp:4790
msgid "ACOT(0) equals 1.57079633"
msgstr "ACOT(0) нәтижесі 1,57079633"

#. i18n: file: functions/trig.xml:46
#: xml_doc.cpp:4794
msgid "The SIN() function returns the sine of x, where x is given in radians."
msgstr "SIN() функциясы x радианның синусын қайтарады."

#. i18n: file: functions/trig.xml:47
#: xml_doc.cpp:4796
msgid "SIN(Float)"
msgstr "SIN(x)"

#. i18n: file: functions/trig.xml:48
#: xml_doc.cpp:4798
msgid "SIN(0) equals 0"
msgstr "SIN(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:49
#: xml_doc.cpp:4800
msgid "SIN(PI()/2) equals 1"
msgstr "SIN(PI()/2) нәтижесі 1"

#. i18n: file: functions/trig.xml:63
#: xml_doc.cpp:4804
msgid ""
"The TAN() function returns the tangent of x, where x is given in radians."
msgstr "TAN() функциясы x радианның тангенсін қайтарады."

#. i18n: file: functions/trig.xml:64
#: xml_doc.cpp:4806
msgid "TAN(Float)"
msgstr "TAN(x)"

#. i18n: file: functions/trig.xml:65
#: xml_doc.cpp:4808
msgid "TAN(0.7) equals 0.84228838"
msgstr "TAN(0,7) нәтижесі 0,84228838"

#. i18n: file: functions/trig.xml:66
#: xml_doc.cpp:4810
msgid "TAN(0) equals 0"
msgstr "TAN(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:79
#: xml_doc.cpp:4814
msgid ""
"The ACOS() function returns the arc cosine in radians and the value is "
"mathematically defined to be 0 to PI (inclusive)."
msgstr ""
"ACOS() функциясы мәні 0 мен PI (шектері кіретін) аралықта жататын радиандағы "
"арккосинусын қайтарады."

#. i18n: file: functions/trig.xml:80
#: xml_doc.cpp:4816
msgid "ACOS(Float)"
msgstr "ACOS(x)"

#. i18n: file: functions/trig.xml:81
#: xml_doc.cpp:4818
msgid "ACOS(0.8) equals 0.6435011"
msgstr "ACOS(0,8) нәтижесі 0,6435011"

#. i18n: file: functions/trig.xml:82
#: xml_doc.cpp:4820
msgid "ACOS(0) equals 1.57079633"
msgstr "ACOS(0) нәтижесі 1,57079633"

#. i18n: file: functions/trig.xml:95
#: xml_doc.cpp:4824
msgid ""
"The ASIN() function returns the arc sine in radians and the value is "
"mathematically defined to be -PI/2 to PI/2 (inclusive)."
msgstr ""
"ASIN() функциясы мәні-PI/2 мен PI/2 (шектері кіретін) аралықта жататын "
"радиандағы арксинусын қайтарады."

#. i18n: file: functions/trig.xml:96
#: xml_doc.cpp:4826
msgid "ASIN(Float)"
msgstr "ASIN(x)"

#. i18n: file: functions/trig.xml:97
#: xml_doc.cpp:4828
msgid "ASIN(0.8) equals 0.92729522"
msgstr "ASIN(0,8) нәтижесі 0,92729522"

#. i18n: file: functions/trig.xml:98
#: xml_doc.cpp:4830
msgid "ASIN(0) equals 0"
msgstr "ASIN(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:111
#: xml_doc.cpp:4834
msgid ""
"The ATAN() function returns the arc tangent in radians and the value is "
"mathematically defined to be -PI/2 to PI/2 (inclusive)."
msgstr ""
"ATAN() функциясы мәні-PI/2 мен PI/2 (шектері кіретін) аралықта жататын "
"радиандағы арктангенсін қайтарады."

#. i18n: file: functions/trig.xml:112
#: xml_doc.cpp:4836
msgid "ATAN(Float)"
msgstr "ATAN(x)"

#. i18n: file: functions/trig.xml:113
#: xml_doc.cpp:4838
msgid "ATAN(0.8) equals 0.67474094"
msgstr "ATAN(0,8) нәтижесі 0,67474094"

#. i18n: file: functions/trig.xml:114
#: xml_doc.cpp:4840
msgid "ATAN(0) equals 0"
msgstr "ATAN(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:128
#: xml_doc.cpp:4844
msgid ""
"The COSH() function returns the hyperbolic cosine of x, which is defined "
"mathematically as (exp(x) + exp(-x)) / 2."
msgstr ""
"COSH() функциясы (exp(x) + exp(-x)) / 2 деп анықталған x-тың гиперболалық "
"косинусын қайтарады."

#. i18n: file: functions/trig.xml:129
#: xml_doc.cpp:4846
msgid "COSH(Float)"
msgstr "COSH(x)"

#. i18n: file: functions/trig.xml:130
#: xml_doc.cpp:4848
msgid "COSH(0.8) equals 1.33743495"
msgstr "COSH(0,8) нәтижесі 1,33743495"

#. i18n: file: functions/trig.xml:131
#: xml_doc.cpp:4850
msgid "COSH(0) equals 1"
msgstr "COSH(0) нәтижесі 1"

#. i18n: file: functions/trig.xml:144
#: xml_doc.cpp:4854
msgid ""
"The SINH() function returns the hyperbolic sine of x, which is defined "
"mathematically as (exp(x) - exp(-x)) / 2."
msgstr ""
"SINH() функциясы (exp(x) - exp(-x)) / 2 деп анықталған x-тың гиперболалық "
"синусын қайтарады."

#. i18n: file: functions/trig.xml:145
#: xml_doc.cpp:4856
msgid "SINH(Float)"
msgstr "SINH(x)"

#. i18n: file: functions/trig.xml:146
#: xml_doc.cpp:4858
msgid "SINH(0.8) equals 0.88810598"
msgstr "SINH(0,8) нәтижесі 0,88810598"

#. i18n: file: functions/trig.xml:147
#: xml_doc.cpp:4860
msgid "SINH(0) equals 0"
msgstr "SINH(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:160
#: xml_doc.cpp:4864
msgid ""
"The TANH() function returns the hyperbolic tangent of x, which is defined "
"mathematically as sinh(x)/cosh(x)."
msgstr ""
"The TANH() функциясы sinh(x)/cosh(x) деп анықталған x-тың гиперболалық "
"тангенсін қайтарады."

#. i18n: file: functions/trig.xml:161
#: xml_doc.cpp:4866
msgid "TANH(Float)"
msgstr "TANH(x)"

#. i18n: file: functions/trig.xml:162
#: xml_doc.cpp:4868
msgid "TANH(0.8) equals 0.66403677"
msgstr "TANH(0,8) нәтижесі 0,66403677"

#. i18n: file: functions/trig.xml:163
#: xml_doc.cpp:4870
msgid "TANH(0) equals 0"
msgstr "TANH(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:176
#: xml_doc.cpp:4874
msgid ""
"The ACOSH() function calculates the inverse hyperbolic cosine of x. That is "
"the value whose hyperbolic cosine is x. If x is less than 1.0, acosh() "
"returns not-a-number (NaN) and errno is set."
msgstr ""
"ACOSH() функциясы x-тың кері гиперболалық косинусын есептеп береді. Бұл "
"гиперболалық косинусы x-қа тең сан. Егер x-тың мәні 1,0-ден кем болса, acosh"
"() функциясы \"сан емес\" (NaN) қате белгісін қайтарады."

#. i18n: file: functions/trig.xml:177
#: xml_doc.cpp:4876
msgid "ACOSH(Float)"
msgstr "ACOSH(x)"

#. i18n: file: functions/trig.xml:178
#: xml_doc.cpp:4878
msgid "ACOSH(5) equals 2.29243167"
msgstr "ACOSH(5) нәтижесі 2,29243167"

#. i18n: file: functions/trig.xml:179
#: xml_doc.cpp:4880
msgid "ACOSH(0) equals NaN"
msgstr "ACOSH(0) нәтижесі NaN"

#. i18n: file: functions/trig.xml:192
#: xml_doc.cpp:4884
msgid ""
"The ASINH() function calculates the inverse hyperbolic sine of x; that is "
"the value whose hyperbolic sine is x."
msgstr ""
"ASINH() функциясы x-тың кері гиперболалық синусын есептеп береді. Бұл "
"гиперболалық синусы x-қа тең сан."

#. i18n: file: functions/trig.xml:193
#: xml_doc.cpp:4886
msgid "ASINH(Float)"
msgstr "ASINH(x)"

#. i18n: file: functions/trig.xml:194
#: xml_doc.cpp:4888
msgid "ASINH(0.8) equals 0.73266826"
msgstr "ASINH(0,8) нәтижесі 0,73266826"

#. i18n: file: functions/trig.xml:195
#: xml_doc.cpp:4890
msgid "ASINH(0) equals 0"
msgstr "ASINH(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:208
#: xml_doc.cpp:4894
msgid ""
"The ATANH() function calculates the inverse hyperbolic tangent of x; that is "
"the value whose hyperbolic tangent is x. If the absolute value of x is "
"greater than 1.0, ATANH() returns not-a-number (NaN)."
msgstr ""
"ATANH() функциясы x-тың кері гиперболалық тангенсін есептеп береді. Бұл "
"гиперболалық тангенсі x-қа тең сан. Егер x-тың модулі 1,0-ден артық болса, "
"ATANH() функциясы \"сан емес\" (NaN) қате белгісін қайтарады."

#. i18n: file: functions/trig.xml:209
#: xml_doc.cpp:4896
msgid "ATANH(Float)"
msgstr "ATANH(x)"

#. i18n: file: functions/trig.xml:210
#: xml_doc.cpp:4898
msgid "ATANH(0.8) equals 1.09861229"
msgstr "ATANH(0,8) нәтижесі 1,09861229"

#. i18n: file: functions/trig.xml:211
#: xml_doc.cpp:4900
msgid "ATANH(0) equals 0"
msgstr "ATANH(0) нәтижесі 0"

#. i18n: file: functions/trig.xml:228
#: xml_doc.cpp:4906
msgid ""
"This function calculates the arc tangent of the two variables x and y. It is "
"similar to calculating the arc tangent of y/x, except that the signs of both "
"arguments are used to determine the quadrant of the result."
msgstr ""
"Бұл функция x пен y екі айнымалының кері гиперболалық тангенсін есептеп "
"береді. Бұл y/x гиперболалық арктангенсін есептеуге ұқсас, айырмашылығы - "
"бұнда екі айнымалының оң-терістігі ескеріліп, нәтижесі қай квадрантта "
"жататыны анықталады."

#. i18n: file: functions/trig.xml:229
#: xml_doc.cpp:4908
msgid "ATAN2(value;value)"
msgstr "ATAN2(y;x)"

#. i18n: file: functions/trig.xml:230
#: xml_doc.cpp:4910
msgid "ATAN2(0.5;1.0) equals 1.107149"
msgstr "ATAN2(0,5;1,0) нәтижесі 1,107149"

#. i18n: file: functions/trig.xml:231
#: xml_doc.cpp:4912
msgid "ATAN2(-0.5;2.0) equals 1.815775"
msgstr "ATAN2(-0,5;2,0) нәтижесі 1,815775"

#. i18n: file: functions/trig.xml:244
