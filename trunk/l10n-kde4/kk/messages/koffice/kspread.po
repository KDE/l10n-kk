msgstr "IMTAN(жол) функциясы комплекс санның тангенсін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 513
#: xml_doc.cpp:1689
msgid "IMTAN(string)"
msgstr "IMTAN(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 514
#: xml_doc.cpp:1692
msgid "IMTAN(\"1+i\") returns \"0.27175+1.08392i\""
msgstr "IMTAN(\"1+i\") қайтаратыны \"0,27175+1,08392i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 515
#: xml_doc.cpp:1695
msgid "IMTAN(\"1.2\") returns 2.57215"
msgstr "IMTAN(\"1,2\") қайтаратыны 2,57215"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 527
#: xml_doc.cpp:1701
msgid ""
"The IMTANH(string) function returns the hyperbolic tangent of a complex "
"number."
msgstr ""
"IMTANH(жол) функциясы комплекс санның гиперболалық тангенсін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 528
#: xml_doc.cpp:1704
msgid "IMTANH(string)"
msgstr "IMTANH(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 529
#: xml_doc.cpp:1707
msgid "IMTANH(\"1+i\") returns \"1.08392+0.27175i\""
msgstr "IMTANH(\"1+i\") қайтаратыны \"1,08392+0,27175i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 530
#: xml_doc.cpp:1710
msgid "IMTANH(\"1.2\") returns 0.83365"
msgstr "IMTANH(\"1,2\") қайтаратыны 0,83365"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 542
#: xml_doc.cpp:1716
msgid "The IMEXP(string) returns the exponential of a complex number."
msgstr "IMEXP(жол) комплексті санның экспонентасын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 543
#: xml_doc.cpp:1719
msgid "IMEXP(string)"
msgstr "IMEXP(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 544
#: xml_doc.cpp:1722
msgid "IMEXP(\"2-i\") returns \"3.99232-6.21768i\""
msgstr "IMEXP(\"2-i\") қайтаратыны \"3,99232-6,21768i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 545
#: xml_doc.cpp:1725
msgid "IMEXP(\"12i\") returns \"0.843854-0.536573i\" "
msgstr "IMEXP(\"12i\") қайтаратыны \"0,843854-0,536573i\" "

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 557
#: xml_doc.cpp:1731
msgid "The IMLN(string) returns the natural logarithm of a complex number."
msgstr "IMLN(жол) комплекс санның натурал логарифмін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 558
#: xml_doc.cpp:1734
msgid "IMLN(string)"
msgstr "IMLN(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 559
#: xml_doc.cpp:1737
msgid "IMLN(\"3-i\") returns \"1.15129-0.321751i\""
msgstr "IMLN(\"3-i\") қайтаратыны \"1,15129-0,321751i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 560
#: xml_doc.cpp:1740
msgid "IMLN(\"12\") returns 2.48491 "
msgstr "IMLN(\"12\") қайтаратыны 2,48491 "

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 572
#: xml_doc.cpp:1746
msgid "The IMLOG2(string) returns the base-2 logarithm of a complex number."
msgstr "IMLOG2(жол) комплекс санның негізі 2 логарифмін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 573
#: xml_doc.cpp:1749
msgid "IMLOG2(string)"
msgstr "IMLOG2(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 574
#: xml_doc.cpp:1752
msgid "IMLOG2(\"3+4i\") returns \"2.321928+1.337804i\""
msgstr "IMLOG2(\"3+4i\") қайтаратыны \"2,321928+1,337804i\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 586
#: xml_doc.cpp:1758
msgid "The IMLOG10(string) returns the base-10 logarithm of a complex number."
msgstr "IMLOG10(жол) комплекс санның негізі 10 логарифмін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 587
#: xml_doc.cpp:1761
msgid "IMLOG10(string)"
msgstr "IMLOG10(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 588
#: xml_doc.cpp:1764
msgid "IMLOG10(\"3+4i\") returns \"0.69897+0.402719i\""
msgstr "IMLOG10(\"3+4i\") қайтаратыны \"0,69897+0,402719i\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 600
#: xml_doc.cpp:1770
msgid "The IMSQRT(string) returns the square root of a complex number."
msgstr "IMSQRT(жол) комплекс санның квадрат түбірін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 601
#: xml_doc.cpp:1773
msgid "IMSQRT(string)"
msgstr "IMSQRT(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 602
#: xml_doc.cpp:1776
msgid "IMSQRT(\"1+i\") returns \"1.09868+0.45509i\""
msgstr "IMSQRT(\"1+i\") қайтаратыны \"1,09868+0,45509i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 603
#: xml_doc.cpp:1779
msgid "IMSQRT(\"1.2i\") returns \"0.774597+0.774597i\" "
msgstr "IMSQRT(\"1,2i\") қайтаратыны \"0,774597+0,774597i\" "

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 615
#: xml_doc.cpp:1785
msgid "Power"
msgstr "Дәреже"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 619
#: xml_doc.cpp:1788
msgid "The IMPOWER(string) returns a complex number raised to a power."
msgstr "IMPOWER(жол) комплекс санды дәрежеге шығарып береді."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 620
#: xml_doc.cpp:1791
msgid "IMPOWER(string)"
msgstr "IMPOWER(жол)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 621
#: xml_doc.cpp:1794
msgid "IMPOWER(\"4-i\";2) returns \"15-8i\""
msgstr "IMPOWER(\"4-i\";2) қайтаратыны \"15-8i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 622
#: xml_doc.cpp:1797
msgid "IMPOWER(\"1.2\";2) returns 1.44 "
msgstr "IMPOWER(\"1,2\";2) қайтаратыны 1,44 "

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 651
#: xml_doc.cpp:1815
msgid "The IMSUM() returns the sum of several complex numbers of form x+yi."
msgstr "IMSUM() бірнеше комплекс сандар қосындысын x+yi түрінде қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 652
#: xml_doc.cpp:1818
msgid "IMSUM(value;value;...)"
msgstr "IMSUM(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 653
#: xml_doc.cpp:1821
msgid "IMSUM(1.2;\"3.4+5i\") returns \"4.6+5i\""
msgstr "IMSUM(1,2;\"3,4+5i\") қайтаратыны \"4,6+5i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 654
#: xml_doc.cpp:1824
msgid "IMSUM(1.2;\"1i\") returns \"1.2+i\""
msgstr "IMSUM(1,2;\"1i\") қайтаратыны \"1,2+i\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 682
#: xml_doc.cpp:1842
msgid ""
"The IMDIV() returns the division of several complex numbers of form x+yi."
msgstr ""
"IMDIV() бірнеше комплекс сандарының бір-біріне бөлу нәтижесін x+yi түрінде "
"қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 683
#: xml_doc.cpp:1845
msgid "IMDIV(value;value;...)"
msgstr "IMDIV(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 684
#: xml_doc.cpp:1848
msgid "IMDIV(1.2;\"3.4+5i\") returns \"0.111597-0.164114i\""
msgstr "IMDIV(1,2;\"3,4+5i\") қайтаратыны \"0,111597-0,164114i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 685
#: xml_doc.cpp:1851
msgid "IMDIV(\"12+i\";\"12-i\") returns \"0.986207+0.16551i\""
msgstr "IMDIV(\"12+i\";\"12-i\") қайтаратыны \"0,986207+0,16551i\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 714
#: xml_doc.cpp:1869
msgid ""
"The IMSUB() returns the difference of several complex numbers of form x+yi."
msgstr ""
"IMSUB() бірнеше комплекс сандарының азайту амалдар нәтіжесін x+yi түрінде "
"қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 715
#: xml_doc.cpp:1872
msgid "IMSUB(value;value;...)"
msgstr "IMSUB(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 716
#: xml_doc.cpp:1875
msgid "IMSUB(1.2;\"3.4+5i\") returns \"-2.2-5i\""
msgstr "IMSUB(1,2;\"3,4+5i\") қайтаратыны \"-2,2-5i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 717
#: xml_doc.cpp:1878
msgid "IMSUB(1.2;\"1i\") returns \"1.2-i\""
msgstr "IMSUB(1,2;\"1i\") қайтаратыны \"1,2-i\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 745
#: xml_doc.cpp:1896
msgid ""
"The IMPRODUCT() returns the product of several complex numbers of form x+yi."
msgstr ""
"IMPRODUCT() бірнеше комплекс сандарының бір-біріне көбейту нәтижесін x+yi "
"түрінде қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 746
#: xml_doc.cpp:1899
msgid "IMPRODUCT(value;value;...)"
msgstr "IMPRODUCT(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 747
#: xml_doc.cpp:1902
msgid "IMPRODUCT(1.2;\"3.4+5i\") returns \"4.08+6i\""
msgstr "IMPRODUCT(1,2;\"3,4+5i\") қайтаратыны \"4,08+6i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 748
#: xml_doc.cpp:1905
msgid "IMPRODUCT(1.2;\"1i\") returns \"+1.2i\""
msgstr "IMPRODUCT(1,2;\"1i\") қайтаратыны \"+1,2i\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 760
#: xml_doc.cpp:1911
msgid ""
"The IMCONJUGATE(complex number) returns the conjugate of a complex number of "
"form x+yi."
msgstr ""
"IMCONJUGATE(комплекс_сан) комплекс санның түйіндес санын x+yi түрінде "
"қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 761
#: xml_doc.cpp:1914
msgid "IMCONJUGATE(complex number)"
msgstr "IMCONJUGATE(комплекс_сан)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 762
#: xml_doc.cpp:1917
msgid "IMCONJUGATE(\"1.2+5i\") returns \"1.2-5i\""
msgstr "IMCONJUGATE(\"1,2+5i\") қайтаратыны \"1,2-5i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 763
#: xml_doc.cpp:1920
msgid "IMCONJUGATE(\"-i\") returns \"i\""
msgstr "IMCONJUGATE(\"-i\") қайтаратыны \"i\""

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 764
#: xml_doc.cpp:1923
msgid "IMCONJUGATE(\"12\") returns \"12\""
msgstr "IMCONJUGATE(\"12\") қайтаратыны \"12\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 776
#: xml_doc.cpp:1929
msgid ""
"The IMARGUMENT(complex number) returns the argument of a complex number of "
"form x+yi."
msgstr ""
"IMARGUMENT(комплекс_сан) функциясы x+yi түрдегі комплекс санның (полярлық "
"түрінің) аргументін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 777
#: xml_doc.cpp:1932
msgid "IMARGUMENT(complex number)"
msgstr "IMARGUMENT(комплекс_сан)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 778
#: xml_doc.cpp:1935
msgid "IMARGUMENT(\"1.2+5i\") returns 0.6072"
msgstr "IMARGUMENT(\"1,2+5i\") қайтаратыны 0,6072"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 779
#: xml_doc.cpp:1938
msgid "IMARGUMENT(\"-i\") returns -1.57079633 "
msgstr "IMARGUMENT(\"-i\") қайтаратыны -1,57079633 "

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 780
#: xml_doc.cpp:1941
msgid "IMARGUMENT(\"12\") returns \"#Div/0\""
msgstr "IMARGUMENT(\"12\") қайтаратыны \"#Div/0\""

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 792
#: xml_doc.cpp:1947
msgid ""
"The IMABS(complex number) returns the norm of a complex number of form x+yi."
msgstr ""
"IMABS(комплекс_сан) функциясы x+yi түрдегі комплекс санның модулін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 793
#: xml_doc.cpp:1950
msgid "IMABS(complex number)"
msgstr "IMABS(комплекс_сан)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 794
#: xml_doc.cpp:1953
msgid "IMABS(\"1.2+5i\") returns 5.1419"
msgstr "IMABS(\"1,2+5i\") қайтаратыны 5,1419"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 795
#: xml_doc.cpp:1956
msgid "IMABS(\"-i\") returns 1"
msgstr "IMABS(\"-i\") қайтаратыны 1"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 796
#: xml_doc.cpp:1959
msgid "IMABS(\"12\") returns 12"
msgstr "IMABS(\"12\") қайтаратыны 12"

