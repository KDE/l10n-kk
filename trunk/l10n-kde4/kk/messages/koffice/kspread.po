msgstr "FIB(n)"

#. i18n: file: functions/math.xml:1173
#: xml_doc.cpp:3134
msgid "FIB(9) returns 34"
msgstr "FIB(9) қайтаратыны 34"

#. i18n: file: functions/math.xml:1174
