"көрсетіледі."

#. i18n: file: part/dialogs/SheetPropertiesWidget.ui:152
#. i18n: ectx: property (text), widget (QCheckBox, hideZeroCheckBox)
#: rc.cpp:714
msgid "&Hide zero"
msgstr "&Нөл жасырылсын"

