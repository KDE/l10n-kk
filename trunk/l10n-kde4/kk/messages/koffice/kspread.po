msgid "Order of the function"
msgstr "Функцияның реті"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 41
#: xml_doc.cpp:1230
msgid "The BESSELI() function returns the modified Bessel function In(x)."
msgstr ""
"BESSELI() функциясы модификацияланған Бессел In(x) функциясын есептейді."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 42
#: xml_doc.cpp:1233
msgid "BESSELI(X;N)"
msgstr "BESSELI(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 43
#: xml_doc.cpp:1236
msgid "BESSELI(0.7;3) returns 0.007367374"
msgstr "BESSELI(0,7;3) қайтаратыны 0,007367374"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 62
#: xml_doc.cpp:1245
msgid "The BESSELJ() function returns the Bessel function."
msgstr "BESSELJ() Бессел функциясын есептейді."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 63
#: xml_doc.cpp:1248
msgid "BESSELJ(X;N)"
msgstr "BESSELJ(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 64
#: xml_doc.cpp:1251
msgid "BESSELJ(0.89;3) returns 0.013974004"
msgstr "BESSELJ(0,89;3) қайтаратыны 0,013974004"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 83
#: xml_doc.cpp:1260
msgid ""
"The BESSELK() function returns the modified Bessel function, which is "
"equivalent to the Bessel function evaluated for purely imaginary arguments."
msgstr ""
"BESSELK() функциясы модификацияланған Бессел функциясын есептейді. Бұл "
"Бессел функциясын таза жорамал аргументімен есептегенге тең."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 84
#: xml_doc.cpp:1263
msgid "BESSELK(X;N)"
msgstr "BESSELK(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 85
#: xml_doc.cpp:1266
msgid "BESSELK(3;9) returns 397.95880"
msgstr "BESSELK(3;9) қайтаратыны 397,95880"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 104
#: xml_doc.cpp:1275
msgid ""
"The BESSELY() function returns the Bessel function, which is also called the "
"Weber function or the Neumann function."
msgstr ""
"BESSELY() функциясы Бессел функциясын есептейді. Бұл функция сонымен қатар "
"Вебер функциясы немесе Нейман функциясы деп аталады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 105
#: xml_doc.cpp:1278
msgid "BESSELY(X;N)"
msgstr "BESSELY(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 106
#: xml_doc.cpp:1281
msgid "BESSELY(4;2) equals 0.215903595"
msgstr "BESSELY(4;2) нәтижесі 0,215903595"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 121
#: xml_doc.cpp:1287
msgid "From unit"
msgstr "Өлшем бірлігінен"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 125
#: xml_doc.cpp:1290
msgid "To unit"
msgstr "Өлшем бірлігіне"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 129
#: xml_doc.cpp:1293
msgid ""
"The CONVERT() function returns a conversion from one measurement system to "
"another."
msgstr ""
"CONVERT() функциясы бір өлшем жүйесінен басқа өлшем жүйесіне аударып береді."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 130
#: xml_doc.cpp:1296
msgid ""
"Supported mass units: g (gram), sg (pieces), lbm (pound), u (atomic mass), "
"ozm (ounce), stone, ton, grain, pweight (pennyweight), hweight "
"(hundredweight), bron (gross registered ton)."
msgstr ""
"Түсінетін масса бірліктері: g (грамм), sg (пиіс), lbm (фунт), u (атомдық "
"масса), ozm (унция), stone (стоун), ton (тонна), grain (гран), pweight "
"(пенниуейт), hweight (хандретуейт), bron (үлкен ағылшын тонна)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 131
#: xml_doc.cpp:1299
msgid ""
"Supported distance units: m (meter), in (inch), ft (feet), mi (mile), Nmi "
"(nautical mile), ang (Angstrom), parsec, lightyear."
msgstr ""
"Түсінетін қашықтық бірліктері: m (метр), in (дюйм), ft (фут), mi (миля), Nmi "
"(теңіз миля), ang (Ангстрем), parsec (парсек), lightyear (жарықтық жыл)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 132
#: xml_doc.cpp:1302
msgid ""
"Supported pressure units: Pa (Pascal), atm (atmosphere), mmHg (mm of "
"Mercury), psi, Torr."
msgstr ""
"Түсінетін қысым бірліктері: Pa (Паскаль), atm (атмосфера), mmHg (сынап баған "
"мм), psi (фунт/шаршы), Torr (Торр)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 133
#: xml_doc.cpp:1305
msgid "Supported force units: N (Newton), dyn, pound."
msgstr "Түсінетін күш бірліктері: N (Ньютон), dyn (дин), pound (фунт)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 134
#: xml_doc.cpp:1308
msgid ""
"Supported energy units: J (Joule), e (erg), c (Thermodynamic calorie), cal "
"(IT calorie), eV (electronvolt), HPh (Horsepower-hour), Wh (Watt-hour), flb "
"(foot-pound), BTU."
msgstr ""
"Түсінетін энергия бірліктері: J (Джоуль), e (эрг), c (термодинамикалық "
"калория), cal (халықаралық калория), eV (электронвольт), HPh (ат күші-"
"сағат), Wh (Ватт-сағат), flb (фут-фунт), BTU (Британдық жылу бірлігі)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 135
#: xml_doc.cpp:1311
msgid "Supported power units: W (Watt), HP (horsepower), PS (Pferdestaerke)."
msgstr ""
"Түсінетін қуат бірліктері:: W (Ватт), HP (ат күші), PS (Pferdestaerke [ат "
"күші - немісше])."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 136
#: xml_doc.cpp:1314
msgid "Supported magnetism units: T (Tesla), ga (Gauss)."
msgstr "Түсінетін магниттік бірліктері: T (Тесла), ga (Гаусс)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 137
#: xml_doc.cpp:1317
msgid "Supported temperature units: C (Celsius), F (Fahrenheit), K (Kelvin)."
msgstr ""
"Түсінетін температура бірліктері: C (Цельсий градусы), F (Фаренгейт "
"градусы), K (Кельвин)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 138
#: xml_doc.cpp:1320
msgid ""
"Supported volume units: l (liter), tsp (teaspoon), tbs (tablespoon), oz "
"(ounce liquid), cup, pt (pint), qt (quart), gal (gallone), barrel, m3 (cubic "
"meter), mi3 (cubic mile), Nmi3 (cubic Nautical mile), in3 (cubic inch), ft3 "
"(cubic foot), yd3 (cubic yard)."
msgstr ""
"Түсінетін көлем бірліктері: l (литр), tsp (шай қасық), tbs (ас қасық), oz "
"(сұйық унция), cup (шыныаяқ), pt (пинта), qt (кварта), gal (галлон), barrel "
"(баррель), m3 (текше метр), mi3 (текше миля), Nmi3 (текше теңіз миля), in3 "
"(текше дюйм), ft3 (текше фут), yd3 (текше ярд)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 139
#: xml_doc.cpp:1323
msgid ""
"Supported area units: m2 (square meter), mi2 (square mile), Nmi2 (square "
"Nautical mile), in2 (square inch), ft2 (square foot), yd2 (square yard), "
"acre, ha (hectare)."
msgstr ""
"Түсінетін аудан бірліктері: m2 (шаршы метр), mi2 (шаршы миля), Nmi2 (шаршы "
"теңіз миля), in2 (шаршы дюйм), ft2 (шаршы фут), yd2 (шаршы ярд), acre (акр), "
"ha (гектар)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 140
#: xml_doc.cpp:1326
msgid ""
"Supported speed units: m/s (meters per second), m/h (meters per hour), mph "
"(miles per hour), kn (knot)."
msgstr ""
"Түсінетін жылдамдық бірліктері: m/s (метр/сек), m/h (метр/сағат), mph (миля/"
"сағат), kn (узел)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 141
#: xml_doc.cpp:1329
msgid ""
"For metric units any of the following prefixes can be used: E (exa, 1E+18), "
"P (peta, 1E+15), T (tera, 1E+12), G (giga, 1E+09), M (mega, 1E+06), k (kilo, "
"1E+03), h (hecto, 1E+02), e (dekao, 1E+01), d (deci, 1E-01), c (centi, 1E-"
"02), m (milli, 1E-03), u (micro, 1E-06), n (nano, 1E-09), p (pico, 1E-12), f "
"(femto, 1E-15), a (atto, 1E-18)."
msgstr ""
"Метрикалық бірліктердің алдына келесі префикстерді қоюға болады: E (экза, 1E"
"+18), P (пета, 1E+15), T (тера, 1E+12), G (гига, 1E+09), M (мега, 1E+06), k "
"(кило, 1E+03), h (гекто, 1E+02), e (дека, 1E+01), d (деци, 1E-01), c (санти, "
"1E-02), m (милли, 1E-03), u (микро, 1E-06), n (нано, 1E-09), p (пико, 1E-"
"12), f (фемто, 1E-15), a (атто, 1E-18)."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 142
#: xml_doc.cpp:1332
msgid "CONVERT(Number; From Unit; To Unit)"
msgstr "CONVERT(Сан; Қай_бірліктен; Қай_бірлікке)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 143
#: xml_doc.cpp:1335
msgid "CONVERT(32;\"C\";\"F\") equals 89.6"
msgstr "CONVERT(32;\"C\";\"F\") нәтижесі 89,6"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 144
#: xml_doc.cpp:1338
msgid "CONVERT(3;\"lbm\";\"kg\") equals 1.3608"
msgstr "CONVERT(3;\"lbm\";\"kg\") нәтижесі 1,3608"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 145
#: xml_doc.cpp:1341
msgid "CONVERT(7.9;\"cal\";\"J\") equals 33.0757"
msgstr "CONVERT(7,9;\"cal\";\"J\") нәтижесі 33,0757"

