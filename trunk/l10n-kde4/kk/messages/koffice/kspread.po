#: xml_doc.cpp:3912
msgid "PEARSON(A1:A3; B1:B3)"
msgstr "PEARSON(A1:A3; B1:B3)"

#. i18n: file: functions/statistical.xml:935
#: xml_doc.cpp:3916
msgid "Number of elements to permutate"
msgstr "Орын алмастырымалы элементтер саны"

#. i18n: file: functions/statistical.xml:939
#: xml_doc.cpp:3918
msgid ""
"The PERMUT() function returns the number of permutations. The first "
"parameter is the number of elements, and the second parameter is the number "
"of elements used in the permutation."
msgstr ""
"PERMUT() функциясы орын алмастырымдар санын есептеп береді. Бірінші "
"параметрі элементтер саны, екінші параметрі - орын алмастыруға қатысатын "
"элементтер саны."

#. i18n: file: functions/statistical.xml:940
#: xml_doc.cpp:3920
msgid "PERMUT(total;permutated)"
msgstr "PERMUT(жалпы;орын_алм)"

#. i18n: file: functions/statistical.xml:941
#: xml_doc.cpp:3922
msgid "PERMUT(8;5) equals 6720"
msgstr "PERMUT(8;5) нәтижесі 6720"

#. i18n: file: functions/statistical.xml:942
#: xml_doc.cpp:3924
msgid "PERMUT(1;1) equals 1"
msgstr "PERMUT(1;1) нәтижесі 1"

#. i18n: file: functions/statistical.xml:950
#: xml_doc.cpp:3926
msgid ""
"The number for which the standard normal distribution is to be calculated"
msgstr "Осы сан үшін стандартты қалыпты үлестірімі есептеледі"

#. i18n: file: functions/statistical.xml:954
#: xml_doc.cpp:3928
msgid ""
"The PHI() function returns value of the distribution function for a standard "
"normal distribution."
msgstr ""
"PHI() функциясы стандартты қалыпты үлестірім функциясының мәнін қайтарады."

#. i18n: file: functions/statistical.xml:955
#: xml_doc.cpp:3930
msgid "PHI(value)"
msgstr "PHI(мән)"

