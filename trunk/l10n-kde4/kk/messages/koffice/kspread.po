#: xml_doc.cpp:3526 xml_doc.cpp:3529 xml_doc.cpp:3544 xml_doc.cpp:3547
#: xml_doc.cpp:3550 xml_doc.cpp:3553 xml_doc.cpp:3556 xml_doc.cpp:3571
#: xml_doc.cpp:3574 xml_doc.cpp:3577 xml_doc.cpp:3580 xml_doc.cpp:3583
#: xml_doc.cpp:3598 xml_doc.cpp:3601 xml_doc.cpp:3604 xml_doc.cpp:3607
#: xml_doc.cpp:3610
msgid "Boolean values"
msgstr "Логикалық мәндер"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 51
#: xml_doc.cpp:3505
msgid ""
"The AND() function returns True if all the values are true. Otherwise it "
"returns False (unless any of the values in an error - then it returns an "
"error)."
msgstr ""
"AND() функциясы барлық мәндері true (ақиқат) болса қайтаратыны True. Әйтпесе "
"қайтаратыны False (кемінде бірінің мәні қате болмаса, бұндайда қайтаратыны "
"қате белгісі)."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 52
#: xml_doc.cpp:3508
msgid "AND(value;value;...)"
msgstr "AND(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 53
#: xml_doc.cpp:3511
msgid "AND(true;true;true) returns True"
msgstr "AND(true;true;true) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 54
#: xml_doc.cpp:3514
msgid "AND(true;false) returns False"
msgstr "AND(true;false) қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 82
#: xml_doc.cpp:3532
msgid ""
"The OR() function returns True if at least one of the values is true. "
"Otherwise it returns False (unless any of the values is an error, then it "
"returns an error)."
msgstr ""
"OR() функциясы мәндерінің кемінде бірі true (ақиқат) болса қайтаратыны True. "
"Әйтпесе қайтаратыны False (кемінде бірінің мәні қате болмаса, бұндайда "
"қайтаратыны қате белгісі)."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 83
#: xml_doc.cpp:3535
msgid "OR(value;value;...)"
msgstr "OR(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 84
#: xml_doc.cpp:3538
msgid "OR(false;false;false) returns False"
msgstr "OR(false;false;false) қайтаратыны False"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 85
#: xml_doc.cpp:3541
msgid "OR(true;false) returns True"
msgstr "OR(true;false) қайтаратыны True"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 113
#: xml_doc.cpp:3559
msgid ""
"The NAND() function returns True if at least one value is not true. "
"Otherwise it returns False."
msgstr ""
"NAND() функциясы мәндерінің кемінде бірі true (ақиқат) емес болса "
"қайтаратыны True. Әйтпесе қайтаратыны False."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 114
#: xml_doc.cpp:3562
msgid "NAND(value;value;...)"
msgstr "NAND(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 115
#: xml_doc.cpp:3565
msgid "NAND(true;false;false) returns True"
msgstr "NAND(true;false;false) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 116
#: xml_doc.cpp:3568
msgid "NAND(true;true) returns False"
msgstr "NAND(true;true) қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 144
#: xml_doc.cpp:3586
msgid ""
"The NOR() function returns True if all the values given as parameters are of "
"boolean type and have the value false. Otherwise it returns False."
msgstr ""
"NOR() функциясы мәндерінің барлығы логикалық мән және false (жалған) болса "
"қайтаратыны True. Әйтпесе қайтаратыны False."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 145
#: xml_doc.cpp:3589
msgid "NOR(value;value;...)"
msgstr "NOR(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 146
#: xml_doc.cpp:3592
msgid "NOR(true;false;false) returns False"
msgstr "NOR(true;false;false) қайтаратыны False"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 147
#: xml_doc.cpp:3595
msgid "NOR(false;false) returns True"
msgstr "NOR(false;false) қайтаратыны True"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 175
#: xml_doc.cpp:3613
msgid ""
"The XOR() function returns True if the number of True values is even. "
"Otherwise it returns False. It returns an error if any argument is an error."
msgstr ""
"XOR() функциясы мәндерінің арасындағы true (ақиқат) мәндер саны жұп болса "
"қайтаратыны True. Әйтпесе қайтаратыны False. Аргументінің кем дегенде біреуі "
"қате болса қайтаратыны қате белгісі."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 176
#: xml_doc.cpp:3616
msgid "XOR(value;value;...)"
msgstr "XOR(мән;мән;...)"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 177
#: xml_doc.cpp:3619
msgid "XOR(false;false;false) returns True"
msgstr "XOR(false;false;false) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 178
#: xml_doc.cpp:3622
msgid "XOR(true;false) returns False"
msgstr "XOR(true;false) қайтаратыны False"

#. i18n: tag Comment
#. i18n: file functions/logic.xml line 186
#: xml_doc.cpp:3625
msgid "Boolean value"
msgstr "Логикалық мән"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 190
#: xml_doc.cpp:3628
msgid ""
"The NOT() function returns True if the value is False and returns False if "
"the value is True. It returns an error if the input in an error."
msgstr ""
"NOT() функциясы, егер тапсырылғаны True болса, қайтаратыны False және "
"тапсырылғаны False болса, қайтаратыны True. Кірісінде қате болса, қатені "
"қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 191
#: xml_doc.cpp:3631
msgid "NOT(bool)"
msgstr "NOT(логиқалық_мән)"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 192
#: xml_doc.cpp:3634
msgid "NOT(false) returns True"
msgstr "NOT(false) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 193
#: xml_doc.cpp:3637
msgid "NOT(true) returns False"
msgstr "NOT(true) қайтаратыны False"

#. i18n: tag Comment
#. i18n: file functions/logic.xml line 201
#: xml_doc.cpp:3640
msgid "Condition"
msgstr "Шарт"

#. i18n: tag Comment
#. i18n: file functions/logic.xml line 205
#: xml_doc.cpp:3643
msgid "If true"
msgstr "Егер ақиқат болса"

#. i18n: tag Comment
#. i18n: file functions/logic.xml line 209
#: xml_doc.cpp:3646
msgid "If false"
msgstr "Егер жалған болса"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 213
#: xml_doc.cpp:3649
msgid ""
"The IF() function is a conditional function. This function returns the "
"second parameter if the condition is True. Otherwise it returns the third "
"parameter (which defaults to being false)."
msgstr ""
"IF() функциясы шарт функция. Егер шарты True (ақиқат) болса екінші "
"параметрін қайтарады. Әйтпесе (false - жалған болса) үшінші параметрін "
"қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 214
#: xml_doc.cpp:3652
msgid "IF(condition;if_true;if_false)"
msgstr "IF(шарт;ақиқат_болса;жалған_болса)"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 215
#: xml_doc.cpp:3655
msgid "A1=4;A2=6;IF(A1>A2;5;3) returns 3"
msgstr "A1=4;A2=6;IF(A1>A2;5;3) қайтаратыны 3"

#. i18n: tag GroupName
#. i18n: file functions/math.xml line 5
#: xml_doc.cpp:3658
msgid "Math"
msgstr "Математикалық"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 11
#: xml_doc.cpp:3661 dialogs/FormulaDialog.cpp:67
msgid "Function"
msgstr "Функция"

#. i18n: tag Text
#. i18n: file functions/math.xml line 19
#: xml_doc.cpp:3667
msgid ""
"The SUBTOTAL() function returns a subtotal of a given list of arguments "
"ignoring other subtotal results in there. Function can be one of the "
"following numbers: 1 - Average, 2 - Count, 3 - CountA, 4 - Max, 5 - Min, 6 - "
"Product, 7 - StDev, 8 - StDevP, 9 - Sum, 10 - Var, 11 - VarP."
msgstr ""
"SUBTOTAL() функциясы берлген аргументтер тізімінің қортындысын есептеп "
"береді. Тізімінде кездескен басқа қортындылар есепке алынбайды. Есептегенде "
"қолданатын функциясы келесі бір нөмірімен белгіленіп беріледі: 1 - Average, "
"2 - Count, 3 - CountA, 4 - Max, 5 - Min, 6 - Product, 7 - StDev, 8 - StDevP, "
"9 - Sum, 10 - Var, 11 - VarP."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 20
#: xml_doc.cpp:3670
msgid "SUBTOTAL(function; value)"
msgstr "SUBTOTAL(функция; мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 21
#: xml_doc.cpp:3673
msgid "If A1:A5 contains 7, 24, 23, 56 and 9:"
msgstr "Егер A1:A5 мазмұны 7, 24, 23, 56, 9 болса:"

#. i18n: tag Example
#. i18n: file functions/math.xml line 22
#: xml_doc.cpp:3676
msgid "SUBTOTAL(1; A1:A5) returns 23.8"
msgstr "SUBTOTAL(1; A1:A5) қайтаратыны 23.8"

#. i18n: tag Example
#. i18n: file functions/math.xml line 23
#: xml_doc.cpp:3679
msgid "SUBTOTAL(4; A1:A5) returns 56"
msgstr "SUBTOTAL(4; A1:A5) қайтаратыны 56"

#. i18n: tag Example
#. i18n: file functions/math.xml line 24
#: xml_doc.cpp:3682
msgid "SUBTOTAL(9; A1:A5) returns 119"
msgstr "SUBTOTAL(9; A1:A5) қайтаратыны 119"

#. i18n: tag Example
#. i18n: file functions/math.xml line 25
#: xml_doc.cpp:3685
msgid "SUBTOTAL(11; A1:A5) returns 307.76"
msgstr "SUBTOTAL(11; A1:A5) қайтаратыны 307.76"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 44
#: xml_doc.cpp:3688
msgid "X the independent variable of the power series"
msgstr "X дәрежелік қатардың тәуелсіз айнымалысы"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 48
#: xml_doc.cpp:3691
msgid "N the initial power to which X is to be raised"
msgstr "N деген X-тің бастапқы шығарылатын дәрежесі"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 52
#: xml_doc.cpp:3694
msgid "M the increment by which to increase N for each term in the series"
msgstr "M қатардың әрбір келесі мүшесінің N-ды үлкейту қадамы"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 56
#: xml_doc.cpp:3697
msgid ""
"Coefficients a set of coefficients by which each sccessive power of the "
"variable X is multiplied"
msgstr ""
"Коэффициенттері деген әрбір келесі дәрежелі X-тің көбейткіш коэффициенттер "
"жиыны"

#. i18n: tag Text
#. i18n: file functions/math.xml line 60
#: xml_doc.cpp:3700
msgid "The SERIESSUM() function returns the sum of a power series."
msgstr "SERIESSUM() функциясы дәрежелік қатарының қосындысын есептеп береді."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 61
#: xml_doc.cpp:3703
msgid "SERIESSUM( X; N; M; Coefficients)"
msgstr "SERIESSUM( X; N; M; Коэффициенттері)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 62
#: xml_doc.cpp:3706
msgid "SERIESSUM(2;0;2;{1;2}) return 9"
msgstr "SERIESSUM(2;0;2;{1;2}) қайтаратыны 9"

#. i18n: tag Text
#. i18n: file functions/math.xml line 79
#: xml_doc.cpp:3715
msgid ""
"The LCM() function returns the least common multiple for two or more float "
"values"
msgstr ""
"LCM() функциясы екі не одан да артық нақты сандарының ең кіші ортақ еселігін "
"қайтарады"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 80
#: xml_doc.cpp:3718
msgid "LCM(value; value)"
msgstr "LCM(мән;мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 81
#: xml_doc.cpp:3721
msgid "LCM(6;4) returns 12"
msgstr "LCM(6;4) қайтаратыны 12"

#. i18n: tag Example
#. i18n: file functions/math.xml line 82
#: xml_doc.cpp:3724
msgid "LCM(1.5;2.25) returns 4.5"
msgstr "LCM(1,5;2,25) қайтаратыны 4,5"

#. i18n: tag Example
#. i18n: file functions/math.xml line 83
#: xml_doc.cpp:3727
msgid "LCM(2;3;4) returns 12"
msgstr "LCM(2;3;4) қайтаратыны 12"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 100
#: xml_doc.cpp:3736
msgid "Third number"
msgstr "Үшінші сан"

#. i18n: tag Text
#. i18n: file functions/math.xml line 104
#: xml_doc.cpp:3739
msgid ""
"The GCD() function returns the greatest common denominator for two or more "
"integer values."
msgstr ""
"GCD() функциясы екі не одан да артық бүтін сандарының ең үлкен ортақ "
"бөлгішін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 105
#: xml_doc.cpp:3742
msgid "GCD(value; value)"
msgstr "GCD(мән;мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 106
#: xml_doc.cpp:3745
msgid "GCD(6;4) returns 2"
msgstr "GCD(6;4) қайтаратыны 2"

#. i18n: tag Example
#. i18n: file functions/math.xml line 107
#: xml_doc.cpp:3748
msgid "GCD(10;20) returns 10"
msgstr "GCD(10;20) қайтаратыны 10"

#. i18n: tag Example
#. i18n: file functions/math.xml line 108
#: xml_doc.cpp:3751
msgid "GCD(20;15;10) returns 5"
msgstr "GCD(20;15;10) қайтаратыны 5"

#. i18n: tag Text
#. i18n: file functions/math.xml line 117
#: xml_doc.cpp:3754
msgid ""
"EPS() returns the machine epsilon; this is the difference between 1 and the "
"next largest floating-point number. Because computers use a finite number of "
"digits, roundoff error is inherent (but usually insignificant) in all "
"calculations."
msgstr ""
"EPS() компьютердің эпсилон шамасын қайтатады; бұл 1 және келесі одан артық "
"бірақ мейілінше жақын жылжымалы үтірлі санмен айырмашылығы. Компьютерде сан "
"таңбалары шектеулі болғандықтан есептегенде дөңгелектеу қателігінен құтылуға "
"болмайды (бірақ әдетте ол мардымсыз деуге болады)."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 118
#: xml_doc.cpp:3757
msgid "EPS()"
msgstr "EPS()"

#. i18n: tag Example
#. i18n: file functions/math.xml line 119
#: xml_doc.cpp:3760
msgid "On most systems, this returns 2^-52=2.2204460492503131e-16"
msgstr "Жүйелерінің көбінде бұл 2^-52=2.2204460492503131e-16"

#. i18n: tag Example
#. i18n: file functions/math.xml line 120
#: xml_doc.cpp:3763
msgid ""
"0.5*EPS() returns the \"unit round\"; this value is interesting because it "
"is the largest number x where (1+x)-1=0 (due to roundoff errors)."
msgstr ""
"0,5*EPS() деген \"дөңгелектеу бірлігін\" қайтарады; бұл сан дөңгелектеу "
"қателігі салдарынан (1+x)-1=0 нәтижеге әкелетін ең үлкен x саны."

#. i18n: tag Example
#. i18n: file functions/math.xml line 121
#: xml_doc.cpp:3766
msgid "EPS() is so small that KSpread displays 1+eps() as 1"
msgstr ""
"EPS() кішілігі соңшалықты сан, KSpread-те 1+eps() деген өрнек тұра 1-ге тең "
"деп көрсетіледі"

#. i18n: tag Example
#. i18n: file functions/math.xml line 122
#: xml_doc.cpp:3769
msgid ""
"Pick a number x between 0 and EPS(). Observe that 1+x rounds x to either 0 "
"or EPS() by using the equation (1+x)-1"
msgstr ""
"x саның 0 мен EPS() арасында қылып таңдаңыз. Дөңгелектеу 1+x өрнегінде, (1"
"+x)-1 формуласын пайдаланып, x-ті 0 немесе EPS() қылады"

#. i18n: tag Text
#. i18n: file functions/math.xml line 138
#: xml_doc.cpp:3778
msgid ""
"The POWER(x;y) function returns the value of x raised to the power of y."
msgstr "POWER(x;y) функциясы x-ті y дәрежесіне шығарып береді."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 139
#: xml_doc.cpp:3781
msgid "POWER(value;value)"
msgstr "POWER(мән;мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 140
#: xml_doc.cpp:3784
msgid "POWER(1.2;3.4) equals 1.8572"
msgstr "POWER(1,2;3,4) нәтижесі 1,8572"

#. i18n: tag Example
#. i18n: file functions/math.xml line 141
#: xml_doc.cpp:3787
msgid "POWER(2;3) equals 8"
msgstr "POWER(2;3) нәтижесі 8"

#. i18n: tag Text
#. i18n: file functions/math.xml line 158
#: xml_doc.cpp:3796
msgid ""
"The POW(x;y) function returns the value of x raised to the power of y. It's "
"the same as POWER."
msgstr ""
"POW(x;y) функциясы x-ті y дәрежесіне шығарып береді. Бұл функция POWER "
"функциясымен бірдей."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 159
#: xml_doc.cpp:3799
msgid "POW(value;value)"
msgstr "POW(мән;мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 160
#: xml_doc.cpp:3802
msgid "POW(1.2;3.4) equals 1.8572"
msgstr "POW(1,2;3,4) нәтижесі 1,8572"

#. i18n: tag Example
#. i18n: file functions/math.xml line 161
#: xml_doc.cpp:3805
msgid "POW(2;3) equals 8"
msgstr "POW(2;3) нәтижесі 8"

#. i18n: tag Text
#. i18n: file functions/math.xml line 174
#: xml_doc.cpp:3811
msgid ""
"The EVEN() function returns the number rounded up to the nearest even "
"integer."
msgstr ""
"EVEN() функциясы оң/теріс санды ең жақын артық/кем жүп бүтін санға дейін "
"өсіріп/кемітіп береді."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 175
#: xml_doc.cpp:3814
msgid "EVEN(value)"
msgstr "EVEN(мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 176
#: xml_doc.cpp:3817
msgid "EVEN(1.2) returns 2"
msgstr "EVEN(1,2) қайтаратыны 2"

#. i18n: tag Example
#. i18n: file functions/math.xml line 177
#: xml_doc.cpp:3820
msgid "EVEN(2) returns 2"
msgstr "EVEN(2) қайтаратыны 2"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 190
#: xml_doc.cpp:3826
msgid "Precision"
msgstr "Дәлдігі"

#. i18n: tag Text
#. i18n: file functions/math.xml line 194
#: xml_doc.cpp:3829
msgid ""
"The TRUNC() function truncates a numeric value to a certain precision. If "
"the precision is omitted 0 is assumed."
msgstr ""
"TRUNC() функциясы санды көрсетілген дәлдігіне (ондық бөлшек таңбалар санына) "
"дейін қысқартып тастайды. Егер дәлдігі келтірілмесе, ол 0 деп саналып санның "
"бүтін бөлігі ғана қалдырылады."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 195
#: xml_doc.cpp:3832
msgid "TRUNC(value; precision)"
msgstr "TRUNC(мән; дәлдігі)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 196
#: xml_doc.cpp:3835
msgid "TRUNC(1.2) returns 1"
msgstr "TRUNC(1,2) қайтаратыны 1"

#. i18n: tag Example
#. i18n: file functions/math.xml line 197
#: xml_doc.cpp:3838
msgid "TRUNC(213.232; 2) returns 213.23"
msgstr "TRUNC(213,232; 2) қайтаратыны 213,23"

#. i18n: tag Text
#. i18n: file functions/math.xml line 212
#: xml_doc.cpp:3844
msgid ""
"The ODD() function returns the number rounded up (or down, for negative "
"values) to the nearest odd integer. By definition, ODD(0) is 1."
msgstr ""
"ODD() функциясы оң/теріс санды ең жақын артық/кем тақ бүтін санға дейін "
"өсіріп/кемітіп береді. ODD(0) нәтижесі 1 деп саналады."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 213
#: xml_doc.cpp:3847
msgid "ODD(value)"
msgstr "ODD(мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 214
#: xml_doc.cpp:3850
msgid "ODD(1.2) returns 3"
msgstr "ODD(1,2) қайтаратыны 3"

#. i18n: tag Example
#. i18n: file functions/math.xml line 215
#: xml_doc.cpp:3853
msgid "ODD(2) returns 3"
msgstr "ODD(2) қайтаратыны 3"

#. i18n: tag Example
#. i18n: file functions/math.xml line 216
#: xml_doc.cpp:3856
msgid "ODD(-2) returns -3"
msgstr "ODD(-2) қайтаратыны -3"

#. i18n: tag Text
#. i18n: file functions/math.xml line 229
#: xml_doc.cpp:3862
msgid "The GAMMA() function returns the gamma function value."
msgstr "GAMMA() - гамма функциясын есептеп береді."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 230
#: xml_doc.cpp:3865
msgid "GAMMA(value)"
msgstr "GAMMA(мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 231
#: xml_doc.cpp:3868
msgid "GAMMA(1) returns 1"
msgstr "GAMMA(1) қайтаратыны 1"

#. i18n: tag Text
#. i18n: file functions/math.xml line 248
#: xml_doc.cpp:3877
msgid ""
"The MOD() function returns the remainder after division. If the second "
"parameter is null the function returns #DIV/0."
msgstr ""
"MOD() функциясы бөлудің қалдығын қайтарады. Егер екінші параметрі нөл болса "
"оның қайтаратыны #DIV/0 қатесі."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 249
#: xml_doc.cpp:3880
msgid "MOD(value;value)"
msgstr "MOD(мән;мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 250
#: xml_doc.cpp:3883
msgid "MOD(12;5) returns 2"
msgstr "MOD(12;5) қайтаратыны 2"

#. i18n: tag Example
#. i18n: file functions/math.xml line 251
#: xml_doc.cpp:3886
msgid "MOD(5;5) returns 0"
msgstr "MOD(5;5) қайтаратыны 0"

#. i18n: tag Text
#. i18n: file functions/math.xml line 264
#: xml_doc.cpp:3892
msgid ""
"This function returns -1 if the number is negative, 0 if the number is null "
"and 1 if the number is positive."
msgstr ""
"Бұл функция тапсырылған сан теріс болса -1 қайтарады, 0 тапсырылса 0 "
"қайтарады, оң сан тапсырылса 1 қайтарылады."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 265
#: xml_doc.cpp:3895
msgid "SIGN(value)"
msgstr "SIGN(мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 266
#: xml_doc.cpp:3898
msgid "SIGN(5) equals 1"
msgstr "SIGN(5) нәтижесі 1"

#. i18n: tag Example
#. i18n: file functions/math.xml line 267
#: xml_doc.cpp:3901
msgid "SIGN(0) equals 0"
msgstr "SIGN(0) нәтижесі 0"

#. i18n: tag Example
#. i18n: file functions/math.xml line 268
#: xml_doc.cpp:3904
msgid "SIGN(-5) equals -1"
msgstr "SIGN(-5) нәтижесі -1"

#. i18n: tag Text
#. i18n: file functions/math.xml line 280
#: xml_doc.cpp:3910
msgid "This function multiplies each value by -1."
msgstr "Бұл функция тапсырылған санды терістейді (-1-ге көбейтеді)."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 281
#: xml_doc.cpp:3913
msgid "INV(value)"
msgstr "INV(мән)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 282
#: xml_doc.cpp:3916
msgid "INV(-5) equals 5"
msgstr "INV(-5) нәтижесі 5"

#. i18n: tag Example
#. i18n: file functions/math.xml line 283
#: xml_doc.cpp:3919
msgid "INV(5) equals -5"
msgstr "INV(5) нәтижесі -5"

#. i18n: tag Example
#. i18n: file functions/math.xml line 284
#: xml_doc.cpp:3922
msgid "INV(0) equals 0"
msgstr "INV(0) нәтижесі 0"

#. i18n: tag Text
#. i18n: file functions/math.xml line 296
#: xml_doc.cpp:3928
msgid ""
"This function returns the count of integer or floating arguments passed. You "
"can count using a range: COUNT(A1:B5) or using a list of values like COUNT"
"(12;5;12.5)."
msgstr ""
"Бұл функция тапсырылған параметрлердің қатарында қаншасы (бүтін не бөлшекті) "
"сан екенін санап береді. Тапсырғанда ұяшық аумағын көрсетуге болады, мысалы "
"былай: COUNT(A1:B5) немесе тікелей мәндерін келтіруге болады, мысалы, былай: "
"COUNT(12;5;12,5)."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 297
#: xml_doc.cpp:3931
msgid "COUNT(value;value;value...)"
msgstr "COUNT(мән;мән;мән...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 298
#: xml_doc.cpp:3934
msgid "COUNT(-5;\"KSpread\";2) returns 2"
msgstr "COUNT(-5;\"KSpread\";2) қайтаратыны 2"

#. i18n: tag Example
#. i18n: file functions/math.xml line 299
#: xml_doc.cpp:3937
msgid "COUNT(5) returns 1"
msgstr "COUNT(5) қайтаратыны 1"

#. i18n: tag Text
#. i18n: file functions/math.xml line 314
#: xml_doc.cpp:3943
msgid ""
"This function returns the count of all non empty arguments passed. You can "
"count using a range: COUNTA(A1:B5) or using a list of values like COUNTA"
"(12;5;12.5)."
msgstr ""
"Бұл функция параметрлердің қатарында қаншасы келтірілген (бос емес) екенін "
"санап береді. Тапсырғанда ұяшық аумағын көрсетуге болады, мысалы былай: "
"COUNTA(A1:B5) немесе тікелей мәндерін келтіруге болады, мысалы, былай: COUNTA"
"(12;5;12,5)."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 315
#: xml_doc.cpp:3946
msgid "COUNTA(value;value;value...)"
msgstr "COUNTA(мән;мән;мән...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 316
#: xml_doc.cpp:3949
msgid "COUNTA(-5;\"KSpread\";2) returns 3"
msgstr "COUNTA(-5;\"KSpread\";2) қайтаратыны 3"

#. i18n: tag Example
#. i18n: file functions/math.xml line 317
#: xml_doc.cpp:3952
msgid "COUNTA(5) returns 1"
msgstr "COUNTA(5) қайтаратыны 1"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 327
#: xml_doc.cpp:3955
msgid "Cell range"
msgstr "Ұяшық аумағы"

#. i18n: tag Text
#. i18n: file functions/math.xml line 331
#: xml_doc.cpp:3958
msgid "This function returns the count of all empty cells within the range."
msgstr ""
"Бұл функция келтірілген ұяшықтар аумағында қаншасы бос ұяшық екенін санап "
"береді."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 332
#: xml_doc.cpp:3961
msgid "COUNTBLANK(range)"
msgstr "COUNTBLANK(аумағы)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 333
#: xml_doc.cpp:3964
msgid "COUNTBLANK(A1:B5)"
msgstr "COUNTBLANK(A1:B5)"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 344
#. i18n: tag Comment
#. i18n: file functions/math.xml line 1201
#: xml_doc.cpp:3967 xml_doc.cpp:4710
msgid "Range"
msgstr "Аумағы"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 348
#. i18n: tag Comment
#. i18n: file functions/math.xml line 433
#: xml_doc.cpp:3970 xml_doc.cpp:4045
msgid "Criteria"
msgstr "Шарт"

#. i18n: tag Text
#. i18n: file functions/math.xml line 352
#: xml_doc.cpp:3973
msgid ""
"The COUNTIF() function returns the number of cells in the given range that "
"meet the given criteria."
msgstr ""
"COUNTIF() функциясы келтірілген ұяшықтар аумағында қаншасы келтірілген "
"шартқа сәйкесті екенін санап береді."

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 353
#: xml_doc.cpp:3976
msgid "COUNTIF(range;criteria)"
msgstr "COUNTIF(аумағы;шарты)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 354
#: xml_doc.cpp:3979
msgid "COUNTIF(A2:A3;\"14\") returns 1 if A1 is -4 and A2 is 14"
msgstr ""
"COUNTIF(A1:A2;\"14\"), егер A1 ұяшығында -4 және A2 ұяшығында 14 болса, "
"қайтаратыны 1"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 364
#. i18n: tag Comment
#. i18n: file functions/math.xml line 379
#. i18n: tag Comment
#. i18n: file functions/math.xml line 654
#. i18n: tag Comment
#. i18n: file functions/math.xml line 670
#. i18n: tag Comment
#. i18n: file functions/math.xml line 684
#. i18n: tag Comment
#. i18n: file functions/math.xml line 702
#. i18n: tag Comment
