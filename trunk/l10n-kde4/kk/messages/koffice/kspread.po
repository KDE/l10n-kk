#. i18n: tag Text
#. i18n: file functions/information.xml line 58
#: xml_doc.cpp:3235
msgid ""
"The ISLOGICAL() function returns True if the parameter is a boolean value. "
"Otherwise it returns False."
msgstr ""
"ISLOGICAL() функциясы, параметрдегісі логикалық мән болса, қайтаратыны True. "
"Әйтпесе False дейді."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 59
#: xml_doc.cpp:3238
msgid "ISLOGICAL(x)"
msgstr "ISLOGICAL(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 60
#: xml_doc.cpp:3241
msgid "ISLOGICAL(A1>A2) returns True"
msgstr "ISLOGICAL(A1>A2) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 61
#: xml_doc.cpp:3244
msgid "ISLOGICAL(12) returns False"
msgstr "ISLOGICAL(12) қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 73
#: xml_doc.cpp:3250
msgid ""
"The ISBLANK() function returns True if the parameter is empty. Otherwise it "
"returns False."
msgstr ""
"ISBLANK() функциясы, параметрдегісі бос болса, қайтаратыны True. Әйтпесе "
"False дейді."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 74
#: xml_doc.cpp:3253
msgid "ISBLANK(x)"
msgstr "ISBLANK(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 75
#: xml_doc.cpp:3256
msgid "ISBLANK(A1) returns True if A1 is empty"
msgstr "ISBLANK(A1), егер A1 бос болса, True дегенді қайтарады"

#. i18n: tag Example
#. i18n: file functions/information.xml line 76
#: xml_doc.cpp:3259
msgid "ISBLANK(A1) returns False if A1 holds a value"
msgstr "ISBLANK(A1) егер A1 бос болмаса False дегенді қайтарады"

#. i18n: tag Text
#. i18n: file functions/information.xml line 88
#: xml_doc.cpp:3265
msgid ""
"The ISNUMBER() function returns True if the parameter is a numerical value. "
"Otherwise it returns False. It's the same as ISNUM."
msgstr ""
"ISNUMBER() функциясы, параметрдегісі сан болса, қайтаратыны True. Әйтпесе "
"False дейді. Бұл функция ISNUM функциясымен бірдей."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 89
#: xml_doc.cpp:3268
msgid "ISNUMBER(x)"
msgstr "ISNUMBER(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 90
#: xml_doc.cpp:3271
msgid "ISNUMBER(12) returns True"
msgstr "ISNUMBER(12) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 91
#: xml_doc.cpp:3274
msgid "ISNUMBER(hello) returns False"
msgstr "ISNUMBER(\"сәлем\") қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 104
#: xml_doc.cpp:3280
msgid ""
"The ISNUM() function returns True if the parameter is a numerical value. "
"Otherwise it returns False. It's the same as ISNUMBER."
msgstr ""
"ISNUM() функциясы, параметрдегісі сан болса, қайтаратыны True. Әйтпесе False "
"дейді. Бұл функция ISNUMBER функциясымен бірдей."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 105
#: xml_doc.cpp:3283
msgid "ISNUM(x)"
msgstr "ISNUM(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 106
#: xml_doc.cpp:3286
msgid "ISNUM(12) returns True"
msgstr "ISNUM(12) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 107
#: xml_doc.cpp:3289
msgid "ISNUM(hello) returns False"
msgstr "ISNUM(\"сәлем\") қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 120
#: xml_doc.cpp:3295
msgid ""
"The ISTIME() function returns True if the parameter is a time value. "
"Otherwise it returns False."
msgstr ""
"ISTIME() функциясы, параметрдегісі уақыт болса, қайтаратыны True. Әйтпесе "
"False дейді."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 121
#: xml_doc.cpp:3298
msgid "ISTIME(x)"
msgstr "ISTIME(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 122
#: xml_doc.cpp:3301
msgid "ISTIME(\"12:05\") returns True"
msgstr "ISTIME(\"12:05\") қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 123
#: xml_doc.cpp:3304
msgid "ISTIME(\"hello\") returns False"
msgstr "ISTIME(\"сәлем\") қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 135
#: xml_doc.cpp:3310
msgid ""
"The ISDATE() function returns True if the parameter is a date value. "
"Otherwise it returns False"
msgstr ""
"ISDATE() функциясы, параметрдегісі күн белгісі болса, қайтаратыны True. "
"Әйтпесе False дейді"

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 136
#: xml_doc.cpp:3313
msgid "ISDATE(x)"
msgstr "ISDATE(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 137
#: xml_doc.cpp:3316
msgid "ISDATE(\"2000-2-2\") returns True"
msgstr "ISDATE(\"02.02.2000\") қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 138
#: xml_doc.cpp:3319
msgid "ISDATE(\"hello\") returns False"
msgstr "ISDATE(\"сәлем\") қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 150
#: xml_doc.cpp:3325
msgid ""
"The ISREF() function returns True if the parameter refers to a reference. "
"Otherwise it returns False"
msgstr ""
"ISREF() функциясы, параметрі сілтеме болса, қайтаратыны True. Әйтпесе False "
"дейді"

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 151
#: xml_doc.cpp:3328
msgid "ISREF(x)"
msgstr "ISREF(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 152
#: xml_doc.cpp:3331
msgid "ISREF(A12) returns true"
msgstr "ISREF(A12) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 153
#: xml_doc.cpp:3334
msgid "ISREF(\"hello\") returns false"
msgstr "ISREF(\"сәлем\") қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 165
#: xml_doc.cpp:3340
msgid ""
"The ISTEXT() function returns True if the parameter is a string. Otherwise "
"it returns False"
msgstr ""
"ISTEXT() функциясы, параметрдегісі мәтін болса, қайтаратыны True. Әйтпесе "
"False дейді"

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 166
#: xml_doc.cpp:3343
msgid "ISTEXT(x)"
msgstr "ISTEXT(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 167
#: xml_doc.cpp:3346
msgid "ISTEXT(12) returns False"
msgstr "ISTEXT(12) қайтаратыны False"

#. i18n: tag Example
#. i18n: file functions/information.xml line 168
#: xml_doc.cpp:3349
msgid "ISTEXT(\"hello\") returns True"
msgstr "ISTEXT(\"сәлем\") қайтаратыны True"

#. i18n: tag Text
#. i18n: file functions/information.xml line 180
#: xml_doc.cpp:3355
msgid ""
"The ISNONTEXT() function returns True if the parameter is not a string. "
"Otherwise it returns False. It's the same as ISNOTTEXT."
msgstr ""
"ISNONTEXT() функциясы, параметрдегісі мәтін емес болса, қайтаратыны True. "
"Әйтпесе False дейді. Бұл функция ISNOTTEXT функциясымен бірдей."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 181
#: xml_doc.cpp:3358
msgid "ISNONTEXT(x)"
msgstr "ISNONTEXT(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 182
#: xml_doc.cpp:3361
msgid "ISNONTEXT(12) returns True"
msgstr "ISNONTEXT(12) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 183
#: xml_doc.cpp:3364
msgid "ISNONTEXT(\"hello\") returns False"
msgstr "ISNONTEXT(\"сәлем\") қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 196
#: xml_doc.cpp:3370
msgid ""
"The ISNOTTEXT() function returns True if the parameter is not a string. "
"Otherwise it returns False. It's the same as ISNONTEXT."
msgstr ""
"ISNOTTEXT() функциясы, параметрдегісі мәтін емес болса, қайтаратыны True. "
"Әйтпесе False дейді. Бұл функция ISNOTEXT функциясымен бірдей."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 197
#: xml_doc.cpp:3373
msgid "ISNOTTEXT(x)"
msgstr "ISNOTTEXT(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 198
#: xml_doc.cpp:3376
msgid "ISNOTTEXT(12) returns True"
msgstr "ISNOTTEXT(12) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 199
#: xml_doc.cpp:3379
msgid "ISNOTTEXT(\"hello\") returns False"
msgstr "ISNOTTEXT(\"сәлем\") қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 212
#: xml_doc.cpp:3385
msgid ""
"The ISODD() function returns True if the number is odd. Otherwise returns "
"False."
msgstr ""
"ISODD() функциясы, параметрдегісі тақ сан болса, қайтаратыны True. Әйтпесе "
"False дейді."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 213
#: xml_doc.cpp:3388
msgid "ISODD(x)"
msgstr "ISODD(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 214
#: xml_doc.cpp:3391
msgid "ISODD(12) returns False"
msgstr "ISODD(12) қайтаратыны False"

#. i18n: tag Example
#. i18n: file functions/information.xml line 215
#: xml_doc.cpp:3394
msgid "ISODD(-7) returns True"
msgstr "ISODD(-7) қайтаратыны True"

#. i18n: tag Text
#. i18n: file functions/information.xml line 227
#: xml_doc.cpp:3400
msgid ""
"The ISEVEN() function returns True if the number is even. Otherwise returns "
"False."
msgstr ""
"ISEVEN() функциясы, параметрдегісі жұп сан болса, қайтаратыны True. Әйтпесе "
"False дейді."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 228
#: xml_doc.cpp:3403
msgid "ISEVEN(x)"
msgstr "ISEVEN(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 229
#: xml_doc.cpp:3406
msgid "ISEVEN(12) returns True"
msgstr "ISEVEN(12) қайтаратыны True"

#. i18n: tag Example
#. i18n: file functions/information.xml line 230
#: xml_doc.cpp:3409
msgid "ISEVEN(-7) returns False"
msgstr "ISEVEN(-7) қайтаратыны False"

#. i18n: tag Text
#. i18n: file functions/information.xml line 242
#: xml_doc.cpp:3415
msgid ""
"The ISERR() function returns True if its parameter is an error other than N/"
"A. Otherwise, it returns False. Use ISERROR() if you want to include the N/A "
"error as well."
msgstr ""
"ISERR() функциясы, параметрдегісі қатесі А/Ж (ақпарат жоқ) қатесінен басқа "
"болса, қайтаратыны True. Әйтпесе False дейді. Егер А/Ж қателер қатарынан "
"бөлінбесін десеңіз ISERROR() функциясын қолданыңыз."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 243
#: xml_doc.cpp:3418
msgid "ISERR(x)"
msgstr "ISERR(x)"

#. i18n: tag Text
#. i18n: file functions/information.xml line 257
#: xml_doc.cpp:3424
msgid ""
"The ISERROR() function returns True if its parameter is an error of any "
"type. Otherwise, it returns False."
msgstr ""
"ISERROR() функциясы, параметрдегісі түрі кез келген қате белгісі болса, "
"қайтаратыны True. Әйтпесе False дейді."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 258
#: xml_doc.cpp:3427
msgid "ISERROR(x)"
msgstr "ISERROR(x)"

#. i18n: tag Text
#. i18n: file functions/information.xml line 272
#: xml_doc.cpp:3433
msgid ""
"The ISNA() function returns True if its parameter is a N/A error. In all "
"other cases, it returns False."
msgstr ""
"ISNA() функциясы, параметрдегісі қатесі А/Ж (ақпарат жоқ) қатесі болса, "
"қайтаратыны True. Әйтпесе False дейді."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 273
#: xml_doc.cpp:3436
msgid "ISNA(x)"
msgstr "ISNA(x)"

#. i18n: tag Text
#. i18n: file functions/information.xml line 283
#: xml_doc.cpp:3439
msgid "The NA() function returns the constant error value, N/A."
msgstr "NA() функциясы тек қана А/Ж (ақпарат жоқ) қате белгісін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 284
#: xml_doc.cpp:3442
msgid "NA()"
msgstr "NA()"

#. i18n: tag Text
#. i18n: file functions/information.xml line 299
#: xml_doc.cpp:3448
msgid ""
"The TYPE() function returns 1 if the value is a number, 2 if it is text, 4 "
"if the value is a logical value, 16 if it is an error value or 64 if the "
"value is an array. If the cell the value represents contains a formula you "
"get its return type."
msgstr ""
"TYPE() функциясы параметрдегісі сан болса қайтаратыны 1, мәтін болса 2, "
"логикалық мән болса 4, қате белгісі болса 16, жиым болса 64. Егер сілтегені "
"формуласы бар ұяшық болса - формуласы қайтаратынның түрі қарастырлады."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 300
#: xml_doc.cpp:3451
msgid "TYPE(x)"
msgstr "TYPE(x)"

#. i18n: tag Example
#. i18n: file functions/information.xml line 301
#: xml_doc.cpp:3454
msgid "TYPE(A1) returns 2, if A1 contains \"Text\""
msgstr "TYPE(A1), егер A1 мазмұны \"Мәтін\" болса, қайтаратыны 2"

#. i18n: tag Example
#. i18n: file functions/information.xml line 302
#: xml_doc.cpp:3457
msgid "TYPE(-7) returns 1"
msgstr "TYPE(-7) қайтаратыны 1"

#. i18n: tag Example
#. i18n: file functions/information.xml line 303
#: xml_doc.cpp:3460
msgid "TYPE(A2) returns 1, if A2 contains \"=CURRENTDATE()\""
msgstr "TYPE(A2), егер A2 мазмұны \"=CURRENTDATE()\" болса, қайтаратыны 1"

#. i18n: tag Text
#. i18n: file functions/information.xml line 311
#: xml_doc.cpp:3463
msgid ""
"Returns the current filename. If the current document is not saved, an empty "
"string is returned."
msgstr ""
"Осы құжаттың файл атауын қайтарады. Егер құжат әлі сақталмаған болса - бос "
"жол қайтарылады."

#. i18n: tag Syntax
#. i18n: file functions/information.xml line 312
#: xml_doc.cpp:3466
msgid "FILENAME()"
msgstr "FILENAME()"

#. i18n: tag GroupName
#. i18n: file functions/logic.xml line 5
#: xml_doc.cpp:3469
msgid "Logical"
msgstr "Логикалық"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 11
#: xml_doc.cpp:3472
msgid "The FALSE() function returns the boolean value FALSE."
msgstr "FALSE() функциясы логикалық FALSE мәнін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 12
#: xml_doc.cpp:3475
msgid "FALSE()"
msgstr "FALSE()"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 13
#: xml_doc.cpp:3478
msgid "FALSE() returns FALSE"
msgstr "FALSE() қайтаратыны FALSE"

#. i18n: tag Text
#. i18n: file functions/logic.xml line 21
#: xml_doc.cpp:3481
msgid "The TRUE() function returns the boolean value TRUE."
msgstr "TRUE() функциясы логикалық TRUE мәнін қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/logic.xml line 22
#: xml_doc.cpp:3484
msgid "TRUE()"
msgstr "TRUE()"

#. i18n: tag Example
#. i18n: file functions/logic.xml line 23
#: xml_doc.cpp:3487
msgid "TRUE() returns TRUE"
msgstr "TRUE() қайтаратыны TRUE"

