msgstr "X бойлығы"

#. i18n: file: functions/conversion.xml:124
#. i18n: file: functions/conversion.xml:146
#: xml_doc.cpp:124 xml_doc.cpp:136
msgid "Value in Y"
msgstr "Y бойлығы"

#. i18n: file: functions/conversion.xml:128
#: xml_doc.cpp:126
msgid ""
"The POLR() function returns the radius corresponding to the position of a "
"point in a cartesian landmark."
msgstr ""
"POLR() функциясы келтірілген тікбұрышты Декарт координаттарға сйкесті "
"радиусының ұзындығын қайтарады."

#. i18n: file: functions/conversion.xml:129
#: xml_doc.cpp:128
msgid "POLR(X;Y)"
msgstr "POLR(X;Y)"

#. i18n: file: functions/conversion.xml:130
#: xml_doc.cpp:130
msgid "POLR(12;12) returns 16.9705"
msgstr "POLR(12;12) қайтаратыны 16.9705"

#. i18n: file: functions/conversion.xml:131
#: xml_doc.cpp:132
msgid "POLR(12;0) returns 12"
msgstr "POLR(12;0) қайтаратыны 12"

#. i18n: file: functions/conversion.xml:150
#: xml_doc.cpp:138
msgid ""
"The POLA() function returns the angle (in radians) corresponding to the "
"position of a point in a cartesian landmark."
msgstr ""
"POLA() функциясы келтірілген тікбұрышты Декарт координаттарға сәйкесті "
"радиусының (радиандағы) бұрышын қайтарады."

#. i18n: file: functions/conversion.xml:151
#: xml_doc.cpp:140
msgid "POLA(X;Y)"
msgstr "POLA(X;Y)"

#. i18n: file: functions/conversion.xml:152
#: xml_doc.cpp:142
msgid "POLA(12;12) returns 0.78539816"
msgstr "POLA(12;12) қайтаратыны 0,78539816"

#. i18n: file: functions/conversion.xml:153
#: xml_doc.cpp:144
