#. i18n: file functions/engineering.xml line 153
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 172
#: xml_doc.cpp:1344 xml_doc.cpp:1359
msgid "Lower limit"
msgstr "Төменгі_шек"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 157
#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 176
#: xml_doc.cpp:1347 xml_doc.cpp:1362
msgid "Upper limit"
msgstr "Жоғарғы_шек"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 161
#: xml_doc.cpp:1350
msgid ""
"The ERF() function returns the error function. With a single argument, ERF() "
"returns the error function between 0 and that argument."
msgstr ""
"ERF() функциясы қате функциясын есептейді. Жалғыз аргумент келтірілсе ERF() "
"0 мен сол аргумент шамасы арасындағы қате функциясын қайтарады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 162
#: xml_doc.cpp:1353
msgid "ERF(Lower limit; Upper limit)"
msgstr "ERF(Төменгі_шек; Жоғарғы_шек)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 163
#: xml_doc.cpp:1356
msgid "ERF(0.4) equals 0.42839236"
msgstr "ERF(0,4) нәтижесі 0,42839236"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 180
#: xml_doc.cpp:1365
msgid "The ERFC() function returns the complementary error function."
msgstr "ERF() функциясы толықтауыш қате функциясын есептейді."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 181
#: xml_doc.cpp:1368
msgid "ERFC(Lower limit; Upper limit)"
msgstr "ERFC(Төменгі_шек; Жоғарғы_шек)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 182
#: xml_doc.cpp:1371
msgid "ERFC(0.4) equals 0.57160764"
msgstr "ERFC(0,4) нәтижесі 0,57160764"

