#. i18n: tag Text
#. i18n: file functions/engineering.xml line 812
#: xml_doc.cpp:1968
msgid ""
"The DELTA() function returns 1 if x equals y, otherwise returns 0. y "
"defaults to 0."
msgstr ""
"DELTA() функциясы x пен y тең болса 1-ді қайтарады, әйтпесе 0-ді қайтарады. "
"y келтірілмесе, ол 0 деп саналады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 813
#: xml_doc.cpp:1971
msgid "DELTA(x; y)"
msgstr "DELTA(x; y)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 814
#: xml_doc.cpp:1974
msgid "DELTA(1.2; 3.4) returns 0"
msgstr "DELTA(1,2; 3,4) қайтаратыны 0"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 815
#: xml_doc.cpp:1977
msgid "DELTA(3; 3) returns 1"
msgstr "DELTA(3; 3) қайтаратыны 1"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 816
#: xml_doc.cpp:1980
msgid "DELTA(1; TRUE) returns 1"
msgstr "DELTA(1; TRUE) қайтаратыны 1"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 832
#: xml_doc.cpp:1989
msgid ""
"The GESTEP() function returns 1 if x greater or equals y, otherwise returns "
"0. y defaults to 0."
msgstr ""
"GESTEP() функциясы x саны y санынан артық не тең болса 1-ді қайтарады, "
"әйтпесе 0-ді қайтарады. y келтірілмесе, ол 0 деп саналады."

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 833
#: xml_doc.cpp:1992
msgid "GESTEP(x; y)"
msgstr "GESTEP(x; y)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 834
#: xml_doc.cpp:1995
msgid "GESTEP(1.2; 3.4) returns 0"
msgstr "GESTEP(1,2; 3,4) қайтаратыны 0"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 835
#: xml_doc.cpp:1998
msgid "GESTEP(3; 3) returns 1"
msgstr "GESTEP(3; 3) қайтаратыны 1"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 836
#: xml_doc.cpp:2001
msgid "GESTEP(0.4; TRUE) returns 0"
msgstr "GESTEP(0,4; TRUE) қайтаратыны 0"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 837
#: xml_doc.cpp:2004
msgid "GESTEP(4; 3) returns 1"
msgstr "GESTEP(4; 3) қайтаратыны 1"

