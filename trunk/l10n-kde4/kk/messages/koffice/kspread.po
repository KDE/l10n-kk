#. i18n: file: functions/math.xml:1226
#: xml_doc.cpp:3164
msgid "MMULT(A1:C3)"
msgstr "MMULT(A1:C3)"

#. i18n: file: functions/math.xml:1235
#. i18n: file: functions/math.xml:1268
#: xml_doc.cpp:3166 xml_doc.cpp:3186
msgid "Matrix"
msgstr "Матрица"

#. i18n: file: functions/math.xml:1239
#: xml_doc.cpp:3168
msgid "Calculates the inverse of the matrix."
msgstr "Кері матрицасын есептеп береді."

#. i18n: file: functions/math.xml:1240
#: xml_doc.cpp:3170
msgid ""
"The matrix multiplied with its inverse results in the unity matrix of the "
"same dimension."
msgstr ""
"Бір-біріне көбейткен матрица мен оның кері матрицасы сол өлшемідегі бірлік "
"матрицаны береді."

#. i18n: file: functions/math.xml:1241
#: xml_doc.cpp:3172
msgid "Invertible matrices have a non-zero determinant."
msgstr "Керіленетін матрицаның детерминанты нөлге тең болмайды."

#. i18n: file: functions/math.xml:1242
#: xml_doc.cpp:3174
msgid "MINVERSE(matrix)"
msgstr "MINVERSE(матрица)"

#. i18n: file: functions/math.xml:1243
#: xml_doc.cpp:3176
msgid "MINVERSE(A1:C3)"
msgstr "MINVERSE(A1:C3)"

#. i18n: file: functions/math.xml:1253
#: xml_doc.cpp:3178
msgid "Dimension"
msgstr "Өлшемі"

#. i18n: file: functions/math.xml:1257
#: xml_doc.cpp:3180
msgid "Creates the unity matrix of the given dimension."
msgstr "Келтірілген өлшемді бірлік матрицаны құру."

#. i18n: file: functions/math.xml:1258
#: xml_doc.cpp:3182
msgid "MUNIT(dimension)"
msgstr "MUNIT(өлшемі)"

#. i18n: file: functions/math.xml:1259
#: xml_doc.cpp:3184
msgid "MUNIT(3) creates a 3x3 unity matrix"
msgstr "MUNIT(3) деген 3x3 бірлік матрицаны құрып береді"

#. i18n: file: functions/math.xml:1272
#: xml_doc.cpp:3188
msgid ""
"Returns the transpose of a matrix, i.e. rows and columns of the matrix are "
"exchanged."
msgstr "Матрицаны аударып, яғни жолдар мен бағандарын өзара ауыстырып береді."

#. i18n: file: functions/math.xml:1273
#: xml_doc.cpp:3190
msgid "TRANSPOSE(matrix)"
msgstr "TRANSPOSE(матрица)"

#. i18n: file: functions/math.xml:1274
#: xml_doc.cpp:3192
msgid "TRANSPOSE(A1:C3)"
msgstr "TRANSPOSE(A1:C3)"

#. i18n: file: functions/reference.xml:5
#: xml_doc.cpp:3194
msgid "Lookup & Reference"
msgstr "Қарастыру мен сілтеу"

#. i18n: file: functions/reference.xml:11
#: xml_doc.cpp:3196
msgid "Row number"
msgstr "Жол нөмірі"

#. i18n: file: functions/reference.xml:15
#: xml_doc.cpp:3198
msgid "Column number"
msgstr "Баған нөмірі"

#. i18n: file: functions/reference.xml:19
#: xml_doc.cpp:3200
msgid "Absolute number (optional)"
msgstr "Абсолютті нөмірі (келтірмеуге де болады)"

#. i18n: file: functions/reference.xml:23
#. i18n: file: functions/reference.xml:140
#: xml_doc.cpp:3202 xml_doc.cpp:3286
msgid "A1 style (optional)"
msgstr "A1 стилі (келтірмеуге де болады)"

#. i18n: file: functions/reference.xml:27
#: xml_doc.cpp:3204
msgid "Sheet name"
msgstr "Беттің атауы"

#. i18n: file: functions/reference.xml:31
#: xml_doc.cpp:3206
msgid ""
"The ADDRESS creates a cell address. Parameter Row is the row number and "
"Column is the column number."
msgstr ""
"ADDRESS ұяшықтың адресін құрып береді. Жол параметрі - жолының нөмірі, "
"Баған  параметрі - бағанның нөмірі."

#. i18n: file: functions/reference.xml:32
#: xml_doc.cpp:3208
msgid ""
"Absolute number specifies the type of reference: 1 or omitted = Absolute, 2 "
"= Absolute row, relative column,  3 = Relative row; absolute column and 4 = "
"Relative."
msgstr ""
"Абсолютті нөмірі сілтеме түрін анықтайды: 1 немесе келтірілмеген болса = "
"абсолютті түрде, 2 = жол абсолютті, баған салыстырмалы түрде,  3 = жол "
"салыстырмалы, жол абсолютті түрде, 4 = салыстырмалы түрде."

#. i18n: file: functions/reference.xml:33
#: xml_doc.cpp:3210
msgid ""
"A1 Style specifies the style of the address to return. If A1 is set to TRUE "
"(default) the address is returned in A1 style if it is set to FALSE in R1C1 "
"style."
msgstr ""
"A1 стилі қайтаратын адрес стилін анықтайды. Егер A1 стилі TRUE болса (әдетті "
"жағдай), адресі осы A1 түрде қайтарылады, егерде FALSE болса, R1C1 түрінде "
"қайтарылады."

#. i18n: file: functions/reference.xml:34
#: xml_doc.cpp:3212
msgid "Sheet name is the text specifying the name of the sheet."
msgstr "Беттің атауы деген бетке берілген мәтін атауы."

#. i18n: file: functions/reference.xml:35
#: xml_doc.cpp:3214
msgid "ADDRESS(row; col; absolute; style; sheet name)"
msgstr "ADDRESS(жол; бағ; абсолют; стилі; бет_атауы)"

#. i18n: file: functions/reference.xml:36
#: xml_doc.cpp:3216
msgid "ADDRESS(6; 4) returns $D$6"
msgstr "ADDRESS(6; 4) қайтаратыны $D$6"

#. i18n: file: functions/reference.xml:37
#: xml_doc.cpp:3218
msgid "ADDRESS(6; 4; 2) returns D$6"
msgstr "ADDRESS(6; 4; 2) қайтаратыны D$6"

#. i18n: file: functions/reference.xml:38
#: xml_doc.cpp:3220
msgid "ADDRESS(6; 4; 2; FALSE; \"Sheet1\") returns Sheet1!R6C[4]"
msgstr "ADDRESS(6; 4; 2; FALSE; \"Бет1\") қайтаратыны Бет1!R6C[4]"

#. i18n: file: functions/reference.xml:39
#: xml_doc.cpp:3222
msgid "ADDRESS(6; 4; 1; FALSE; \"Sheet1\") returns Sheet1!R6C4"
msgstr "ADDRESS(6; 4; 1; FALSE; \"Бет1\") қайтаратыны Бет1!R6C4"

#. i18n: file: functions/reference.xml:40
#: xml_doc.cpp:3224
msgid "ADDRESS(6; 4; 4; TRUE; \"Sheet1\") returns Sheet1!D6"
msgstr "ADDRESS(6; 4; 4; TRUE; \"Бет1\") қайтаратыны Бет1!D6"

#. i18n: file: functions/reference.xml:48
#. i18n: file: functions/reference.xml:80
#. i18n: file: functions/reference.xml:97
#. i18n: file: functions/reference.xml:113
#. i18n: file: functions/reference.xml:136
#. i18n: file: functions/reference.xml:155
#. i18n: file: functions/reference.xml:172
#: xml_doc.cpp:3226 xml_doc.cpp:3248 xml_doc.cpp:3258 xml_doc.cpp:3268
#: xml_doc.cpp:3284 xml_doc.cpp:3296 xml_doc.cpp:3306
msgid "Reference"
msgstr "Сілтеме"

#. i18n: file: functions/reference.xml:52
#: xml_doc.cpp:3228
msgid ""
"Returns the number of areas in the reference string. An area can be asingle "
"cell or a set of cells."
msgstr ""
"Сілтеме жолындағы аумақтар санын қайтарады. Аумақ бір ұяшықтан не бірнеше "
"ұяшықтан тұрады."

#. i18n: file: functions/reference.xml:53
#: xml_doc.cpp:3230
msgid "AREAS(reference)"
msgstr "AREAS(сілтеме)"

#. i18n: file: functions/reference.xml:54
#: xml_doc.cpp:3232
msgid "AREAS(A1) returns 1"
msgstr "AREAS(A1) қайтаратыны 1"

#. i18n: file: functions/reference.xml:55
#: xml_doc.cpp:3234
msgid "AREAS((A1; A2:A4)) returns 2"
msgstr "AREAS((A1; A2:A4)) қайтаратыны 2"

#. i18n: file: functions/reference.xml:62
#: xml_doc.cpp:3236
msgid "Index"
msgstr "Индекс"

#. i18n: file: functions/reference.xml:66
#: xml_doc.cpp:3238
msgid "Arguments"
msgstr "Аргументтері"

#. i18n: file: functions/reference.xml:69
#: xml_doc.cpp:3240
msgid "Returns the parameter specified by the index."
msgstr "Индексі көрсеткен параметрін қайтарады."

#. i18n: file: functions/reference.xml:70
#: xml_doc.cpp:3242
msgid "CHOOSE(index; parameter1; parameter2;...)"
msgstr "CHOOSE(индек; параметр1; параметр2;...)"

#. i18n: file: functions/reference.xml:71
#: xml_doc.cpp:3244
msgid "CHOOSE(1; \"1st\"; \"2nd\") returns \"1st\""
msgstr "CHOOSE(1; \"1-ші\"; \"2-ші\") қайтаратыны \"1-ші\""

#. i18n: file: functions/reference.xml:72
#: xml_doc.cpp:3246
msgid "CHOOSE(2; 3; 2; 4) returns 2"
msgstr "CHOOSE(2; 3; 2; 4) қайтаратыны 2"

#. i18n: file: functions/reference.xml:84
#: xml_doc.cpp:3250
msgid ""
"The COLUMN function returns the column of given cell reference. If no "
"parameter is specified the column of the current cell gets returned."
msgstr ""
"COLUMN функциясы сілтемеде келтірілген бағанның нөмірін қайтарады. Егер "
"параметрі келтірілмесе назардағы ұяшықтың бағанының нөмірін қайтарады."

#. i18n: file: functions/reference.xml:85
#: xml_doc.cpp:3252
msgid "COLUMN(reference)"
msgstr "COLUMN(сілтеме)"

#. i18n: file: functions/reference.xml:86
#: xml_doc.cpp:3254
msgid "COLUMN(A1) returns 1"
msgstr "COLUMN(A1) қайтаратыны 1"

#. i18n: file: functions/reference.xml:87
#: xml_doc.cpp:3256
msgid "COLUMN(D2) returns 4"
msgstr "COLUMN(D2) қайтаратыны 4"

#. i18n: file: functions/reference.xml:101
#: xml_doc.cpp:3260
msgid "The COLUMNS function returns the number of columns in a reference."
msgstr "COLUMNS функциясы сілтемеде келтірілген бағандар санын қайтарады."

#. i18n: file: functions/reference.xml:102
#: xml_doc.cpp:3262
msgid "COLUMNS(reference)"
msgstr "COLUMNS(сілтеме)"

#. i18n: file: functions/reference.xml:103
#: xml_doc.cpp:3264
msgid "COLUMNS(A1:C3) returns 3"
msgstr "COLUMNS(A1:C3) қайтаратыны 3"

#. i18n: file: functions/reference.xml:104
#: xml_doc.cpp:3266
msgid "COLUMNS(D2) returns 1"
msgstr "COLUMNS(D2) қайтаратыны 1"

#. i18n: file: functions/reference.xml:117
#. i18n: file: functions/reference.xml:217
#: xml_doc.cpp:3270 xml_doc.cpp:3332
msgid "Row"
msgstr "Жол"

#. i18n: file: functions/reference.xml:121
#. i18n: file: functions/reference.xml:243
#: xml_doc.cpp:3272 xml_doc.cpp:3346 dialogs/DatabaseDialog.cpp:189
msgid "Column"
msgstr "Баған"

#. i18n: file: functions/reference.xml:125
#: xml_doc.cpp:3274
msgid ""
"If a range is given, returns value stored in a given row/column. If one cell "
"is given, which contains an array, then one element of the array is returned."
msgstr ""
"Егер ауқым келтірілсе, онда сол ауқымдағы жол/бағанмен көрсетілген ұяшықтың "
"мазмұнын қайтарады. Егер жиымға (матрицаға) сілтейтін бір ұяшық келтірілсе, "
"онда сол жиымының жол/баған анықтаған элементін қайтарады."

#. i18n: file: functions/reference.xml:126
#: xml_doc.cpp:3276
msgid "INDEX(cell, row, column)"
msgstr "INDEX(ұяшық, жол, баған)"

#. i18n: file: functions/reference.xml:127
#: xml_doc.cpp:3278
msgid "INDEX(range, row, column)"
msgstr "INDEX(ауқым, жол, баған)"

#. i18n: file: functions/reference.xml:128
#: xml_doc.cpp:3280
msgid "INDEX(A1:C3;2;2), returns contents of B2"
msgstr "INDEX(A1:C3;2;2), қайтаратыны B2 мазмұны"

#. i18n: file: functions/reference.xml:129
#: xml_doc.cpp:3282
msgid ""
"INDEX(A1;2;2), if A1 is a result of array calculation, returns its (2,2) "
"element."
msgstr ""
"INDEX(A1;2;2), егер A1 есептеудің жиым түрдегі нәтижесі болса, қайтаратыны "
"жиымының (2,2) элементі."

#. i18n: file: functions/reference.xml:144
#: xml_doc.cpp:3288
msgid ""
"Returns the content of the cell specified by the reference text. The second "
"parameter is optional."
msgstr ""
"Сілтеме мәтінімен келтірілген ұяшықтың мазмұнын қайтарады. Екінші параметрін "
"келтірмеуге де болады."

#. i18n: file: functions/reference.xml:145
#: xml_doc.cpp:3290
msgid "INDIRECT(referenceText, a1 style)"
msgstr "INDIRECT(сілтемеМәтіні; a1 стилі)"

#. i18n: file: functions/reference.xml:146
#: xml_doc.cpp:3292
msgid "INDIRECT(A1), A1 contains \"B1\", and B1 1 => returns 1"
msgstr ""
"INDIRECT(A1), A1 ұяшығында \"B1\", B1 ұяшығында 1 болса => қайтаратыны 1"

#. i18n: file: functions/reference.xml:147
#: xml_doc.cpp:3294
msgid "INDIRECT(\"A1\"), returns content of A1"
msgstr "INDIRECT(\"A1\") қайтаратыны A1 мазмұны"

#. i18n: file: functions/reference.xml:159
#: xml_doc.cpp:3298
msgid ""
"The ROW function returns the row of given cell reference. If no parameter is "
"specified the row of the current cell gets returned."
msgstr ""
"ROW функциясы сілтемеде келтірілген жолдың нөмірін қайтарады. Егер параметрі "
"келтірілмесе назардағы ұяшықтың жолының нөмірін қайтарады."

#. i18n: file: functions/reference.xml:160
#: xml_doc.cpp:3300
msgid "ROW(reference)"
msgstr "ROW(сілтеме)"

#. i18n: file: functions/reference.xml:161
#: xml_doc.cpp:3302
msgid "ROW(A1) returns 1"
msgstr "ROW(A1) қайтаратыны 1"

#. i18n: file: functions/reference.xml:162
#: xml_doc.cpp:3304
msgid "ROW(D2) returns 2"
msgstr "ROW(D2) қайтаратыны 2"

#. i18n: file: functions/reference.xml:176
#: xml_doc.cpp:3308
msgid "The ROWS function returns the number of rows in a reference."
msgstr "ROWS функциясы сілтемеде келтірілген жолдар санын қайтарады."

#. i18n: file: functions/reference.xml:177
#: xml_doc.cpp:3310
msgid "ROWS(reference)"
msgstr "ROWS(сілтеме)"

#. i18n: file: functions/reference.xml:178
#: xml_doc.cpp:3312
msgid "ROWS(A1:C3) returns 3"
msgstr "ROWS(A1:C3) қайтаратыны 3"

#. i18n: file: functions/reference.xml:179
#: xml_doc.cpp:3314
msgid "ROWS(D2) returns 1"
msgstr "ROWS(D2) қайтаратыны 1"

#. i18n: file: functions/reference.xml:187
#. i18n: file: functions/reference.xml:209
#. i18n: file: functions/reference.xml:235
#: xml_doc.cpp:3316 xml_doc.cpp:3328 xml_doc.cpp:3342
msgid "Lookup value"
msgstr "Іздейтін мәні"

#. i18n: file: functions/reference.xml:191
#: xml_doc.cpp:3318
msgid "Lookup vector"
msgstr "Қарастыру векторы"

#. i18n: file: functions/reference.xml:195
#: xml_doc.cpp:3320
msgid "Result vector"
msgstr "Нәтижелер векторы"

#. i18n: file: functions/reference.xml:199
#: xml_doc.cpp:3322
msgid ""
"The LOOKUP function looks up the first parameter in the lookup vector. It "
"returns a value in the result Vector with the same index as the matching "
"value in the lookup vector. If value is not in the lookup vector it takes "
"the next lower one. If no value in the lookup vector matches an error is "
"returned. The lookup vector must be in ascending order and lookup and result "
"vector must have the same size. Numeric values, string and boolean values "
"are recognized. Comparison between strings is case-insensitive."
msgstr ""
"LOOKUP функциясы бірінші параметріндегісін қарастыру векторынан іздейді. "
"Тапқанда, нәтіжелер векторынан орны сәйкесті мәнің алып, қайтарады. "
"Қарастыру векторында іздегені табылмаса, іздеу одан аспайтын ең жақын "
"мәнінде тоқтайды. Ештеңе табылмаса - қате белгісі қайтарылады. Қарастыру "
"векторы өсу тәртібімен реттелген және ұзыңдығы нәтижелер векторымен бірдей "
"болу керек. Функция сан, мәтін жол, логикалық мәндерімен істейді. Мәтін "
"жолында үлкен-кіші әріптерді айырмайды."

#. i18n: file: functions/reference.xml:200
#: xml_doc.cpp:3324
msgid "LOOKUP(value; lookup vector; result vector)"
msgstr "LOOKUP(мән; қарастыру_векторы; нәтиже_векторы)"

#. i18n: file: functions/reference.xml:201
#: xml_doc.cpp:3326
msgid "LOOKUP(1.232; A1:A6; B1:B6) for A1 = 1, A2 = 2 returns the value of B1."
msgstr ""
"LOOKUP(1,232; A1:A6; B1:B6) егер A1 = 1, A2 = 2 болса, қайтаратыны B1 ұяшық "
"мазмұны."

#. i18n: file: functions/reference.xml:213
#. i18n: file: functions/reference.xml:239
#: xml_doc.cpp:3330 xml_doc.cpp:3344
msgid "Data source"
msgstr "Деректер көзі"

#. i18n: file: functions/reference.xml:221
#. i18n: file: functions/reference.xml:247
#: xml_doc.cpp:3334 xml_doc.cpp:3348
msgid "Sorted (optional)"
msgstr "Реттелген (келтірмеу де болады)"

#. i18n: file: functions/reference.xml:225
#: xml_doc.cpp:3336
msgid ""
"Look for a matching value in the first row of the given table, and return the value of the "
"indicated row."
msgstr ""
"Келтірілген кестенің бірінші жолынан керегін тауып, көрсетілген жолынан "
"сәйкесті бағандағы ұяшығының мазмұнын қайтару."

#. i18n: file: functions/reference.xml:226
#: xml_doc.cpp:3338
msgid ""
"Looks up the 'lookup value' in the first row of the 'data source'. If a "
"value matches, the value in the 'row' and the column, the value was found "
"in, is returned. If 'sorted' is true (default), the first row is assumed to "
"be sorted. The search will end, if the 'lookup value' is lower than the "
"value, currently compared to."
msgstr ""
"'Деректер көзі' дегеннің бірінші жолынан 'іздейтін мән' дегенді тауып, "
"'жолы' дегендегі және табылған бағандағы ұяшығының мазмұнын қайтарады. Егер "
"'реттелген' дегені ақиқат (true) болса (әдетті жағдай), бірінші жолы "
"реттелген деп саналады. 'Іздейтін мән' дегені салыстырып жатқан мәнінен "
"төмен болғанда іздеу тоқталады."

#. i18n: file: functions/reference.xml:227
#: xml_doc.cpp:3340
msgid "HLOOKUP(Lookup value; data source; Row; Sorted)"
msgstr "HLOOKUP(Іздейтін_мән; деректер_көзі; жолы; реттелген)"

#. i18n: file: functions/reference.xml:251
#: xml_doc.cpp:3350
#, fuzzy
#| msgid ""
#| "Look for a matching value in the first column of the given table, and return the value of the "
#| "indicated column."
msgid ""
"Look for a matching value in the first column of the given table, and return "
"the value of the indicated column."
msgstr ""
"Келтірілген кестенің бірінші бағанынан керегін тауып, көрсетілген бағанынан "
"сәйкесті жолдағы ұяшығының мазмұнын қайтару."

#. i18n: file: functions/reference.xml:252
#: xml_doc.cpp:3352
msgid ""
"Looks up the 'lookup value' in the first column of the 'data source'. If a "
"value matches, the value in the 'column' and the row, the value was found "
"in, is returned. If 'sorted' is true (default), the first column is assumed "
"to be sorted. The search will end, if the 'lookup value' is lower than the "
"value, currently compared to."
msgstr ""
"'Деректер көзі' дегеннің бірінші бағанынан 'іздейтін мән' дегенді тауып, "
"'бағаны' дегендегі және табылған жолдағы ұяшығының мазмұнын қайтарады. Егер "
"'реттелген' дегені ақиқат (true) болса (әдетті жағдай), бірінші бағаны "
"реттелген деп саналады. 'Іздейтін мән' дегені салыстырып жатқан мәнінен "
"төмен болғанда іздеу тоқталады."

