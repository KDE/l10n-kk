msgstr "Автотүзету"

#: AutocorrectConfigDialog.cpp:289
msgid "&Modify"
msgstr "Ө&згерту"

#. i18n: tag string
#. i18n: file AutocorrectConfig.ui line 437
#. i18n: tag string
#. i18n: file AutocorrectConfig.ui line 558
