#: medianotifier.cpp:207
#, kde-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"'%1' дискіңізде автобастау файлы табылды. Оны орындағыңыз келді ме?\n"
"Байқаңыз, ондай файлды орындау жүйеңіздің қауіпсіздік деңгейін төмендетеді"

#: medianotifier.cpp:211
#, kde-format
msgid "Autorun - %1"
msgstr "Автобастау - %1"

#: medianotifier.cpp:276
#, kde-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"'%1' дискіңізде автоашу файлы табылды. '%2' дегенді ашқыңыз келе ме?\n"
"Байқаңыз, ондай файлды ашу жүйеңіздің қауіпсіздік деңгейін төмендетеді"

#: medianotifier.cpp:280
#, kde-format
msgid "Autoopen - %1"
msgstr "Автоашу - %1"

