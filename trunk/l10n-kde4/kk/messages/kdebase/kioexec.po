#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - қашықтағы файлдарды ашады, өзгерістерін бақылайды да жүктеп алуды "
"сұрайды"

#: main.cpp:50
msgid "Treat URLs as local files and delete them afterwards"
msgstr "URL-адрестерді жергілікті файл дер санап, кейін оларды өшіру"

#: main.cpp:51
msgid "Suggested file name for the downloaded file"
msgstr ""

#: main.cpp:52
msgid "Command to execute"
msgstr "Орындайтын команда"

#: main.cpp:53
msgid "URL(s) or local file(s) used for 'command'"
msgstr "'command' үшін қолданатын URL-сілтеме(лер) не жергілікті файл(дар)"

#: main.cpp:62
msgid "'command' expected.\n"
msgstr "'command' күтілген.\n"

#: main.cpp:91
#, qt-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"%1 деген URL\n"
"жарамсыз"

#: main.cpp:93
#, qt-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Қашықтағы %1 деген URL\n"
"--tempfiles деген параметрімен рұқсат етілмеген"

#: main.cpp:222
#, qt-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"%1\n"
"деген уақытша файл,\n"
"бәлкім, өзгертілген.\n"
"Сонда да өшірілсін бе?"

#: main.cpp:223 main.cpp:230
msgid "File Changed"
msgstr "Файл өзгертілген"

#: main.cpp:223
msgid "Do Not Delete"
msgstr "Өшірілмесін"

#: main.cpp:229
#, qt-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"%1\n"
"деген файл өзгертілген.\n"
"Өзгерістерді жүктеп беруді қалайсыз ба?"

#: main.cpp:230
msgid "Upload"
msgstr "Жүктеп берілсін"

#: main.cpp:230
msgid "Do Not Upload"
msgstr "Жүктелмесін"

#: main.cpp:253
msgid "KIOExec"
msgstr "KIOExec"

