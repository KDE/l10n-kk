msgctxt "@info bug status"
msgid "Opened"
msgstr "Ашық"

#: reportassistantpages_bugzilla_duplicates.cpp:620
msgctxt "@info bug resolution"
msgid "Fixed"
msgstr "Түзелген"

#: reportassistantpages_bugzilla_duplicates.cpp:621
msgctxt "@info bug resolution"
msgid "the bug was fixed by KDE developers"
msgstr "бұл қатені KDE тобы түзеген"

#: reportassistantpages_bugzilla_duplicates.cpp:623
msgctxt "@info bug resolution"
msgid "Non-reproducible"
msgstr "Қайталауға келмеді"

#: reportassistantpages_bugzilla_duplicates.cpp:625
msgctxt "@info bug resolution"
msgid "Already reported"
msgstr "Бұрын хабарланған"

#: reportassistantpages_bugzilla_duplicates.cpp:627
msgctxt "@info bug resolution"
msgid "Not a valid report/crash"
msgstr "Дұрыс емес хабарлама/жаңылыс"

#: reportassistantpages_bugzilla_duplicates.cpp:630
msgctxt "@info bug resolution"
msgid "Not caused by a problem in the KDE's Applications or libraries"
msgstr "KDE қолданба не жиын файлдан туындаған мәселе емес"

#: reportassistantpages_bugzilla_duplicates.cpp:632
msgctxt "@info bug resolution"
msgid ""
"the bug is caused by a problem in an external application or library, or by "
"a distribution or packaging issue."
msgstr ""
"бұл қате бөтен қолданба не жиын файлдан туындаған немесе дистрибутивтің не "
"дестелеудің мәселесі."

#: reportassistantpages_bugzilla_duplicates.cpp:639
#, kde-format
