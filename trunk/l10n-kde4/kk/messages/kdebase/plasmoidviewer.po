#: main.cpp:49
msgid "Run Plasma widgets in their own window"
msgstr "Plasma виджетін өзінің терезесінде жегу"

#: main.cpp:100
msgid "No description available"
msgstr "Сипаттамасы жоқ"

#: main.cpp:117
msgid "Plasma Widget Viewer"
msgstr "Plasma виджетін қарау құралы"

#: main.cpp:119
msgid "2007-2008, Frerich Raabe"
msgstr "2007-2008, Frerich Raabe"

#: main.cpp:121
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:122
msgid "Original author"
msgstr "Бастапқы авторы"

#: main.cpp:129
msgid "Name of the containment plugin"
msgstr "Плагин контейнерінің атауы"

#: main.cpp:131
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr "Орналасу қалыпы(horizontal, vertical, mediacenter не planar)"

#: main.cpp:132
msgid "Displays a list of known applets"
msgstr "Бар апплеттер тізімін көрсету"

#: main.cpp:133
msgid "Displays a list of known wallpapers"
msgstr "Бар тұсқаздар тізімін көрсету"

#: main.cpp:134
msgid "Displays a list of known containments"
msgstr "Бар контейнерлер тізімін көрсету"

#: main.cpp:136
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"Орналасу шектеуі (floating, desktop, fullscreen, top, bottom, left, right)"

#: main.cpp:138
msgid "The size in KB to set the pixmap cache to"
msgstr "Кескін кэшінің көлемі (КБ)"

#: main.cpp:140
msgid ""
"Takes a screenshot of the widget and saves it the working directory as "
"<pluginname>.png"
msgstr ""
"Виджеттің экранын түсіріп алып, оны жұмыс қапшығында "
"<плагин_атауы>.png деп сақтайды"

#: main.cpp:141
msgid ""
"Takes a screenshot of each widget and saves it the working directory as "
"<pluginname>.png"
msgstr ""
"Әрі виджеттің экранын түсіріп алып, оны жұмыс қапшығында "
"<плагин_атауы>.png деп сақтайды"

#: main.cpp:143
msgid "Desktop SVG theme to use"
msgstr "Пайдаланатын үстелдің SVG нақышы"

#: main.cpp:145
msgid ""
"Name of the wallpaper plugin. Requires a containment plugin to be specified."
msgstr "Тұсқағаз плагиннің атауы. Келтіру үшін контейнер плагинін қажет етеді."

#: main.cpp:146
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"Қарайтын апплеттің атауы, бұл плагиннің атауы не дестесінің (абсолютті не "
"салыстырмалы) жолы болмақ. Келтірілмесе, онда қазір қолданыстағы "
"қапшығындағы дестені жүктеп көреді.ы"

#: main.cpp:149
msgid "Optional arguments of the applet to add"
msgstr "Қосатын апплеттің қосымша аргументі"

#: main.cpp:150
msgid "List zeroconf announced remote widgets"
msgstr "Жарияланған қашықтағы виджеттердің zeroconf тізімі"

