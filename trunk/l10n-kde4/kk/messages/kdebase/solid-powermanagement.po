#: solid-powermanagement.cpp:49
msgid "solid-powermanagement"
msgstr "solid-powermanagement"

#: solid-powermanagement.cpp:51
msgid ""
"KDE tool for querying and controlling your power management options from the "
"command line"
msgstr "Қуатандыру параметрлерін команда жолынан сұрап басқаратын KDE құралы"

#: solid-powermanagement.cpp:163
msgid "Syntax Error: Not enough arguments"
msgstr "Синтаксис қатесі: Аргументтер жетіспейді"

#: solid-powermanagement.cpp:169
msgid "Syntax Error: Too many arguments"
msgstr "Синтаксис қатесі: Аргументтері тым көп"

#: solid-powermanagement.cpp:181
msgid "Show available commands"
msgstr "Бар командаларын көрсету"

#: solid-powermanagement.cpp:183
msgid "Command (see --commands)"
msgstr "Командасы (--commands деп қараңыз)"

#: solid-powermanagement.cpp:185
msgid "Arguments for command"
msgstr "Команданың аргументтері"

#: solid-powermanagement.cpp:197
msgid "Syntax:"
msgstr "Синтаксисі:"

#: solid-powermanagement.cpp:200
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # Қуаттандыруды басқару туралы мәліметті шығару.\n"
"             # - Егер 'suspend' параметрі келтірілсе, осы жүйедегі қалғу\n"
"             #  әдістерінің тізімі шығарылады.\n"
"             # - Егер 'scheme' параметрі келтірілсе, осы жүйенің\n"
"             # қуаттандыруын басқару сұлбалар тізімі шығарылады.\n"
"             # - Егер 'cpufreq' параметрі келтірілсе, жүйедегі "
"процессорының\n"
"             # жиілік саясаттар тізімі шығарылады.\n"

#: solid-powermanagement.cpp:209
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Жүйені қуаттандыруын басқару параметрлерін орнату.\n"
"             # - Егер 'scheme' параметрі келтірілсе, қуаттандыру басқару\n"
"             # сұлбасы 'value' деп орнатылады\n"
"             # - Егер 'cpufreq' параметрі келтірілсе, процессордың жиілік\n"
"             # саясаты 'value' деп орнатылады.\n"

#: solid-powermanagement.cpp:216
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Компьютерді келтірілген 'method' әдісімен қалғыту.\n"

#: solid-powermanagement.cpp:263 solid-powermanagement.cpp:282
