msgstr "Синтаксис қатесі: '%1' параметрі беймәлім"

#: solid-powermanagement.cpp:287
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "Синтаксис қатесі: '%1' командасы беймәлім"

#: solid-powermanagement.cpp:336
#, kde-format
