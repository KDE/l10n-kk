#: devicewrapper.cpp:125
msgid "Mount the device"
msgstr "Құрылғыны тіркеу"

#: devicewrapper.cpp:127
msgid "Unmount the device"
msgstr "Құрылғыны тіркеуден шығару"

#: devicewrapper.cpp:131
msgctxt ""
"Unlock the encrypted container; will ask for a password; partitions inside "
"will appear as they had been plugged in"
msgid "Unlock the container"
msgstr "Контейнерден бұғатты шешу"

#: devicewrapper.cpp:133
msgctxt ""
"Close the encrypted container; partitions inside will disappear as they had "
"been unplugged"
msgid "Lock the container"
msgstr "Контейнерді бұғаттау"

#: devicewrapper.cpp:137
msgid "Eject medium"
msgstr "Тасушысын алып-шығу"

#: solidrunner.cpp:48
msgid "Finds devices whose name match :q:"
msgstr "Атауы :q: дегенге сәйкес құрылғыларды іздеу"

#: solidrunner.cpp:50 solidrunner.cpp:131
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "құрылғы"

#: solidrunner.cpp:51
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr ""
"Барлық құрылғыларды тізімдеп, оларды тіркеу, тіркеуден шығару, алып-шығу."

#: solidrunner.cpp:52 solidrunner.cpp:137
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "тіркеу"

#: solidrunner.cpp:53
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr "Тіркеуге болатын құрылғыларды тізімдеп, оларды тіркеу."

#: solidrunner.cpp:54 solidrunner.cpp:141
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "тіркеуден шығару"

#: solidrunner.cpp:55
msgid ""
"Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr ""
"Тіркеуден шығаруға болатын құрылғыларды тізімдеп, оларды тіркеуден шығару."

#: solidrunner.cpp:56
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "алып-шығу"

#: solidrunner.cpp:57
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr "Алып-шығуға болатын құрылғыларды тізімдеп, оларды алып-шығу."

#~ msgid ""
#~ "Could not unmount the device.\n"
#~ "One or more files on this device are open within an application."
#~ msgstr ""
#~ "Құрылғы тіркеуден шығарылмады.\n"
#~ "Құрылғыдағы бір не бірнеше файл бір қолданбада ашылып тұр."

#~ msgid ""
#~ "Could not eject the disc.\n"
#~ "One or more files on this disc are open within an application."
#~ msgstr ""
#~ "Дискі алып-шығарылмады.\n"
#~ "Дискідегі бір не бірнеше файл бір қолданбада ашылып тұр."

#~ msgid "Could not mount the disc."
#~ msgstr "Дискі тіркелмеді."
