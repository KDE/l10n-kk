#: main.cpp:65
#, qt-format
msgid ""
"Another instance of %1 is already running, do you really want to open "
"another instance or continue work in the same instance?\n"
"Please note that, unfortunately, duplicate views are read-only."
msgstr ""
"%1 дегеннің бір данасы орындалуда ғой. Сіз шынымен басқа данасын ашпақсыз ба, немесе бұрынғысын қолдана бересіз бе?\n"
"Қосымша даналар тек оқу үшін күйінде орындалатыны есіңізде жүрген жөн."

#: main.cpp:68
msgid "Warning"
msgstr "Ескерту"

#: main.cpp:69
msgid "Run Another"
msgstr "Басқасын жегу"

#: main.cpp:70
msgid "Continue in Same"
msgstr "Бұрынғысын колдану"

