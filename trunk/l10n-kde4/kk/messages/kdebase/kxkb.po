#: kxkb.cpp:384
msgid "A utility to switch keyboard maps"
msgstr "Пернетақта сәйкестігін аыстыру утилитасы"

#: kxkb.cpp:388
msgid "KDE Keyboard Tool"
msgstr "KDE пернетақта құралы"

