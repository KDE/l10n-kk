msgstr "Қатынау п&ернесін Ctrl пернемен белсендетуді қосу/бұғаттау"

#: settings/konqhtml/htmlopts.cpp:167
msgid ""
"Pressing the Ctrl key when viewing webpages activates KDE's Access Keys. "
"Unchecking this box will disable this accessibility feature. (Konqueror "
"needs to be restarted for changes to take effect)"
msgstr ""
"Веб-парақтарды қарап жатқанда Ctrl пернесін басқанда Қатынау пернелерін "
"белсендетеді. Белгіні алып тастаса бұл арнаулы мүмкіндік бұғатталады. "
"(Өзгерістер Konqueror қайта жүетелгенде ғана күшіне енеді)"

#: settings/konqhtml/htmlopts.cpp:178
msgid "Und&erline links:"
msgstr "Сілтемелердің ас&тын сызу:"

#: settings/konqhtml/htmlopts.cpp:182
msgctxt "underline"
msgid "Enabled"
msgstr "Болсын"

#: settings/konqhtml/htmlopts.cpp:183
msgctxt "underline"
msgid "Disabled"
msgstr "Болмасын"

#: settings/konqhtml/htmlopts.cpp:184
