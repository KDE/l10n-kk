#: deviceitem.cpp:273
msgid "Click to safely remove this device from the computer."
msgstr "Осы құрылғыны қауіпсіз компьютерден алып шығу үшін түртіңіз."

#: deviceitem.cpp:274
msgid "Device is plugged in and can be accessed by applications."
msgstr "Құрылғысы қосылып қолданбалардан қатынауға дайын."

#: deviceitem.cpp:276
msgid "Click to access this device from other applications."
msgstr "Құрылғысына басқа қолданбалардан қатынау үшін түртіңіз."

#: deviceitem.cpp:277
msgid "Device is plugged in, but not mounted for access yet."
msgstr "Құрылғы қосылды, бірақ тіркеуі өткізілген жоқ."

#: deviceitem.cpp:368
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "%1 бос"

#: deviceitem.cpp:422
msgid "Mounting..."
msgstr "Тіркеу..."

#: deviceitem.cpp:425
msgid "Unmounting..."
msgstr "Тіркеуден шығару..."

#: devicenotifier.cpp:203
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "осы құрылғының %1 әрекеті"

#: devicenotifier.cpp:272
msgid "No devices available."
msgstr "Қосылған құрылғы жоқ."

#: devicenotifier.cpp:276
#, kde-format
msgid "Most recent device: %1"
msgstr "Соңғы қосылған құрылғы: %1"

#: devicenotifier.cpp:378
msgid "Display"
msgstr "Көрсету"

#: devicenotifier.cpp:381
msgid "Automounting"
msgstr "Автотіркеу"

#: notifierdialog.cpp:67
msgid "Show hidden devices"
msgstr "Жасырын құрылғыларын көрсету"

#: notifierdialog.cpp:574, kde-format
#| msgid ""
#| "Could not unmount the device.\n"
#| "One or more files on this device are open within an application."
msgid ""
"Could not unmount device %1.\n"
"One or more files on this device are open within an application."
msgstr ""
"%1 құрылғысы тіркеуден шығарылмады.\n"
"Құрылғыдағы бір не бірнеше файл бір қолданбада ашылып тұр."

#: notifierdialog.cpp:593
msgid ""
"Cannot eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"Дискіні алып-шығаруға болмайды.\n"
"Діскідегі бір не бірнеше файл бір қолданбада ашылып тұр."

#: notifierdialog.cpp:613, kde-format
#| msgid "Most recent device: %1"
msgid "Could not mount device %1."
msgstr "%1 құрылғысы тіркелмеді."

#: notifierdialog.cpp:822
#, kde-format
msgctxt "Hide a device"
msgid "Hide %1"
msgstr "%1 құрылғысын жасыру"

