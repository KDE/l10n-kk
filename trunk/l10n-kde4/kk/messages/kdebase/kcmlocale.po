#: kcmlocale.cpp:736
msgid ""
"<p>This is the country where you live.  The KDE Workspace will use the "
"settings for this country or region.</p>"
msgstr ""
"<p>Бұл Сіз тұратын Еліңіз. KDE осы Ел/Өлкеге тән параметрлерді қолданады.</p>"

#: kcmlocale.cpp:753
#, kde-format
msgctxt "%1 is the system country name"
msgid "System Country (%1)"
msgstr "Жүйе бапталған Елі (%1)"

#: kcmlocale.cpp:756
msgid "No Country (Default Settings)"
msgstr "Ел анықталмаған (әдетті параметрлері)"

#: kcmlocale.cpp:797
msgid "Subdivision:"
msgstr "Ел бөлімі"

#: kcmlocale.cpp:798
msgid ""
"<p>This is the country subdivision where you live, e.g. your state or "
"province.  The KDE Workspace will use this setting for local information "
"services such as holidays.</p>"
msgstr ""
"<p>Бұл Еліңіздің Сіз тұратын бөлігі, мысалы, облысы не уәлаяты. KDE бұл "
"параметрін жергілікті ақпарат қызметтерінде қолданады, мысалы жергілікті "
"мейрамдарын білу үшін."

#: kcmlocale.cpp:830
msgid "Available Languages:"
msgstr "Бар тілдер:"

#: kcmlocale.cpp:831
msgid ""
"<p>This is the list of installed KDE Workspace language translations not "
"currently being used.  To use a language translation move it to the "
"'Preferred Languages' list in the order of preference.  If no suitable "
"languages are listed, then you may need to install more language packages "
"using your usual installation method.</p>"
msgstr ""

#: kcmlocale.cpp:840
msgid "Preferred Languages:"
msgstr "Тілдеріңіз:"

#: kcmlocale.cpp:841
msgid ""
"<p>This is the list of installed KDE Workspace language translations "
"currently being used, listed in order of preference.  If a translation is "
"not available for the first language in the list, the next language will be "
"used.  If no other translations are available then US English will be used.</"
"p>"
msgstr ""

#: kcmlocale.cpp:851
#, kde-format
msgctxt "%1 = default language name"
msgid "%1 (Default)"
msgstr ""

#: kcmlocale.cpp:889
#, kde-format
msgid ""
"You have the language with code '%1' in your list of languages to use for "
"translation but the localization files for it could not be found. The "
"language has been removed from your configuration. If you want to add it "
"again please install the localization files for it and add the language "
"again."
msgstr ""

