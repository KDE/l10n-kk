#: knewthemedlg.cpp:31
msgid "New Theme"
msgstr "Жаңа нақыш"

#: kthememanager.cpp:62
msgid "KDE Theme Manager"
msgstr "KDE нақыш менеджері"

#: kthememanager.cpp:63 kthememanager.cpp:69
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr ""
"Бұл басқару модулі KDE-нің көрнекті нақыштарды орнату, өшіру және "
"құрастырумен айналысады."

#: kthememanager.cpp:65
msgid "(c) 2003, 2004 Lukáš Tinkl"
msgstr "(c) 2003, 2004 Lukáš Tinkl"

#: kthememanager.cpp:266
msgid "Theme Files"
msgstr "Нақыш файлдары"

#: kthememanager.cpp:267
msgid "Select Theme File"
msgstr "Нақыш файлын таңдаңыз"

#: kthememanager.cpp:301
#, kde-format
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "<b>%1</b> деген нақышын өшіргіңіз келгені рас па?"

#: kthememanager.cpp:302
msgid "Remove Theme"
msgstr "Нақышты өшіру"

#: kthememanager.cpp:324
msgid "My Theme"
msgstr "Менің нақышым"

#: kthememanager.cpp:335
#, kde-format
msgid "Theme %1 already exists."
msgstr "%1 деген нақыш бар ғой."

#: kthememanager.cpp:355
#, kde-format
msgid "Your theme has been successfully created in %1."
msgstr "Нақышыңыз сәтті құрылды %1."

#: kthememanager.cpp:356
msgid "Theme Created"
msgstr "Нақыш құрылды"

#: kthememanager.cpp:358
msgid "An error occurred while creating your theme."
msgstr "Нақышыңызды құру кезде қате пайда болды."

#: kthememanager.cpp:359
msgid "Theme Not Created"
msgstr "Нақыш құрылған жоқ"

#: kthememanager.cpp:386
msgid "This theme does not contain a preview."
msgstr "Бұл нақыштың алдын-ала қарауы жоқ."

#: kthememanager.cpp:390
#, kde-format
msgid "Author: %1<br />Email: %2<br />Version: %3<br />Homepage: %4"
msgstr "Авторы: %1<br />Эл.пошта: %2<br />Нұсқасы: %3<br />Мекен парағы: %4"

