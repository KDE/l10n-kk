msgid "Desktop Theme Details"
msgstr "Үстел нақышының егжей-тегжейі"

#: desktopthemedetails.cpp:412
msgid "Unable to save theme."
msgstr "Нақыш сақталмайды."

#: desktopthemedetails.cpp:429
#, kde-format
msgid ""
"To change your desktop theme to \"%1\", open\n"
"Desktop Settings and select \"%2\" from the droplist."
msgstr ""
"Үстел нақышын \"%1\" дегенге ауыстыру үшін\n"
"Үстел баптауларына барып, ашлылмалы тізімінен \"%2\" дегенді таңдаңыз."

#: desktopthemedetails.cpp:429
msgid "How to Change Desktop Theme"
msgstr "Үстел нақышын қалай ауыстыру"

#: desktopthemedetails.cpp:440
#, kde-format
msgid ""
"Theme items have been changed.  Do you still wish remove the \"%1\" theme?"
msgstr "Үстел нақышы ауысты. \"%1\" нақышын өшіруін қалайсыз ба?"

#: desktopthemedetails.cpp:440 desktopthemedetails.cpp:445
#: desktopthemedetails.cpp:448
msgid "Remove Desktop Theme"
msgstr "Үстел нақышын өшіру"

#: desktopthemedetails.cpp:445
msgid "Removal of the default KDE theme is not allowed."
msgstr "Әдетті KDE өзіннің нақышын өшіруге болмайды."

#: desktopthemedetails.cpp:448
#, kde-format
msgid "Are you sure you wish remove the \"%1\" theme?"
msgstr "Шынымен \"%1\" нақышын өшірмексіз бе?"

#: desktopthemedetails.cpp:466
msgid "Unfortunately, this feature is not yet implemented."
msgstr "Өкінішке орай бұл мімкіндік әлі іске асырылмаған."

#: desktopthemedetails.cpp:466
msgid "Export Desktop Theme"
msgstr "Үстел нақышын экспорт ету"

#: desktopthemedetails.cpp:522
msgid "Theme items data file could not be found."
msgstr "Нақыш нысандар дерек файлы табылмады."

#: desktopthemedetails.cpp:528
msgid "Theme Item"
msgstr "Нақыш нысандары"

#: desktopthemedetails.cpp:528
msgid "Source"
msgstr "Қайдан"

#: desktopthemedetails.cpp:589
#, kde-format
msgid "%1 %2"
msgstr "%1 %2"

#: desktopthemedetails.cpp:598 desktopthemedetails.cpp:616
