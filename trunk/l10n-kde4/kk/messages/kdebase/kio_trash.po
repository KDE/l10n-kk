msgstr "(%1 %2)"

#: kcmtrash.cpp:264
msgid "Delete files older than:"
msgstr "Келесіден ескі файлдар өшірілсін:"

#: kcmtrash.cpp:275
msgid "Limit to maximum size"
msgstr "Макс. өлшемінің шегі"

#: kcmtrash.cpp:286
#, fuzzy
#| msgid "Maximum Size:"
msgid "Maximum size:"
