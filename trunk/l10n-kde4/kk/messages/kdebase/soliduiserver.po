#: soliduiserver.cpp:296
#, kde-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"'%1' дегеніңізде автожегу файлы бар. Орындалсын ба?\n"
"Бұндайда қауіпсіздік жағынан тәуекелі бар екенін ескерген жөн"

#: soliduiserver.cpp:300
#, kde-format
msgid "Autorun - %1"
msgstr "Автожегу - %1"

#: soliduiserver.cpp:361
#, kde-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"'%1' дегеніңізде автоашу файлы бар. '%2' ашылсын ба?\n"
"Бұндайда қауіпсіздік жағынан тәуекелі бар екенін ескерген жөн"

#: soliduiserver.cpp:365
#, kde-format
msgid "Autoopen - %1"
msgstr "Автоашу - %1"
