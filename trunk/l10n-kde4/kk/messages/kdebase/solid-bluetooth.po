#: solid-bluetooth.cpp:52
msgid "solid-bluetooth"
msgstr "solid-bluetooth"

#: solid-bluetooth.cpp:54
msgid "KDE tool for querying and controlling your hardware from the command line"
msgstr "Жабдықтарды команда жолынан сұрап басқаратын KDE құралы"

#: solid-bluetooth.cpp:166
msgid "Syntax Error: Not enough arguments"
msgstr "Синтаксис қатесі: Аргументтер жетіспейді"

#: solid-bluetooth.cpp:172
msgid "Syntax Error: Too many arguments"
msgstr "Синтаксис қатесі: Аргументтері тым көп"

#: solid-bluetooth.cpp:184
msgid "Show available commands by domains"
msgstr "Бар командаларды домендер бойынша көрсету"

#: solid-bluetooth.cpp:186
msgid "Command (see --commands)"
msgstr "Командасы (--commands деп қараңыз)"

#: solid-bluetooth.cpp:188
msgid "Arguments for command"
msgstr "Команданың аргументтері"

#: solid-bluetooth.cpp:200
msgid "Syntax:"
msgstr "Синтаксисі:"

#: solid-bluetooth.cpp:203
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # Bluetooth адаптер/интерфейстер тізімін шығару\n"

#: solid-bluetooth.cpp:206
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # Bluetooth әдетті адаптер/интерфейсін шығару\n"

#: solid-bluetooth.cpp:209
#| msgid ""
#| "             # Query information about the bluetooth adapter/interface "
#| "with 'ubi'\n"
msgid ""
"             # Query the name from the remote device 'remote-mac' with "
"'ubi'\n"
msgstr "             # 'ubi' арқылы 'remote-mac' қашықтағы құрылғыдан атауын сурау\n"

#: solid-bluetooth.cpp:212
msgid ""
"             # Query information about the bluetooth adapter/interface with "
"'ubi'\n"
msgstr "             # 'ubi' арқылы bluetooth адаптер/интерфейсінің мәліметін сұрау\n"

#: solid-bluetooth.cpp:215
msgid ""
"             # Set the bluetooth adapter name.\n"
"             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
"             # off|connectable|discoverable\n"
msgstr ""
"             # Bluetooth адаптеріне атау беру.\n"
"             # Bluetooth адаптерінің режімін орнату. Мұнда 'value' деген:\n"
"             # off|connectable|discoverable дегеннің біреуі\n"

#: solid-bluetooth.cpp:220
msgid "             # Scan for bluetooth remote devices.\n"
msgstr "             # Қашықтағы bluetooth құрылғыны іздестіру.\n"

#: solid-bluetooth.cpp:223
msgid "             # List configured input devices.\n"
msgstr "             # Бапталған енгізу құрылғылар тізімін шығару.\n"

#: solid-bluetooth.cpp:226
msgid ""
"             # Setup bluetooth input device.\n"
"             # Remove configuration of remote input device.\n"
"             # Connect or disconnect bluetooth input device.\n"
msgstr ""
"             # Енгізу bluetooth құрылығысын орнату.\n"
"             # Қашықтағы енгізу құрылғының баптауын өшіру.\n"
"             # Bluetooth енгізу құрылғыны қосу не ажырату.\n"

#: solid-bluetooth.cpp:231
msgid ""
"             # Create bonding (pairing) with bluetooth remote device.\n"
"             # Remove bonding of bluetooth remote device.\n"
"             # Check for bonding of bluetooth remote device.\n"
msgstr ""
"             # Қашықтағы bluetooth құрылғымен байланыс құру.\n"
"             # Қашықтағы bluetooth құрылғымен байланысты үзу.\n"
"             # Қашықтағы bluetooth құрылғымен байланысын тексеру.\n"

#: solid-bluetooth.cpp:371
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "Синтаксис қатесі: '%1' командасы беймәлім"

#: solid-bluetooth.cpp:551
msgid "Error: unsupported operation!"
msgstr "Қате: қолдауы жоқ әрекет!"

#: solid-bluetooth.cpp:562 solid-bluetooth.cpp:613
#, kde-format
msgid "Error: %1"
msgstr "Қате: %1"

#: solid-bluetooth.cpp:659
#, kde-format
msgid "Progress: %1%"
msgstr "Барысы: %1"

#: solid-bluetooth.cpp:664
#, kde-format
msgid "Info: %1"
msgstr "Мәлімет: %1"

