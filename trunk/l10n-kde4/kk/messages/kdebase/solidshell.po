#: main.cpp:60
msgid "solidshell"
msgstr "solidshell"

#: main.cpp:62
msgid ""
"KDE tool for querying and controlling your hardware from the command line"
msgstr "Жабдықтарды команда жолынан сұрап басқаратын KDE құралы"

#: main.cpp:281
msgid "Syntax Error: Not enough arguments"
msgstr "Синтаксис қатесі: Аргументтер жетіспейді"

#: main.cpp:287
msgid "Syntax Error: Too many arguments"
msgstr "Синтаксис қатесі: Аргументтері тым көп"

#: main.cpp:299
msgid "Show available commands by domains"
msgstr "Бар командаларды домендер бойынша көрсету"

#: main.cpp:301
msgid "Domain (see --commands)"
msgstr "Домені (--commands деп қараңыз)"

#: main.cpp:303
msgid "Command (see --commands)"
msgstr "Командасы (--commands деп қараңыз)"

#: main.cpp:305
msgid "Arguments for command"
msgstr "Команданың аргументтері"

#: main.cpp:317
msgid "Syntax:"
msgstr "Синтаксисі:"

#: main.cpp:320
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # Жүйедегі бар жабдықтар тізімін шығару.\n"
"             # - Егер 'nonportableinfo' параметрі келтірілсе, құрылғының\n"
"             # қасиеттер тізімі шығарлады (байқаңыз, бұндайда қасиеттің "
"атауы\n"
"             # бағдарламасына тәуелді),\n"
"             # - Егер 'details' параметрі келтірілсе, құрылғы интерфейстері\n"
"             # мен оның қасиеттері платформаға бейтарап\n"
"             # түрінде шығарылады,\n"
"             # - Әйтпесе, тек құрылғының UDI-тері ғана шығарылады.\n"

#: main.cpp:330
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # Платформадан тәуелсіз түрінде 'udi' дегенге сәйкесті\n"
"             # құрылғының барлық интерфейстерін және оның қасиеттерін\n"
"             # көрсету\n"

#: main.cpp:334
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # 'udi' дегенге сәйкесті құрылғының барлық қасиеттерін көрсету\n"
"             # (байқаңыз, бұндайда қасиеттің атауы бағдарламасына тәуелді)\n"

#: main.cpp:338
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # 'predicate' дегенге сәйкесті UDI-лер тізімін шығару.\n"
"             # - Егер 'parentUdi' келтірілген болса, іздеу сәйкес келетін\n"
"             # құрылғының саласымен шектеледі.\n"
"             # - Әйтпесе, іздеу барлық құрылығыларға салынады.\n"

#: main.cpp:344
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr ""
"             # Істеуге келсе, 'udi' дегенге сәйкесті құрылғыны тіркеу.\n"

#: main.cpp:347
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr ""
"             # Істеуге келсе, 'udi' дегенге сәйкесті құрылғыны тіркеуден "
"шығару.\n"

#: main.cpp:350
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr ""
"             # Істеуге келсе, 'udi' дегенге сәйкесті құрылғыны алып шығару.\n"

#: main.cpp:357
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # Қуаттандыруды басқару туралы мәліметті шығару.\n"
"             # - Егер 'suspend' параметрі келтірілсе, осы жүйедегі қалғу\n"
"             #  әдістерінің тізімі шығарылады.\n"
"             # - Егер 'scheme' параметрі келтірілсе, осы жүйенің\n"
"             # қуаттандыруын басқару сұлбалар тізімі шығарылады.\n"
"             # - Егер 'cpufreq' параметрі келтірілсе, жүйедегі "
"процессорының\n"
"             # жиілік саясаттар тізімі шығарылады.\n"

#: main.cpp:366
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # Жүйені қуаттандыруын басқару параметрлерін орнату.\n"
"             # - Егер 'scheme' параметрі келтірілсе, қуаттандыру басқару\n"
"             # сұлбасы 'value' деп орнатылады\n"
"             # - Егер 'cpufreq' параметрі келтірілсе, процессордың жиілік\n"
"             # саясаты 'value' деп орнатылады.\n"

#: main.cpp:373
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Компьютерді келтірілген 'method' әдісімен қалғыту.\n"

#: main.cpp:378
msgid "             # List the network devices present.\n"
msgstr "             # Бар желі құрылғылар тізімін шығару.\n"

#: main.cpp:381
msgid ""
"             # List the networks known to the device specified by 'uni'.\n"
msgstr ""
"             # Келтірілген 'uni' құрылғысына мәлім желілер тізімін шығару.\n"

#: main.cpp:384
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""
"             # Белсенді желілік ерекшеліктерін сұрап анықтау.\n"
"             # - Егер 'status' параметрі келтірілсе, жүйеге желі әрекеттері\n"
"             # рұқсат етілгені туралы жауап қайтарылады\n"
"             # - Егер 'wireless' параметрі келтірілсе, жүйе сымсыз желіге\n"
"             # қосылған - қосылмаған туралы жауап қайтарылады\n"
"             # - Егер 'interface' параметрі келтрілсе, 'uni' сілтеген\n"
"             # желі интерфейсінің қасиеттері шығарылады.\n"
"             # - Егер 'network' параметрі келтірілсе, 'device-uni' деген\n"
"             # құрылғысы қосылған 'network-uni' деген желінің қасиеттері "
"шығарылады.\n"

#: main.cpp:395 main.cpp:398
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # Осы жүйеге желі әрекеттерін рұқсат ету не етпеу.\n"

#: main.cpp:401
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # 'device-uni' құрылғысы арқылы 'network-uni' желіні "
"белсендету.\n"
"             # Қаласаңыз, оналтылық 'key' (Hardcoded) кілтімен WEP128, ашық-"
"жүйелі шифрлауды пайдаланыңыз\n"
"             # Мұндағы 'authentication' деген:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [ашық|ортақ]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes паролінің бірі\n"
"             # wpaeap SOLIDSHELL-ДЕ ІСКЕ АСЫРЫЛМАҒАН\n"

#: main.cpp:411
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # Bluetooth адаптер/интерфейстер тізімін шығару\n"

#: main.cpp:414
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # Bluetooth әдетті адаптер/интерфейсін шығару\n"

#: main.cpp:417
msgid ""
"             # Query information about the bluetooth adapter/interface with "
"'ubi'\n"
msgstr ""
"             # 'ubi' деген bluetooth адаптер/интерфейсінің мәліметін сұрау\n"

#: main.cpp:420
msgid ""
"             # Set the bluetooth adapter name.\n"
"             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
"             # off|connectable|discoverable\n"
msgstr ""
"             # Bluetooth адаптеріне атау беру.\n"
"             # Bluetooth адаптерінің режімін орнату. Мұнда 'value' деген:\n"
"             # off|connectable|discoverable дегеннің біреуі\n"

#: main.cpp:425
msgid "             # Scan for bluetooth remote devices.\n"
msgstr "             # Қашықтағы bluetooth құрылғыны іздестіру.\n"

#: main.cpp:428
msgid "             # List configured input deviceses.\n"
msgstr "             # Бар енгізу құрылғылар тізімін шығару.\n"

#: main.cpp:431
msgid ""
"             # Setup bluetooth input device.\n"
"             # Remove configuration of remote input device.\n"
"             # Connect or disconnect bluetooth input device.\n"
msgstr ""
"             # Енгізу bluetooth құрылығысын орнату.\n"
"             # Қашықтағы енгізу құрылғының баптауын өшіру.\n"
"             # Bluetooth енгізу құрылғыны қосу не ажырату.\n"

#: main.cpp:436
msgid ""
"             # Create bonding (pairing) with bluetooth remote device.\n"
"             # Remove bonding of bluetooth remote device.\n"
"             # Check for bonding of bluetooth remote device.\n"
msgstr ""
"             # Қашықтағы bluetooth құрылғымен байланыс құру.\n"
"             # Қашықтағы bluetooth құрылғымен байланысты үзу.\n"
"             # Қашықтағы bluetooth құрылғымен байланысын тексеру.\n"

