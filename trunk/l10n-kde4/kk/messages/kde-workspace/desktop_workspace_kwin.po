msgctxt "Comment"
msgid "Slide back windows when another window is raised"
msgstr "Басқа терезе алдына шығарылғанда терезелерді сырғанату."

#: effects/slide/slide.desktop:2
msgctxt "Name"
msgid "Slide"
msgstr "Сырғанату"

