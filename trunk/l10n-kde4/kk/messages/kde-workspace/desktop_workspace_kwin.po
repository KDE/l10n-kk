msgctxt "Name"
msgid "Snap Helper"
msgstr "Адаспауға көмек"

#: effects/snaphelper/snaphelper.desktop:71
msgctxt "Comment"
msgid "Help you locate the center of the screen when moving a window."
msgstr "Терезені жылжытқанда экранның ортасын жоғалтпауға көмек."

