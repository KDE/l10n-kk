#: effects/startupfeedback/startupfeedback.desktop:58
msgctxt "Comment"
msgid "Helper effect for startup feedback"
msgstr "Жегу барысын көрсететін эффекті"

#: effects/thumbnailaside/thumbnailaside_config.desktop:8
#: effects/thumbnailaside/thumbnailaside.desktop:2
msgctxt "Name"
msgid "Thumbnail Aside"
msgstr "Нобайды шеттеу"

#: effects/thumbnailaside/thumbnailaside.desktop:80
msgctxt "Comment"
msgid "Display window thumbnails on the edge of the screen"
msgstr "Терезе нобайларын экранның шетінде көрсету"

#: effects/trackmouse/trackmouse_config.desktop:8
#: effects/trackmouse/trackmouse.desktop:2
msgctxt "Name"
msgid "Track Mouse"
msgstr "Тышқандың ізі"

#: effects/trackmouse/trackmouse.desktop:83
msgctxt "Comment"
msgid "Display a mouse cursor locating effect when activated"
msgstr "Белсенді тышқынның ізін көрсету"

#: effects/translucency/package/metadata.desktop:2
msgctxt "Name"
msgid "Translucency"
msgstr "Мөлдірлік"

#: effects/translucency/package/metadata.desktop:86
msgctxt "Comment"
msgid "Make windows translucent under different conditions"
msgstr "Түрлі жағдайда терезелерді мөлдір қылады"

#: effects/windowgeometry/windowgeometry_config.desktop:8
#: effects/windowgeometry/windowgeometry.desktop:3
msgctxt "Name"
msgid "WindowGeometry"
msgstr "Терезенің өлшемдері"

#: effects/windowgeometry/windowgeometry.desktop:57
msgctxt "Comment"
msgid "Display window geometries on move/resize"
msgstr "Терезені өзгерткенде өлшемін көрсету"

#: effects/wobblywindows/wobblywindows_config.desktop:8
#: effects/wobblywindows/wobblywindows.desktop:2
msgctxt "Name"
msgid "Wobbly Windows"
msgstr "Майысқақ терезелер"

#: effects/wobblywindows/wobblywindows.desktop:76
msgctxt "Comment"
msgid "Deform windows while they are moving"
msgstr "Терезелер жылжығанда майысқақ болады"

#: effects/zoom/zoom_config.desktop:8 effects/zoom/zoom.desktop:2
msgctxt "Name"
msgid "Zoom"
msgstr "Ұлғайту"

#: effects/zoom/zoom.desktop:89
msgctxt "Comment"
msgid "Magnify the entire desktop"
msgstr "Бүкіл үстелді үлкейту"

#: kcmkwin/kwindecoration/kwindecoration.desktop:14
msgctxt "Name"
msgid "Window Decorations"
msgstr "Терезенің безендірулері"

#: kcmkwin/kwindecoration/kwindecoration.desktop:76
msgctxt "Comment"
msgid "Configure the look and feel of window titles"
msgstr "Терезе айдарының безендіруін баптау"

#: kcmkwin/kwindecoration/kwindecoration.desktop:164
msgctxt "X-KDE-Keywords"
msgid ""
"kwin,window,manager,border,style,theme,look,feel,layout,button,handle,edge,"
"kwm,decoration"
msgstr ""
"kwin,window,manager,border,style,theme,look,feel,layout,button,handle,edge,"
"kwm,decoration"

#: kcmkwin/kwindesktop/desktop.desktop:14
msgctxt "Name"
msgid "Virtual Desktops"
msgstr "Виртуалды Үстелдер"

#: kcmkwin/kwindesktop/desktop.desktop:78
msgctxt "Comment"
msgid "You can configure how many virtual desktops there are."
msgstr "Керек виртуалды үстелдер санын орнату."

#: kcmkwin/kwindesktop/desktop.desktop:166
msgctxt "X-KDE-Keywords"
msgid ""
"desktop,desktops,number,virtual desktop,multiple desktops,pager,pager widget,"
"pager applet,pager settings"
msgstr ""
"desktop,desktops,number,virtual desktop,multiple desktops,pager,pager widget,"
"pager applet,pager settings"

#: kcmkwin/kwinoptions/kwinactions.desktop:12
msgctxt "Name"
msgid "Actions"
msgstr "Амалдар"

#: kcmkwin/kwinoptions/kwinactions.desktop:103
msgctxt "Comment"
msgid "Configure mouse actions on windows"
msgstr "Терезелердегі тышқанның әрекеттерін баптау"

#: kcmkwin/kwinoptions/kwinactions.desktop:144
msgctxt "X-KDE-Keywords"
msgid ""
"shade,maximise,maximize,minimize,minimise,lower,operations menu,titlebar,"
"resize"
msgstr ""
"shade,maximise,maximize,minimize,minimise,lower,operations menu,titlebar,"
"resize"

#: kcmkwin/kwinoptions/kwinadvanced.desktop:11
msgctxt "Name"
msgid "Advanced"
msgstr "Жетелеу"

#: kcmkwin/kwinoptions/kwinadvanced.desktop:102
msgctxt "Comment"
msgid "Configure advanced window management features"
msgstr "Терезе басқаруының жетелеп баптау"

#: kcmkwin/kwinoptions/kwinadvanced.desktop:189
msgctxt "X-KDE-Keywords"
msgid ""
"shading,border,hover,active borders,tiling,tabs,tabbing,window tabbing,"
"window grouping,window tiling,window placement,placement of windows,window "
"advanced behavior"
msgstr ""
"shading,border,hover,active borders,tiling,tabs,tabbing,window tabbing,"
"window grouping,window tiling,window placement,placement of windows,window "
"advanced behavior"

#: kcmkwin/kwinoptions/kwinfocus.desktop:11
msgctxt "Name"
msgid "Focus"
msgstr "Назар"

#: kcmkwin/kwinoptions/kwinfocus.desktop:100
msgctxt "Comment"
msgid "Configure the window focus policy"
msgstr "Терезедегі назар тартібін баптау"

#: kcmkwin/kwinoptions/kwinfocus.desktop:186
msgctxt "X-KDE-Keywords"
