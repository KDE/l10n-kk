msgctxt "Comment"
msgid "Highlights a screen edge when approaching"
msgstr "Экран жиегіне жақындағанда оны бояп белгілеу"

#: effects/screenshot/screenshot.desktop:2
msgctxt "Name"
msgid "Screenshot"
msgstr "Экраннан түсіргені"

