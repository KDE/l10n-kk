#: desktopnameswidget.cpp:67
#, kde-format
msgid "Desktop %1:"
msgstr "%1-үстел:"

#: desktopnameswidget.cpp:69 desktopnameswidget.cpp:70
#, kde-format
msgid "Here you can enter the name for desktop %1"
msgstr "Мұнда %1-үстел қалай аталатынын келтіріңіз"

#: desktopnameswidget.cpp:108 main.cpp:220
#, kde-format
msgid "Desktop %1"
msgstr "%1-үстел"

#: main.cpp:84
msgid ""
"<h1>Multiple Desktops</h1>In this module, you can configure how many virtual "
"desktops you want and how these should be labeled."
msgstr ""
"<h1>Бірнеше Үстел</h1>Қанша виртуалды үстел керек және олар қалай "
"белгіленетінің осы модулінде анықталады."

#: main.cpp:96
msgid "Switch to Next Desktop"
msgstr "Келесі үстелге ауысу"

#: main.cpp:97
msgid "Switch to Previous Desktop"
msgstr "Алдыңғы үстелге ауысу"

#: main.cpp:98
msgid "Switch One Desktop to the Right"
msgstr "Оң жақ үстелге ауысу"

#: main.cpp:99
msgid "Switch One Desktop to the Left"
msgstr "Сол жақ үстелге ауысу"

#: main.cpp:100
msgid "Switch One Desktop Up"
msgstr "Үстңгі жақ үстелге ауысу"

#: main.cpp:101
msgid "Switch One Desktop Down"
msgstr "Астыңғы жақ үстелге ауысу"

#: main.cpp:102
msgid "Walk Through Desktops"
msgstr "Үстелдерді аралау"

#: main.cpp:103
msgid "Walk Through Desktops (Reverse)"
msgstr "Үстелідерді (кері) аралау"

#: main.cpp:104
msgid "Walk Through Desktop List"
msgstr "Үстелдерінің тізімі бойынша аралау"

#: main.cpp:105
msgid "Walk Through Desktop List (Reverse)"
msgstr "Үстелдерінің тізімі бойынша (кері) аралау"

#: main.cpp:107 main.cpp:128 main.cpp:496 main.cpp:497
msgid "Desktop Switching"
msgstr "Басқа үстелге ауысу"

#: main.cpp:119 main.cpp:476
#, kde-format
msgid "Switch to Desktop %1"
msgstr "%1-үстеліне ауысу"

#: main.cpp:147
msgid "No Animation"
msgstr "Анимациясыз"

#: main.cpp:480
#, kde-format
msgid "No suitable Shortcut for Desktop %1 found"
msgstr "%1-үстелге лайық тіркесім табылған жоқ"

#: main.cpp:486
#, kde-format
msgid "Assigned global Shortcut \"%1\" to Desktop %2"
msgstr "Жалпы жүйелік \"%1\" тіркесімі  %2-үстелге тағайындалды"

#: main.cpp:489
#, kde-format
msgid "Shortcut conflict: Could not set Shortcut %1 for Desktop %2"
msgstr "Тіркесім қайшылығы: %1 тіркесімі %2-үстелге тағайындалмады"

#. i18n: ectx: attribute (title), widget (QWidget, desktop)
#: main.ui:33
msgid "Desktops"
msgstr "Үстелдер"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: main.ui:39
msgid "Layout"
msgstr "Құрамы"

#. i18n: ectx: property (whatsThis), widget (QLabel, numberLabel)
#. i18n: ectx: property (whatsThis), widget (QSpinBox, numberSpinBox)
#: main.ui:51 main.ui:64
msgid ""
"Here you can set how many virtual desktops you want on your KDE desktop."
msgstr ""
"Мұнда KDE үстеліңізде қанша виртуалды үстел керек ететіңізді анықтай аласыз."

#. i18n: ectx: property (text), widget (QLabel, numberLabel)
#: main.ui:54
msgid "Number of desktops:"
msgstr "Үстелдер саны: "

#. i18n: ectx: property (text), widget (QLabel, label)
#: main.ui:83
msgid "Number of rows:"
msgstr "Бағандар саны: "

#. i18n: ectx: property (text), widget (QCheckBox, activityCheckBox)
#: main.ui:100
msgid "Different widgets for each desktop"
msgstr "Әрбір үстелдегі виджеттері бөлек"

#. i18n: ectx: property (title), widget (QGroupBox, nameGroup)
#: main.ui:110
msgid "Desktop Names"
msgstr "Үстел атаулары"

#. i18n: ectx: attribute (title), widget (QWidget, switching)
#: main.ui:143
msgid "Switching"
msgstr "Ауысу"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, wrapAroundBox)
#: main.ui:149
msgid ""
"Enable this option if you want keyboard or active desktop border navigation "
"beyond the edge of a desktop to take you to the opposite edge of the new "
"desktop."
msgstr ""
"Бұл параметрді таңдағанда, пернетақта не незардағы үстелдің шегінің "
"сыртындағы навигациясы жаңа үстелдің қарсы шетіне шығарады."

#. i18n: ectx: property (text), widget (QCheckBox, wrapAroundBox)
#: main.ui:152
msgid "Desktop navigation wraps around"
msgstr "Тұйық үстел навигациясы"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: main.ui:159
msgid "Desktop Effect Animation"
msgstr "Үстел эффект анимациясы"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: main.ui:171
msgid "Animation:"
msgstr "Анимация"

#. i18n: ectx: property (title), widget (QGroupBox, popupInfoCheckBox)
#: main.ui:211
msgid "Desktop Switch On-Screen Display"
msgstr "Экрандағы үстелара ауысу панелі"

#. i18n: ectx: property (text), widget (QLabel, hideLabel)
#: main.ui:229
msgid "Duration:"
msgstr "Ұзақтығы:"

#. i18n: ectx: property (suffix), widget (QSpinBox, popupHideSpinBox)
#: main.ui:239
msgid " msec"
msgstr " мсек"

#. i18n: ectx: property (toolTip), widget (QCheckBox, desktopLayoutIndicatorCheckBox)
#: main.ui:252
msgid ""
"Enabling this option will show a small preview of the desktop layout "
"indicating the selected desktop."
msgstr ""
"Бұл белгіні қойсаңыз, таңдалған үстелдің көрінісін нобайлайтын шағын сурет "
"көрсетіледі."

#. i18n: ectx: property (text), widget (QCheckBox, desktopLayoutIndicatorCheckBox)
#: main.ui:255
msgid "Show desktop layout indicators"
msgstr "Үстелдегінін орналасу индикаторы болсын"

#. i18n: ectx: property (title), widget (QGroupBox, shortcutsGroupBox)
#: main.ui:265
msgid "Shortcuts"
msgstr "Тіркесімдер"

#. i18n: ectx: property (text), widget (QCheckBox, allShortcutsCheckBox)
#: main.ui:284
msgid "Show shortcuts for all possible desktops"
msgstr "Бар және болуға мүмкін үстелдерінің перне тіркесімдері"

#~ msgid "Mouse wheel over desktop background switches desktop"
#~ msgstr "Үстел аясында тышқанның тегіршігі үстелді ауыстырады"
