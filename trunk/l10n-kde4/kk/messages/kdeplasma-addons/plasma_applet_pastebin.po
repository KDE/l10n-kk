#: pastebin.cpp:197
msgctxt "The status of the applet has not been set - i.e. it is unset."
msgid "Unset"
msgstr "Орнатылмаған"

#: pastebin.cpp:202
msgid "Drop text or an image onto me to upload it to Pastebin."
msgstr ""
"Мәтін не кескініңізді Pastebin-ге жүктеп беру үшін осында сүйреп әкеліңіз."

#: pastebin.cpp:207
msgid "Error during upload. Try again."
msgstr "Жүктеп беру кезде қате орын алды. Қайталап көріңіз."

#: pastebin.cpp:215
#, kde-format
msgid "Successfully uploaded to %1."
msgstr "%1 дегенге сәтті жүктеп берілді."

#: pastebin.cpp:223
msgid "Sending...."
msgstr "Жіберу.,,"

#: pastebin.cpp:358
msgid "Drop!"
msgstr "Лақтыр!"

#: pastebin.cpp:377
msgid "Error: Try Again"
msgstr "Қате: Қайталап көріңіз."

#: pastebin.cpp:445
msgid "General"
msgstr "Жалпы"

#: pastebin.cpp:608
#, kde-format
msgctxt ""
"Notification when the pastebin applet has copied the URL to the clipboard"
msgid "%1 has been copied to your clipboard"
msgstr "%1 алмасу буферіңізге көшіріп алынды"

