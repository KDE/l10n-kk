#: groupware.cpp:284
#, kde-format
msgid ""
"You changed the invitation \"%1\".\n"
"Do you want to email the attendees an update message?"
msgstr ""
"\"%1\" шақыруын өзгерттііңіз.\n"
"Қаттысушыларға, ол туралы эл.пошта жолдаймысыз?"

#: groupware.cpp:290
#, kde-format
msgid ""
"You removed the invitation \"%1\".\n"
"Do you want to email the attendees that the event is canceled?"
msgstr ""
"\"%1\" шақыруын өшірдіңіз.\n"
"Қаттысушыларға, оқиға болмайды деп, эл.пошта жолдаймысыз?"

#: groupware.cpp:294
#, kde-format
msgid ""
"You removed the invitation \"%1\".\n"
"Do you want to email the attendees that the todo is canceled?"
msgstr ""
"\"%1\" шақыруын өшірдіңіз.\n"
"Қаттысушыларға, жоспар жойылды деп, эл.пошта жолдаймысыз?"

#: groupware.cpp:298
#, kde-format
msgid ""
"You removed the invitation \"%1\".\n"
"Do you want to email the attendees that the journal is canceled?"
msgstr ""
"\"%1\" шақыруын өшірдіңіз.\n"
"Қаттысушыларға, күн тәртібі жойылды деп, эл.пошта жолдаймысыз?"

#: groupware.cpp:305
#, kde-format
msgid ""
"The event \"%1\" includes other people.\n"
"Do you want to email the invitation to the attendees?"
msgstr ""
"\"%1\" оқиғасына басқалар да қатысты.\n"
"Оларға шақыру эл.пошта жолдаймысыз?"

#: groupware.cpp:309
#, kde-format
msgid ""
"The todo \"%1\" includes other people.\n"
"Do you want to email the invitation to the attendees?"
msgstr ""
"\"%1\" іс жоспарына басқалар да қатысты.\n"
"Оларға эл.пошта жолдаймысыз?"

