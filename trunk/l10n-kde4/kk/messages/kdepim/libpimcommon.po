msgid "Permissions"
msgstr "Рұқсаттары"

#: aclentrydialog.cpp:127
msgid "<b>Note: </b>Renaming requires write permissions on the parent folder."
msgstr ""
"<b>Ескерту: </b>Атуын өзгерту үшін аталық қапшығына жазу рұқсаты керек."

