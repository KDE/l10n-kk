msgstr "\"%1\" деген команда қолданбайды"

#: shared/error.cpp:201
#, kde-format
msgid "Test \"%1\" not supported"
msgstr "\"%1\" деген сынағы қолданбайды"

#: shared/error.cpp:204
#, kde-format
