#. i18n: file filteredit_base.ui line 210
#. i18n: tag string
#. i18n: file ./filteredit_base.ui line 210
#: rc.cpp:48 rc.cpp:2341
msgid "Show all except selected"
msgstr "Таңдалмағандар ғана көрсетілсін"

