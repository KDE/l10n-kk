#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 577
#: rc.cpp:1017
msgid "Warn if root certificate expires in &less than:"
msgstr "Түбір куәлігінің мерзімі бітуге не&ше күн қалғанда ескерту:"

