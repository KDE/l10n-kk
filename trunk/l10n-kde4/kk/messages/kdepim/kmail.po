#. i18n: tag string
#. i18n: file smimeconfiguration.ui line 137
#: rc.cpp:990
msgid "Entirely disables the use of HTTP for S/MIME."
msgstr "S/MIME үшін HTTP мүлдем рұксат етілмесін."

