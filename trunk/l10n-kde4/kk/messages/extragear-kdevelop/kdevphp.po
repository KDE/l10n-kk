#: duchain/builders/contextbuilder.cpp:410
#, kde-format
msgid "Circular inheritance of %1 and %2"
msgstr "%1 және %2 бір-бірінен туындау тұйықтығы"

#: duchain/builders/declarationbuilder.cpp:330
#, kde-format
msgid "Access type for interface method %1 must be omitted."
msgstr "%1 интерфейс әдісінің қатынау түрін келтірмеу керек."

#: duchain/builders/declarationbuilder.cpp:334
#, kde-format
msgid "Interface function %1 cannot contain body."
msgstr "%1 интерфайс функцияның денесі болмау керек."

#: duchain/builders/declarationbuilder.cpp:346
#, kde-format
msgid ""
"Class %1 contains abstract method %2 and must therefore be declared abstract "
"or implement the method."
msgstr ""
"%1 класы абстрактты %2 әдісі бар болғандықтан абстрактты болу тиіс, немесе "
"әдісін іске асыру керек."

#: duchain/builders/declarationbuilder.cpp:352
#, kde-format
msgid "Abstract function %1 cannot contain body."
msgstr "%1 абстрактты функцияның денесі болмау керек."

#: duchain/builders/declarationbuilder.cpp:355
msgid "Cannot use the final modifier on an abstract class member."
msgstr "Абстрактты класс мүшесінде final түрлендіргіші қолданбау тиіс.."

#: duchain/builders/declarationbuilder.cpp:365
#, kde-format
msgid "Non-abstract method %1 must contain body."
msgstr "%1 абстрактты әдісінің денесі болу керек."

#: duchain/builders/declarationbuilder.cpp:383
msgid "Properties cannot be declared final."
msgstr "Қасиеттерін final деп мәлімдеуге болмайды."

#: duchain/builders/declarationbuilder.cpp:386
msgid "Properties cannot be declared abstract."
msgstr "Қасиеттерін abstract деп мәлімдеуге болмайды."

#: duchain/builders/declarationbuilder.cpp:432
#, kde-format
msgid ""
"Trait method %1 has not been applied, because there are collisions with "
"other trait methods on %2"
msgstr ""

#: duchain/builders/declarationbuilder.cpp:586
#, kde-format
msgid "Cannot redeclare private property %1 from this context."
msgstr "Бұл контекстінде private %1 қасиетін қайта мәлімдеуге болмайды."

#: duchain/builders/declarationbuilder.cpp:592
#, kde-format
msgid "Cannot redeclare protected property %1 from this context."
msgstr "Бұл контекстінде protected %1 қасиетін қайта мәлімдеуге болмайды."

#: duchain/builders/declarationbuilder.cpp:625
msgid "Traits cannot have constants."
msgstr "Трейттерде тұрақтылар бола алмайды."

#: duchain/builders/declarationbuilder.cpp:666
msgid ""
"Only booleans, ints, floats and strings are allowed for class constants."
msgstr "Клас тұрақтылары тек boolean, int, float және string ғана болу тиіс."

#: duchain/builders/declarationbuilder.cpp:718
msgid "Cannot use 'final' as method modifier"
msgstr ""

#: duchain/builders/declarationbuilder.cpp:721
msgid "Cannot use 'static' as method modifier"
msgstr ""

#: duchain/builders/declarationbuilder.cpp:769
msgid "Default value for parameters with a class type hint can only be NULL."
msgstr ""
"Түрі туралы ишарасы бар клас параметрінің әдетті мәні тек NULL бола алады."

#: duchain/builders/declarationbuilder.cpp:772
msgid "Following parameters must have a default value assigned."
msgstr "Келесі параметрлерде әдетті мәні болуға тиіс."

#: duchain/builders/declarationbuilder.cpp:879
#, kde-format
msgid "Cannot redeclare PHP internal %1."
msgstr "PHP ішіндегі %1 дегенді қайта мәлімдеуге болмайды."

#: duchain/builders/declarationbuilder.cpp:882
#, kde-format
msgid ""
"%1 and %2 define the same property (%3) in the composition of %1. This might "
"be incompatible, to improve maintainability consider using accessor methods "
"in traits instead."
msgstr ""

#: duchain/builders/declarationbuilder.cpp:890
#, kde-format
msgid "Cannot redeclare %1, already declared in %2 on line %3."
msgstr ""
"%1 дегенді қайта мәлімдеуге болмайды, ол %2 дегенде %3 жолда мәлімделген."

#: duchain/builders/declarationbuilder.cpp:936
msgid "Cannot re-assign $this."
msgstr "$this дегенді қайта тағайындау болмайды."

#: duchain/builders/declarationbuilder.cpp:1374
#, kde-format
msgid "The use statement with non-compound name '%1' has no effect."
msgstr "Құрылымды емес '%1' деп аталған өрнек істемейді."

#: duchain/builders/declarationbuilder.cpp:1398
#, kde-format
msgid "Cannot use '%1' as '%2' because the name is already in use."
msgstr ""

#: duchain/builders/usebuilder.cpp:204
#, kde-format
msgid "Usage of %1 is deprecated."
msgstr "%1 пайдалануы ескірген."

#: duchain/builders/usebuilder.cpp:206
#, kde-format
msgid "Declaration not found: %1"
msgstr "Мәлімдемесі жоқ: %1"

