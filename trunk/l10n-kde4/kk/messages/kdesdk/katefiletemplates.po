"<qt><strong>%1</strong><br />деген файлды оқу үшін ашқандағы ашу қатесі. "
"Құжат құрылмайды.</qt>"

#: filetemplates.cpp:361 filetemplates.cpp:969
msgid "Template Plugin"
msgstr "Үлгілер плагині"

#: filetemplates.cpp:430
#, kde-format
msgid "Untitled %1"
msgstr "Аталмаған %1"

