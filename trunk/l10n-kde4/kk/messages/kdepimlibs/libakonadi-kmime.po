#. i18n: ectx: label, entry (ImapServer), group (network)
#: imapresource.kcfg:10
msgid "IMAP server"
msgstr "IMAP сервері"

#. i18n: ectx: label, entry (ImapPort), group (network)
#: imapresource.kcfg:13
msgid "Defines the port the IMAP service is running on"
